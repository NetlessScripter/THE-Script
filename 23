function MakeReadOnlyCamera()
	local real = workspace.CurrentCamera
	return setmetatable({}, {
		__index = function(_, key)
			local value = real[key]
			if type(value) == "function" then
				return function(_, ...) return value(real, ...) end
			end
			return value
		end,
		__newindex = function() end,
	})
end

local function destroyActorInstance(plr)
	local inst = ActorInstances[plr]
	if not inst then return end
	ActorInstances[plr] = nil
	for _, name in ipairs({ "TriggerConn", "AnimPlayedConn" }) do
		local conn = rawget(inst.env, name)
		if conn then pcall(function() conn:Disconnect() end) end
	end
end

