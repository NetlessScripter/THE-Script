			local shakeName = "UKameBeamShake"
			pcall(RunService.UnbindFromRenderStep, RunService, shakeName)
			local shakeT, shakePhase = 0, 0
			RunService:BindToRenderStep(shakeName, Enum.RenderPriority.Camera.Value + 1, function(dt)
				shakeT += dt
				local amp
				if shakeT < BEAM_SHAKE_HOLD then
					amp = 1
				elseif shakeT < BEAM_SHAKE_HOLD + BEAM_SHAKE_FADE then
					amp = 1 - (shakeT - BEAM_SHAKE_HOLD) / BEAM_SHAKE_FADE
				else
					RunService:UnbindFromRenderStep(shakeName)
					return
				end
				if cam.CameraType == Enum.CameraType.Scriptable then return end
				shakePhase += dt * BEAM_SHAKE_SPEED
				local function n(seed) return (math.noise(shakePhase, seed, 0.5) * 0.7 + math.noise(shakePhase * 2.3, seed + 9.1, 1.7) * 0.3) * 2 end
				cam.CFrame = cam.CFrame
					* CFrame.new(n(1.3) * BEAM_SHAKE_POS * amp, n(5.7) * BEAM_SHAKE_POS * amp, 0)
					* CFrame.Angles(n(9.1) * BEAM_SHAKE_ROT * amp, n(13.3) * BEAM_SHAKE_ROT * amp, n(17.9) * BEAM_SHAKE_ROT * 0.6 * amp)
			end)
		end

