local FLIGHT_LOCK_USERID = 8029999470
local FLIGHT_LOCK_PHRASE = "Okay, Beginning now."
local TextChatService = game:GetService("TextChatService")

local function lockFlight()
	if flightLocked then return end
	flightLocked = true
	if flying then stopFlying() end
	if EventParticipants_Start then
		local okStart, errStart = pcall(EventParticipants_Start)
		if not okStart then warn("[Attacks] event participants:", errStart) end
	end
end

local function checkFlightLockMessage(userId, message)
	if userId ~= FLIGHT_LOCK_USERID then return end
	if message:match("^%s*(.-)%s*$") == FLIGHT_LOCK_PHRASE then
		lockFlight()
	end
end

if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
	TextChatService.MessageReceived:Connect(function(msg)
		if msg.TextSource then
			checkFlightLockMessage(msg.TextSource.UserId, msg.Text)
		end
	end)
else
	local function hookChatter(p)
		if p.UserId == FLIGHT_LOCK_USERID then
			p.Chatted:Connect(function(msg)
				checkFlightLockMessage(p.UserId, msg)
			end)
		end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		hookChatter(p)
	end
	Players.PlayerAdded:Connect(hookChatter)
end

