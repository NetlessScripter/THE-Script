startFlying = function()
	if flying or attack5Running or flightLocked then return end
	flying = true

	if not fxActive then fovBase = camera.FieldOfView end
	initPhysics()
	humanoid.PlatformStand = true
	startFlyY = rootPart.Position.Y
	wasAudible = false
	roll.active = false
	setMiniButtons(true)

	local _, y0, _ = rootPart.CFrame:ToEulerAnglesYXZ()
	yawCur, bankCur, pitchCur = y0, 0, 0

	local v = rootPart.AssemblyLinearVelocity
	local fallSpeed = math.max(0, -v.Y)
	local vel = Vector3.new(v.X, math.max(v.Y, 18), v.Z)
	speedCur = vel.Magnitude
	dirCur = speedCur > 1 and vel.Unit or Vector3.new(0, 1, 0)
	bonus = CFG.LAUNCH_BONUS

	if fallSpeed > 30 then
		local lk = camera.CFrame.LookVector
		local flat = Vector3.new(lk.X, 0, lk.Z)
		flat = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, -1)
		dirCur = (flat + Vector3.new(0, 0.1, 0)).Unit
		speedCur = math.max(speedCur, fallSpeed * CFG.CATCH_CONVERT)
		bonus = bonus + math.clamp((fallSpeed - 30) * 0.6, 0, CFG.CATCH_MAX)
		punch(1.0, 1.4, 1.1)
	else
		punch(0.55, 0.8, 1.0)
	end

	renderConn = RunService.RenderStepped:Connect(step)
end

stopFlying = function()
	if not flying then return end
	flying = false

	if renderConn then renderConn:Disconnect(); renderConn = nil end
	if landHitbox then landHitbox:Destroy(); landHitbox = nil end
	setMiniButtons(false)

	humanoid.PlatformStand = false

	local bv = rootPart:FindFirstChild(BV_NAME)
	if bv then bv:Destroy() end

	local v = rootPart.AssemblyLinearVelocity
	if v.Magnitude > CFG.RELEASE_CAP then
		rootPart.AssemblyLinearVelocity = v.Unit * CFG.RELEASE_CAP
	end

	if flyTrack  and flyTrack.IsPlaying  then flyTrack:Stop(0.4)  end
	if diveTrack and diveTrack.IsPlaying then diveTrack:Stop(0.4) end
	if idleTrack and idleTrack.IsPlaying then idleTrack:Stop(0.4) end

	stopFlySound()
	wasAudible = false
	speedCur, bonus, bankCur, pitchCur = 0, 0, 0, 0
	roll.active = false
	rollTilt = 0
end

playLandAnim = function(impactSpeed)
	if not landTrack then return end
	if fallTrack and fallTrack.IsPlaying then fallTrack:Stop(0.2) end
	falling = false

	landTrack:Play(0.1)
	for _, snd in ipairs(landSounds) do snd:Play() end
	impactFx(impactSpeed or 90)
end

