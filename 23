	local BEAM_DISTANCE = 24 * BEAM_SCALE
	local BEAM_DURATION = 3
	local BEAM_FADE     = 1
	local BEAM_SHAKE_HOLD = 3
	local BEAM_SHAKE_FADE = 1
	local BEAM_SHAKE_POS  = 1.1
