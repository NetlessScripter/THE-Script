	local function step(dt)
		T = os.clock() - T0
		if T >= TOTAL then finish() return end
		cam.CameraType = Enum.CameraType.Scriptable

		local cf = hrp.CFrame
		local F = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
		F = F.Magnitude > 0.01 and F.Unit or F0
		local R = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
		R = R.Magnitude > 0.01 and R.Unit or R0
		local torso = hrp.Position + Vector3.new(0, 0.6, 0)
		local headP = headFn()

		orbSm = orbSm:Lerp(orbTarget(), 1 - math.exp(-dt * 25))
		local d = orbD(T)
		local vis = d > 0.03

		local pos, tgt, fov, roll, shk = shot(T, F, R, torso, headP, orbSm)
		pos = Vector3.new(pos.X, math.max(pos.Y, G0 + 0.6), pos.Z)
		shakeI = lerp(shakeI, shakeTarget(T), 1 - math.exp(-dt * 14))
		shakePhase += dt * (5 + 4 * shakeI)
		local function n2(seed) return (math.noise(shakePhase, seed, 0.5) * 0.7 + math.noise(shakePhase * 2.3, seed + 9.1, 1.7) * 0.3) * 2 end
		local rotAmp = shk + shakeI * 0.03
		local shake = CFrame.Angles(n2(1.7) * rotAmp, n2(7.1) * rotAmp, n2(13.3) * (rotAmp * 0.5 + shakeI * 0.015))
		local shakePos = CFrame.new(n2(21.3) * shakeI * 0.45, n2(31.7) * shakeI * 0.45, 0)
		cam.CFrame = CFrame.lookAt(pos, tgt) * shakePos * CFrame.Angles(0, 0, math.rad(roll)) * shake
		cam.FieldOfView = fov
		local dist = (pos - tgt).Magnitude
		dof.FocusDistance = dist
		dof.InFocusRadius = math.clamp(dist * 0.45, 2.5, 18)

		local gl = sstep(seg(T, 0, 1.3))
		local g1 = sstep(seg(T, 0.15, 1.0))
		if ACTOR_IS_LOCAL then
			Lighting.ExposureCompensation = orig.exp - 0.8 * gl
			Lighting.Ambient = orig.amb:Lerp(Color3.fromRGB(25, 40, 95), 0.75 * gl)
			Lighting.OutdoorAmbient = orig.oamb:Lerp(Color3.fromRGB(25, 40, 95), 0.75 * gl)
		end
		cc.TintColor = WHITE:Lerp(Color3.fromRGB(165, 205, 255), gl)
		cc.Contrast = 0.22 * gl
		cc.Saturation = 0.18 * gl
		cc.Brightness = -0.04 * gl
		bloom.Intensity = 0.45 * gl + d * 0.04
		bloom.Size = lerp(24, 40, gl)
		bloom.Threshold = lerp(1, 0.93, gl)
		sun.Intensity = 0.05 * gl
		dof.FarIntensity = 0.45 * gl

		local op = 1 + 0.05 * math.sin(T * 34) + 0.03 * math.sin(T * 57)
		local ocf = CFrame.new(orbSm)
		orb.core.Size = Vector3.one * math.max(0.05, d * 0.55 * op)
		orb.mid.Size = Vector3.one * math.max(0.05, d * 0.8 * op)
		orb.out.Size = Vector3.one * math.max(0.05, d * 1.15 * op)
		orb.glow.Size = Vector3.one * math.max(0.05, d * 1.5 * op)
		orb.core.CFrame = ocf orb.mid.CFrame = ocf orb.out.CFrame = ocf orb.glow.CFrame = ocf
		orb.core.Transparency = vis and 0 or 1
		orb.mid.Transparency = vis and 0.3 or 1
		orb.out.Transparency = vis and 0.76 or 1
		orb.glow.Transparency = vis and 0.95 or 1
		orb.mid.Color = CYAN:Lerp(WHITE, 0.25 * seg(T, 5.1, 5.9))
		light.Range = math.clamp(d * 14, 0, 60)
		light.Brightness = d * 1.5

		local shellSize = d * 1.6 + 6
		shell.Size = Vector3.one * shellSize
		shell.CFrame = ocf
		local sp = shellSize / 2 / 0.52
		local inRate = vis and lerp(30, 100, sstep(seg(T, 1.0, 5.9))) or 0
		inDots.Rate = inRate
		inSwirl.Rate = inRate * 0.15
		inDots.Speed = NumberRange.new(sp * 0.85, sp * 1.15)
		inSwirl.Speed = NumberRange.new(sp * 0.85, sp * 1.15)
		starFlare.Rate = vis and 8 or 0
		starFlare.Size = NumberSequence.new(d * 1.8 * op)
		halo.Rate = vis and 5 or 0
		halo.Size = NumberSequence.new(d * 3.2)

		while cometTimes[cIdx] and T >= cometTimes[cIdx] do
			comet(d)
			cIdx += 1
		end
		if T >= 2.45 and T < 3.45 then
			acc.spark += dt * 50
			while acc.spark >= 1 do
				acc.spark -= 1
				streak(headFn, 0.8, 3 + math.random() * 5, 0.22, 0.05, 0.9 + math.random(), CYAN)
			end
		end
		local bodyRate = (vis and T >= 3.45) and 12 or 0
		acc.body += dt * bodyRate
		while acc.body >= 1 do
			acc.body -= 1
			streak(orbFn, d * 0.7 + 0.5, d * 0.7 + 5 + math.random() * 5, 0.35, 0.07, 2, CYAN)
		end

		while events[evIdx] and T >= events[evIdx][1] do
			local ok, err = pcall(events[evIdx][2])
			if not ok then warn("[UKame] " .. tostring(err)) end
			evIdx += 1
		end

		for i = #anims, 1, -1 do
			if anims[i](T) then table.remove(anims, i) end
		end

		setVig(0.55 * gl + 0.2 * seg(T, 4.75, 5.9))
		local lineAmt = sstep(seg(T, 4.2, 4.5)) * (0.12 + 0.1 * sstep(seg(T, 4.75, 5.9)))
		updateLines(dt, lineAmt)
		local fi = math.clamp((d - 0.6) / 1.8, 0, 1) * (T >= 3.45 and 0.65 or 0.5) * (1 - 0.3 * sstep(seg(T, 5.5, 5.9)))
		if ACTOR_IS_LOCAL then updateFlare(fi) end
		if T > 5.55 then
			flashF.BackgroundColor3 = WHITE
			flashF.BackgroundTransparency = 1 - 0.22 * sstep(seg(T, 5.6, 5.9)) ^ 2
		end
	end

	T0 = os.clock()
	conn = RunService.RenderStepped:Connect(function(dt)
		local ok, err = pcall(step, dt)
		if not ok then
			warn("[UKame] " .. tostring(err))
			finish(true)
		end
	end)
