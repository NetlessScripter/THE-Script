		local g = gl * ATTACK4_GRADE_STRENGTH
		Lighting.ExposureCompensation = orig.exp - 0.8 * g
		Lighting.Ambient = orig.amb:Lerp(DARK_BLUE, math.clamp(0.75 * g, 0, 1))
		Lighting.OutdoorAmbient = orig.oamb:Lerp(DARK_BLUE, math.clamp(0.75 * g, 0, 1))
		cc.TintColor = WHITE:Lerp(TINT, math.clamp(g, 0, 1))
		cc.Contrast = 0.22 * g
		cc.Saturation = 0.18 * g
		cc.Brightness = -0.04 * g
		bloom.Intensity = 0.45 * g
		bloom.Size = 24 + 16 * gl
		bloom.Threshold = 1 - 0.07 * gl
		sun.Intensity = 0.05 * g
		dof.FarIntensity = 0.45 * g
	end

	conn = runService.RenderStepped:Connect(function()
		if controller.finished then return end
		local now = os.clock()
		local gl
		if releaseStart then
			local a = math.clamp((now - releaseStart) / ATTACK4_GRADE_RELEASE_SECONDS, 0, 1)
			gl = releaseFrom * (1 - sstep(a))
			if a >= 1 then cleanup() return end
		else
			gl = sstep((now - startTime) / ATTACK4_GRADE_RAMP_SECONDS)
			lastGl = gl
		end
		apply(gl)
		curGl = gl

		if focusPart and focusPart.Parent then
			local dist = (camera.CFrame.Position - focusPart.Position).Magnitude
			dof.FocusDistance = dist
			dof.InFocusRadius = math.clamp(dist * 0.45, 2.5, 18)
		end
	end)

	pcall(runService.UnbindFromRenderStep, runService, flareBind)
	runService:BindToRenderStep(flareBind, Enum.RenderPriority.Last.Value, function()
		if controller.finished then return end
		updateFlare(ATTACK4_FLARE_STRENGTH * curGl)
	end)

	function controller.release()
		if controller.finished or releaseStart then return end
		releaseStart = os.clock()
		releaseFrom = lastGl
	end

	function controller.abort()
		cleanup()
	end

	task.delay(4, controller.release)
	return controller
end

attack4CameraController = nil

function StartAttack4Camera()
	if not ACTOR_IS_LOCAL then
		return { finished = true, burst = function() end, restore = function() end }
	end
	local runService = game:GetService("RunService")
	local camera = workspace.CurrentCamera
	local bindName = "Attack4Camera"

	local originalFov = camera.FieldOfView
	if attack4CameraController and not attack4CameraController.finished then
		originalFov = attack4CameraController.originalFov
		attack4CameraController.finished = true
	end
	pcall(runService.UnbindFromRenderStep, runService, bindName)

	local controller = { originalFov = originalFov, finished = false }
	attack4CameraController = controller

	local phase = "zoom"
	local phaseStartTime = os.clock()
	local phaseStartFov = originalFov
	local lastFov = originalFov
	local fovReleased = false
	local shakeStartTime = nil
	local shakePhase = 0

	local function lerp(startValue, endValue, alpha)
		return startValue + (endValue - startValue) * alpha
	end
	local function easeOut(alpha)
		return 1 - (1 - alpha) * (1 - alpha)
	end
	local function easeInOut(alpha)
		return -(math.cos(math.pi * alpha) - 1) / 2
	end

	local function finish()
		controller.finished = true
		pcall(runService.UnbindFromRenderStep, runService, bindName)
	end

	runService:BindToRenderStep(bindName, Enum.RenderPriority.Camera.Value + 2, function(deltaTime)
		if controller.finished then
			finish()
			return
		end

		local now = os.clock()
		local phaseElapsed = now - phaseStartTime

		if not fovReleased then
			local targetFov
			if phase == "zoom" then
				local alpha = math.clamp(phaseElapsed / ATTACK4_ZOOM_SECONDS, 0, 1)
				targetFov = lerp(phaseStartFov, ATTACK4_ZOOM_FOV, easeInOut(alpha))
			elseif phase == "burst" then
				if phaseElapsed < ATTACK4_BURST_RISE_SECONDS then
					local alpha = phaseElapsed / ATTACK4_BURST_RISE_SECONDS
					targetFov = lerp(phaseStartFov, ATTACK4_BURST_FOV, easeOut(alpha))
				else
					local alpha = math.clamp((phaseElapsed - ATTACK4_BURST_RISE_SECONDS) / ATTACK4_SETTLE_SECONDS, 0, 1)
					targetFov = lerp(ATTACK4_BURST_FOV, ATTACK4_SETTLE_FOV, easeOut(alpha))
				end
			else
				local alpha = math.clamp(phaseElapsed / ATTACK4_RESTORE_SECONDS, 0, 1)
				targetFov = lerp(phaseStartFov, originalFov, easeInOut(alpha))
				if alpha >= 1 then
					fovReleased = true
					targetFov = originalFov
				end
			end
			lastFov = targetFov
			camera.FieldOfView = targetFov
		end

		local shakeActive = false
		if shakeStartTime then
			local shakeElapsed = now - shakeStartTime
			local amplitude = 0
			if shakeElapsed < ATTACK4_SHAKE_HOLD_SECONDS then
				amplitude = 1
			elseif shakeElapsed < ATTACK4_SHAKE_HOLD_SECONDS + ATTACK4_SHAKE_FADE_SECONDS then
				amplitude = 1 - (shakeElapsed - ATTACK4_SHAKE_HOLD_SECONDS) / ATTACK4_SHAKE_FADE_SECONDS
			end
			if amplitude > 0 then
				shakeActive = true
				if camera.CameraType ~= Enum.CameraType.Scriptable then
					shakePhase += deltaTime * ATTACK4_SHAKE_SPEED
					local function noise(seed)
						return (math.noise(shakePhase, seed, 0.5) * 0.7 + math.noise(shakePhase * 2.3, seed + 9.1, 1.7) * 0.3) * 2
					end
					camera.CFrame = camera.CFrame
						* CFrame.new(noise(1.3) * ATTACK4_SHAKE_POSITION * amplitude, noise(5.7) * ATTACK4_SHAKE_POSITION * amplitude, 0)
						* CFrame.Angles(
							noise(9.1) * ATTACK4_SHAKE_ROTATION * amplitude,
							noise(13.3) * ATTACK4_SHAKE_ROTATION * amplitude,
							noise(17.9) * ATTACK4_SHAKE_ROTATION * 0.6 * amplitude
						)
				end
			end
		end

		if fovReleased and not shakeActive then
			finish()
		end
	end)

	function controller.burst()
		if controller.finished or phase ~= "zoom" then return end
		phase = "burst"
		phaseStartTime = os.clock()
		phaseStartFov = lastFov
		shakeStartTime = os.clock()
	end

	function controller.restore()
		if controller.finished or phase == "restore" then return end
		phase = "restore"
		phaseStartTime = os.clock()
		phaseStartFov = lastFov
	end

	return controller
end

