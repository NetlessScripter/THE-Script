			task.delay(0.07, function()
				A4FX_Ring(debrisFolder, ringFrame, 3, 36, 0.3, 0.35, CORE, 0.2)
			end)
			dustPuff(groundHit.Position, color, math.floor(24 * quality), 45)
			throwShards(groundHit.Position, groundHit.Normal, color, material, math.floor(14 * quality), 22, 52)
		end
