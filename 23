			for _, d in ipairs(model:GetDescendants()) do
				if d:IsA("BasePart") then
					local offset = refCFrame:ToObjectSpace(d.CFrame)
					if not engineScaled then
						d.Size = d.Size * BEAM_SCALE
						offset = CFrame.new(offset.Position * BEAM_SCALE) * (offset - offset.Position)
					end
