function A4FX_Bolt(parent, startPos, direction, boltLength, jitter, haloColor, coreColor, rng)
	local segments = 5
	local anchor = A4FX_Anchor("Bolt", parent)
	anchor.CFrame = CFrame.new(startPos)

	local sideA = direction:Cross(Vector3.yAxis)
	if sideA.Magnitude < 0.01 then
		sideA = Vector3.xAxis
	end
	sideA = sideA.Unit
	local sideB = direction:Cross(sideA).Unit

	local attachments = {}
	for index = 0, segments do
		local attachment = Instance.new("Attachment")
		local wobble = (index == 0 or index == segments) and 0 or jitter
		attachment.Position = direction * (boltLength * index / segments)
			+ sideA * rng:NextNumber(-wobble, wobble)
			+ sideB * rng:NextNumber(-wobble, wobble)
		attachment.Parent = anchor
		attachments[index + 1] = attachment
	end

	for index = 1, segments do
		for layer = 1, 2 do
			local beam = Instance.new("Beam")
			beam.Attachment0 = attachments[index]
			beam.Attachment1 = attachments[index + 1]
			beam.FaceCamera = true
			beam.Segments = 1
			beam.LightEmission = 1
			beam.LightInfluence = 0
			beam.Color = ColorSequence.new(layer == 1 and haloColor or coreColor)
			local width = layer == 1 and 0.6 or 0.2
			beam.Width0 = width
			beam.Width1 = width
			beam.Transparency = NumberSequence.new(layer == 1 and 0.35 or 0)
			beam.Parent = anchor
		end
	end

	game:GetService("Debris"):AddItem(anchor, 0.09)
end

function StartAttack4ChargeFX(handFn, chargeSeconds)
	local runService = game:GetService("RunService")
	local tweenService = game:GetService("TweenService")
	local debris = game:GetService("Debris")
	local quality = math.clamp(ATTACK4_FX_QUALITY or 1, 0.4, 1)
	local CORE, MID = ATTACK4_FX_CORE_COLOR, ATTACK4_FX_MID_COLOR
	local rng = Random.new()
	local controller = { finished = false }

	local folder = Instance.new("Folder")
	folder.Name = "Attack4ChargeFX"
	folder.Parent = workspace
	debris:AddItem(folder, 2.5)

	local duration = chargeSeconds or 0.6
	local startTime = os.clock()

	local orbShell = A4FX_Part("OrbShell", Enum.PartType.Ball, Vector3.one * 0.6, MID, 0.5, folder)
	local orbCore = A4FX_Part("OrbCore", Enum.PartType.Ball, Vector3.one * 0.4, CORE, 0, folder)
	local light = Instance.new("PointLight")
	light.Color = MID
	light.Range = 6
	light.Brightness = 1
	light.Shadows = false
	light.Parent = orbCore

	local streaks = {}
	local streakCount = math.floor(22 * quality)
	local nextStreak = 1
	local connection

	local function stopLoop()
		if controller.finished then
			return
		end
		controller.finished = true
		if connection then
			connection:Disconnect()
		end
	end

	local function step()
		if controller.finished then
			return
		end
		local elapsed = os.clock() - startTime
		local hand = handFn()
		local progress = math.clamp(elapsed / duration, 0, 1)

		local size = 0.4 + 3.4 * progress ^ 1.8
		local tremble = 0.08 * progress
		local jitter = Vector3.new(rng:NextNumber(-tremble, tremble), rng:NextNumber(-tremble, tremble), rng:NextNumber(-tremble, tremble))
		local pulse = 1 + 0.07 * math.sin(elapsed * 70)
		orbShell.Size = Vector3.one * (size * 1.6 * pulse)
		orbShell.Position = hand + jitter
		orbCore.Size = Vector3.one * (size * pulse)
		orbCore.Position = hand + jitter
		light.Range = 6 + 16 * progress
		light.Brightness = 1 + 3 * progress

		while nextStreak <= streakCount and elapsed >= (nextStreak - 1) / streakCount * duration * 0.6 do
			nextStreak += 1
			local direction = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.5, 1), rng:NextNumber(-1, 1))
			if direction.Magnitude < 0.25 then
				direction = Vector3.yAxis
			end

			local part = A4FX_Part("Streak", Enum.PartType.Block, Vector3.new(0.2, 0.2, 0.2), CORE, 1, folder)
			local attachment0 = Instance.new("Attachment")
			attachment0.Position = Vector3.new(0, 0.3, 0)
			attachment0.Parent = part
			local attachment1 = Instance.new("Attachment")
			attachment1.Position = Vector3.new(0, -0.3, 0)
			attachment1.Parent = part

			local trail = Instance.new("Trail")
			trail.Attachment0 = attachment0
			trail.Attachment1 = attachment1
			trail.Lifetime = 0.16
			trail.LightEmission = 1
			trail.LightInfluence = 0
			trail.FaceCamera = true
			trail.Color = ColorSequence.new(CORE, MID)
			trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
			trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
			trail.Parent = part

			table.insert(streaks, {
				part = part,
				direction = direction.Unit,
				radius = rng:NextNumber(9, 16),
				born = elapsed,
				life = math.max(0.14, math.min(rng:NextNumber(0.2, 0.3), duration - elapsed)),
			})
		end

		for index = #streaks, 1, -1 do
			local streak = streaks[index]
			local t = (elapsed - streak.born) / streak.life
			if t >= 1 then
				streak.part:Destroy()
				table.remove(streaks, index)
			else
				local swirl = CFrame.Angles(0, t * 1.3, 0)
				streak.part.Position = hand + swirl:VectorToWorldSpace(streak.direction) * streak.radius * (1 - t * t)
			end
		end
	end

	step()
	connection = runService.Heartbeat:Connect(step)

	function controller.release()
		if controller.finished then
			return
		end
		stopLoop()
		for _, streak in ipairs(streaks) do
			streak.part:Destroy()
		end
		table.clear(streaks)
		local info = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		tweenService:Create(orbShell, info, { Size = orbShell.Size * 1.8, Transparency = 1 }):Play()
		tweenService:Create(orbCore, info, { Size = orbCore.Size * 0.4, Transparency = 1 }):Play()
		tweenService:Create(light, info, { Brightness = 0 }):Play()
		debris:AddItem(folder, 0.3)
	end

	function controller.abort()
		stopLoop()
		folder:Destroy()
	end

	task.delay(1.5, controller.abort)
	return controller
end

function PlayAttack4BeamFX(model)
