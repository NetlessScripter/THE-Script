local function angleDiff(a, b)  -- shortest signed a - b
	local d = (a - b) % (math.pi * 2)
	if d > math.pi then d = d - math.pi * 2 end
	return d
end

local function turnToward(a, b, maxAng)
	local d = math.clamp(a:Dot(b), -1, 1)
	local ang = math.acos(d)
	if ang <= maxAng or ang < 1e-4 then return b end
	local axis = a:Cross(b)
	if axis.Magnitude < 1e-4 then axis = Vector3.yAxis end -- exactly opposite: swing round the vertical
	axis = axis.Unit
	local c, s = math.cos(maxAng), math.sin(maxAng)
	local r = a * c + axis:Cross(a) * s + axis * axis:Dot(a) * (1 - c)
	return r.Unit
end

