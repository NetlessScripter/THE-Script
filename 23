ATTACK1_HITSTOP_SECONDS       = 0.12
ATTACK1_LANCE_LENGTH          = 36
ATTACK1_LANCE_GROW_SECONDS    = 0.07
ATTACK1_LANCE_TOTAL_SECONDS   = 0.42
ATTACK1_GATHER_FOV            = -8
ATTACK1_BURST_FOV             = 16
ATTACK1_BURST_RISE_SECONDS    = 0.05
ATTACK1_BURST_SETTLE_SECONDS  = 0.45
ATTACK1_EMBER_COUNT           = 22
ATTACK1_EMBER_LIFE_SECONDS    = 0.5

attack1CameraController = nil

function Attack1_StartCamera()
	if not ACTOR_IS_LOCAL then
		return { finished = true, appliedKick = 0, abort = function() end, burst = function() end }
	end
	local runService = game:GetService("RunService")
	local camera = workspace.CurrentCamera
	local bindName = "Attack1Camera"

	if attack1CameraController then
		attack1CameraController.abort()
	end
	pcall(runService.UnbindFromRenderStep, runService, bindName)

	local controller = { finished = false, appliedKick = 0 }
	attack1CameraController = controller
	local phase = "gather"
	local phaseStartTime = os.clock()
	local burstStartKick = 0

	local function applyKick(targetKick)
		camera.FieldOfView += targetKick - controller.appliedKick
		controller.appliedKick = targetKick
	end

	function controller.abort()
		if controller.finished then
			return
		end
		controller.finished = true
		pcall(runService.UnbindFromRenderStep, runService, bindName)
		applyKick(0)
	end

	function controller.burst()
		if controller.finished then
			return
		end
		phase = "burst"
		phaseStartTime = os.clock()
		burstStartKick = controller.appliedKick
	end

	runService:BindToRenderStep(bindName, Enum.RenderPriority.Camera.Value + 2, function()
		if controller.finished then
			return
		end
		local elapsed = os.clock() - phaseStartTime
		if phase == "gather" then
			local gatherAlpha = math.clamp(elapsed / ATTACK1_ORB_SECONDS, 0, 1)
			applyKick(ATTACK1_GATHER_FOV * gatherAlpha * gatherAlpha)
		elseif elapsed < ATTACK1_BURST_RISE_SECONDS then
			local riseAlpha = elapsed / ATTACK1_BURST_RISE_SECONDS
			local easedRise = 1 - (1 - riseAlpha) * (1 - riseAlpha)
			applyKick(burstStartKick + (ATTACK1_BURST_FOV - burstStartKick) * easedRise)
		else
			local settleAlpha = math.clamp((elapsed - ATTACK1_BURST_RISE_SECONDS) / ATTACK1_BURST_SETTLE_SECONDS, 0, 1)
			applyKick(ATTACK1_BURST_FOV * (1 - settleAlpha) * (1 - settleAlpha))
			if settleAlpha >= 1 then
				controller.abort()
			end
		end
	end)

	task.delay(1.5, controller.abort)
	return controller
end

function Attack1_FindTarget(maximumDistance)
	local rootPosition = HumanoidRootPart.Position
	local facingDirection = HumanoidRootPart.CFrame.LookVector
	local candidateCharacters = {}
	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= LocalPlayer and otherPlayer.Character then
			table.insert(candidateCharacters, otherPlayer.Character)
		end
	end
	local liveFolder = workspace:FindFirstChild("Live")
	local trainingDummy = liveFolder and liveFolder:FindFirstChild("Weakest Dummy")
	if trainingDummy then
		table.insert(candidateCharacters, trainingDummy)
	end

	local closestRoot = nil
	local closestDistance = maximumDistance
	for _, candidateCharacter in ipairs(candidateCharacters) do
		local candidateRoot = candidateCharacter:FindFirstChild("HumanoidRootPart")
		local candidateHumanoid = candidateCharacter:FindFirstChildOfClass("Humanoid")
		if candidateRoot and candidateHumanoid and candidateHumanoid.Health > 0 then
			local offset = candidateRoot.Position - rootPosition
			local distance = offset.Magnitude
			if distance > 0.01 and distance < closestDistance and offset.Unit:Dot(facingDirection) > 0.25 then
				closestRoot = candidateRoot
				closestDistance = distance
			end
		end
	end
	return closestRoot
end

function Attack1_ResolveImpact()
	local facingDirection = Vector3.new(HumanoidRootPart.CFrame.LookVector.X, 0, HumanoidRootPart.CFrame.LookVector.Z)
	facingDirection = facingDirection.Magnitude > 0.01 and facingDirection.Unit or Vector3.new(0, 0, -1)

	local targetRoot = Attack1_FindTarget(ATTACK1_TARGET_RANGE)
	if not targetRoot then
		return A4FX_Hand(), facingDirection
	end

	local offset = targetRoot.Position - HumanoidRootPart.Position
	local flatOffset = Vector3.new(offset.X, 0, offset.Z)
	local punchDirection = flatOffset.Magnitude > 0.01 and flatOffset.Unit or facingDirection
	local bellyPosition = targetRoot.Position - punchDirection * 0.9 - Vector3.new(0, 0.35, 0)
	return bellyPosition, punchDirection
end

