function Attack1_FireLance(folder, originPosition, direction)
	local runService = game:GetService("RunService")
	local lanceCore = A4FX_Part("LanceCore", Enum.PartType.Cylinder, Vector3.new(0.1, 0.1, 0.1), ATTACK4_FX_CORE_COLOR, 0, folder)
	local lanceShell = A4FX_Part("LanceShell", Enum.PartType.Cylinder, Vector3.new(0.1, 0.1, 0.1), ATTACK4_FX_MID_COLOR, 0.4, folder)
	local startTime = os.clock()
	local connection

	connection = runService.Heartbeat:Connect(function()
		local elapsed = os.clock() - startTime
		if elapsed >= ATTACK1_LANCE_TOTAL_SECONDS or not folder.Parent then
			connection:Disconnect()
			lanceCore:Destroy()
			lanceShell:Destroy()
			return
		end

		local growAlpha = math.clamp(elapsed / ATTACK1_LANCE_GROW_SECONDS, 0, 1)
		local lanceLength = math.max(0.1, ATTACK1_LANCE_LENGTH * (1 - (1 - growAlpha) ^ 3))
		local fadeAlpha = math.clamp((elapsed - ATTACK1_LANCE_GROW_SECONDS) / (ATTACK1_LANCE_TOTAL_SECONDS - ATTACK1_LANCE_GROW_SECONDS), 0, 1)
		local thicknessScale = (1 - fadeAlpha) ^ 2
		local flicker = 1 + 0.08 * math.sin(elapsed * 90)
		local coreDiameter = math.max(0.05, 1.1 * thicknessScale * flicker)
		local shellDiameter = math.max(0.05, 3.4 * thicknessScale * flicker)
		local lanceCenter = originPosition + direction * (lanceLength / 2)
		local lanceFrame = A4FX_Frame(lanceCenter, direction)

		lanceCore.Size = Vector3.new(lanceLength, coreDiameter, coreDiameter)
		lanceShell.Size = Vector3.new(lanceLength, shellDiameter, shellDiameter)
		lanceCore.CFrame = lanceFrame
		lanceShell.CFrame = lanceFrame
		lanceShell.Transparency = 0.4 + 0.6 * fadeAlpha
	end)
end

function Attack1_EmitEmbers(folder, originPosition, direction)
	local runService = game:GetService("RunService")
	local rng = Random.new()
	local embers = {}

	for _ = 1, ATTACK1_EMBER_COUNT do
		local emberPart = A4FX_Part("Ember", Enum.PartType.Block, Vector3.new(0.2, 0.2, 0.2), ATTACK4_FX_CORE_COLOR, 1, folder)
		local topAttachment = Instance.new("Attachment")
		topAttachment.Position = Vector3.new(0, 0.3, 0)
		topAttachment.Parent = emberPart
		local bottomAttachment = Instance.new("Attachment")
		bottomAttachment.Position = Vector3.new(0, -0.3, 0)
		bottomAttachment.Parent = emberPart

		local emberTrail = Instance.new("Trail")
		emberTrail.Attachment0 = topAttachment
		emberTrail.Attachment1 = bottomAttachment
		emberTrail.Lifetime = 0.2
		emberTrail.LightEmission = 1
		emberTrail.LightInfluence = 0
		emberTrail.FaceCamera = true
		emberTrail.Color = ColorSequence.new(ATTACK4_FX_CORE_COLOR, ATTACK4_FX_MID_COLOR)
		emberTrail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
		emberTrail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
		emberTrail.Parent = emberPart

		local scatter = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.4, 1), rng:NextNumber(-1, 1))
		local launchVector = direction * rng:NextNumber(0.4, 1.4) + scatter
		if launchVector.Magnitude < 0.2 then
			launchVector = direction
		end
		table.insert(embers, {
			part = emberPart,
			position = originPosition,
			velocity = launchVector.Unit * rng:NextNumber(45, 110),
		})
	end

	local startTime = os.clock()
	local connection
	connection = runService.Heartbeat:Connect(function(deltaTime)
		local elapsed = os.clock() - startTime
		if elapsed >= ATTACK1_EMBER_LIFE_SECONDS or not folder.Parent then
			connection:Disconnect()
			for _, ember in ipairs(embers) do
				ember.part:Destroy()
			end
			return
		end
		local dragFactor = math.max(0.1, 1 - 2.4 * deltaTime)
		for _, ember in ipairs(embers) do
			ember.velocity = (ember.velocity + Vector3.new(0, -55 * deltaTime, 0)) * dragFactor
			ember.position += ember.velocity * deltaTime
			ember.part.Position = ember.position
		end
	end)
end

