	fadeTween.Completed:Connect(function()
		snd:Destroy()
		if flySound == snd then flySound = nil end
		fadeTween = nil
	end)
end

-- ===== tricks =====
local function triggerBoost()
	if not flying then return end
	local now = os.clock()
	if now < boostReady then return end
	boostReady = now + CFG.BOOST_COOLDOWN
	bonus = math.min(CFG.MAX_BONUS, bonus + CFG.BOOST_BURST)
	speedCur = math.min(CFG.MAX_SPEED, speedCur + CFG.BOOST_KICK)
	punch(0.85, 1.0, 1.35)
end

local function doRoll(sign)
	if not flying or roll.active or speedCur < 40 then return end
	local now = os.clock()
	if now < roll.ready then return end
	roll.active = true
	roll.t = 0
	roll.dir = (sign and sign ~= 0) and sign or lastStrafe
	roll.ready = now + CFG.ROLL_COOLDOWN
	bonus = math.min(CFG.MAX_BONUS, bonus + CFG.ROLL_BONUS)
	punch(0.35, nil, 1.15)
end

-- ===== camera fx (runs just after the Roblox camera has updated) =====
local punchBlur = Instance.new("BlurEffect")
punchBlur.Name = randomName()
punchBlur.Size = 0
punchBlur.Parent = camera

local function camFx(dt)
	camera = workspace.CurrentCamera or camera
	if camera.CameraType == Enum.CameraType.Scriptable then return end -- cutscenes own the camera

	camSpeed = camSpeed + ((flying and speedCur or 0) - camSpeed) * (1 - math.exp(-5 * dt))
	local targetRoll = flying and (math.rad(bankCur) * CFG.CAM_ROLL_FRAC + rollTilt) or 0
	camRoll   = camRoll + (targetRoll - camRoll) * (1 - math.exp(-8 * dt))
	fovKick   = fovKick   * math.exp(-CFG.FOV_KICK_DECAY * dt)
	camPunch  = camPunch  * math.exp(-CFG.CAM_PUNCH_DECAY * dt)
	shake     = shake     * math.exp(-CFG.SHAKE_DECAY * dt)
	blurPunch = blurPunch * math.exp(-CFG.BLUR_DECAY * dt)

	local active = flying or camSpeed > 1 or math.abs(camRoll) > 0.002 or fovKick > 0.05
		or camPunch > 0.03 or shake > 0.01 or blurPunch > 0.05
	if not active then
		if fxActive then
			fxActive = false
			camera.FieldOfView = fovBase
			punchBlur.Size = 0
		end
		return
	end
	fxActive = true
	if punchBlur.Parent ~= camera then punchBlur.Parent = camera end

	local r = math.clamp(camSpeed / CFG.MAX_SPEED, 0, 1)
	local fov = fovBase * (1 + CFG.FOV_SPEED_GAIN * (r ^ 0.8)) + fovKick
	camera.FieldOfView = math.min(fov, math.max(CFG.FOV_MAX, fovBase))

	local t = os.clock()
	local amp = CFG.SHAKE_SPEED * r * r + shake
	local sx = math.noise(t * 23, 1.3, 0) * 2 * amp
	local sy = math.noise(t * 27, 7.7, 0) * 2 * amp
	local sr = math.noise(t * 19, 3.1, 0) * 2 * amp
	local pull = CFG.CAM_PULLBACK * r + camPunch
	camera.CFrame = camera.CFrame * CFrame.new(sx, sy, pull) * CFrame.Angles(0, 0, camRoll + math.rad(sr * 1.5))
	punchBlur.Size = math.clamp(blurPunch, 0, 24)
end
RunService:BindToRenderStep(FX_NAME, Enum.RenderPriority.Camera.Value + 1, camFx)

-- ===== main flight step =====
local function step(dt)
	if not flying then return end -- guard against a stray frame after stopFlying
	if dt > 0.1 then dt = 0.1 end
	local now = os.clock()

	local bv = rootPart:FindFirstChild(BV_NAME)
	if not bv then
		initPhysics()
		bv = rootPart:FindFirstChild(BV_NAME)
		if not bv then return end
	end
	bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)

	-- ---- input ----
	local camCF = camera.CFrame
	local look = camCF.LookVector
	local rf = Vector3.new(-look.Z, 0, look.X)
	local right = rf.Magnitude > 1e-3 and rf.Unit or camCF.RightVector

	local dirIn = controlModule:GetMoveVector()
	local wishDir
	if dirIn.Magnitude > 0.01 then
		local w = right * dirIn.X - look * dirIn.Z
		if w.Magnitude > 1e-3 then wishDir = w.Unit end
	end
	local moving     = wishDir ~= nil
	local forwardIn  = moving and dirIn.Z < 0
	local isDiving   = moving and look.Y < -0.2 and dirIn.Z < 0
	local isBackward = dirIn.Z > 0
	local shiftHeld  = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or now < mobileBoostUntil
	if math.abs(dirIn.X) > 0.3 then lastStrafe = dirIn.X > 0 and 1 or -1 end

	-- ---- dive / climb momentum ----
	local diveFactor  = forwardIn and math.clamp((-look.Y - 0.15) / 0.6, 0, 1) or 0
	local climbFactor = forwardIn and math.clamp((look.Y - 0.15) / 0.6, 0, 1) or 0
	if diveFactor > 0 then
		bonus = math.min(CFG.MAX_BONUS, bonus + CFG.DIVE_GAIN * diveFactor * dt)
		if diveFactor > 0.5 and bonus > CFG.SLING_MIN_BONUS then lastDiveTime = now end
	else
		bonus = math.max(0, bonus - (CFG.BONUS_DECAY + CFG.CLIMB_BLEED * climbFactor) * dt)
	end
	-- pull-up slingshot: dive hard, then pull up -> extra kick
	if climbFactor > 0.25 and now - lastDiveTime < CFG.SLING_WINDOW and now > slingReady then
		lastDiveTime = -math.huge
		slingReady = now + 1.0
		bonus = math.min(CFG.MAX_BONUS, bonus + CFG.SLING_BONUS)
		punch(0.8, 1.2, 1.25)
	end

	-- ---- speed with inertia ----
	local baseSpeed = CFG.CRUISE_SPEED * (shiftHeld and CFG.BOOST_MULT or 1)
	local targetSpeed = moving and math.min(baseSpeed + bonus, CFG.MAX_SPEED) or 0
	local rate
	if targetSpeed > speedCur then rate = CFG.ACCEL
	elseif moving then rate = CFG.SLOW_DRAG
	else rate = CFG.STOP_DRAG end
	speedCur = speedCur + (targetSpeed - speedCur) * (1 - math.exp(-rate * dt))
	local r = math.clamp(speedCur / CFG.MAX_SPEED, 0, 1)

	-- ---- heading with inertia (heavier the faster you go) ----
	if moving then
		if speedCur < 12 then
			dirCur = wishDir
		else
			local turnRate = CFG.TURN_SLOW + (CFG.TURN_FAST - CFG.TURN_SLOW) * r
			dirCur = turnToward(dirCur, wishDir, turnRate * dt)
		end
	end

	local vel = dirCur * speedCur
	if speedCur < 8 and not moving and CFG.HOVER_BOB > 0 then
		vel = vel + Vector3.new(0, math.sin(now * 1.8) * CFG.HOVER_BOB, 0)
	end
	bv.Velocity = vel

	-- ---- hitbox (stops flight on contact, same as v1) ----
	local hitSize = 10 + math.max(0, speedCur - 200) * 0.05 -- a bit larger at extreme speed so thin walls can't be tunnelled
	if not landHitbox or not landHitbox.Parent then
		landHitbox = Instance.new("Part")
		landHitbox.Name         = "Hitbox"
		landHitbox.Size         = Vector3.new(hitSize, hitSize, hitSize)
		landHitbox.Anchored     = true
		landHitbox.CanCollide   = false
		landHitbox.CanQuery     = false
		landHitbox.CastShadow   = false
		landHitbox.Transparency = 1
		landHitbox.CFrame       = rootPart.CFrame
		landHitbox.Parent       = workspace

		landHitbox.Touched:Connect(function(hit)
			if not flying then return end
			if hit:IsDescendantOf(character) then return end
			local hitModel = hit:FindFirstAncestorOfClass("Model")
			if hitModel == character then return end
			local impactSpeed = speedCur
			if landHitbox then landHitbox:Destroy(); landHitbox = nil end
			stopFlying()
			playLandAnim(impactSpeed)
		end)
	else
		landHitbox.Size = Vector3.new(hitSize, hitSize, hitSize)
		landHitbox.CFrame = rootPart.CFrame
	end

	-- ---- height cap ----
	if rootPart.Position.Y >= startFlyY + CFG.MAX_FLY_HEIGHT then
		stopFlying()
		falling = true
		if fallTrack and not fallTrack.IsPlaying then fallTrack:Play(0.2) end
		return
	end

	-- ---- animations (fly pose follows actual speed, so coasting doesn't snap to idle) ----
	if isDiving then
		if flyTrack.IsPlaying  then flyTrack:Stop(0.3)  end
		if idleTrack.IsPlaying then idleTrack:Stop(0.3) end
		if not diveTrack.IsPlaying then diveTrack:Play(0.3) end
		diveTrack:AdjustSpeed(0.9 + r * 0.5)
	elseif speedCur > 25 and not (moving and isBackward) then
		if diveTrack.IsPlaying then diveTrack:Stop(0.3) end
		if idleTrack.IsPlaying then idleTrack:Stop(0.3) end
		if not flyTrack.IsPlaying then flyTrack:Play(0.3) end
		flyTrack:AdjustSpeed(0.85 + r * 0.6)
	else
		if flyTrack.IsPlaying  then flyTrack:Stop(0.3)  end
		if diveTrack.IsPlaying then diveTrack:Stop(0.3) end
		if not idleTrack.IsPlaying then idleTrack:Play(0.3) end
	end

	-- ---- wind sound follows speed ----
	local audible = speedCur > 14
	if audible and not wasAudible then
		playFlySound()
	elseif not audible and wasAudible then
		stopFlySound()
	end
	wasAudible = audible
	if audible and flySound and not fadeTween then
		flySound.PlaybackSpeed = 0.85 + r * 0.55
		flySound.Volume = 0.6 + r * 0.7
	end

	-- ---- body orientation: yaw (lagged) + bank + pitch lean + barrel roll ----
	local lookFlat = Vector3.new(look.X, 0, look.Z)
	local yawTarget = yawCur
	if moving and lookFlat.Magnitude > 0.001 then
		yawTarget = math.atan2(-lookFlat.Z, lookFlat.X) - math.rad(90)
	end
	local newYaw = yawCur + angleDiff(yawTarget, yawCur) * (1 - math.exp(-CFG.YAW_FOLLOW * dt))
	local yawRate = angleDiff(newYaw, yawCur) / math.max(dt, 1e-3)
	yawCur = newYaw

	local speedScale = math.clamp(speedCur / 60, 0, 1)
	local bankSign = CFG.BANK_INTO_TURN and 1 or -1
	local bankTarget = (yawRate * CFG.BANK_GAIN + dirIn.X * -CFG.STRAFE_BANK) * bankSign * speedScale
	bankTarget = math.clamp(bankTarget, -CFG.BANK_ANGLE, CFG.BANK_ANGLE)
	bankCur = bankCur + (bankTarget - bankCur) * (1 - math.exp(-CFG.BANK_FOLLOW * dt))

	local velPitch = math.asin(math.clamp(dirCur.Y, -1, 1))
	local pitchTarget = math.clamp(velPitch * CFG.LEAN_FACTOR * math.clamp(speedCur / 80, 0, 1),
		-math.rad(CFG.LEAN_MAX_DOWN), math.rad(CFG.LEAN_MAX_UP))
	pitchCur = pitchCur + (pitchTarget - pitchCur) * (1 - math.exp(-CFG.LEAN_FOLLOW * dt))

	local rollAngle = 0
	rollTilt = 0
	if roll.active then
		roll.t = roll.t + dt / CFG.ROLL_TIME
		if roll.t >= 1 then
			roll.active = false
			roll.t = 0
		else
			local e = roll.t * roll.t * (3 - 2 * roll.t)
			rollAngle = -roll.dir * math.pi * 2 * e
			rollTilt = -roll.dir * math.sin(math.pi * roll.t) * math.rad(CFG.ROLL_CAM_TILT)
		end
	end

	rootPart.CFrame = CFrame.new(rootPart.Position)
		* CFrame.Angles(0, yawCur, 0)
		* CFrame.Angles(pitchCur, 0, 0)
		* CFrame.Angles(0, 0, math.rad(bankCur) + rollAngle)
end

