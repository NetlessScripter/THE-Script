-- Saves where we are, teleports to CUTSCENE_TELEPORT_POS, plays the cutscene, then teleports back to the saved spot.
function PlayCutsceneWithTeleport()
	local function getRoot()
		local c = LocalPlayer.Character
		return c and c:FindFirstChild("HumanoidRootPart")
	end

	local root = getRoot()
	local savedCFrame = root and root.CFrame -- exactly where we were right before teleporting
	local pinConn

	if root then
		local waitCFrame = CFrame.new(CUTSCENE_TELEPORT_POS)
		root.CFrame = waitCFrame
		-- keep us parked there for the whole cutscene (stops falling / other scripts moving us)
		pinConn = game:GetService("RunService").Heartbeat:Connect(function()
			local r = getRoot()
			if r then
				r.CFrame = waitCFrame
				r.AssemblyLinearVelocity = Vector3.zero
				r.AssemblyAngularVelocity = Vector3.zero
			end
		end)
	end

	if cutsceneSfx then
		cutsceneSfx.TimePosition = 0
		cutsceneSfx:Play() -- cutscene sound starts together with the cutscene
	end

	PlayPlanetExplosion(function()
		if pinConn then pinConn:Disconnect() end
		local r = getRoot()
		if r and savedCFrame then
			r.CFrame = savedCFrame -- back to where we were
			r.AssemblyLinearVelocity = Vector3.zero
			r.AssemblyAngularVelocity = Vector3.zero
		end
	end)
end

function StartAttack4Hitbox(duration)
	local state = { triggered = false }
	local char = LocalPlayer.Character or Character
	local root = (char and char:FindFirstChild("HumanoidRootPart")) or HumanoidRootPart

	local hitbox = Instance.new("Part")
	hitbox.Name = "Attack4Hitbox"
	hitbox.Size = ATTACK4_HITBOX_SIZE
	hitbox.Anchored = true
	hitbox.CanCollide, hitbox.CanQuery, hitbox.CanTouch, hitbox.CastShadow = false, false, false, false
	hitbox.Transparency = ATTACK4_HITBOX_DEBUG and 0.7 or 1
	hitbox.Color = Color3.new(1, 0, 0)
	hitbox.Material = Enum.Material.SmoothPlastic
	hitbox.CFrame = root.CFrame * CFrame.new(0, 0, -ATTACK4_HITBOX_OFFSET)
	hitbox.Parent = workspace

	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char, hitbox }

	local startTime = os.clock()
	local conn
	local function stop()
		if conn then conn:Disconnect(); conn = nil end
		if hitbox then hitbox:Destroy(); hitbox = nil end
	end
	state.stop = stop

	conn = game:GetService("RunService").Heartbeat:Connect(function()
		if not hitbox then return end
		if os.clock() - startTime >= duration then stop() return end
		hitbox.CFrame = root.CFrame * CFrame.new(0, 0, -ATTACK4_HITBOX_OFFSET) -- rides along with us during the charge
		for _, part in ipairs(workspace:GetPartBoundsInBox(hitbox.CFrame, hitbox.Size, params)) do
			local model = part:FindFirstAncestorOfClass("Model")
			local hum = model and model:FindFirstChildOfClass("Humanoid")
			local plr = model and Players:GetPlayerFromCharacter(model)
			local live = workspace:FindFirstChild("Live")
			local dummy = live and live:FindFirstChild("Weakest Dummy")
			local isTarget = (plr ~= nil and plr ~= LocalPlayer) or (dummy ~= nil and model == dummy)
			if hum and isTarget and hum.Health > 0 and hum.Health <= ATTACK4_FINISHER_HEALTH then
				state.triggered = true
				stop() -- destroy the hitbox; the explosion waits for the beam fade
				return
			end
		end
	end)
	return state
end

-- ================= PLANET EXPLOSION V3 (embedded) =================
-- PlayPlanetExplosion() runs the whole cinematic (camera takeover, ~7s). Fired by the Attack 4 finisher below.
PlayPlanetExplosion = (function()
--[[
	PLANET EXPLOSION V3  (LocalScript -> StarterPlayer > StarterPlayerScripts)
	Explosion happens CONFIG.Distance studs in front of the camera.

	Pacing : charge (energy spirals INTO the core, camera pushes in, rumble builds)
	         -> inhale (everything collapses, screen dims)  -> BREACH (blue) -> SECOND BURST
	         -> fade out (the hot detonation, aftershocks and whiteout were cut).
	3D     : trail-based spiral comets (smooth curved streaks), jagged lightning cracks,
	         tapered beam starbursts, 12-layer neon core, tilted shockwaves, glowing debris, embers.
	Screen : stretched particle lens flare (core, band, long streaks, ghost - recolored every phase), 24-layer radial haze,
	         smooth UI shockwave rings, vignette, impact frames.
	Camera : impulse shake with decay, dolly via FOV, whip-out on detonation.
]]

local CONFIG = {
	Distance = 3000,                          -- studs from camera to the explosion
	FOV = 60,
	UseStage = true,                          -- true: camera sits at StageOrigin (empty void)
	StageOrigin = Vector3.new(0, 25000, 0),   -- false: uses your current camera position/direction
	Quality = 1,                              -- 0.4 - 1 (lower = fewer trails/beams, better for mobile)
	Shake = 1,
	ExplosionShake = 1,                       -- strength of the big smooth camera shakes on the two blue explosions (0 = off)
	Sway = 1,
	Flare = 1,                                -- lens flare strength (0 = off)
	FlareStretch = 1,                         -- how far the flare is stretched out horizontally (0 = round, 2 = double)
	FlareTilt = 10,                           -- degrees the stretch is tilted (+ = rising to the right, - = falling)
	SlowMo = true,
	HideUI = true,                            -- hides ALL ui (game HUD, CoreGui, gethui, chat, topbar, touch controls) while playing
	AutoPlay = false,                         -- unused here: the explosion is fired by the Attack 4 finisher
	EarthAssetId = 750680926,
	EarthIntroSeconds = 2,
	EarthScreenFraction = 0.55,
	StartupScale = 1,
	EarthParkDistance = 8000,
	EarthReveal = true,                       -- black night-to-day shadow sweeps across the earth during the intro, then is destroyed
	EarthRevealSeconds = 2.2,                 -- how long the shadow takes to slide off the planet
	EarthWarningGlow = true,                  -- highlight fades in on the earth right before it gets moved (planet about to blow)
	EarthWarningGlowSeconds = 1,              -- how long before the breach the glow tween runs
	EarthWarningGlowEase = 2.5,               -- ease-in strength: 1 = linear, 2 = quad, 3 = cubic, higher = later and sharper
	EndFadeOutSeconds = 1.5,                  -- the black screen at the end of the cutscene fades out over this long instead of cutting instantly
	ImpactFlashSeconds = 0.035,               -- real-time length of the pure black & white impact frame on the big blue explosion (0 = off)
}

