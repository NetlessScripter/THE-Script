	local impactLight = Instance.new("PointLight")
	impactLight.Color = MID
	impactLight.Range = 22
	impactLight.Brightness = 0
	impactLight.Shadows = false
	impactLight.Parent = impactFlash

	local function dustPuff(position, color, count, speed)
		local anchor = A4FX_Anchor("DustPuff", debrisFolder)
		anchor.CFrame = CFrame.new(position)
		local attachment = Instance.new("Attachment")
		attachment.Parent = anchor
		local emitter = Instance.new("ParticleEmitter")
		emitter.Texture = "rbxassetid://272050333"
		emitter.Color = ColorSequence.new(color:Lerp(Color3.fromRGB(170, 170, 170), 0.45))
		emitter.LightEmission = 0
		emitter.LightInfluence = 1
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 10) })
		emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 1) })
		emitter.Lifetime = NumberRange.new(0.6, 1.1)
		emitter.Speed = NumberRange.new(speed * 0.4, speed)
		emitter.SpreadAngle = Vector2.new(75, 75)
		emitter.EmissionDirection = Enum.NormalId.Top
		emitter.Drag = 4
		emitter.Rate = 0
		emitter.Parent = attachment
		emitter:Emit(count)
		debris:AddItem(anchor, 1.6)
	end

	local function throwShards(origin, normal, color, material, count, speedMin, speedMax)
		for _ = 1, count do
			local size = rng:NextNumber(0.25, 0.7)
			local shard = Instance.new("Part")
			shard.Name = "Shard"
			shard.Size = Vector3.new(size * rng:NextNumber(0.7, 1.3), size, size * rng:NextNumber(0.7, 1.3))
			shard.Color = color
			shard.Material = material
			shard.Anchored = false
			shard.CanCollide = false
			shard.CanQuery = false
			shard.CanTouch = false
			shard.CastShadow = false
			shard.CFrame = CFrame.new(origin + normal * 0.3 + Vector3.new(rng:NextNumber(-1.5, 1.5), 0, rng:NextNumber(-1.5, 1.5)))
				* CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0)
			shard.Parent = debrisFolder

			local push = normal * rng:NextNumber(0.9, 1.5) + Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(0.2, 1), rng:NextNumber(-1, 1))
			if push.Magnitude < 0.1 then
				push = Vector3.yAxis
			end
			shard.AssemblyLinearVelocity = push.Unit * rng:NextNumber(speedMin, speedMax)
			shard.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-20, 20), rng:NextNumber(-20, 20), rng:NextNumber(-20, 20))

