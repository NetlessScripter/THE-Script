Part_upvr = Instance.new("Part", Character)
Part_upvr.Transparency = 1
Part_upvr.Anchored = true
Part_upvr.CanCollide = false
Part_upvr.Massless = true
Part_upvr.Size = Vector3.new()

HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")
Humanoid = Character:WaitForChild("Humanoid")

tickW = 0

RunService.RenderStepped:Connect(function()
	Magnitude = HumanoidRootPart.Velocity.Magnitude

	if 0 < Magnitude then
		Part_upvr.CFrame = CFrame.new(CurrentCamera.CFrame.Position, CurrentCamera.CFrame.Position + HumanoidRootPart.Velocity * 5)
	else
		Part_upvr.Position = CurrentCamera.CFrame.Position
	end

	tickW += 1

	Blur.Size = math.clamp(Magnitude / 70, 0, 9)

	
	isMovingNow = Magnitude > 8
	if isMovingNow and not wasMoving then
		if runBlurTween then runBlurTween:Cancel() end
		RunBlur.Size = 0
		runBlurTween = TweenService:Create(
			RunBlur,
			TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{Size = 0}
		)
		runBlurTween:Play()
	elseif not isMovingNow then
		if runBlurTween then runBlurTween:Cancel() end
		RunBlur.Size = 0
	end
	wasMoving = isMovingNow

	wndPos = CurrentCamera.CFrame.Position + CurrentCamera.CFrame.LookVector * 15
	wndPart.CFrame = CFrame.new(wndPos, wndPos + CurrentCamera.CFrame.LookVector)

	if 80 <= Magnitude and tickW % math.max(1, math.floor(50 / Magnitude)) == 0 then
		Part = Instance.new("Part")
		Part.CastShadow = false
		Part.Color = Color3.new(1,1,1)
		Part.Material = Enum.Material.ForceField
		Part.Transparency = 1
		Part.Size = Vector3.new(0.03, 0.03, Magnitude / 60)
		Part.CanCollide = false
		Part.Massless = true
		Part.Parent = workspace

		SpecialMesh = Instance.new("SpecialMesh")
		SpecialMesh.MeshType = Enum.MeshType.Sphere
		SpecialMesh.Parent = Part

		cframe = CFrame.new(math.random(-300,300)/100, math.random(-200,200)/100, -math.floor(Magnitude/50)*2)

		Weld = Instance.new("Weld", Part)
		Weld.Part0 = Part_upvr
		Weld.Part1 = Part
		Weld.C0 = cframe

		for _, v in pairs(wndAttachment:GetDescendants()) do
			if v:IsA("ParticleEmitter") then
				v.Enabled = true
				if v.Name ~= "Wind3" then
					v.Speed = NumberRange.new(math.clamp(5*Magnitude/40,-100,50), math.clamp(20*Magnitude/40,-100,200))
					v.Rate = math.clamp(2*Magnitude/4, 0, _G.G_Optimized and 1000 or 2000)
				elseif v.Name == "Wind3" then
					lock = false
					if Humanoid.FloorMaterial == Enum.Material.Air then
						if 250 >= Magnitude then
							lock = false
						else
							lock = true
						end
					end
					v.LockedToPart = lock
				end
			end
		end

		Debris:AddItem(Part, 0.6)

		TweenService:Create(Part, TweenInfo.new(0.05, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 0), {Transparency = 0.8}):Play()
		TweenService:Create(Weld, TweenInfo.new(0.3, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 0), {C0 = CFrame.new(cframe.Position.X, cframe.Position.Y, math.floor(Magnitude/100)*4)}):Play()

		-- Non-blocking: never wait()/task.wait() inside a RenderStepped callback.
		-- A blocking wait here let a new copy of this whole block spawn every
		-- frame while the old one was still stalled, stacking up coroutines,
		-- Parts, Welds, and Tweens faster than Debris could clean them up.
		-- Part/Weld are reused globals, so grab local refs before scheduling
		-- the delayed callback or a later frame's reassignment would leak in.
		local partRef = Part
		task.delay(0.225, function()
			if partRef and partRef.Parent then
				TweenService:Create(partRef, TweenInfo.new(0.095, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 0), {Transparency = 1}):Play()
			end
		end)
	else
		for _, v in pairs(wndAttachment:GetChildren()) do
			if v:IsA("ParticleEmitter") then
				v.Enabled = false
			end
		end
	end
end)

end)
