local EARTH_MODEL_NAME = "PlanetExplosionEarth"
local cachedEarthModel = nil
local EARTH_VISUAL_TO_BOUNDS_RATIO = 2.1
local EARTH_BEHIND_PLANE_MARGIN = 1.06

local function obtainEarthModel()
	if cachedEarthModel and cachedEarthModel.Parent then
		return cachedEarthModel
	end
	local existingEarthModel = Workspace:FindFirstChild(EARTH_MODEL_NAME)
	if existingEarthModel then
		cachedEarthModel = existingEarthModel
		return existingEarthModel
	end
	local loadSucceeded, loadedObjects = pcall(function()
		return game:GetObjects("rbxassetid://" .. tostring(CONFIG.EarthAssetId))
	end)
	if not loadSucceeded or type(loadedObjects) ~= "table" or #loadedObjects == 0 then
		warn("PlanetExplosion: could not load earth model " .. tostring(CONFIG.EarthAssetId) .. " - " .. tostring(loadedObjects))
		return nil
	end
	local earthModel = Instance.new("Model")
	earthModel.Name = EARTH_MODEL_NAME
	for _, loadedObject in ipairs(loadedObjects) do
		loadedObject.Parent = earthModel
	end
	for _, descendant in ipairs(earthModel:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
			descendant.CastShadow = false
		end
	end
	earthModel.Parent = Workspace
	cachedEarthModel = earthModel
	return earthModel
end

local function fitEarthDiameter(earthModel, targetDiameter)
	local _, boundingSize = earthModel:GetBoundingBox()
	local currentDiameter = math.max(boundingSize.X, boundingSize.Y, boundingSize.Z)
	if currentDiameter <= 0 then
		return
	end
	local scaleSucceeded, scaleError = pcall(function()
		earthModel:ScaleTo(earthModel:GetScale() * targetDiameter / currentDiameter)
	end)
	if not scaleSucceeded then
		warn("PlanetExplosion: could not scale earth model - " .. tostring(scaleError))
	end
end

local function centerEarthAt(earthModel, targetPosition)
	local boundingCFrame = earthModel:GetBoundingBox()
	earthModel:PivotTo(earthModel:GetPivot() + (targetPosition - boundingCFrame.Position))
end

local function play(onDone)
	if playing then return end
	playing = true

	local rng = Random.new(1337)
	local function rr(a, b) return rng:NextNumber(a, b) end
	local function pick(t) return t[rng:NextInteger(1, #t)] end
	local function cnt(n) return math.max(1, math.floor(n * CONFIG.Quality)) end

	-- ================= camera & scale =================
	local D = CONFIG.Distance
	local camBase = CONFIG.UseStage and CFrame.new(CONFIG.StageOrigin) or camera.CFrame
	local C = camBase * CFrame.new(0, 0, -D) -- explosion center; axes = camera axes (X right, Y up, Z toward camera)

	local earthModel = obtainEarthModel()

	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = CONFIG.FOV
	camera.CFrame = camBase
	camera.Focus = C

	local V = camera.ViewportSize
	local aspect = math.max(V.X / math.max(V.Y, 1), 1.6)
	local halfH = D * math.tan(math.rad(CONFIG.FOV) / 2)
	local S = halfH * aspect -- half the visible width at the explosion plane; every size is a fraction of S
	local srcX, srcY, onScreen = V.X / 2, V.Y / 2, true

	local earthRadius = earthModel and CONFIG.EarthScreenFraction * halfH or 0
	local earthBackOffset = earthModel and EARTH_BEHIND_PLANE_MARGIN * D * earthRadius / (D - earthRadius) or 0
	local earthDistanceScale = (D + earthBackOffset) / D
	local startupScale = (1 + earthRadius / (0.2 * S)) * CONFIG.StartupScale
	local backdropDepth = earthModel and (earthBackOffset + earthRadius * earthDistanceScale + 300) or 300

	if earthModel then
		fitEarthDiameter(earthModel, math.min(2 * earthRadius * earthDistanceScale / EARTH_VISUAL_TO_BOUNDS_RATIO, 2000))
		centerEarthAt(earthModel, C.Position + camBase.LookVector * earthBackOffset)
	end

	-- ================= world setup =================
	-- remember which Roblox core UI was on (so we restore exactly that), then hide all of it
	local coreStates = {}
	for _, t in ipairs(Enum.CoreGuiType:GetEnumItems()) do
		if t ~= Enum.CoreGuiType.All then
			local okState, on = pcall(function() return StarterGui:GetCoreGuiEnabled(t) end)
			if okState then coreStates[t] = on end
		end
	end
	pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false) end)

	local removed = {}
	for _, c in ipairs(Lighting:GetChildren()) do
		if c:IsA("Sky") or c:IsA("Atmosphere") then
			table.insert(removed, c)
			c.Parent = nil
		end
	end
	local sky = Instance.new("Sky")
	for _, f in ipairs({ "SkyboxBk", "SkyboxDn", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxUp" }) do sky[f] = "" end
	sky.StarCount = 0
	sky.CelestialBodiesShown = false
	sky.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Size = 56
	bloom.Threshold = 0.8
	bloom.Parent = Lighting

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Saturation = 0.25
	cc.Parent = Lighting

	-- impact frame: a stack of max-contrast, fully desaturated color corrections crushes every pixel to pure black or pure white.
	-- (one effect can't hard-threshold, so several are chained). They stay disabled except for the flash.
	local flashCCs = {}
	for i = 1, 6 do
		local f = Instance.new("ColorCorrectionEffect")
		f.Saturation = -1
		f.Contrast = 1
		f.Brightness = 0
		f.TintColor = WHITE
		f.Enabled = false
		f.Parent = Lighting
		flashCCs[i] = f
	end
	local flashUntil, flashOn = 0, false
	local explosionShakes = {} -- { start = real-time stamp, strength, phase } per explosion; drives the smooth camera shakes

	local root = Instance.new("Folder")
	root.Name = "PlanetExplosionFX"
	root.Parent = Workspace

	local anchor = Instance.new("Part")
	anchor.Anchored, anchor.CanCollide, anchor.CanQuery, anchor.CanTouch = true, false, false, false
	anchor.Transparency = 1
	anchor.Size = Vector3.one
	anchor.CFrame = CFrame.new(C.Position)
	anchor.Parent = root

	local gui = Instance.new("ScreenGui")
	gui.IgnoreGuiInset = true
	gui.ScreenInsets = Enum.ScreenInsets.None -- no safe-area clamping, vignette hits the real screen edges
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 1000
	gui.Parent = player:WaitForChild("PlayerGui")

	-- hide EVERY ui while the cutscene plays: the game's HUD, CoreGui, gethui() guis, other scripts' guis, the chat window,
	-- the topbar and touch controls. A per-frame watcher keeps them hidden if the game (or another script) turns one back on
	-- or creates a new one. Only the cutscene's own gui and the white/black fade overlays are exempt.
	local hiddenGuis, controls = {}, nil
	local hiddenSet, chatStates, uiConn = {}, {}, nil
	local KEEP_GUI_NAMES = { Attack4FinisherWhite = true, PlanetExplosionEndFade = true }
	if CONFIG.HideUI then
		local containers = { player.PlayerGui }
		pcall(function() table.insert(containers, game:GetService("CoreGui")) end)
		pcall(function()
			if gethui then
				local h = gethui()
				if h and not table.find(containers, h) then table.insert(containers, h) end
			end
		end)

		local function hideAllGuis()
			for _, c in ipairs(containers) do
				local okKids, kids = pcall(c.GetChildren, c)
				if okKids then
					for _, g in ipairs(kids) do
						if g:IsA("ScreenGui") and g ~= gui and not KEEP_GUI_NAMES[g.Name] and g.Enabled then
							if not hiddenSet[g] then
								hiddenSet[g] = true
								table.insert(hiddenGuis, g)
							end
							pcall(function() g.Enabled = false end)
						end
					end
				end
			end
		end

		-- new-style chat (TextChatService): chat window + input bar
		local function hideChat()
			pcall(function()
				local tcs = game:GetService("TextChatService")
				for _, cls in ipairs({ "ChatWindowConfiguration", "ChatInputBarConfiguration" }) do
					local cfg = tcs:FindFirstChildOfClass(cls)
					if cfg then
						if chatStates[cfg] == nil then chatStates[cfg] = cfg.Enabled end
						cfg.Enabled = false
					end
				end
			end)
		end

		hideAllGuis()
		hideChat()
		local lastCoreSweep = os.clock()
		uiConn = RunService.RenderStepped:Connect(function()
			hideAllGuis()
			if os.clock() - lastCoreSweep > 0.25 then -- re-assert core UI / topbar / chat a few times a second
				lastCoreSweep = os.clock()
				pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false) end)
				pcall(function() StarterGui:SetCore("TopbarEnabled", false) end)
				hideChat()
			end
		end)

		pcall(function() StarterGui:SetCore("TopbarEnabled", false) end)
		pcall(function()
			controls = require(player.PlayerScripts:WaitForChild("PlayerModule", 2)):GetControls()
			controls:Disable()
		end)
	end

	-- ================= scheduler (story-time) =================
	local tasks = {}
	local function at(t0, dur, fn, done) table.insert(tasks, { t0 = t0, dur = dur, fn = fn, done = done }) end
	local function once(t0, fn) table.insert(tasks, { t0 = t0, once = true, fn = fn }) end

	-- ================= 3D building blocks =================
	local function newAtt()
		local a = Instance.new("Attachment")
		a.Parent = anchor
		return a
	end

	local function makeBeam(a0, a1, colorSeq)
		local b = Instance.new("Beam")
		b.Attachment0, b.Attachment1 = a0, a1
		b.FaceCamera = true
		b.LightEmission = 1
		b.LightInfluence = 0
		b.Segments = 1
		b.Color = colorSeq
		b.Width0, b.Width1 = 0, 0
		b.Parent = root
		return b
	end

	local function neonPart(shape)
		local p = Instance.new("Part")
		p.Shape = shape or Enum.PartType.Block
		p.Material = Enum.Material.Neon
		p.Anchored = true
		p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = false, false, false, false
		p.Parent = root
		return p
	end

	local function seqFor(base, tr)
		local t = base + (1 - base) * tr
		return NumberSequence.new({ NSK(0, t), NSK(0.55, t + (1 - t) * 0.4), NSK(1, 1) })
	end

	-- tapered beam streak: white-hot tail -> colored body -> soft tip (halo layer on thick rays)
	local function addRay(s)
		local dir = Vector3.new(math.cos(s.ang), math.sin(s.ang), s.z or 0).Unit
		local grow, hold, tm = s.grow or 0.25, s.hold or 0.5, s.tailMove or 0.7
		local useHalo = s.w > 0.009 * S
		local a0, a1, halo, body, core
		at(s.t0, s.life, function(a)
			if not a0 then
				a0, a1 = newAtt(), newAtt()
				if useHalo then halo = makeBeam(a0, a1, ColorSequence.new(s.color)) end
				body = makeBeam(a0, a1, ColorSequence.new({ CSK(0, WHITE), CSK(0.3, s.color), CSK(1, s.color) }))
				core = makeBeam(a0, a1, ColorSequence.new(WHITE))
			end
			local g = outExpo(math.min(a / grow, 1))
			local head = s.r0 + s.len * g
			local tail = s.r0 + s.len * tm * math.clamp((a - grow) / (1 - grow), 0, 1) ^ 1.5
			a0.WorldPosition = C * (dir * tail)
			a1.WorldPosition = C * (dir * head)
			local tr = math.max(1 - math.min(a / 0.05, 1), math.clamp((a - hold) / (1 - hold), 0, 1) ^ 1.3)
			local w = s.w * (1 - 0.5 * a)
			if halo then
				halo.Width0, halo.Width1 = w * 5, 0
				halo.Transparency = seqFor(0.82, tr)
			end
			body.Width0, body.Width1 = w * 2, 0
			body.Transparency = seqFor(0.3, tr)
			core.Width0, core.Width1 = w * 0.7, 0
			core.Transparency = seqFor(0, tr)
		end, function()
			if a0 then
				a0:Destroy(); a1:Destroy(); body:Destroy(); core:Destroy()
				if halo then halo:Destroy() end
			end
		end)
	end

	-- tilted ellipse shockwave ring (beam segments)
	local function addRing3D(s)
		local N = s.N or cnt(72)
		local cr, sr = math.cos(s.rot or 0), math.sin(s.rot or 0)
		local atts, beams
		at(s.t0, s.life, function(a)
			if not atts then
				atts, beams = {}, {}
				for i = 0, N do atts[i] = newAtt() end
				for i = 1, N do beams[i] = makeBeam(atts[i - 1], atts[i], ColorSequence.new(s.color)) end
			end
			local sc = s.s0 + (s.s1 - s.s0) * outExpo(a)
			for i = 0, N do
				local th = 2 * PI * (i / N)
				local x, y = s.rx * sc * math.cos(th), s.ry * sc * math.sin(th)
				atts[i].WorldPosition = C * Vector3.new(x * cr - y * sr, x * sr + y * cr, 0)
			end
			local tseq = NumberSequence.new(math.max(1 - math.min(a / 0.05, 1), a ^ 1.4))
