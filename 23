	local function updateFlare(strength)
		local vs = cam.ViewportSize
		local sp = cam:WorldToViewportPoint(orbSm)
		if sp.Z <= 0 or strength <= 0.01 then return end
		local toSrc = orbSm - cam.CFrame.Position
		local va = math.acos(math.clamp(cam.CFrame.LookVector:Dot(toSrc.Unit), -1, 1))
		local vf = math.rad(cam.FieldOfView)
		local ar = vs.X / vs.Y
		local df = 2 * math.atan(math.tan(vf * 0.5) * math.sqrt(1 + ar * ar))
		local aa = 1 - math.clamp(va / (df * 0.5), 0, 1)
		local alpha = aa * strength
		if alpha <= 0.001 then return end
		local center = Vector2.new(vs.X, vs.Y) * 0.5
		local off = Vector2.new(sp.X, sp.Y) - center
		local ft = 1 - aa
		for _, d in ipairs(flareEm) do
			local es = center + Vector2.new(off.X * d.pos.X, off.Y * d.pos.Y) * d.mult
			local ray = cam:ViewportPointToRay(es.X, es.Y)
			d.att.WorldPosition = ray.Origin + ray.Direction.Unit * FLARE_DEPTH
			d.e.Size = NumberSequence.new(lerp(d.s0, d.s1, ft))
			d.e.Squash = NumberSequence.new(-lerp(d.q0, d.q1, ft))
			d.e.Transparency = NumberSequence.new(math.clamp(1 - ((1 - lerp(d.t0, d.t1, ft)) * alpha), 0, 1))
			d.e:Emit(1)
		end
	end

