local function kf(t, pts)
	if t <= pts[1][1] then return pts[1][2] end
	for i = 2, #pts do
		local p0, p1 = pts[i - 1], pts[i]
		if t <= p1[1] then
			local s = (t - p0[1]) / (p1[1] - p0[1])
			s = s * s * (3 - 2 * s)
			local v0, v1 = p0[2], p1[2]
			if typeof(v0) == "Color3" then return v0:Lerp(v1, s) end
			return v0 + (v1 - v0) * s
		end
	end
	return pts[#pts][2]
end
local function outExpo(a) return a >= 1 and 1 or 1 - 2 ^ (-10 * a) end

local BLUE = { rgb(70, 150, 255), rgb(90, 230, 255), rgb(30, 80, 255), rgb(180, 205, 255) }
local HOT = { rgb(255, 120, 30), rgb(255, 220, 60), rgb(255, 60, 150), rgb(255, 255, 255), rgb(190, 70, 255), rgb(255, 150, 40) }
