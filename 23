	local _CACHE_FILE = "anim6d_kfcache_17585779478.json"
	local _HttpService = game:GetService("HttpService")

	local _jsonBody
	if isfile and isfile(_CACHE_FILE) then
		local ok, raw = pcall(readfile, _CACHE_FILE)
		if ok and raw and #raw > 100 then _jsonBody = raw end
	end
	if not _jsonBody then
		local ok, body = pcall(game.HttpGet, game, _CACHE_URL)
		if ok and body and #body > 100 then
