	}
	local shakeI, shakePhase = 0, 0
	local function shakeTarget(t)
		local x = lerp(0.15, 0.6, sstep(seg(t, 0, TOTAL))) + 0.15 * sstep(seg(t, 4.75, TOTAL))
		for _, im in ipairs(SHAKE_IMPACTS) do
			local age = t - im[1]
			if age >= 0 then
				x += im[2] * sstep(seg(age, 0, 0.07)) * math.exp(-age / im[3])
			end
		end
		return math.min(x, 1.3)
	end

