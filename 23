function A4FX_Hand()
	if RightArm and RightArm.Parent then
		return (RightArm.CFrame * CFrame.new(0, -1.35, 0)).Position
	end
	return HumanoidRootPart.Position + HumanoidRootPart.CFrame.LookVector * 2
end

function A4FX_Part(name, shape, size, color, transparency, parent)
	local part = Instance.new("Part")
	part.Name = name
	part.Shape = shape
	part.Size = size
	part.Color = color
	part.Material = Enum.Material.Neon
	part.Transparency = transparency
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Massless = true
	part.Parent = parent
	return part
end

function A4FX_Anchor(name, parent)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = Vector3.new(0.1, 0.1, 0.1)
	part.Transparency = 1
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Massless = true
	part.Parent = parent
	return part
end

function A4FX_LookFrame(position, direction)
	local dir = direction.Magnitude > 0.0001 and direction.Unit or Vector3.new(0, 0, -1)
	local upVector = math.abs(dir.Y) > 0.98 and Vector3.xAxis or Vector3.yAxis
	return CFrame.lookAt(position, position + dir, upVector)
end

function A4FX_Frame(position, direction)
	return A4FX_LookFrame(position, direction) * CFrame.Angles(0, math.pi / 2, 0)
end

function A4FX_Cast(origin, direction, ignore)
	local list = table.clone(ignore)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true
	for _ = 1, 5 do
		params.FilterDescendantsInstances = list
		local result = workspace:Raycast(origin, direction, params)
		if not result then
			return nil
		end
		local hit = result.Instance
		if hit.Transparency >= 0.95 and not hit.CanCollide then
			table.insert(list, hit)
		else
			return result
		end
	end
	return nil
end

function A4FX_IgnoreList(extra)
	local list = { LocalPlayer.Character or Character }
	local thrown = workspace:FindFirstChild("Thrown")
	if thrown then
		table.insert(list, thrown)
	end
	for _, wall in ipairs(game:GetService("CollectionService"):GetTagged("InvisibleWalls")) do
		table.insert(list, wall)
	end
	for _, instance in ipairs(extra or {}) do
		table.insert(list, instance)
	end
	return list
end

function A4FX_SurfaceColor(result)
	local instance = result.Instance
	if instance:IsA("Terrain") then
		local ok, color = pcall(function()
			return workspace.Terrain:GetMaterialColor(result.Material)
		end)
		return (ok and color) or Color3.fromRGB(120, 110, 100), result.Material
	end
	return instance.Color, result.Material
end

