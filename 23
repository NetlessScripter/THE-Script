local lastTap = {}
if not isMobile then
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		local kc = input.KeyCode
		if kc == Enum.KeyCode.U then
			if flying then stopFlying() else startFlying() end
		elseif not flying then
			return
		elseif kc == Enum.KeyCode.LeftShift then
			triggerBoost()
		elseif kc == CFG.ROLL_KEY then
			doRoll(lastStrafe)
		elseif CFG.DOUBLE_TAP_ROLL and (kc == Enum.KeyCode.A or kc == Enum.KeyCode.D) then
			local now = os.clock()
			if lastTap[kc] and now - lastTap[kc] < CFG.DOUBLE_TAP_WINDOW then
				doRoll(kc == Enum.KeyCode.D and 1 or -1)
				lastTap[kc] = nil
			else
				lastTap[kc] = now
			end
		end
	end)
end

local function hookHumanoid()
	humanoid.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Landed then
			if flying then stopFlying() end
			if flying or falling then playLandAnim(80) end
		end
	end)
	humanoid.Died:Connect(function()
		if flying then stopFlying() end
		if fallTrack and fallTrack.IsPlaying then fallTrack:Stop(0.2) end
		falling = false
	end)
end
