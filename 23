	local bloom
	if ATTACK4_FX_BLOOM ~= false and ACTOR_IS_LOCAL then
		bloom = Instance.new("BloomEffect")
		bloom.Name = "Attack4BeamBloom"
		bloom.Intensity = 0
		bloom.Size = 24
		bloom.Threshold = 0.95
		bloom.Parent = lighting
		tweenService:Create(bloom, TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Intensity = 0.9 }):Play()
	end

	local startTime = os.clock()
	local launchTime = 0.07
	local fadeStart, fadeDuration
	local rings = {}
	local ringIndex = 0
	local nextRing, nextBolt, nextTrail, nextImpactRing = 0, 0, 0, 0
	local hadHit = false
	local lastHitInstance, hitColor, hitMaterial
	local hitIsCharacter = false
	local connection

	local function cleanup()
		if controller.finished then
			return
		end
		controller.finished = true
		if connection then
			connection:Disconnect()
		end
		if bloom then
			bloom:Destroy()
		end
		folder:Destroy()
	end

	local function step()
		if controller.finished then
			return
		end
		if not root.Parent or not model.Parent then
			cleanup()
			return
		end

		local now = os.clock()
		local elapsed = now - startTime
		local fadeAlpha = 0
		if fadeStart then
			fadeAlpha = math.clamp((now - fadeStart) / fadeDuration, 0, 1)
			if fadeAlpha >= 1 then
				cleanup()
				return
			end
		end
		local keep = 1 - fadeAlpha

		local currentCF = root.CFrame
		local aim = currentCF.LookVector
		local muzzle = currentCF * muzzleLocal

		for part, relative in pairs(follow) do
			if part.Parent then
				part.CFrame = currentCF * relative
			end
		end

		local hit = A4FX_Cast(muzzle, aim * beamLength, ignore)
		local length = hit and math.max((hit.Position - muzzle).Magnitude, 1) or beamLength

		local launch = math.clamp(elapsed / launchTime, 0, 1)
		local launchEase = 1 - (1 - launch) * (1 - launch)
		local visibleLength = math.max(length * launchEase, 0.5)
		local flicker = 1 + math.noise(elapsed * 38, 3.1, 0.5) * 0.35

		beamCore.Size = Vector3.new(visibleLength, coreDiameter * flicker, coreDiameter * flicker)
		beamCore.CFrame = A4FX_Frame(muzzle + aim * (visibleLength / 2), aim)
		beamCore.Transparency = 0.2 + 0.8 * fadeAlpha
		beamShell.Size = Vector3.new(visibleLength, shellDiameter * (2 - flicker), shellDiameter * (2 - flicker))
		beamShell.CFrame = beamCore.CFrame
		beamShell.Transparency = 0.6 + 0.4 * fadeAlpha

		local pop = 1 + 1.2 * math.max(0, 1 - elapsed / 0.15)
		local orbSize = beamRadius * 1.6 * pop * flicker
		muzzleCore.Size = Vector3.one * orbSize
		muzzleCore.Position = muzzle
		muzzleCore.Transparency = 0.05 + 0.95 * fadeAlpha
		muzzleShell.Size = Vector3.one * (orbSize * 1.7)
		muzzleShell.Position = muzzle
		muzzleShell.Transparency = 0.55 + 0.45 * fadeAlpha
		muzzleLight.Brightness = 5 * keep
		muzzleAnchor.CFrame = A4FX_LookFrame(muzzle, aim)

		if not fadeStart and elapsed >= nextRing then
			nextRing = elapsed + 0.07
			if #rings < 10 then
				ringIndex += 1
				table.insert(rings, {
					part = A4FX_Part("PulseRing", Enum.PartType.Cylinder, Vector3.new(ringThickness, beamRadius * 2.3, beamRadius * 2.3), (ringIndex % 2 == 0) and CORE or MID, 0.2, folder),
					born = elapsed,
				})
			end
		end
		for index = #rings, 1, -1 do
			local ring = rings[index]
			local age = (elapsed - ring.born) / 0.26
			local distance = length * age
			if age >= 1 or distance >= length then
				ring.part:Destroy()
				table.remove(rings, index)
			else
				local diameter = beamRadius * 2.3 * (0.85 + 0.45 * age)
				ring.part.Size = Vector3.new(ringThickness, diameter, diameter)
				ring.part.CFrame = A4FX_Frame(muzzle + aim * distance, aim)
				ring.part.Transparency = math.clamp(0.2 + 0.8 * age * age + fadeAlpha, 0, 1)
			end
		end

		if not fadeStart and elapsed >= nextBolt then
			nextBolt = elapsed + 0.05
			local aimRight = aim:Cross(Vector3.yAxis)
			if aimRight.Magnitude < 0.01 then
				aimRight = Vector3.xAxis
			end
			aimRight = aimRight.Unit
			local aimUp = aimRight:Cross(aim).Unit
			for _ = 1, math.max(1, math.floor(2 * quality + 0.5)) do
				local angle = rng:NextNumber(0, math.pi * 2)
				local radial = aimRight * math.cos(angle) + aimUp * math.sin(angle)
				local startAt = muzzle + aim * (rng:NextNumber(0.03, 0.92) * length) + radial * (beamRadius * rng:NextNumber(0.75, 1.25))
				local direction = (aim * rng:NextNumber(0.6, 1) + radial * rng:NextNumber(-0.1, 0.9)).Unit
				A4FX_Bolt(folder, startAt, direction, rng:NextNumber(6, 15), beamRadius * 0.35, MID, CORE, rng)
			end
		end

		if hit then
			local normal = hit.Normal
			impactAnchor.CFrame = A4FX_LookFrame(hit.Position, normal)

			if hit.Instance ~= lastHitInstance then
				lastHitInstance = hit.Instance
				hitColor, hitMaterial = A4FX_SurfaceColor(hit)
				local owner = hit.Instance:FindFirstAncestorOfClass("Model")
				hitIsCharacter = owner ~= nil and owner:FindFirstChildOfClass("Humanoid") ~= nil
				impactDust.Color = ColorSequence.new(hitColor:Lerp(Color3.fromRGB(170, 170, 170), 0.45))
			end

			impactSparks.Enabled = not fadeStart
			impactDust.Enabled = (not fadeStart) and not hitIsCharacter

			local impactSize = beamRadius * 2.2 * flicker
			impactFlash.Size = Vector3.one * impactSize
			impactFlash.Position = hit.Position + normal * (impactSize * 0.2)
			impactFlash.Transparency = 0.2 + 0.8 * fadeAlpha
			impactGlow.Size = Vector3.one * (impactSize * 1.8)
			impactGlow.Position = impactFlash.Position
			impactGlow.Transparency = 0.6 + 0.4 * fadeAlpha
			impactLight.Brightness = 4 * keep

			if not hadHit then
				hadHit = true
				A4FX_Ring(debrisFolder, A4FX_Frame(hit.Position + normal * 0.2, normal), beamRadius * 1.5, beamRadius * 14, ringThickness, 0.45, CORE, 0.1)
				impactSparks:Emit(math.floor(40 * quality))
				if not hitIsCharacter then
					dustPuff(hit.Position, hitColor, math.floor(20 * quality), 40)
					throwShards(hit.Position, normal, hitColor, hitMaterial, math.floor(12 * quality), 25, 55)
				end
			end
			if not fadeStart and elapsed >= nextImpactRing then
				nextImpactRing = elapsed + 0.14
				A4FX_Ring(debrisFolder, A4FX_Frame(hit.Position + normal * 0.2, normal), beamRadius, beamRadius * 6, ringThickness * 0.8, 0.3, MID, 0.35)
			end
		else
			impactSparks.Enabled = false
			impactDust.Enabled = false
			impactFlash.Transparency = 1
			impactGlow.Transparency = 1
			impactLight.Brightness = 0
		end

		if ATTACK4_FX_GROUND ~= false and not fadeStart and elapsed >= nextTrail then
			nextTrail = elapsed + 0.07
			local low = math.min(5, length)
			local high = math.max(low, math.min(length, 70))
			local probe = muzzle + aim * rng:NextNumber(low, high)
			local ground = A4FX_Cast(probe + Vector3.new(0, 4, 0), Vector3.new(0, -34, 0), ignore)
			if ground and (probe.Y - ground.Position.Y) < 24 then
				local owner = ground.Instance:FindFirstAncestorOfClass("Model")
				if not (owner and owner:FindFirstChildOfClass("Humanoid")) then
					local color, material = A4FX_SurfaceColor(ground)
					dustPuff(ground.Position, color, math.floor(5 * quality + 0.5), 26)
					throwShards(ground.Position, ground.Normal, color, material, math.floor(3 * quality + 0.5), 18, 40)
				end
			end
		end
	end

	step()
	connection = runService.Heartbeat:Connect(step)

	function controller.fade(duration)
		if controller.finished or fadeStart then
			return
		end
		fadeStart = os.clock()
		fadeDuration = math.max(duration or 0.3, 0.05)
		sparks.Enabled = false
		if bloom then
			tweenService:Create(bloom, TweenInfo.new(fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Intensity = 0 }):Play()
		end
	end

	function controller.abort()
		cleanup()
	end

	task.delay(3, cleanup)
	return controller
end


