			local x0 = planetLeft + dPx * 1.03
			local x1 = planetLeft - F - dPx * 0.03
			local x = x0 + (x1 - x0) * e
			local tailW = V.X * 3 + dPx * 4
			tail.Size = UDim2.new(0, tailW, 1, 0) -- full screen height
			tail.Position = UDim2.new(0, x - tailW, 0, 0)
			fade.Size = UDim2.new(0, F, 1, 0)
			fade.Position = UDim2.new(0, x, 0, 0)
		end
		placeShadow(0)
		at(-CONFIG.EarthIntroSeconds, CONFIG.EarthRevealSeconds, placeShadow, function() holder:Destroy() end)
	end

	-- EARTH WARNING GLOW: in the last second before the planet is moved away (T1), a highlight fades in on the earth in the
	-- charge-phase lens flare color (BLUE[2], cyan), telling the viewer the planet is about to blow. Ease-in (power curve):
	-- starts slow, shoots to full strength right at the end. Occluded depth mode, fill + outline, destroyed when the earth moves.
	if earthModel and CONFIG.EarthWarningGlow then
		local glow
		at(T1 - CONFIG.EarthWarningGlowSeconds, CONFIG.EarthWarningGlowSeconds, function(a)
			if not glow then
				glow = Instance.new("Highlight")
				glow.Adornee = earthModel
				glow.DepthMode = Enum.HighlightDepthMode.Occluded
				glow.FillColor = BLUE[2]
				glow.OutlineColor = BLUE[2]
				glow.FillTransparency, glow.OutlineTransparency = 1, 1
				glow.Parent = root
			end
			local e = a ^ CONFIG.EarthWarningGlowEase -- power ease-in: slow start, fast finish, but visible much earlier than an expo curve
			glow.FillTransparency = 1 - (1 - 0.15) * e
			glow.OutlineTransparency = 1 - e
		end, function() if glow then glow:Destroy() end end)
	end

	-- PHASE 1: seed + lens streak + charge (energy spirals INTO the core)
	for _, off in ipairs({ 0, PI }) do
		addRay{ t0 = 0.5, life = 4.2, ang = TILT + off, r0 = 0, len = earthRadius + 0.62 * S, w = 0.007 * S * startupScale, color = BLUE[2], grow = 0.3, hold = 0.85, tailMove = 0 }
	end
	for i = 1, cnt(12) do
		addRay{ t0 = 0.9 + i * 0.02, life = 3.8, ang = TILT + PI * i / 6 + rr(-0.1, 0.1), z = rr(-0.2, 0.2), r0 = 0.01 * S, len = rr(0.07, 0.22) * S * startupScale, w = 0.0035 * S * startupScale, color = pick(BLUE), grow = 0.3, hold = 0.85, tailMove = 0 }
	end
	for i = 1, cnt(110) do
		local u = rng:NextNumber()
		addComet{
			t0 = 1.2 + 3.4 * u ^ 0.6, life = rr(1.1, 1.7), mode = "in", ang = rr(0, 2 * PI), r0 = rr(0.3, 0.95) * S, r1 = 0.015 * S,
			swirl = rr(2.2, 3.6) * (rng:NextNumber() < 0.5 and 1 or -1), z = rr(-0.2, 0.2), w = rr(0.003, 0.008) * S * startupScale,
			trail = rr(0.35, 0.6), color = pick(BLUE), color2 = BLUE[3],
		}
	end
	for i = 1, cnt(6) do
		addBolt{ t0 = 3.5 + i * 0.18, life = 0.5, ang = rr(0, 2 * PI), r0 = 0.03 * S, len = rr(0.1, 0.22) * S * startupScale, w = 0.003 * S * startupScale, color = BLUE[2], jitter = 0.14, N = 7 }
	end

	-- PHASE 2: BREACH (your frame 2)
	once(T1, function() burst(WHITE, BLUE[2], cnt(10), 1.0, 0.006) end)
	-- the big blue explosion: pure black & white impact frame (real-time, so slow-mo doesn't stretch it)
	once(T1, function() flashUntil = os.clock() + CONFIG.ImpactFlashSeconds end)
	once(T1, function() table.insert(explosionShakes, { start = os.clock(), strength = 1, phase = 0 }) end) -- big smooth camera shake on the breach
	once(T1, function()
		if earthModel then
			centerEarthAt(earthModel, C.Position + camBase.UpVector * CONFIG.EarthParkDistance)
		end
	end)
	starburst(T1, 16, 1.5, 0.007, BLUE, 2.2, TILT)
	for i = 1, cnt(40) do
		addRay{ t0 = T1 + rr(0, 0.1), life = rr(0.8, 1.3), ang = rr(0, 2 * PI), z = rr(-0.3, 0.3), r0 = rr(0.02, 0.1) * S, len = rr(0.12, 0.5) * S, w = rr(0.008, 0.016) * S, color = pick(BLUE), grow = 0.16, hold = 0.35, tailMove = 0.6 }
	end
	for i = 1, cnt(90) do
		addComet{
			t0 = T1 + rr(0, 0.2), life = rr(1.0, 1.7), mode = "out", ang = rr(0, 2 * PI), r0 = 0.04 * S, r1 = rr(0.8, 2.3) * S,
			swirl = rr(0.7, 1.7) * (rng:NextNumber() < 0.5 and 1 or -1), z = rr(-0.25, 0.25), w = rr(0.008, 0.02) * S,
			trail = rr(0.4, 0.8), color = pick(BLUE), color2 = BLUE[3],
		}
	end
	for i = 1, cnt(10) do
		addBolt{ t0 = T1 + rr(0, 0.35), life = rr(0.4, 0.8), ang = rr(0, 2 * PI), r0 = 0.1 * S, len = rr(0.5, 1.1) * S, w = 0.006 * S, color = BLUE[2], jitter = 0.08 }
	end

	-- PHASE 3: SECOND BURST (your frame 3)
	once(T2, function() burst(BLUE[2], BLUE[3], cnt(12), 1.2, 0.007) end)
	once(T2, function() table.insert(explosionShakes, { start = os.clock(), strength = 0.85, phase = 2.3 }) end) -- smooth shake on the second burst too
	for _, a in ipairs({ 0.15, PI + 0.15, -0.12, PI - 0.12, 1.2, PI + 1.2 }) do
		addRay{ t0 = T2 + 0.03, life = 2.6, ang = a, r0 = 0.1 * S, len = 1.7 * S, w = 0.03 * S, color = BLUE[2], grow = 0.12, hold = 0.6, tailMove = 0.35 }
	end
	for i = 1, cnt(90) do
		addComet{
			t0 = T2 + rr(0, 0.25), life = rr(1.0, 1.8), mode = "out", ang = rr(0, 2 * PI), r0 = 0.06 * S, r1 = rr(1, 2.6) * S,
			swirl = rr(0.8, 2.0) * (rng:NextNumber() < 0.5 and 1 or -1), z = rr(-0.25, 0.25), w = rr(0.01, 0.025) * S,
			trail = rr(0.45, 0.9), color = pick(BLUE), color2 = BLUE[3],
		}
	end
	for i = 1, cnt(8) do
		addBolt{ t0 = T2 + rr(0, 0.4), life = rr(0.4, 0.8), ang = rr(0, 2 * PI), r0 = 0.12 * S, len = rr(0.7, 1.4) * S, w = 0.007 * S, color = BLUE[2], jitter = 0.08 }
	end

	-- ================= key tracks =================
	local blackKeys = earthModel and { { 0, 1 }, { 6.7, 1 }, { 7.1, 0 } } or { { 0, 0 }, { 1.3, 1 }, { 6.7, 1 }, { 7.1, 0 } }
	local dimKeys = { { 0, 1 }, { 4.3, 1 }, { 4.72, 0.5 }, { 4.79, 0.5 }, { 4.84, 1 } }
	local whiteKeys = { { 0, 1 }, { 4.74, 1 }, { 4.8, 0.15 }, { 4.86, 0.7 }, { 5.3, 1 }, { 5.88, 1 }, { 5.93, 0.3 }, { 6.3, 1 }, { 7.12, 1 }, { 7.2, 0 }, { 7.3, 0.4 }, { 7.9, 0.96 }, { 10, 0.96 }, { 11.2, 0 } }
	local rumbleKeys = { { 0, 0 }, { 1.5, 0.03 }, { 4.4, 0.3 }, { 4.74, 0.55 }, { 4.78, 0 }, { 7.2, 0 }, { 7.5, 0.4 }, { 12, 0 } }
	local impulses = {} -- the old jagged per-explosion impulses are gone: the two blue explosions use the smooth shake below
	local swayKeys = { { 0, 0 }, { 7.1, 0 }, { 7.3, 0.03 }, { 10, 0.015 }, { 12, 0 } }
	local fovKeys = { { 0, 3 }, { 4.4, -6 }, { 4.74, -17 }, { 4.8, -17 }, { 4.88, 14 }, { 5.5, 5 }, { 5.9, 2 }, { 6.0, 10 }, { 7.1, 5 }, { 7.14, -9 }, { 7.3, 24 }, { 9, 9 }, { 12, 0 } }
	local dustKeys = { { 0.5, 0 }, { 1, 70 }, { 4.6, 70 }, { 4.8, 0 } }
	local emberKeys = { { 7.2, 0 }, { 7.6, 120 }, { 11, 60 }, { 12, 0 } }
	local pulseKeys = { { 0.5, 0 }, { 1.5, 1 }, { 4.0, 1 }, { 4.6, 0 } }
	local hotKeys = { { 7.1, 0 }, { 7.4, 1 } }
	local bloomKeys = { { 0, 0.5 }, { 4.7, 1.0 }, { 4.82, 2.0 }, { 5.5, 1.2 }, { 7.2, 2.6 }, { 9, 1.8 }, { 11, 3 } }
	local contrastKeys = { { 0, 0.12 }, { 7.14, 0.12 }, { 7.18, 1.0 }, { 7.32, 0.12 } }
	local brightKeys = { { 0, 0 }, { 4.4, 0 }, { 4.72, -0.12 }, { 4.8, 0.15 }, { 5.2, 0 } }
	local vigKeys = { { 0, 0.4 }, { 4.4, 0.2 }, { 4.72, 0 }, { 4.84, 0.4 }, { 7.1, 0.3 }, { 7.2, 0.45 }, { 11, 0.6 } }
	local tsKeys = CONFIG.SlowMo
		and { { 0, 1 }, { 4.74, 1 }, { 4.8, 0.35 }, { 4.92, 0.35 }, { 5.05, 1 }, { 7.05, 1 }, { 7.12, 0.15 }, { 7.4, 0.15 }, { 7.6, 1 } }
		or { { 0, 1 }, { 1, 1 } }
	local flareKeys = {
		{ 0, 0 }, { 0.6, 0 }, { 3.0, 0.12 }, { 4.4, 0.3 }, { 4.72, 0.1 }, { 4.82, 1.0 }, { 5.5, 0.5 }, { 5.9, 0.6 }, { 6.0, 0.9 },
		{ 6.6, 0.6 }, { 7.1, 0.65 }, { 7.2, 1.0 }, { 8.5, 0.85 }, { 10, 1.0 }, { 11.2, 0.6 }, { 11.8, 0 },
	}

	-- flare colors per phase: { start, end, main, accent, ghost } - the gap between two phases is the crossfade
	local flarePhases = {
		{ 0,    4.7,  BLUE[2],            BLUE[1], BLUE[3] }, -- charge: cyan
		{ 4.84, 5.85, BLUE[4],            BLUE[2], BLUE[1] }, -- breach: icy white-blue
		{ 5.95, 7.05, BLUE[1],            BLUE[3], BLUE[2] }, -- second burst: deep blue
		{ 7.25, 8.4,  rgb(255, 220, 120), HOT[1],  HOT[3] },  -- detonation: gold / orange / magenta
		{ 8.8,  10.1, rgb(255, 80, 140),  HOT[5],  HOT[3] },  -- aftershocks: magenta / violet
		{ 10.5, 12,   WHITE,              rgb(255, 150, 200), HOT[5] }, -- whiteout
	}
	local flareCols = { {}, {}, {} }
	for _, ph in ipairs(flarePhases) do
		for i = 1, 3 do
			table.insert(flareCols[i], { ph[1], ph[2 + i] })
			table.insert(flareCols[i], { ph[2], ph[2 + i] })
		end
	end
	local glowSize = { { 0, 0 }, { 0.5, 0.05 }, { 1.6, 0.5 }, { 4.2, 0.9 }, { 4.72, 0.12 }, { 4.85, 2.0 }, { 5.9, 2.2 }, { 7.1, 2.4 }, { 7.25, 4 }, { 9, 5 }, { 11, 7 } }
	local glowAlpha = { { 0, 0 }, { 0.5, 0.2 }, { 1.5, 0.7 }, { 4.5, 0.9 }, { 4.85, 1.4 }, { 5.5, 1.0 }, { 6.1, 1.4 }, { 7.1, 1.2 }, { 7.25, 2.0 }, { 9, 1.6 }, { 11, 2.5 }, { 11.8, 0 } }

	-- ================= per-frame drivers =================
	local function shakeAmp(t)
		local a = kf(t, rumbleKeys)
		for _, im in ipairs(impulses) do
			if t >= im[1] then a += im[2] * math.exp(-(t - im[1]) * im[3]) end
		end
		return a
	end

	-- big smooth shake per explosion: sums of sine waves (no noise, no random jumps) under a punchy envelope
	-- (instant-ish attack, hard hit, long heavy tail). Runs in real time so the slow-mo doesn't dull it.
	-- Each explosion gets its own phase so the two shakes don't move identically; overlapping tails simply add.
	local TAU = 2 * PI
	local function explosionShake()
		if CONFIG.ExplosionShake <= 0 or #explosionShakes == 0 then return 0, 0, 0 end
		local now = os.clock()
		local yaw, pitch, roll = 0, 0, 0
		for _, sh in ipairs(explosionShakes) do
			local rt = now - sh.start
			local atk = math.clamp(rt / 0.06, 0, 1)
			atk = atk * atk * (3 - 2 * atk)
			local env = atk * (0.55 * math.exp(-rt * 4.5) + 0.45 * math.exp(-rt * 1.3))
			if env >= 0.0005 then
				local k, ph = env * sh.strength * CONFIG.ExplosionShake, sh.phase
				yaw += (0.6 * math.sin(rt * TAU * 6.1 + 0.3 + ph) + 0.4 * math.sin(rt * TAU * 10.7 + 1.7 + ph)) * 0.11 * k
				pitch += (0.6 * math.sin(rt * TAU * 7.3 + 2.1 + ph) + 0.4 * math.sin(rt * TAU * 12.9 + 0.4 + ph)) * 0.09 * k
				roll += (0.7 * math.sin(rt * TAU * 5.2 + 4.0 + ph) + 0.3 * math.sin(rt * TAU * 9.1 + 1.0 + ph)) * 0.07 * k
			end
		end
		return yaw, pitch, roll -- radians (a single hit peaks around 6 deg yaw, 5 deg pitch, 4 deg roll)
	end

	local function updateCamera(t)
		local amp = shakeAmp(t) * CONFIG.Shake
		local shYaw, shPitch, shRoll = explosionShake()
		local yaw = (0.045 * math.sin(t * 0.45) + kf(t, swayKeys) * math.sin(t * 1.7)) * CONFIG.Sway
		local pitch = 0.028 * math.sin(t * 0.37 + 1) * CONFIG.Sway
		camera.CFrame = camBase * CFrame.Angles(
			pitch + math.noise(t * 31, 0.3) * amp * 0.035 + shPitch,
			yaw + math.noise(t * 31, 10.3) * amp * 0.035 + shYaw,
			math.noise(t * 27, 20.3) * amp * 0.025 + shRoll)
		camera.FieldOfView = CONFIG.FOV + kf(t, fovKeys)
		V = camera.ViewportSize
		local P = camera:WorldToViewportPoint(C.Position)
		srcX, srcY, onScreen = P.X, P.Y, P.Z > 0
	end

	local function updateWorld(t, ts)
		local flashing = os.clock() < flashUntil
		if flashing ~= flashOn then
			flashOn = flashing
			for _, f in ipairs(flashCCs) do f.Enabled = flashing end
		end
		bloom.Intensity = flashing and 0 or kf(t, bloomKeys) -- bloom would smear the pure black/white
		cc.Contrast = kf(t, contrastKeys)
		cc.Brightness = kf(t, brightKeys)

		local bc = kf(t, bgKeys)
		for _, tile in ipairs(tiles) do tile.Color = bc end

		local starFade = kf(t, starKeys)
		for _, st in ipairs(stars) do
			local tw = 0.7 + 0.3 * math.sin(t * st.speed + st.phase) -- gentle twinkle
			st.part.Transparency = 1 - math.clamp(st.base * tw * starFade, 0, 1)
		end

		local d = kf(t, coreKeys) * S * (1 + 0.12 * math.sin(t * (6 + 3 * t)) * kf(t, pulseKeys))
		local hot = kf(t, hotKeys)
		for i = 1, NL do
			local l = layers[i]
			local sz = softCap(d * mult[i])
			if d > 1 then
				l.Size = Vector3.one * sz
				l.Transparency = ctr[i]
				l.Color = blueL[i]:Lerp(hotL[i], hot)
			else
				l.Transparency = 1
			end
		end

		dust.Rate = kf(t, dustKeys) * CONFIG.Quality
		embers.Rate = kf(t, emberKeys) * CONFIG.Quality
		if hasTimeScale then
			for _, e in ipairs(emitters) do e.TimeScale = ts end
		end
		return hot
	end

	local function updateUI(t, hot)
		local cx, cy = V.X / 2, V.Y / 2
		local tint = rgb(70, 150, 255):Lerp(rgb(255, 120, 60), hot)
		local fl = onScreen and kf(t, flareKeys) * CONFIG.Flare or 0

		vigC.GroupTransparency = kf(t, vigKeys)
		vigC.Visible, glowC.Visible, ringC.Visible = not flashOn, not flashOn, not flashOn -- keep the flash exactly black/white

		local gs, ga = kf(t, glowSize), onScreen and kf(t, glowAlpha) or 0
		for i, c in ipairs(glowCircles) do
			local sz = V.Y * 0.05 * 1.22 ^ (i - 1) * gs
			c.Size = UDim2.fromOffset(sz, sz)
			c.Position = UDim2.fromOffset(srcX, srcY)
			c.BackgroundColor3 = tint:Lerp(WHITE, math.clamp(1 - (i - 1) / 8, 0, 1))
			-- discs wider than the screen only tint the whole frame (the wash + visible ring edges), so they fade out
			local reach = 1 - math.clamp((sz - V.Y * 1.1) / (V.Y * 0.9), 0, 1)
			c.BackgroundTransparency = 1 - math.clamp(0.025 * ga * reach, 0, 1)
		end

		-- lens flare: Sunset-style placement, colors follow the current phase
		local cols = { kf(t, flareCols[1]), kf(t, flareCols[2]), kf(t, flareCols[3]) }
		local cf = camera.CFrame
		local toSrc = C.Position - cf.Position
		local viewAngle = math.acos(math.clamp(cf.LookVector:Dot(toSrc.Unit), -1, 1))
		local vFov = math.rad(camera.FieldOfView)
		local ar = V.X / V.Y
		local dFov = 2 * math.atan(math.tan(vFov / 2) * math.sqrt(1 + ar * ar))
		local angleAlpha = 1 - math.clamp(viewAngle / (dFov / 2), 0, 1)
		local strength = math.clamp(angleAlpha * fl, 0, 1)
		if strength > 0.001 then
			local src = Vector2.new(srcX, srcY)
			-- drift bias so the ghosts still spread out while the source sits dead center
			local b = Vector2.new(cx, cy) - src + Vector2.new(math.cos(t * 0.7) * V.Y * 0.16, math.sin(t * 0.5) * V.Y * 0.1)
			local fovK = math.tan(vFov / 2) / math.tan(math.rad(CONFIG.FOV) / 2) -- keeps flare size constant on screen while FOV swings
			for _, d in ipairs(flareDefs) do
				local k = Vector2.one - d.pos * d.mult
				local pt = src + Vector2.new(b.X * k.X, b.Y * k.Y)
				local ray = camera:ViewportPointToRay(pt.X, pt.Y)
				d.att.WorldPosition = ray.Origin + ray.Direction.Unit * FLARE_DEPTH
				local fade = 1 - angleAlpha
				d.e.Size = NumberSequence.new(evalSeq(d.size, fade) * fovK)
				d.e.Squash = NumberSequence.new(evalSeq(d.squash, fade) * CONFIG.FlareStretch)
				d.e.Transparency = NumberSequence.new(math.clamp(1 - (1 - evalSeq(d.alpha, fade)) * strength, 0, 1))
				d.e.Color = ColorSequence.new(WHITE:Lerp(cols[d.role], d.blend))
				d.e:Emit(1)
			end
		end

		blackF.BackgroundTransparency = math.min(kf(t, blackKeys), kf(t, dimKeys))
		whiteF.BackgroundTransparency = kf(t, whiteKeys)
	end

	-- ================= run =================
	local clock = earthModel and -CONFIG.EarthIntroSeconds or 0
	local conn
	conn = RunService.RenderStepped:Connect(function(dt)
		local ts = kf(clock, tsKeys)
		clock += dt * ts
		updateCamera(clock)
		for i = #tasks, 1, -1 do
			local k = tasks[i]
			if clock >= k.t0 then
				if k.once then
					k.fn()
					table.remove(tasks, i)
				else
					local a = (clock - k.t0) / k.dur
					if a >= 1 then
						k.fn(1)
						if k.done then k.done() end
						table.remove(tasks, i)
					else
						k.fn(a)
					end
				end
			end
		end
		local hot = updateWorld(clock, ts)
		updateUI(clock, hot)

		if clock >= DURATION then
			conn:Disconnect()
			if uiConn then uiConn:Disconnect(); uiConn = nil end -- stop keeping the UI hidden
			-- the cutscene ends on a fully black screen: replace it with a black overlay that fades out
			-- (created before the cutscene gui is destroyed so there is no one-frame gap)
			do
				local endGui = Instance.new("ScreenGui")
				endGui.Name = "PlanetExplosionEndFade"
				endGui.IgnoreGuiInset = true
				endGui.ScreenInsets = Enum.ScreenInsets.None
				endGui.ResetOnSpawn = false
				endGui.DisplayOrder = 2000
				local endFrame = Instance.new("Frame")
				endFrame.Size = UDim2.fromScale(1, 1)
				endFrame.BackgroundColor3 = Color3.new(0, 0, 0)
				endFrame.BackgroundTransparency = 0
				endFrame.BorderSizePixel = 0
				endFrame.Parent = endGui
				endGui.Parent = (gethui and gethui()) or player:WaitForChild("PlayerGui")
				local endTween = game:GetService("TweenService"):Create(
					endFrame,
					TweenInfo.new(CONFIG.EndFadeOutSeconds, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
					{ BackgroundTransparency = 1 }
				)
				endTween.Completed:Connect(function() endGui:Destroy() end)
				endTween:Play()
			end
			root:Destroy()
			gui:Destroy()
			bloom:Destroy()
			cc:Destroy()
			for _, f in ipairs(flashCCs) do f:Destroy() end
			sky:Destroy()
			for _, c in ipairs(removed) do c.Parent = Lighting end
			for _, g in ipairs(hiddenGuis) do
				if g.Parent then pcall(function() g.Enabled = true end) end
			end
			for cfg, was in pairs(chatStates) do
				if cfg.Parent then pcall(function() cfg.Enabled = was end) end
			end
			pcall(function() StarterGui:SetCore("TopbarEnabled", true) end)
			if controls then pcall(function() controls:Enable() end) end
			camera.CameraType = Enum.CameraType.Custom
			camera.FieldOfView = 70
			for t, was in pairs(coreStates) do -- put each core UI back to what it was before the cutscene
				pcall(function() StarterGui:SetCoreGuiEnabled(t, was) end)
			end
			playing = false
			if onDone then task.spawn(onDone) end -- cutscene finished
		end
	end)
end

