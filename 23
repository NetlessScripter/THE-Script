	local root = HumanoidRootPart
	local rootCF = root.CFrame
	local aim0 = rootCF.LookVector
	local right0, up0 = rootCF.RightVector, rootCF.UpVector
	local hand0 = A4FX_Hand()

	local maxForward = 0
	local lateralValues, verticalValues, radiusValues = {}, {}, {}
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") and descendant.Transparency < 0.95 then
			local cf, size = descendant.CFrame, descendant.Size
			local function halfAlong(axis)
				return 0.5 * (math.abs(axis:Dot(cf.RightVector)) * size.X
					+ math.abs(axis:Dot(cf.UpVector)) * size.Y
					+ math.abs(axis:Dot(cf.LookVector)) * size.Z)
			end
			local relative = cf.Position - hand0
			maxForward = math.max(maxForward, relative:Dot(aim0) + halfAlong(aim0))
			table.insert(lateralValues, relative:Dot(right0))
			table.insert(verticalValues, relative:Dot(up0))
			table.insert(radiusValues, math.max(halfAlong(right0), halfAlong(up0)))
		end
	end
	local function median(values)
		if #values == 0 then
			return nil
		end
		table.sort(values)
		return values[math.ceil(#values / 2)]
