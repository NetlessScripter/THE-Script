local EXPLOSION_COLORS = {
    White = Color3.fromRGB(235, 248, 255),
    Ice = Color3.fromRGB(150, 225, 255),
    Cyan = Color3.fromRGB(60, 175, 255),
    Blue = Color3.fromRGB(30, 100, 255),
    Deep = Color3.fromRGB(10, 35, 190),
}

local function NewEffectPart(parent, className, size, cf, color, material, transparency)
    local part = Instance.new(className)
    part.Anchored = true
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.CastShadow = false
    part.Size = size
    part.CFrame = cf
    part.Color = color
    part.Material = material
    part.Transparency = transparency
    part.Parent = parent
    return part
end

local function PlayTween(instance, duration, style, direction, goal, delayTime)
    local function run()
        if instance.Parent then
            TweenService:Create(instance, TweenInfo.new(duration, style, direction), goal):Play()
        end
    end

    if delayTime and delayTime > 0 then
        task.delay(delayTime, run)
    else
        run()
    end
end

-- Expanding glowing sphere (core / mid / outer / pressure wave)
local function CreateExplosionShell(folder, center, props)
    local shell = NewEffectPart(
        folder, "Part", Vector3.one * 2, CFrame.new(center),
        props.Color, props.Material, props.Transparency
    )
    shell.Shape = Enum.PartType.Ball

    PlayTween(shell, props.GrowTime, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out,
        {Size = Vector3.one * props.Diameter})
    PlayTween(shell, props.FadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.In,
        {Transparency = 1}, props.FadeDelay)

    return shell
end

-- Thin glowing ring (hollow) built from a SurfaceGui stroke, tilted like the reference
local function CreateShockRing(folder, center, tilt, diameter, startDelay, color)
    task.delay(startDelay, function()
        local ring = NewEffectPart(
            folder, "Part", Vector3.new(10, 0.2, 10), CFrame.new(center) * tilt,
            color, Enum.Material.SmoothPlastic, 1
        )

        local growTime = 1.4
        PlayTween(ring, growTime, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out,
            {Size = Vector3.new(diameter, 0.2, diameter)})

        for _, face in ipairs({Enum.NormalId.Top, Enum.NormalId.Bottom}) do
            local gui = Instance.new("SurfaceGui")
            gui.Face = face
            gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
            gui.CanvasSize = Vector2.new(1024, 1024)
            gui.LightInfluence = 0
            gui.Brightness = 3
            gui.Parent = ring

            local frame = Instance.new("Frame")
            frame.AnchorPoint = Vector2.new(0.5, 0.5)
            frame.Position = UDim2.fromScale(0.5, 0.5)
            frame.Size = UDim2.fromScale(0.94, 0.94)
            frame.BackgroundTransparency = 1
            frame.Parent = gui

            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0.5, 0)
            corner.Parent = frame

            local stroke = Instance.new("UIStroke")
            stroke.Color = color
            stroke.Thickness = 26
            stroke.Parent = frame

            PlayTween(stroke, 1.0, Enum.EasingStyle.Quad, Enum.EasingDirection.In,
                {Transparency = 1}, growTime - 0.6)
        end
    end)
end

-- Radial light streaks (the speed lines flanking the blast in the reference)
local function SpawnLightSpokes(folder, center, rng)
    for i = 1, 56 do
        local dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-1, 1), rng:NextNumber(-1, 1))
        if dir.Magnitude > 0.1 then
            dir = dir.Unit

            local length = rng:NextNumber(140, 320)
            local startPos = center + dir * rng:NextNumber(40, 90)
            local endPos = center + dir * rng:NextNumber(380, 760)
            local travel = rng:NextNumber(0.6, 1.1)
            local color = (i % 2 == 0) and EXPLOSION_COLORS.White or EXPLOSION_COLORS.Cyan

            local spoke = NewEffectPart(
                folder, "Part", Vector3.new(0.7, 0.7, length),
                CFrame.lookAt(startPos, startPos + dir),
                color, Enum.Material.Neon, 0
            )

            PlayTween(spoke, travel, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out,
                {CFrame = CFrame.lookAt(endPos, endPos + dir)})
            PlayTween(spoke, travel * 0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In,
                {Transparency = 1, Size = Vector3.new(0.1, 0.1, length)}, travel * 0.2)
        end
    end
end

-- Dark rock chunks flying out with glowing blue trails
local function SpawnDebris(folder, center, rng)
    local rockClasses = {"Part", "WedgePart", "CornerWedgePart"}

    for _ = 1, 48 do
        local dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.5, 1), rng:NextNumber(-1, 1))
        if dir.Magnitude < 0.1 then
            dir = Vector3.yAxis
        end
        dir = dir.Unit

        local size = rng:NextNumber(7, 26)
        local startCF = CFrame.new(center + dir * rng:NextNumber(40, 110))
            * CFrame.Angles(rng:NextNumber(0, 6.28), rng:NextNumber(0, 6.28), rng:NextNumber(0, 6.28))

        local rock = NewEffectPart(
            folder, rockClasses[rng:NextInteger(1, #rockClasses)],
            Vector3.new(size, size * rng:NextNumber(0.5, 1), size * rng:NextNumber(0.6, 1.2)),
            startCF, Color3.fromRGB(22, 26, 40), Enum.Material.Slate, 0
        )

        local a0 = Instance.new("Attachment")
        a0.Position = Vector3.new(0, size * 0.15, 0)
        a0.Parent = rock
        local a1 = Instance.new("Attachment")
        a1.Position = Vector3.new(0, -size * 0.15, 0)
        a1.Parent = rock

        local trail = Instance.new("Trail")
        trail.Attachment0 = a0
        trail.Attachment1 = a1
        trail.Color = ColorSequence.new(EXPLOSION_COLORS.Ice, EXPLOSION_COLORS.Deep)
        trail.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.2),
            NumberSequenceKeypoint.new(1, 1),
        })
        trail.WidthScale = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(1, 0),
        })
        trail.Lifetime = 0.7
        trail.LightEmission = 1
        trail.FaceCamera = true
        trail.Parent = rock

        local travelTime = rng:NextNumber(2.2, 3.4)
        local endPos = center + dir * rng:NextNumber(450, 1100) + Vector3.new(0, -rng:NextNumber(0, 60), 0)
        local endCF = CFrame.new(endPos)
            * CFrame.Angles(rng:NextNumber(-3, 3), rng:NextNumber(-3, 3), rng:NextNumber(-3, 3))

        PlayTween(rock, travelTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {CFrame = endCF})
        PlayTween(rock, 0.8, Enum.EasingStyle.Linear, Enum.EasingDirection.In,
            {Transparency = 1}, travelTime - 0.8)
    end
end

-- Boiling blue plasma that fills the sphere volume
local function AttachPlasma(shell)
    local plasma = Instance.new("ParticleEmitter")
    plasma.Texture = "rbxasset://textures/particles/smoke_main.dds"
    plasma.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, EXPLOSION_COLORS.White),
        ColorSequenceKeypoint.new(0.4, EXPLOSION_COLORS.Cyan),
        ColorSequenceKeypoint.new(1, EXPLOSION_COLORS.Deep),
    })
    plasma.LightEmission = 1
    plasma.LightInfluence = 0
    plasma.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 40),
        NumberSequenceKeypoint.new(1, 100),
    })
    plasma.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.5),
        NumberSequenceKeypoint.new(0.6, 0.7),
        NumberSequenceKeypoint.new(1, 1),
    })
    plasma.Lifetime = NumberRange.new(0.7, 1.4)
    plasma.Speed = NumberRange.new(0, 6)
    plasma.Rotation = NumberRange.new(0, 360)
    plasma.RotSpeed = NumberRange.new(-40, 40)
    plasma.Rate = 0

    pcall(function()
        plasma.Shape = Enum.ParticleEmitterShape.Sphere
        plasma.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
        plasma.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
    end)

    plasma.Parent = shell
    plasma.Rate = 120
    task.delay(1.4, function()
        plasma.Rate = 0
    end)
end

-- Fast glowing sparks burst out of the core
local function AttachSparks(core)
    local sparks = Instance.new("ParticleEmitter")
    sparks.Color = ColorSequence.new(EXPLOSION_COLORS.White, EXPLOSION_COLORS.Cyan)
    sparks.LightEmission = 1
    sparks.LightInfluence = 0
    sparks.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 4),
        NumberSequenceKeypoint.new(1, 0),
    })
    sparks.Lifetime = NumberRange.new(0.8, 1.8)
    sparks.Speed = NumberRange.new(250, 700)
    sparks.Drag = 1.5
    sparks.SpreadAngle = Vector2.new(180, 180)
    sparks.Orientation = Enum.ParticleOrientation.VelocityParallel
    sparks.Rate = 0
    sparks.Parent = core
    sparks:Emit(220)
end

