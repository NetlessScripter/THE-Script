-- Exactly how the original script loads it, for me AND for participants: the module is
-- downloaded and run fresh before every Animator6D call and the JSON is read from disk
-- each time, so every animation gets its own independent instance.
local function EnsureAnimModule()
    loadstring(game:HttpGet(ANIM_MODULE_URL))()
end

-- a fresh table is decoded for every play
local function GetAnimData(info)
    local body
    if isfile and isfile(info.File) then
        local ok, raw = pcall(readfile, info.File)
        if ok and raw and #raw > 100 then
            body = raw
        end
    end
    if not body then
        local ok, fetched = pcall(game.HttpGet, game, info.Url)
        if ok and fetched and #fetched > 100 then
            body = fetched
            if writefile then
                writefile(info.File, fetched)
            end
        else
            error("[Animator6D] Failed to fetch JSON — cannot continue")
        end
    end
    return HttpService:JSONDecode(body)
end

-- the second animation (played when the character launches up)
local function PlayPostLaunchAnim(char, isLocal)
    local animatorData = GetAnimData(POST_LAUNCH_ANIM)
    EnsureAnimModule()
    if isLocal then
        Animator6D(animatorData)
    else
        Animator6D(animatorData, nil, nil, char)
    end
end

