-- Holds the player anchored in the air until the explosion is over
local EXPLOSION_DURATION = 3.4 -- seconds after impact until the last debris/shell fades
local holdInAir = false
local holdToken = 0

local function ReleaseFromAir()
    holdInAir = false
    HumanoidRootPart.Anchored = false
end

local function HoldInAir()
    holdToken += 1
    local myToken = holdToken
    holdInAir = true

    -- Failsafe so the player can never get stuck up there if something errors
    task.delay(20, function()
        if holdToken == myToken and holdInAir then
            ReleaseFromAir()
        end
    end)
end

