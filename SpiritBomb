    -- ---------------------------------------------------------------- detection
    local TARGET_ANIMATION_ID = "11365563255"

    local function TriggerSequence(track)
        -- one handling per track (cleared when it stops, so a reused track works next time)
        if handledTracks[track] then return end
        handledTracks[track] = true
        track.Stopped:Once(function()
            handledTracks[track] = nil
        end)

        -- 2 second flag: no matter how many tracks / detection paths fire, one sequence runs
        if GetSequenceFlag() then return end
        SetSequenceFlag(true)
        task.delay(SEQUENCE_FLAG_SECONDS, function()
            SetSequenceFlag(false)
        end)

        task.spawn(function()
            local ok, err = pcall(PlaySpiritBombSequence)
            if not ok then
                warn("[SpiritBomb] sequence error:", err)
                if ACTOR_IS_LOCAL then
                    ReleaseFromAir()
                end
            end
        end)
    end

    local function ScanTracks(tracks)
        for _, track in ipairs(tracks) do
            local animation = track.Animation
            if animation and string.find(animation.AnimationId, TARGET_ANIMATION_ID, 1, true) then
                TriggerSequence(track)
            end
        end
    end

    -- the same two detection paths 23 uses; these two names are read by destroyActorInstance
    TriggerConn = RunService.Heartbeat:Connect(function()
        ScanTracks(Animator:GetPlayingAnimationTracks())
    end)
    if ACTOR_IS_LOCAL then
        AnimPlayedConn = Humanoid.AnimationPlayed:Connect(function(track)
            ScanTracks({ track })
        end)
    else
        AnimPlayedConn = Animator.AnimationPlayed:Connect(function(track)
            ScanTracks({ track })
        end)
    end
end


