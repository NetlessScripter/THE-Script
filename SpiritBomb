local function BuildActorLibrary()
    -- Everything below belongs to ONE character. ACTOR_IS_LOCAL, LocalPlayer, Character,
    -- Humanoid, HumanoidRootPart, Animator come from the env that createActorInstance sets
    -- with setfenv (same pattern as 23). It must not yield while it builds.
    local holdInAir = false
    local holdToken = 0
    local sequenceFlag = false
    local handledTracks = setmetatable({}, { __mode = "k" })

    local function GetSequenceFlag()
        if SEQUENCE_FLAG_SHARED then return sharedSequenceFlag end
        return sequenceFlag
    end

    local function SetSequenceFlag(value)
        if SEQUENCE_FLAG_SHARED then
            sharedSequenceFlag = value
        else
            sequenceFlag = value
        end
    end

    -- Holds the player anchored in the air until the explosion is over (my own character only:
    -- a participant's character is moved by their own client)
    local function ReleaseFromAir()
        holdInAir = false
        if ACTOR_IS_LOCAL then
            HumanoidRootPart.Anchored = false
        end
    end

    local function HoldInAir()
        if not ACTOR_IS_LOCAL then return end
        holdToken += 1
        local myToken = holdToken
        holdInAir = true

        -- Failsafe so the player can never get stuck up there if something errors
        task.delay(20, function()
            if holdToken == myToken and holdInAir then
                ReleaseFromAir()
            end
        end)
    end

    -- 23 handles sounds for participants spatially (parented to their root), mine stays 2D
    local function PlaySequenceSound()
        if ACTOR_IS_LOCAL then
