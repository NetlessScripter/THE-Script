local function NewEffectPart(parent, className, size, cf, color, material, transparency)
    local part = Instance.new(className)
    part.Anchored = true
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.CastShadow = false
    part.Size = size
    part.CFrame = cf
    part.Color = color
    part.Material = material
    part.Transparency = transparency
    part.Parent = parent
    return part
end

local function PlayTween(instance, duration, style, direction, goal, delayTime)
    local function run()
        if instance.Parent then
            TweenService:Create(instance, TweenInfo.new(duration, style, direction), goal):Play()
        end
    end

    if delayTime and delayTime > 0 then
        task.delay(delayTime, run)
    else
        run()
    end
end

-- Thin glowing ring (hollow) built from a SurfaceGui stroke, tilted like the reference
local function CreateShockRing(folder, center, tilt, diameter, startDelay, color)
    task.delay(startDelay, function()
        local ring = NewEffectPart(
            folder, "Part", Vector3.new(10, 0.2, 10), CFrame.new(center) * tilt,
            color, Enum.Material.SmoothPlastic, 1
        )

        local growTime = 1.4
        PlayTween(ring, growTime, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out,
            {Size = Vector3.new(diameter, 0.2, diameter)})

        for _, face in ipairs({Enum.NormalId.Top, Enum.NormalId.Bottom}) do
            local gui = Instance.new("SurfaceGui")
            gui.Face = face
            gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
            gui.CanvasSize = Vector2.new(1024, 1024)
            gui.LightInfluence = 0
            gui.Brightness = 3
            gui.Parent = ring

            local frame = Instance.new("Frame")
            frame.AnchorPoint = Vector2.new(0.5, 0.5)
            frame.Position = UDim2.fromScale(0.5, 0.5)
            frame.Size = UDim2.fromScale(0.94, 0.94)
            frame.BackgroundTransparency = 1
            frame.Parent = gui

            local corner = Instance.new("UICorner")
