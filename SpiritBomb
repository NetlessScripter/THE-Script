local function PlaySpiritBombExplosion(center)
    local C = EXPLOSION_COLORS
    local rng = Random.new()

    local folder = Instance.new("Folder")
    folder.Name = "SpiritBombExplosion"
    folder.Parent = Workspace
    Debris:AddItem(folder, 8)

    PlayExplosionScreenFX(folder)

    -- Layered spheres: white-hot core -> cyan body -> forcefield skin -> pressure wave
    local core = CreateExplosionShell(folder, center, {
        Color = C.White, Material = Enum.Material.Neon, Transparency = 0,
        Diameter = 170, GrowTime = 0.35, FadeDelay = 0.6, FadeTime = 1.4,
    })
    local body = CreateExplosionShell(folder, center, {
        Color = C.Cyan, Material = Enum.Material.Neon, Transparency = 0.25,
        Diameter = 280, GrowTime = 0.5, FadeDelay = 0.9, FadeTime = 1.6,
    })
    CreateExplosionShell(folder, center, {
        Color = C.Blue, Material = Enum.Material.ForceField, Transparency = 0.2,
        Diameter = 360, GrowTime = 0.7, FadeDelay = 1.2, FadeTime = 1.8,
    })
    CreateExplosionShell(folder, center, {
        Color = C.Ice, Material = Enum.Material.Neon, Transparency = 0.85,
        Diameter = 700, GrowTime = 0.6, FadeDelay = 0.1, FadeTime = 0.8,
    })

    AttachPlasma(body)
    AttachSparks(core)

    -- Light that blasts the surroundings blue
    local light = Instance.new("PointLight")
    light.Color = C.Cyan
    light.Range = 60
    light.Brightness = 12
    light.Shadows = false
    light.Parent = core
    PlayTween(light, 2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {Brightness = 0}, 0.4)

    -- Flat shock slab on the plane of the blast
    local slab = NewEffectPart(
        folder, "Part", Vector3.new(4, 20, 20),
        CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90)),
        C.Ice, Enum.Material.Neon, 0.35
    )
    slab.Shape = Enum.PartType.Cylinder
    PlayTween(slab, 0.9, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out,
        {Size = Vector3.new(1, 760, 760)})
    PlayTween(slab, 0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {Transparency = 1}, 0.1)

    -- Tilted glowing rings, staggered
    CreateShockRing(folder, center + Vector3.new(0, 0, 0),
        CFrame.Angles(math.rad(12), 0, math.rad(5)), 620, 0, C.White)
    CreateShockRing(folder, center + Vector3.new(0, 25, 0),
        CFrame.Angles(math.rad(-8), math.rad(40), math.rad(10)), 780, 0.1, C.Ice)
    CreateShockRing(folder, center + Vector3.new(0, -25, 0),
        CFrame.Angles(math.rad(5), math.rad(-30), math.rad(-9)), 940, 0.2, C.Cyan)

    SpawnLightSpokes(folder, center, rng)
    SpawnDebris(folder, center, rng)

    -- Camera shake through the game's own replication hook
    FireReplicationEvent({
        Intensity = 12,
        Effect = "Camshake"
    })
    task.delay(0.4, function()
        FireReplicationEvent({
            Intensity = 8,
            Effect = "Camshake"
        })
    end)

    -- Explosion is over: let the player drop
    task.delay(EXPLOSION_DURATION, ReleaseFromAir)
end

local function PlaySpiritBombOrb()
    local template = SpiritVFX:WaitForChild("SpiritBombOrb", 5)
    if not template then
        warn("[SpiritBomb] Orb template missing from SpiritVFX")
        ReleaseFromAir()
        return
    end

    local model = template:Clone()
    model.Parent = Character

    model:SetPrimaryPartCFrame(HumanoidRootPart.CFrame * CFrame.new(0, 50, 0))

    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = true
        end
    end

    -- Grow in like a real Spirit Bomb: tiny -> full size over the windup
    local GROW_TIME = 2.1
    local START_SCALE = 0.05

    model:ScaleTo(START_SCALE)

    local scaleValue = Instance.new("NumberValue")
    scaleValue.Value = START_SCALE
    scaleValue:GetPropertyChangedSignal("Value"):Connect(function()
        model:ScaleTo(scaleValue.Value)
    end)

    local growTween = TweenService:Create(
        scaleValue,
        TweenInfo.new(GROW_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {Value = 1}
    )
    growTween:Play()
    growTween.Completed:Wait()
    scaleValue:Destroy()
    model:ScaleTo(1)

    -- The orb stays anchored the whole time (no physics). One tween drives it
    -- along a single diagonal path: forward and down together.
    local FORWARD_DISTANCE = 100
    local DROP_DISTANCE = 230
    local FALL_TIME = 0.8

    local startPos = model.PrimaryPart.Position
    local look = HumanoidRootPart.CFrame.LookVector
    local forwardDir = Vector3.new(look.X, 0, look.Z).Unit
    local targetPos = startPos + forwardDir * FORWARD_DISTANCE + Vector3.new(0, -DROP_DISTANCE, 0)

    local posValue = Instance.new("Vector3Value")
    posValue.Value = startPos

    posValue:GetPropertyChangedSignal("Value"):Connect(function()
        model:SetPrimaryPartCFrame(CFrame.new(posValue.Value))
    end)

    local fallTween = TweenService:Create(
        posValue,
        TweenInfo.new(FALL_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        {Value = targetPos}
    )
    fallTween:Play()

    fallTween.Completed:Once(function()
        posValue:Destroy()
        local lastPos = targetPos

        local impactPart = Instance.new("Part")
        impactPart.Anchored = true
        impactPart.CanCollide = false
        impactPart.Transparency = 1
        impactPart.Size = Vector3.new(1, 1, 1)
        impactPart.CFrame = CFrame.new(lastPos)
        impactPart.Parent = Workspace

        FireReplicationEvent({
            NoUpSmoke = true,
            stronger = {
                minus = 1,
                sound = "rbxassetid://12518569150",
                volume = 3
            },
            justdown = true,
            Effect = "Wall Collision",
            root = impactPart,
            Time = 1,
            AccurateCheck = true,
            camshake = {
                LocalPlayer.Name,
                "Weakest Dummy"
            }
        })

        task.spawn(PlaySpiritBombExplosion, lastPos)

        task.wait(0.3)
        model:Destroy()
        impactPart:Destroy()

        task.spawn(PlayImpactScreenFlash)
    end)
end

local function StreamPillarTextures(targetPart)
    local textures = {}
    for _, decal in pairs(UFW.vfx.Pillar.Preload:GetDescendants()) do
        if decal:IsA("Decal") and decal.Texture ~= "" and not table.find(textures, decal.Texture) then
            table.insert(textures, decal.Texture)
