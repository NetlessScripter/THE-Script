local POST_LAUNCH_ANIM = {
    Url  = "https://raw.githubusercontent.com/NetlessScripter/THE-Script/refs/heads/main/anim6d_kfcache_18878778259.json",
    File = "anim6d_kfcache_18878778259.json",
