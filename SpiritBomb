local function PlayJumpBurstAndHighlight(character)
    local jumpFXClone = FiveSeasonsFX.JumpFX:Clone()
    jumpFXClone:SetPrimaryPartCFrame(character.HumanoidRootPart.CFrame)
    jumpFXClone.Parent = Thrown

    local burnMark = jumpFXClone.JumpFX:FindFirstChild("BurnMark")
    if burnMark then
        burnMark:Destroy()
    end

    for _, emitter in pairs(jumpFXClone.JumpFX:GetDescendants()) do
        if emitter:IsA("ParticleEmitter") then
            emitter:Emit(emitter:GetAttribute("EmitCount") or 0)
        end
    end

    jumpFXClone.JumpFX.EnabledP.Enabled = true

    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(255, 66, 28)
    highlight.OutlineColor = Color3.fromRGB(255, 44, 2)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0.6
    highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    highlight.Parent = character

    TweenService:Create(highlight, TweenInfo.new(0.75, Enum.EasingStyle.Cubic, Enum.EasingDirection.InOut), {
        FillTransparency = 1,
        OutlineTransparency = 1
    }):Play()

    task.wait(0.5)
    jumpFXClone.JumpFX.EnabledP.Enabled = false
    task.wait(4)

    jumpFXClone:Destroy()
    highlight:Destroy()
end

local function LaunchCharacterAndCleanup(flashClone, charClone, renderSteppedConn)
    Animator6DStop(charClone)
    task.spawn(PlayAnimator6DFromCache)

    local goalCFrame = HumanoidRootPart.CFrame + Vector3.new(0, 126, 0)
    local tween = TweenService:Create(
        HumanoidRootPart,
        TweenInfo.new(0.8, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
        {CFrame = goalCFrame}
    )
    tween:Play()
    tween.Completed:Connect(function()
        HumanoidRootPart.Anchored = true
    end)

    for _, connection in ipairs(getconnections(Replication.OnClientEvent)) do
        connection:Fire({
            Effect = "Velocity Forward",
            Distance = 0,
            Time = 0.35,
            Up = 125
        })
        connection:Fire({
            Intensity = 4,
            Effect = "Camshake"
        })
    end

    local reachedHeight = false
    local function checkHeight()
        if HumanoidRootPart.Position.Y >= 125 and not reachedHeight then
            reachedHeight = true
            HumanoidRootPart.Anchored = true
            return true
        end
        return false
    end

    local heightCheckConn
    heightCheckConn = RunService.Heartbeat:Connect(function()
        if checkHeight() then

            heightCheckConn:Disconnect()
            renderSteppedConn:Disconnect()

            Animator6DStop(Character)
            charClone:Destroy()
            flashClone:Destroy()

            for _, part in pairs(charClone:GetChildren()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.Anchored = false
                end
            end
        end
    end)
end

