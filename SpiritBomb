local function PlayJumpMeshTrails(character)
    local jumpMeshes = FiveSeasonsFX.JumpMeshes:Clone()
    jumpMeshes:SetPrimaryPartCFrame(character.HumanoidRootPart.CFrame)
    jumpMeshes.Parent = Thrown

    task.delay(0.075, function()
        for _, emitter in pairs(jumpMeshes.Lines:GetDescendants()) do
            if emitter:IsA("ParticleEmitter") then
                local emitCount = tonumber(emitter.Name) or 0
                emitter:Emit(emitCount)
            end
        end
    end)

    task.spawn(function()
        local mainClone = jumpMeshes.Main:Clone()
        local startPart, endPart = mainClone.Start, mainClone.End
        local clonedMesh = startPart:Clone()
        clonedMesh.Transparency = 0.95
        clonedMesh.Name = "ClonedMesh"
        clonedMesh.Parent = jumpMeshes.CurrentTweens

        TweenService:Create(clonedMesh, TweenInfo.new(0.75, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            CFrame = endPart.CFrame
        }):Play()
        TweenService:Create(clonedMesh, TweenInfo.new(0.75, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = endPart.Size
        }):Play()

        task.wait(0.75)
        clonedMesh:Destroy()
    end)

    task.spawn(function()
        local wind3Clone = jumpMeshes.Wind3:Clone()
        local startPart, endPart = wind3Clone.Start, wind3Clone.End
        local clonedMesh = startPart:Clone()
        clonedMesh.Transparency = 0.75
        clonedMesh.Name = "ClonedMesh"
        clonedMesh.Parent = jumpMeshes.CurrentTweens

        TweenService:Create(clonedMesh, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            CFrame = endPart.CFrame,
            Size = endPart.Size
        }):Play()
        TweenService:Create(clonedMesh, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Transparency = 1
        }):Play()

        task.wait(0.8)
        clonedMesh:Destroy()
    end)

    task.spawn(function()
        local wind2Clone = jumpMeshes.Wind2:Clone()
        local startPart, endPart = wind2Clone.Start, wind2Clone.End
        local clonedMesh = startPart:Clone()
        clonedMesh.Transparency = 0.8
        clonedMesh.Name = "ClonedMesh"
        clonedMesh.Parent = jumpMeshes.CurrentTweens

        TweenService:Create(clonedMesh, TweenInfo.new(0.55, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
            CFrame = endPart.CFrame
        }):Play()
        TweenService:Create(clonedMesh, TweenInfo.new(0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Size = endPart.Size,
            Transparency = 1
        }):Play()

        task.wait(0.55)
        clonedMesh:Destroy()
    end)

    local function PlayWindFX2()
        task.spawn(function()
            local windDecalClone = jumpMeshes.WindDecal2:Clone()
            windDecalClone:ScaleTo(Random.new():NextNumber(0.95, 2.35))
            local tweenTime = Random.new():NextNumber(1, 2.75)
            local randomAngle = math.rad(math.random(0, 360))

            windDecalClone:SetPrimaryPartCFrame(windDecalClone.PrimaryPart.CFrame * CFrame.Angles(0, randomAngle, 0))
            windDecalClone.End.CFrame = windDecalClone.End.CFrame * CFrame.Angles(0, randomAngle, 0)

            local startPart, endPart = windDecalClone.Start, windDecalClone.End
            local clonedMesh = startPart:Clone()
            clonedMesh.Decal.Transparency = Random.new():NextNumber(0.8, 0.93)
            clonedMesh.Name = "ClonedMesh"
            clonedMesh.Parent = jumpMeshes.CurrentTweens

            TweenService:Create(clonedMesh, TweenInfo.new(tweenTime, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
                Size = endPart.Size,
                CFrame = endPart.CFrame
            }):Play()
            TweenService:Create(clonedMesh.Mesh, TweenInfo.new(tweenTime, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
                Scale = endPart.Mesh.Scale
            }):Play()
            TweenService:Create(clonedMesh.Decal, TweenInfo.new(tweenTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Transparency = 1
            }):Play()

            task.wait(4)
            clonedMesh:Destroy()
        end)
    end

    for _ = 1, 5 do
        task.spawn(PlayWindFX2)
        task.wait(0.035)
    end

    task.wait(5)
    jumpMeshes:Destroy()
end

