local function PlaySpiritBombOrb()
    local model = game:GetObjects("rbxassetid://99926232093491")[1]
    model.Parent = Character

    if not model.PrimaryPart then
        model.PrimaryPart = model:FindFirstChildWhichIsA("BasePart")
    end

    model:SetPrimaryPartCFrame(HumanoidRootPart.CFrame * CFrame.new(0, 50, 0))

    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = true
        end
    end

    task.wait(2.1)

    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = false
        end
    end

    local startPos = model.PrimaryPart.Position
    local forwardTarget = startPos + HumanoidRootPart.CFrame.LookVector * 50
    local downTarget = startPos + Vector3.new(0, -126, 0)

    local forwardValue = Instance.new("Vector3Value")
    local downValue = Instance.new("Vector3Value")
    forwardValue.Value = startPos
    downValue.Value = startPos

    local finalPosition = startPos

    forwardValue:GetPropertyChangedSignal("Value"):Connect(function()
        finalPosition = Vector3.new(forwardValue.Value.X, finalPosition.Y, forwardValue.Value.Z)
        model:SetPrimaryPartCFrame(CFrame.new(finalPosition))
    end)

    downValue:GetPropertyChangedSignal("Value"):Connect(function()
        finalPosition = Vector3.new(finalPosition.X, downValue.Value.Y, finalPosition.Z)
        model:SetPrimaryPartCFrame(CFrame.new(finalPosition))
    end)

    TweenService:Create(forwardValue, TweenInfo.new(0.2, Enum.EasingStyle.Linear), {Value = forwardTarget}):Play()
    TweenService:Create(downValue, TweenInfo.new(0.4, Enum.EasingStyle.Linear), {Value = downTarget}):Play()

    task.delay(0.35, function()
        local lastPos = model.PrimaryPart.Position

        local impactPart = Instance.new("Part")
        impactPart.Anchored = true
        impactPart.CanCollide = false
        impactPart.Transparency = 1
        impactPart.Size = Vector3.new(1, 1, 1)
        impactPart.CFrame = CFrame.new(lastPos)
        impactPart.Parent = Workspace

        FireReplicationEvent({
            NoUpSmoke = true,
            stronger = {
                minus = 1,
                sound = "rbxassetid://12518569150",
                volume = 3
            },
            justdown = true,
            Effect = "Wall Collision",
            root = impactPart,
            Time = 1,
            AccurateCheck = true,
            camshake = {
                LocalPlayer.Name,
                "Weakest Dummy"
            }
        })

        task.wait(0.3)
        model:Destroy()
        impactPart:Destroy()

        task.spawn(PlayImpactScreenFlash)
    end)
end

local function StreamPillarTextures(targetPart)
    local textures = {}
    for _, decal in pairs(UFW.vfx.Pillar.Preload:GetDescendants()) do
        if decal:IsA("Decal") and decal.Texture ~= "" and not table.find(textures, decal.Texture) then
            table.insert(textures, decal.Texture)
        end
    end

    for _, texture in pairs(textures) do
        local newDecal = Instance.new("Decal")
        newDecal.Parent = targetPart
        newDecal.Texture = texture
        Debris:AddItem(newDecal, 3)
        task.wait(0.0065)
    end
end

