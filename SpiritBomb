-- Radial light streaks (the speed lines flanking the blast in the reference)
local function SpawnLightSpokes(folder, center, rng)
    for i = 1, 56 do
        local dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-1, 1), rng:NextNumber(-1, 1))
        if dir.Magnitude > 0.1 then
            dir = dir.Unit

            local length = rng:NextNumber(140, 320)
            local startPos = center + dir * rng:NextNumber(40, 90)
            local endPos = center + dir * rng:NextNumber(380, 760)
            local travel = rng:NextNumber(0.6, 1.1)
            local color = (i % 2 == 0) and EXPLOSION_COLORS.White or EXPLOSION_COLORS.Cyan

            local spoke = NewEffectPart(
                folder, "Part", Vector3.new(0.7, 0.7, length),
                CFrame.lookAt(startPos, startPos + dir),
                color, Enum.Material.Neon, 0
            )

            PlayTween(spoke, travel, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out,
                {CFrame = CFrame.lookAt(endPos, endPos + dir)})
            PlayTween(spoke, travel * 0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In,
                {Transparency = 1, Size = Vector3.new(0.1, 0.1, length)}, travel * 0.2)
        end
    end
end

-- Dark rock chunks flying out with glowing blue trails
local function SpawnDebris(folder, center, rng)
    local rockClasses = {"Part", "WedgePart", "CornerWedgePart"}

    for _ = 1, 48 do
        local dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.5, 1), rng:NextNumber(-1, 1))
        if dir.Magnitude < 0.1 then
            dir = Vector3.yAxis
        end
        dir = dir.Unit

        local size = rng:NextNumber(7, 26)
        local startCF = CFrame.new(center + dir * rng:NextNumber(40, 110))
            * CFrame.Angles(rng:NextNumber(0, 6.28), rng:NextNumber(0, 6.28), rng:NextNumber(0, 6.28))

        local rock = NewEffectPart(
            folder, rockClasses[rng:NextInteger(1, #rockClasses)],
            Vector3.new(size, size * rng:NextNumber(0.5, 1), size * rng:NextNumber(0.6, 1.2)),
            startCF, Color3.fromRGB(22, 26, 40), Enum.Material.Slate, 0
        )

        local a0 = Instance.new("Attachment")
        a0.Position = Vector3.new(0, size * 0.15, 0)
        a0.Parent = rock
        local a1 = Instance.new("Attachment")
        a1.Position = Vector3.new(0, -size * 0.15, 0)
        a1.Parent = rock

        local trail = Instance.new("Trail")
        trail.Attachment0 = a0
        trail.Attachment1 = a1
        trail.Color = ColorSequence.new(EXPLOSION_COLORS.Ice, EXPLOSION_COLORS.Deep)
        trail.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.2),
            NumberSequenceKeypoint.new(1, 1),
        })
        trail.WidthScale = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(1, 0),
        })
        trail.Lifetime = 0.7
        trail.LightEmission = 1
        trail.FaceCamera = true
        trail.Parent = rock

        local travelTime = rng:NextNumber(2.2, 3.4)
        local endPos = center + dir * rng:NextNumber(450, 1100) + Vector3.new(0, -rng:NextNumber(0, 60), 0)
        local endCF = CFrame.new(endPos)
            * CFrame.Angles(rng:NextNumber(-3, 3), rng:NextNumber(-3, 3), rng:NextNumber(-3, 3))

        PlayTween(rock, travelTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {CFrame = endCF})
        PlayTween(rock, 0.8, Enum.EasingStyle.Linear, Enum.EasingDirection.In,
            {Transparency = 1}, travelTime - 0.8)
    end
