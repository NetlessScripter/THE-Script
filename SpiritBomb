local function PlayJumpBurstAndHighlight(character)
    local jumpFXClone = FiveSeasonsFX.JumpFX:Clone()
    jumpFXClone:SetPrimaryPartCFrame(character.HumanoidRootPart.CFrame)
    jumpFXClone.Parent = Thrown

    local burnMark = jumpFXClone.JumpFX:FindFirstChild("BurnMark")
    if burnMark then
        burnMark:Destroy()
    end

    for _, emitter in pairs(jumpFXClone.JumpFX:GetDescendants()) do
        if emitter:IsA("ParticleEmitter") then
            emitter:Emit(emitter:GetAttribute("EmitCount") or 0)
        end
    end

    jumpFXClone.JumpFX.EnabledP.Enabled = true

    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(255, 66, 28)
    highlight.OutlineColor = Color3.fromRGB(255, 44, 2)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0.6
    highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    highlight.Parent = character

    TweenService:Create(highlight, TweenInfo.new(0.75, Enum.EasingStyle.Cubic, Enum.EasingDirection.InOut), {
        FillTransparency = 1,
        OutlineTransparency = 1
    }):Play()

    task.wait(0.5)
    jumpFXClone.JumpFX.EnabledP.Enabled = false
    task.wait(4)

    jumpFXClone:Destroy()
    highlight:Destroy()
end

local function LaunchCharacterAndCleanup(flashClone, charClone, renderSteppedConn)
    Animator6DStop(charClone)
    task.spawn(PlayAnimator6DFromCache)

    local goalCFrame = HumanoidRootPart.CFrame + Vector3.new(0, 126, 0)
    local tween = TweenService:Create(
        HumanoidRootPart,
        TweenInfo.new(0.8, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
        {CFrame = goalCFrame}
    )
    tween:Play()
    tween.Completed:Connect(function()
        HumanoidRootPart.Anchored = true
    end)

    for _, connection in ipairs(getconnections(Replication.OnClientEvent)) do
        connection:Fire({
            Effect = "Velocity Forward",
            Distance = 0,
            Time = 0.35,
            Up = 125
        })
        connection:Fire({
            Intensity = 4,
            Effect = "Camshake"
        })
    end

    local reachedHeight = false
    local function checkHeight()
        if HumanoidRootPart.Position.Y >= 125 and not reachedHeight then
            reachedHeight = true
            HumanoidRootPart.Anchored = true
            return true
        end
        return false
    end

    local heightCheckConn
    heightCheckConn = RunService.Heartbeat:Connect(function()
        if checkHeight() then

            heightCheckConn:Disconnect()
            renderSteppedConn:Disconnect()

            Animator6DStop(Character)
            charClone:Destroy()
            flashClone:Destroy()

            for _, part in pairs(charClone:GetChildren()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.Anchored = false
                end
            end
        end
    end)
end

local function PlayViewportFlashEffect(camRig)
    local flashClone = UFW.Flash:Clone()
    local viewport = flashClone.Flashup.Viewport.Viewport
    local viewportCam = Instance.new("Camera", viewport)
    viewport.CurrentCamera = viewportCam
    flashClone.Parent = LocalPlayer.PlayerGui

    Character.Archivable = true
    local charClone = Character:Clone()
    charClone.PrimaryPart.Anchored = true

    for _, obj in pairs(charClone:GetDescendants()) do
        if obj.ClassName:find("Script") then
            obj:Destroy()
        end
    end
    for _, basePart in pairs(charClone:GetChildren()) do
        if basePart:IsA("BasePart") then
            basePart.Anchored = true
        end
    end
    for _, highlight in pairs(charClone:GetDescendants()) do
        if highlight:IsA("Highlight") then
            highlight:Destroy()
        end
    end

    charClone.Parent = viewport.Body

    local VIEWPORT_CACHE_URL = "https://raw.githubusercontent.com/NetlessScripter/THE-Script/refs/heads/main/anim6d_kfcache_18385523261.json"
    local VIEWPORT_CACHE_FILE = "anim6d_kfcache_18385523261.json"

    local viewportJsonBody
    if isfile and isfile(VIEWPORT_CACHE_FILE) then
        local ok, raw = pcall(readfile, VIEWPORT_CACHE_FILE)
        if ok and raw and #raw > 100 then
            viewportJsonBody = raw
            print("[Cache] Loaded from disk")
        end
    end

    if not viewportJsonBody then
        local ok, body = pcall(game.HttpGet, game, VIEWPORT_CACHE_URL)
        if ok and body and #body > 100 then
            viewportJsonBody = body
            print("[Cache] Fetched from GitHub")
            if writefile then
                writefile(VIEWPORT_CACHE_FILE, body)
            end
        else
            error("[Animator6D] Failed to fetch JSON — cannot continue")
        end
    end

    local viewportAnimData = HttpService:JSONDecode(viewportJsonBody)

    loadstring(game:HttpGet(
        "https://raw.githubusercontent.com/NetlessScripter/Universal-KJ-Port/refs/heads/main/Animation%20Module"
    ))()

    Animator6D(viewportAnimData, nil, nil, charClone)

    local renderSteppedConn = RunService.RenderStepped:Connect(function()
        camRig.RootPart.CFrame = Character.HumanoidRootPart.CFrame * CFrame.new(0, -3, 0) * CFrame.Angles(0, math.pi, 0)
        viewportCam.CFrame = camRig.camera.CFrame

        for _, part in pairs(charClone:GetChildren()) do
            if part:IsA("BasePart") then
                local originalPart = Character:FindFirstChild(part.Name)
                if originalPart then
                    part.CFrame = originalPart.CFrame
                end
            end
        end
    end)

    task.delay(0.2, function()
        flashClone.Flashup.Viewport.BackgroundColor3 = Color3.new(0, 0, 0)
        flashClone.Flashup.Viewport.Viewport.ImageColor3 = Color3.fromRGB(20, 20, 20)
        TweenService:Create(flashClone.Flashup.Viewport, TweenInfo.new(1, Enum.EasingStyle.Quad), {
            BackgroundColor3 = Color3.new(1, 1, 1)
        }):Play()
        TweenService:Create(flashClone.Flashup.Viewport.Viewport, TweenInfo.new(0.8, Enum.EasingStyle.Quad), {
            ImageColor3 = Color3.new(1, 1, 1)
        }):Play()
    end)

    TweenService:Create(flashClone.Flashup, TweenInfo.new(2.5, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
        Size = UDim2.new(1, 0, 0.3, 0)
    }):Play()
    TweenService:Create(viewportCam, TweenInfo.new(2, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
        FieldOfView = 120
    }):Play()

    task.wait(1.2)

    task.spawn(function()
        task.wait(0.2)

        task.spawn(AnchorForWindup)

        task.delay(0, function()
            task.spawn(function()
                PlayJumpMeshTrails(Character)
            end)
            PlayJumpBurstAndHighlight(Character)
        end)

        LaunchCharacterAndCleanup(flashClone, charClone, renderSteppedConn)
    end)
end

local function PlaySpiritBombSequence()
