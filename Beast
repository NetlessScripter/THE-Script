-- Tunables (the original red tint used Brightness 1.667 which blows the whole screen out red)
local RED_TINT_BRIGHTNESS = 0.35
local RED_TINT_FADE = 1.1

local function purgeTint()
    for _, child in ipairs(Lighting:GetChildren()) do
        if child.Name == "FinalStandRedTint" then
            child:Destroy()
        end
    end
end

-- removes leftovers from a previous run so effects/camera don't stack
local function purgeLeftovers(char)
    purgeTint()
    for _, child in ipairs(char:GetChildren()) do
        if child.Name == "FinalStandBind" then
            child:Destroy()
        end
    end
end

if environment.CameraCutsceneStop then
    pcall(environment.CameraCutsceneStop)
end
environment.FinalStandEyeShotUntil = 0

local localPlayer = Players.LocalPlayer
local camera = Workspace.CurrentCamera
while not camera do
    task.wait()
    camera = Workspace.CurrentCamera
end
local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")
local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid:WaitForChild("Animator", 5)

purgeLeftovers(character)

local frames = CameraCutscene.Frames
local frameCount = #frames
local anchorCFrame = rootPart.CFrame
local previousCameraType = camera.CameraType
if previousCameraType == Enum.CameraType.Scriptable then
    previousCameraType = Enum.CameraType.Custom
end
local previousCameraSubject = camera.CameraSubject or humanoid
local previousFieldOfView = camera.FieldOfView
if previousFieldOfView < 1 or previousFieldOfView > 120 then
    previousFieldOfView = 70
end
local frameIndex = 1
local startClock = 0
local playbackTrack = nil

if animator then
    local animationInstance = Instance.new("Animation")
    animationInstance.AnimationId = "rbxassetid://" .. CameraCutscene.AnimationId
    local loadSucceeded, loadedTrack = pcall(function()
        return animator:LoadAnimation(animationInstance)
    end)
    if loadSucceeded and loadedTrack then
        loadedTrack.Priority = Enum.AnimationPriority.Action4
        playbackTrack = loadedTrack
    end
end

local function sampleCutscene(elapsedTime)
    while frameIndex < frameCount and frames[frameIndex + 1].Time <= elapsedTime do
        frameIndex = frameIndex + 1
    end
    local currentFrame = frames[frameIndex]
    local nextFrame = frames[math.min(frameIndex + 1, frameCount)]
    local timeSpan = nextFrame.Time - currentFrame.Time
    local blendAlpha = 0
    if timeSpan > 0 then
        blendAlpha = math.max(0, math.min(1, (elapsedTime - currentFrame.Time) / timeSpan))
    end
    return currentFrame, nextFrame, blendAlpha
end

local function applyFrame(elapsedTime)
    local currentFrame, nextFrame, blendAlpha = sampleCutscene(elapsedTime)
    camera.CameraType = Enum.CameraType.Scriptable
    camera.CFrame = anchorCFrame * currentFrame.CFrame:Lerp(nextFrame.CFrame, blendAlpha)
    camera.Focus = anchorCFrame * currentFrame.Focus:Lerp(nextFrame.Focus, blendAlpha)
    camera.FieldOfView = currentFrame.FieldOfView + (nextFrame.FieldOfView - currentFrame.FieldOfView) * blendAlpha
end

local function stopPlayback()
    pcall(function()
        RunService:UnbindFromRenderStep(BIND_NAME)
    end)
    if playbackTrack then
        pcall(function()
            playbackTrack:Stop(0)
        end)
    end
    environment.FinalStandEyeShotUntil = 0
    purgeTint()
    camera.CameraType = previousCameraType
    camera.CameraSubject = previousCameraSubject
    camera.FieldOfView = previousFieldOfView
    environment.CameraCutsceneStop = nil
end

local function onRenderStep()
    local elapsedTime = os.clock() - startClock
    if elapsedTime >= CameraCutscene.Duration then
        stopPlayback()
        return
    end
    if os.clock() < (environment.FinalStandEyeShotUntil or 0) then
        return
    end
    local ok, err = pcall(applyFrame, elapsedTime)
    if not ok then
        warn("[FinalStand] camera error: " .. tostring(err))
        stopPlayback()
    end
end

environment.CameraCutsceneStop = stopPlayback

if playbackTrack then
    pcall(function()
        playbackTrack:Play(0)
    end)
end

humanoid.Died:Connect(function()
    if environment.CameraCutsceneStop == stopPlayback then
        stopPlayback()
    end
end)

