local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ok, objs = pcall(function()
	return game:GetObjects("rbxassetid://6812562887")
end)

if not ok or not objs then
	warn("Could not load asset")
	return
end

for _, obj in ipairs(objs) do
	obj.Parent = ReplicatedStorage
end

local CloudsFolder = ReplicatedStorage:WaitForChild("CloudsModule")

local CloudsModule = {}
local CloudClass = {}
CloudClass.__index = CloudClass
CloudsModule.Clouds = CloudClass

local DefaultValues = {
	Tallness = 40,
	Offset = 0,
	Density = 0.2,
	Speed = 5,
	Height = 1500,
	Size = 3.572,
	ShadowCast = true,
	CloudType = "Cumulus",
}

function CloudClass:new(attributes)
	local self = setmetatable({}, CloudClass)
	attributes = attributes or {}

	self.Tallness = attributes.Tallness or DefaultValues.Tallness
	self.Offset = attributes.Offset or DefaultValues.Offset
	self.Density = attributes.Density or DefaultValues.Density
	self.Speed = attributes.Speed or DefaultValues.Speed
	self.Height = attributes.Height or DefaultValues.Height
	self.Size = attributes.Size or DefaultValues.Size
	self.ShadowCast = attributes.ShadowCast ~= nil and attributes.ShadowCast or DefaultValues.ShadowCast
	self.CloudType = attributes.CloudType or DefaultValues.CloudType

	return self
end

function CloudClass:SpawnClouds()
	task.spawn(function()
		local templateName = self.CloudType == "Stratus" and "StratusCloud" or "CumulusCloud"
		local template = CloudsFolder:WaitForChild(templateName)
		local lastCloud = template
		local darkness = 100
		local rng = Random.new()

		lastCloud.Position = Vector3.new(392.629, self.Height, -405.891)

		for _ = 1, self.Tallness do
			local cl = lastCloud:Clone()
			local ran1 = math.random(-self.Offset, self.Offset)
			local ran2 = math.random(-self.Offset, self.Offset)

			cl.Parent = workspace
			cl.Position = cl.Position + Vector3.new(ran1, 5, ran2)

			if cl:FindFirstChild("Texture1") then
				cl.Texture1.Transparency = 1 - self.Density
				cl.Texture1.Color3 = Color3.fromRGB(darkness, darkness, darkness)
			end

			if cl:FindFirstChild("Texture2") then
				cl.Texture2.Transparency = 1 - self.Density
				cl.Texture2.Color3 = Color3.fromRGB(darkness, darkness, darkness)
			end

			cl.CastShadow = self.ShadowCast

			if self.Size == 3.572 then
				cl.Size = Vector3.new(
					rng:NextNumber(2.9, 3),
					0.143,
					rng:NextNumber(2.9, 3)
				)
			else
				cl.Size = Vector3.new(
					rng:NextNumber(2.9, self.Size),
					0.143,
					rng:NextNumber(2.9, self.Size)
				)
			end

			darkness += 10
			lastCloud = cl
		end
	end)
end

local Clouds = CloudsModule.Clouds:new({
	Tallness = 40,
	Offset = 0,
	Density = 0.2,
	Speed = 5,
	Height = 1500,
	Size = 3.572,
	ShadowCast = true,
	CloudType = "Cumulus"
})

Clouds:SpawnClouds()
