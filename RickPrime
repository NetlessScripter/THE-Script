function FX.burst(parent, count, config)
	local palette = VFX.palette
	local lifetime = config.lifetime or NumberRange.new(0.2, 0.45)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Enabled = false
	emitter.Rate = 0
	if config.texture then
		emitter.Texture = config.texture
	end
	emitter.LightEmission = config.lightEmission or 1
	emitter.LightInfluence = 0
	emitter.Color = config.color or ColorSequence.new({
		ColorSequenceKeypoint.new(0, palette.hot),
		ColorSequenceKeypoint.new(0.35, palette.bright),
		ColorSequenceKeypoint.new(1, palette.deep),
	})
	emitter.Size = config.size or NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = config.transparency or NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.7, 0.15),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime = lifetime
	emitter.Speed = config.speed or NumberRange.new(30, 70)
	emitter.SpreadAngle = config.spread or Vector2.new(20, 20)
	emitter.Acceleration = config.acceleration or Vector3.new(0, -40, 0)
	emitter.Drag = config.drag or 1.5
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.EmissionDirection = Enum.NormalId.Front
	emitter.Parent = parent
	emitter:Emit(count)
	task.delay(lifetime.Max + 0.3, function()
		emitter:Destroy()
	end)
	return emitter
end

function FX.ignoreList(...)
	local list = {}
	for index = 1, select("#", ...) do
		local instance = select(index, ...)
		if instance then
			table.insert(list, instance)
		end
	end
	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer.Character then
			table.insert(list, otherPlayer.Character)
		end
	end
	return list
end

function FX.floorAt(position, ignoreList)
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.RespectCanCollide = true
	rayParams.FilterDescendantsInstances = ignoreList
	return workspace:Raycast(position + Vector3.new(0, 3, 0), Vector3.new(0, -60, 0), rayParams)
end

function FX.camera(bindName, camera, baseCFrame, savedFov, zoomStart, chargeDuration)
	local rig = {}
	local seed = FX.rng:NextNumber(1, 90)
	local rollSign = FX.rng:NextNumber() < 0.5 and -1 or 1
	local fireTime, impactTime
	local kicks = {}

	function rig.fire()
		fireTime = os.clock()
		table.insert(kicks, { time = fireTime, strength = 1, roll = rollSign })
	end

	function rig.impact()
		impactTime = os.clock()
		table.insert(kicks, { time = impactTime, strength = 0.6, roll = -rollSign })
	end

	local function wobble(now, offset)
		return math.noise(now * 34, seed + offset, 0.5) * 2
	end

	local function jitter(amount)
		return (math.random() - 0.5) * 2 * amount
	end

	RunService:BindToRenderStep(bindName, Enum.RenderPriority.Last.Value, function()
		camera.CameraType = Enum.CameraType.Scriptable
		local now = os.clock()

		local fov
		if fireTime then
			local fovAlpha = math.clamp((now - fireTime) / FOV_RETURN_TIME, 0, 1)
			fov = FOV_BURST + (savedFov - FOV_BURST) * (1 - (1 - fovAlpha) ^ 3)
		else
			local fovAlpha = math.clamp((now - zoomStart) / FOV_ZOOM_TIME, 0, 1)
			fov = savedFov + (FOV_ZOOM - savedFov) * (1 - (1 - fovAlpha) ^ 3)
		end
		if impactTime then
			fov -= VFX.impactFov * (1 - math.clamp((now - impactTime) / 0.3, 0, 1)) ^ 2
		end
		camera.FieldOfView = fov

		local progress = math.clamp((now - zoomStart) / chargeDuration, 0, 1)
		local lean = progress ^ 2
		if fireTime then
			lean = (1 - math.clamp((now - fireTime) / 0.5, 0, 1)) ^ 2
		end
		local tremor = fireTime and 0 or progress ^ 3 * VFX.chargeTremor

		local kickBack, kickRoll, kickShake = 0, 0, 0
		for _, kick in ipairs(kicks) do
			local age = now - kick.time
			if age < SHAKE_DURATION then
				local decay = math.exp(-age * VFX.kickDecay)
				kickBack += kick.strength * decay * math.cos(age * VFX.kickFreq)
				kickRoll += kick.strength * kick.roll * decay * math.cos(age * VFX.kickFreq * 0.55)
				kickShake += kick.strength * (1 - age / SHAKE_DURATION) ^ SHAKE_FALLOFF
			end
		end
		local jitterPosition = SHAKE_POSITION * kickShake
		local jitterRotation = SHAKE_ROTATION * kickShake

		camera.CFrame = baseCFrame
			* CFrame.new(
				wobble(now, 1) * tremor + jitter(jitterPosition),
				wobble(now, 2) * tremor + jitter(jitterPosition),
				-VFX.dollyIn * lean + kickBack * VFX.kickBack
			)
			* CFrame.Angles(
				wobble(now, 3) * tremor * 0.6 + jitter(jitterRotation),
				wobble(now, 4) * tremor * 0.6 + jitter(jitterRotation),
				VFX.chargeRoll * rollSign * lean + kickRoll * VFX.kickRoll + jitter(jitterRotation)
			)
	end)

	return rig
end

function FX.screen(camera)
	local palette = VFX.palette
	local lighting = game:GetService("Lighting")
	local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
	local screen = {}
	local destroyed = false
	local edges = {}
	local gui, flashFrame, lineHolder

	local grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "RickPrimeGrade"
	grade.Parent = lighting
	local blur = Instance.new("BlurEffect")
	blur.Name = "RickPrimeBlur"
	blur.Size = 0
	blur.Parent = lighting

	if playerGui then
		gui = Instance.new("ScreenGui")
		gui.Name = "RickPrimeShotGui"
		gui.IgnoreGuiInset = true
		gui.ScreenInsets = Enum.ScreenInsets.None
		gui.ResetOnSpawn = false
		gui.DisplayOrder = 50
		gui.Parent = playerGui

		local function addEdge(anchor, position, size, rotation)
			local frame = Instance.new("Frame")
			frame.AnchorPoint = anchor
			frame.Position = position
			frame.Size = size
			frame.BorderSizePixel = 0
			frame.BackgroundColor3 = palette.deep:Lerp(Color3.new(0, 0, 0), 0.82)
			frame.BackgroundTransparency = 1
			frame.ZIndex = 1
			local gradient = Instance.new("UIGradient")
			gradient.Rotation = rotation
			gradient.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
			gradient.Parent = frame
			frame.Parent = gui
			table.insert(edges, frame)
		end
		addEdge(Vector2.new(0, 0), UDim2.fromScale(0, 0), UDim2.fromScale(0.28, 1), 0)
		addEdge(Vector2.new(1, 0), UDim2.fromScale(1, 0), UDim2.fromScale(0.28, 1), 180)
		addEdge(Vector2.new(0, 0), UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.32), 90)
		addEdge(Vector2.new(0, 1), UDim2.fromScale(0, 1), UDim2.fromScale(1, 0.32), 270)

		lineHolder = Instance.new("Frame")
		lineHolder.BackgroundTransparency = 1
		lineHolder.BorderSizePixel = 0
		lineHolder.Size = UDim2.fromScale(1, 1)
		lineHolder.ZIndex = 3
		lineHolder.Parent = gui

		flashFrame = Instance.new("Frame")
		flashFrame.BackgroundColor3 = Color3.new(1, 1, 1)
		flashFrame.BackgroundTransparency = 1
		flashFrame.BorderSizePixel = 0
		flashFrame.Size = UDim2.fromScale(1, 1)
		flashFrame.ZIndex = 5
		flashFrame.Parent = gui
	end

	function screen.setCharge(progress)
		if destroyed then
			return
		end
		local strength = progress ^ 1.5
		for _, edge in ipairs(edges) do
			edge.BackgroundTransparency = 1 - 0.55 * strength
		end
		grade.Saturation = 0.15 * strength
		grade.Contrast = 0.12 * strength
		grade.TintColor = Color3.new(1, 1, 1):Lerp(palette.tint, 0.55 * strength)
	end

	function screen.release()
		if destroyed then
			return
		end
		for _, edge in ipairs(edges) do
			FX.tween(edge, 0.5, { BackgroundTransparency = 1 })
		end
		FX.tween(grade, 0.5, { Saturation = 0, Contrast = 0, TintColor = Color3.new(1, 1, 1) })
	end

	function screen.flash(strength, duration, color, blurSize)
		if destroyed then
			return
		end
		if flashFrame then
			flashFrame.BackgroundColor3 = color
			flashFrame.BackgroundTransparency = 1 - strength
			FX.tween(flashFrame, duration, { BackgroundTransparency = 1 })
		end
		grade.Brightness = 0.18 * strength
		FX.tween(grade, duration * 1.4, { Brightness = 0 })
		blur.Size = blurSize
		FX.tween(blur, duration * 1.6, { Size = 0 })
	end

	function screen.speedLines()
		if destroyed or not lineHolder then
			return
		end
		local viewport = camera.ViewportSize
		local center = viewport / 2
		local maxRadius = viewport.Magnitude / 2
		for index = 1, VFX.speedLineCount do
			local angle = index / VFX.speedLineCount * 2 * math.pi + FX.rng:NextNumber(-0.09, 0.09)
			local direction = Vector2.new(math.cos(angle), math.sin(angle))
			local length = FX.rng:NextNumber(0.22, 0.42) * maxRadius
			local inner = FX.rng:NextNumber(0.34, 0.55) * maxRadius
			local startPosition = center + direction * (inner + length * 0.25)
			local endPosition = center + direction * (inner + length * 0.9)

			local line = Instance.new("Frame")
			line.BorderSizePixel = 0
			line.BackgroundColor3 = index % 3 == 0 and palette.bright or palette.hot
			line.BackgroundTransparency = 0.25
			line.AnchorPoint = Vector2.new(0.5, 0.5)
			line.Rotation = math.deg(angle) - 90
			line.Size = UDim2.fromOffset(FX.rng:NextNumber(2, 4), length * 0.5)
			line.Position = UDim2.fromOffset(startPosition.X, startPosition.Y)
			line.Parent = lineHolder

			local life = FX.rng:NextNumber(0.2, 0.32)
			FX.tween(line, life, {
				Position = UDim2.fromOffset(endPosition.X, endPosition.Y),
				Size = UDim2.fromOffset(1, length),
				BackgroundTransparency = 1,
			})
			task.delay(life + 0.05, function()
				line:Destroy()
			end)
		end
	end

	function screen.fire()
		screen.flash(0.5, 0.2, palette.hot, 12)
		screen.speedLines()
		screen.release()
	end

	function screen.impact()
		screen.flash(0.25, 0.14, palette.red, 6)
	end

	function screen.destroy()
		if destroyed then
			return
		end
		destroyed = true
		if gui then
			gui:Destroy()
		end
		grade:Destroy()
		blur:Destroy()
	end

	task.delay(8, screen.destroy)
	return screen
end

function FX.reticle(parent, targetRoot)
	local palette = VFX.palette
	local reticle = {}
	local angle = 0
	local lastTime = os.clock()
	local lockTime

	local gui = Instance.new("BillboardGui")
	gui.Name = "RickPrimeReticle"
	gui.Adornee = targetRoot
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Size = UDim2.fromScale(VFX.reticleStart, VFX.reticleStart)
	gui.Parent = parent

	local function makeFrame(parentFrame, size)
		local frame = Instance.new("Frame")
		frame.BackgroundTransparency = 1
		frame.BorderSizePixel = 0
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.Position = UDim2.fromScale(0.5, 0.5)
		frame.Size = size
		frame.Parent = parentFrame
		return frame
	end

	local spinFrame = makeFrame(gui, UDim2.fromScale(1, 1))
	local bracketFrame = makeFrame(gui, UDim2.fromScale(1, 1))

	local ring = makeFrame(spinFrame, UDim2.fromScale(0.82, 0.82))
	local ringCorner = Instance.new("UICorner")
	ringCorner.CornerRadius = UDim.new(0.5, 0)
	ringCorner.Parent = ring
	local ringStroke = Instance.new("UIStroke")
	ringStroke.Thickness = 2
	ringStroke.Color = palette.red
	ringStroke.Transparency = 1
	ringStroke.Parent = ring

	local solids = {}
	local function addSolid(parentFrame, anchor, position, size)
		local frame = Instance.new("Frame")
		frame.BorderSizePixel = 0
		frame.BackgroundColor3 = palette.hot
		frame.BackgroundTransparency = 1
		frame.AnchorPoint = anchor
		frame.Position = position
		frame.Size = size
		frame.Parent = parentFrame
		table.insert(solids, frame)
		return frame
	end

	for _, corner in ipairs({ { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } }) do
		local anchor = Vector2.new(corner[1], corner[2])
		local position = UDim2.fromScale(corner[1], corner[2])
		addSolid(bracketFrame, anchor, position, UDim2.new(0.2, 0, 0, 3))
		addSolid(bracketFrame, anchor, position, UDim2.new(0, 3, 0.2, 0))
	end
	local dot = addSolid(gui, Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(6, 6))
	local dotCorner = Instance.new("UICorner")
	dotCorner.CornerRadius = UDim.new(0.5, 0)
	dotCorner.Parent = dot

	function reticle.update(progress, now)
		local deltaTime = now - lastTime
		lastTime = now

		local lockProgress = math.clamp(progress / 0.8, 0, 1)
		local size = VFX.reticleLock + (VFX.reticleStart - VFX.reticleLock) * (1 - lockProgress ^ 2.6)

		local pop = 1
		if lockProgress >= 1 then
			lockTime = lockTime or now
			pop = 1 + 0.2 * math.exp(-(now - lockTime) * 16)
			ringStroke.Color = palette.hot
			ringStroke.Thickness = 3.5
		else
			ringStroke.Color = palette.red:Lerp(palette.bright, lockProgress)
		end
		gui.Size = UDim2.fromScale(size * pop, size * pop)

		angle += deltaTime * VFX.reticleSpin * (1 - lockProgress * 0.9)
		spinFrame.Rotation = angle
		bracketFrame.Rotation = -angle * 0.6

		local fade = math.clamp(progress / 0.12, 0, 1)
		ringStroke.Transparency = 1 - fade
		for _, solid in ipairs(solids) do
			solid.BackgroundTransparency = 1 - fade
		end
	end

	function reticle.collapse()
		FX.tween(gui, 0.14, { Size = UDim2.fromScale(VFX.reticleLock * 0.35, VFX.reticleLock * 0.35) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		FX.tween(ringStroke, 0.14, { Transparency = 1 })
		for _, solid in ipairs(solids) do
			FX.tween(solid, 0.14, { BackgroundTransparency = 1 })
		end
		task.delay(0.25, function()
			gui:Destroy()
		end)
	end

	task.delay(6, function()
		if gui.Parent then
			gui:Destroy()
		end
	end)

	return reticle
end

function FX.muzzleBurst(owner, origin, direction, paletteOverride)
	local palette = paletteOverride or VFX.palette
	local rng = FX.rng
	local ball = Enum.PartType.Ball
	local block = Enum.PartType.Block
	local frame = FX.facing(origin, direction)

	local flash = FX.part(owner, ball, palette.hot, 0, Vector3.one * 0.7, CFrame.new(origin))
	FX.tween(flash, 0.11, { Transparency = 1, Size = Vector3.one * 3.2 })
	local halo = FX.part(owner, ball, palette.red, 0.35, Vector3.one * 1.2, CFrame.new(origin))
	FX.tween(halo, 0.16, { Transparency = 1, Size = Vector3.one * 5.2 })
	local light = Instance.new("PointLight")
	light.Color = palette.bright
	light.Brightness = 9
	light.Range = 26
	light.Shadows = false
	light.Parent = flash
	FX.tween(light, 0.2, { Brightness = 0 })
	task.delay(0.3, function()
		flash:Destroy()
		halo:Destroy()
	end)

	local rayCount = 9
	for index = 1, rayCount do
		local azimuth = index / rayCount * 2 * math.pi + rng:NextNumber(-0.2, 0.2)
		local spread = rng:NextNumber(math.rad(6), math.rad(34))
		local length = rng:NextNumber(3.2, 7.5) * (1.15 - spread / math.rad(60))
		local localDirection = Vector3.new(math.sin(spread) * math.cos(azimuth), math.sin(spread) * math.sin(azimuth), -math.cos(spread))
		local worldDirection = frame:VectorToWorldSpace(localDirection)
		local grownLength = length * 1.5
		local ray = FX.part(
			owner,
			block,
			index % 2 == 0 and palette.hot or palette.bright,
			0,
			Vector3.new(0.09, 0.09, length),
			CFrame.lookAt(origin + worldDirection * (length / 2), origin + worldDirection * length)
		)
		FX.tween(ray, 0.09 + rng:NextNumber(0, 0.04), {
			Transparency = 1,
			Size = Vector3.new(0.01, 0.01, grownLength),
			CFrame = CFrame.lookAt(origin + worldDirection * (grownLength / 2), origin + worldDirection * grownLength),
		})
		task.delay(0.3, function()
			ray:Destroy()
		end)
	end

	local spike = FX.part(owner, block, palette.hot, 0, Vector3.new(0.16, 0.16, 11), CFrame.lookAt(origin + direction * 5.5, origin + direction * 11))
	FX.tween(spike, 0.12, {
		Transparency = 1,
		Size = Vector3.new(0.01, 0.01, 17),
		CFrame = CFrame.lookAt(origin + direction * 8.5, origin + direction * 17),
	})
	task.delay(0.3, function()
		spike:Destroy()
	end)

	FX.shockRing(owner, FX.facing(origin + direction * 0.25, direction), {
		startRadius = 0.2,
		endRadius = 3.8,
		duration = 0.18,
		thickness = 0.16,
		color = palette.hot,
		segments = 28,
		startTransparency = 0,
	})

	local proxy = FX.part(owner, block, palette.hot, 1, Vector3.new(0.1, 0.1, 0.1), frame)
	FX.burst(proxy, 44, { speed = NumberRange.new(40, 95), spread = Vector2.new(24, 24), lifetime = NumberRange.new(0.18, 0.42) })
	FX.burst(proxy, 14, { speed = NumberRange.new(8, 24), spread = Vector2.new(75, 75), lifetime = NumberRange.new(0.15, 0.3), size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) }) })
	FX.burst(proxy, 4, {
		texture = "rbxasset://textures/particles/smoke_main.dds",
		lightEmission = 0.2,
		color = ColorSequence.new(Color3.fromRGB(70, 56, 64)),
		size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1.6) }),
		transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) }),
		lifetime = NumberRange.new(0.6, 1),
		speed = NumberRange.new(2, 6),
		spread = Vector2.new(35, 35),
		acceleration = Vector3.new(0, 3, 0),
		drag = 3,
	})
end

function FX.impact(owner, position, direction, targetModel, ignoreList, paletteOverride)
	local palette = paletteOverride or VFX.palette
	local ball = Enum.PartType.Ball
	local block = Enum.PartType.Block
	local frame = FX.facing(position, direction)

	local flash = FX.part(owner, ball, palette.hot, 0, Vector3.one * 1.4, CFrame.new(position))
	FX.tween(flash, 0.14, { Transparency = 1, Size = Vector3.one * 8 })
	local core = FX.part(owner, ball, palette.red, 0.25, Vector3.one * 0.8, CFrame.new(position))
	FX.tween(core, 0.28, { Transparency = 1, Size = Vector3.one * 5.5 })
	local light = Instance.new("PointLight")
	light.Color = palette.bright
	light.Brightness = 10
	light.Range = 28
	light.Shadows = false
	light.Parent = flash
	FX.tween(light, 0.3, { Brightness = 0 })
	task.delay(0.4, function()
		flash:Destroy()
		core:Destroy()
	end)

	for index = 0, 3 do
		local length = index % 2 == 0 and 15 or 8
		local blade = FX.part(
			owner,
			block,
			index % 2 == 0 and palette.hot or palette.bright,
			0.05,
			Vector3.new(length * 0.25, 0.3, 0.3),
			frame * CFrame.Angles(0, 0, index * math.pi / 4)
		)
		FX.tween(blade, 0.22, { Transparency = 1, Size = Vector3.new(length, 0.02, 0.02) })
		task.delay(0.3, function()
			blade:Destroy()
		end)
	end

	FX.shockRing(owner, frame, { startRadius = 0.8, endRadius = 9, duration = 0.32, thickness = 0.3, color = palette.hot, segments = 40, startTransparency = 0.05 })
	task.delay(0.05, function()
		if owner.Parent then
			FX.shockRing(owner, frame, { startRadius = 0.5, endRadius = 6, duration = 0.28, thickness = 0.22, color = palette.red, segments = 36, startTransparency = 0.1 })
		end
	end)

	local floorHit = FX.floorAt(position, ignoreList)
	if floorHit and (position - floorHit.Position).Magnitude < 14 then
		local floorFrame = FX.facing(floorHit.Position + floorHit.Normal * 0.15, floorHit.Normal)
		FX.shockRing(owner, floorFrame, { startRadius = 0.8, endRadius = 15, duration = 0.5, thickness = 0.5, color = palette.red, segments = 44, startTransparency = 0.05 })
		FX.shockRing(owner, floorFrame, { startRadius = 0.4, endRadius = 8.5, duration = 0.34, thickness = 0.3, color = palette.hot, segments = 40, startTransparency = 0.1 })
	end

	local proxy = FX.part(owner, block, palette.hot, 1, Vector3.new(0.1, 0.1, 0.1), FX.facing(position, -direction))
	FX.burst(proxy, 48, { speed = NumberRange.new(28, 72), spread = Vector2.new(70, 70), lifetime = NumberRange.new(0.2, 0.5) })
	FX.burst(proxy, 24, { speed = NumberRange.new(10, 42), spread = Vector2.new(180, 180), lifetime = NumberRange.new(0.2, 0.45), size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) }) })

	if targetModel and targetModel.Parent then
		local highlight = Instance.new("Highlight")
		highlight.Adornee = targetModel
		highlight.FillColor = palette.red
		highlight.OutlineColor = palette.hot
		highlight.FillTransparency = 0.15
		highlight.OutlineTransparency = 0
		highlight.DepthMode = Enum.HighlightDepthMode.Occluded
		highlight.Parent = owner
		FX.tween(highlight, 0.4, { FillTransparency = 1, OutlineTransparency = 1 })
		task.delay(0.5, function()
			highlight:Destroy()
		end)
	end
end

local function createChargeEffect(muzzlePlug, targetRoot, duration, context)
	local palette = VFX.palette
	local rng = Random.new()
	local twoPi = 2 * math.pi
	local ball = Enum.PartType.Ball
	local block = Enum.PartType.Block
	local spinDirection = rng:NextNumber() < 0.5 and 1 or -1

	local folder = Instance.new("Folder")
	folder.Name = "RickPrimeCharge"
	folder.Parent = workspace
	local stage = context.stage or folder

	local function getTipFrame()
		local plugCFrame = muzzlePlug.CFrame
		local tip = plugCFrame:PointToWorldSpace(Vector3.new(muzzlePlug.Size.X / 2, 0, 0))
		return CFrame.lookAt(tip, tip + plugCFrame.RightVector, plugCFrame.UpVector)
	end
	local function getCoreFrame()
		return getTipFrame() * CFrame.new(0, 0, -VFX.coreOffset)
	end
	local origin = getCoreFrame()

	FX.sound(VFX.sounds.charge, folder)

	local particles = {}
	local streakColors = { palette.red, palette.bright }
	local function addParticles(count, isStreak)
		local lifeMax = isStreak and 0.34 or 0.38
		for _ = 1, count do
			table.insert(particles, {
				streak = isStreak,
				t0 = rng:NextNumber() ^ 0.65 * math.max(duration - lifeMax, 0),
				life = rng:NextNumber(lifeMax * 0.65, lifeMax),
				azimuth = rng:NextNumber(0, twoPi),
				polar = isStreak and rng:NextNumber(0.12, 1.15) or rng:NextNumber(0.1, 1.7),
				radius = rng:NextNumber(isStreak and 0.5 or 0.3, 1) * VFX.chargeRadius * (isStreak and 1 or 1.1),
				swirl = (isStreak and rng:NextNumber(1, 2.2) or rng:NextNumber(1.2, 2.6)) * spinDirection,
				size = isStreak and rng:NextNumber(0.1, 0.17) or rng:NextNumber(0.05, 0.1),
				color = isStreak and streakColors[rng:NextInteger(1, 2)] or palette.hot,
			})
		end
	end
	addParticles(VFX.streakCount, true)
	addParticles(VFX.moteCount, false)

	local rings = {}
	for ringIndex = 0, VFX.ringCount - 1 do
		table.insert(rings, { t0 = ringIndex * math.max(duration - VFX.ringLife, 0) / math.max(VFX.ringCount - 1, 1) })
	end

	local core = FX.part(folder, ball, palette.hot, 0, Vector3.one * 0.05, origin)
	local halo = FX.part(folder, ball, palette.red, 0.5, Vector3.one * 0.1, origin)
	local aura = FX.part(folder, ball, palette.deep, 0.86, Vector3.one * 0.2, origin)
	local coreLight = Instance.new("PointLight")
	coreLight.Color = palette.bright
	coreLight.Range = 10
	coreLight.Shadows = false
	coreLight.Parent = core

	local flare = {}
	for index = 1, 4 do
		flare[index] = FX.part(folder, block, index % 2 == 1 and palette.hot or palette.bright, 1, Vector3.new(0.1, 0.03, 0.03), origin)
	end
	local tipRing = FX.newRing(folder, 16, palette.red)

	local orbiters = {}
	for _ = 1, VFX.orbiterCount do
		local head = FX.part(folder, ball, palette.hot, 1, Vector3.one * 0.14, origin)
		local orbiterTrail = FX.trail(head, 0.1, 0.16, palette.bright)
		orbiterTrail.Enabled = false
		table.insert(orbiters, {
			part = head,
			trail = orbiterTrail,
			tilt = CFrame.Angles(rng:NextNumber(0, math.pi), rng:NextNumber(0, math.pi), 0),
			speed = rng:NextNumber(12, 17) * spinDirection,
			phase = rng:NextNumber(0, twoPi),
		})
	end

	local sightStartPart, sightStart = FX.node(folder)
	local sightEndPart, sightEnd = FX.node(folder)
	local sightBeam = FX.beam(folder, sightStart, sightEnd, ColorSequence.new(palette.red), 0.03, 0.03, NumberSequence.new(0.8), 0)
	sightBeam.Enabled = targetRoot ~= nil

	local reticle
	if targetRoot then
		local reticleFolder = Instance.new("Folder")
		reticleFolder.Name = "RickPrimeReticleHolder"
		reticleFolder.Parent = workspace
		task.delay(duration + 1, function()
			reticleFolder:Destroy()
		end)
		reticle = FX.reticle(reticleFolder, targetRoot)
	end

	local feetHit = context.feetPosition and FX.floorAt(context.feetPosition, context.ignore)
	local floorFrame
	local embers
	if feetHit then
		floorFrame = FX.facing(feetHit.Position + feetHit.Normal * 0.12, feetHit.Normal)
		local emberPart = FX.part(stage, block, palette.red, 1, Vector3.new(3, 0.1, 3), CFrame.new(feetHit.Position + feetHit.Normal * 0.2))
		embers = Instance.new("ParticleEmitter")
		embers.Rate = 55
		embers.LightEmission = 1
		embers.LightInfluence = 0
		embers.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, palette.hot), ColorSequenceKeypoint.new(0.4, palette.bright), ColorSequenceKeypoint.new(1, palette.deep) })
		embers.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) })
		embers.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
		embers.Lifetime = NumberRange.new(0.5, 0.9)
		embers.Speed = NumberRange.new(6, 13)
		embers.SpreadAngle = Vector2.new(25, 25)
		embers.Acceleration = Vector3.new(0, 5, 0)
		embers.EmissionDirection = Enum.NormalId.Top
		embers.Parent = emberPart
	end
	local groundPulses = { 0, 0.45 }
	local groundPulseIndex = 1

	local stopped = false
	local startTime = os.clock()
	local connection
	connection = RunService.PreRender:Connect(function()
		if stopped or not folder.Parent then
			connection:Disconnect()
			return
		end
		if not muzzlePlug.Parent then
			connection:Disconnect()
			folder:Destroy()
			return
		end

		local now = os.clock()
		local elapsed = now - startTime
		local progress = math.clamp(elapsed / duration, 0, 1)
		local tipFrame = getTipFrame()
		local frame = tipFrame * CFrame.new(0, 0, -VFX.coreOffset)

		local flicker = 1 + (0.5 + progress) * (0.06 * math.sin(elapsed * 57) + 0.04 * math.sin(elapsed * 93))
		local coreSize = (0.05 + 0.85 * progress ^ 2) * flicker
		core.Size = Vector3.one * coreSize
		core.CFrame = frame
		halo.Size = Vector3.one * coreSize * 2.2
		halo.CFrame = frame
		aura.Size = Vector3.one * coreSize * 3.4
		aura.CFrame = frame
		coreLight.Brightness = 1 + 7 * progress
		coreLight.Range = 10 + 6 * progress

		local flareAlpha = math.clamp((progress - 0.12) / 0.2, 0, 1)
		local flareLength = (0.5 + 3.4 * progress ^ 2) * flicker
		local flareThickness = 0.025 + 0.05 * progress
		local flareSpin = spinDirection * elapsed * 4
		for index, blade in ipairs(flare) do
			local length = index % 2 == 1 and flareLength or flareLength * 0.55
			blade.Size = Vector3.new(length, flareThickness, flareThickness)
			blade.CFrame = frame * CFrame.Angles(0, 0, flareSpin + (index - 1) * math.pi / 4)
			blade.Transparency = 1 - flareAlpha * 0.85
		end
		FX.setRing(tipRing, tipFrame * CFrame.new(0, 0, -0.03), 0.17 + 0.1 * progress, 0.02 + 0.02 * progress, 0.6 - 0.5 * progress * (0.85 + 0.15 * math.sin(elapsed * 70)), 0)

		for _, particle in ipairs(particles) do
			local alpha = (elapsed - particle.t0) / particle.life
			if alpha >= 0 and alpha < 1 then
				local ease = alpha ^ (particle.streak and 2.4 or 1.7)
				local distance = particle.radius + (VFX.endRadius - particle.radius) * ease
				local swirlAngle = particle.azimuth + particle.swirl * ease
				local lateral = distance * math.sin(particle.polar)
				local forward = distance * math.cos(particle.polar)
				local particleCFrame = frame * CFrame.new(math.cos(swirlAngle) * lateral, math.sin(swirlAngle) * lateral, -forward)

				if not particle.part then
					local head = FX.part(folder, ball, particle.color:Lerp(Color3.new(1, 1, 1), particle.streak and 0.65 or 0.5), 1, Vector3.one * (particle.streak and particle.size * 1.5 or particle.size), particleCFrame)
					if particle.streak then
						particle.trail = FX.trail(head, particle.size, particle.life * 0.55, particle.color)
					end
					particle.part = head
				end

				particle.part.CFrame = particleCFrame
				if not particle.streak then
					particle.part.Size = Vector3.one * particle.size * (1 - 0.6 * ease)
				end
				local fadeIn = math.clamp(1 - alpha / 0.12, 0, 1)
				local fadeOut = math.clamp((alpha - 0.8) / 0.2, 0, 1)
				particle.part.Transparency = math.max(fadeIn, fadeOut)
			elseif alpha >= 1 and particle.part then
				local finishedPart = particle.part
				particle.part = nil
				finishedPart.Transparency = 1
				if particle.trail then
					particle.trail.Enabled = false
					task.delay(particle.life, function()
						finishedPart:Destroy()
					end)
				else
					finishedPart:Destroy()
				end
			end
		end

		for _, ring in ipairs(rings) do
			local alpha = (elapsed - ring.t0) / VFX.ringLife
			if alpha >= 0 and alpha < 1 then
				if not ring.visual then
					ring.visual = FX.newRing(folder, VFX.ringSegments, palette.bright)
				end
				local ease = alpha ^ 2
				local ringRadius = VFX.chargeRadius * 0.7 * (1 - ease) + 0.12
				local ringDepth = VFX.chargeRadius * 0.62 * (1 - ease)
				local pulse = math.sin(math.pi * alpha)
				FX.setRing(ring.visual, frame * CFrame.new(0, 0, -ringDepth), ringRadius, 0.04 + 0.06 * pulse, 1 - 0.9 * pulse ^ 0.6, spinDirection * alpha * 2.5)
			elseif alpha >= 1 and ring.visual then
				FX.destroyRing(ring.visual)
				ring.visual = nil
			end
		end

		local orbitRadius = coreSize * 0.9 + 0.3
		for _, orbiter in ipairs(orbiters) do
			local orbitAngle = orbiter.phase + orbiter.speed * elapsed
			orbiter.part.CFrame = frame * orbiter.tilt * CFrame.new(math.cos(orbitAngle) * orbitRadius, math.sin(orbitAngle) * orbitRadius, 0)
			orbiter.part.Transparency = math.clamp(1 - progress / 0.2, 0, 1)
			orbiter.trail.Enabled = progress > 0.1
		end

		if targetRoot and targetRoot.Parent then
			sightStartPart.Position = tipFrame.Position
			sightEndPart.Position = targetRoot.Position
			local width = (0.025 + 0.05 * progress) * (0.8 + 0.4 * (math.noise(elapsed * 60, 3.1, 0.5) + 0.5))
			sightBeam.Width0 = width
			sightBeam.Width1 = width
			sightBeam.Transparency = NumberSequence.new(0.8 - 0.65 * progress)
			if reticle then
				reticle.update(progress, now)
			end
		else
			sightBeam.Enabled = false
		end

		if floorFrame then
			while groundPulseIndex <= #groundPulses and progress >= groundPulses[groundPulseIndex] do
				groundPulseIndex += 1
				FX.shockRing(stage, floorFrame, { startRadius = 9, endRadius = 0.8, duration = 0.4, thickness = 0.14, color = palette.red, segments = 40, startTransparency = 0.1, easeIn = true })
			end
		end
	end)

	local handle = {}
	function handle:Destroy()
		if stopped then
			return
		end
		stopped = true
		if embers then
			embers.Enabled = false
		end
		if reticle then
			reticle.collapse()
		end
		folder:Destroy()
	end
	return handle
end

local function getClosestTargetRoot(origin)
	local closestRoot
	local closestDistance = math.huge

	local function consider(otherRoot)
		local distance = (otherRoot.Position - origin).Magnitude
		if distance < closestDistance then
			closestDistance = distance
			closestRoot = otherRoot
		end
	end

	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		local otherCharacter = otherPlayer ~= localPlayer and otherPlayer.Character
		local otherRoot = otherCharacter and otherCharacter:FindFirstChild("HumanoidRootPart")
		local otherHumanoid = otherCharacter and otherCharacter:FindFirstChildOfClass("Humanoid")
		if otherRoot and otherHumanoid and otherHumanoid.Health > 0 then
			consider(otherRoot)
		end
	end

	local liveFolder = workspace:FindFirstChild(DUMMY_FOLDER_NAME)
	local dummy = liveFolder and liveFolder:FindFirstChild(DUMMY_NAME)
	if dummy then
		local dummyRoot = dummy:FindFirstChild("HumanoidRootPart") or (dummy:IsA("Model") and dummy.PrimaryPart)
		local dummyHumanoid = dummy:FindFirstChildOfClass("Humanoid")
		if dummyRoot and dummyRoot.Parent and (not dummyHumanoid or dummyHumanoid.Health > 0) then
			consider(dummyRoot)
		end
	end

	return closestRoot
end

function FX.hideCharacter(character)
	local savedTransparency = {}
	local savedEnabled = {}
	local hidden = true
	local bindName = "RickPrimeHide" .. tostring(os.clock())

	local function apply()
		if not hidden then
			return
		end
		for _, descendant in ipairs(character:GetDescendants()) do
			if descendant:IsA("BasePart") then
				descendant.LocalTransparencyModifier = 1
				if savedTransparency[descendant] == nil then
					savedTransparency[descendant] = descendant.Transparency
				end
				descendant.Transparency = 1
			elseif descendant:IsA("Decal") then
				if savedTransparency[descendant] == nil then
					savedTransparency[descendant] = descendant.Transparency
				end
				descendant.Transparency = 1
			elseif descendant:IsA("ParticleEmitter") or descendant:IsA("Trail") or descendant:IsA("Beam") or descendant:IsA("Highlight") then
				if savedEnabled[descendant] == nil then
					savedEnabled[descendant] = descendant.Enabled
				end
				descendant.Enabled = false
			end
		end
	end

	apply()
	local heartbeatConnection = RunService.Heartbeat:Connect(apply)
	RunService:BindToRenderStep(bindName, Enum.RenderPriority.Last.Value, apply)

	return function()
		if not hidden then
			return
		end
		hidden = false
		heartbeatConnection:Disconnect()
		pcall(function()
			RunService:UnbindFromRenderStep(bindName)
		end)
		for instance, originalTransparency in pairs(savedTransparency) do
			if instance.Parent then
				instance.Transparency = originalTransparency
			end
		end
		for instance, originalEnabled in pairs(savedEnabled) do
			if instance.Parent then
				instance.Enabled = originalEnabled
			end
		end
		for _, descendant in ipairs(character:GetDescendants()) do
			if descendant:IsA("BasePart") then
				descendant.LocalTransparencyModifier = 0
			end
		end
	end
end

