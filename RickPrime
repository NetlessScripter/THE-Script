function FX.accent()
	return CHARGE_RED and Color3.fromRGB(255, 170, 70) or VFX.palette.tint
end

function FX.randomUnit(minY, maxY)
	local y = FX.rng:NextNumber(minY or -1, maxY or 1)
	local angle = FX.rng:NextNumber(0, math.pi * 2)
	local flat = math.sqrt(math.max(1 - y * y, 0))
	return Vector3.new(math.cos(angle) * flat, y, math.sin(angle) * flat)
end

-- frame whose X axis (the attachment / cylinder axis) points along `axis`
function FX.axisFrame(position, axis)
	axis = axis.Unit
	local reference = math.abs(axis.Y) > 0.95 and Vector3.xAxis or Vector3.yAxis
	local perpendicular = axis:Cross(reference).Unit
	return CFrame.fromMatrix(position, axis, perpendicular)
end

function FX.floorFrameAt(position, ignoreList, lift)
	local hit = FX.floorAt(position, ignoreList)
	if hit then
		return FX.facing(hit.Position + hit.Normal * (lift or 0.12), hit.Normal), hit
	end
	return FX.facing(position - Vector3.new(0, 2.8, 0), Vector3.yAxis), nil
end

function FX.emitAt(parent, cframe, count, config)
	local node = FX.node(parent)
	node.CFrame = cframe
	FX.burst(node, count, config)
	local lifetime = config.lifetime and config.lifetime.Max or 0.45
	Debris:AddItem(node, lifetime + 0.4)
end

