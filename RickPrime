-- move gate: nothing can start a move while the script is still loading, only a freshly started
-- animation counts as a trigger, and only one move runs at a time (so they can never stack up)
local MOVES = {
	armDelay = 1.5,
	maxTrackAge = 0.6,
	lockTimeout = 6,
	loadedAt = os.clock(),
	owner = nil,
	since = 0,
}

function MOVES.armed()
	return os.clock() - MOVES.loadedAt >= MOVES.armDelay
end

function MOVES.tryStart(name)
	local now = os.clock()
	if MOVES.owner and now - MOVES.since < MOVES.lockTimeout then
		return false
	end
	MOVES.owner = name
	MOVES.since = now
	return true
end

function MOVES.finish(name)
	if MOVES.owner == name then
		MOVES.owner = nil
	end
end

RunService.Heartbeat:Connect(function()
	local character = localPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator or not MOVES.armed() then
		return
	end

	for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
		local animationId = track.Animation and track.Animation.AnimationId
		-- only a swing that just started can trigger a move (never one that was already playing)
		if animationId and track.TimePosition <= MOVES.maxTrackAge then
			if not attackRunning and string.find(animationId, TRIGGER_ANIM_IDS.ATTACK) and MOVES.tryStart("attack1") then
				attackRunning = true
				track:Stop(0)

				task.spawn(function()
					sequenceBusy = true
					local ok, err = pcall(runSequence, character, function()
						sequenceBusy = false
					end)
					if not ok then
						warn("[RickPrimeGun] Error:", err)
						sequenceBusy = false
					end

					local started = tick()
					while sequenceBusy and tick() - started < SEQUENCE_TIMEOUT do
						task.wait(0.1)
					end
					attackRunning = false
					MOVES.finish("attack1")
				end)

				break
			end

			if string.find(animationId, TRIGGER_ANIM_IDS.ATTACK3) then
				track:Stop(0)
				if not attack3Running and MOVES.tryStart("attack3") then
					attack3Running = true
					task.spawn(function()
						local ok, err = pcall(runAttack3, character, animator, function()
							attack3Running = false
							MOVES.finish("attack3")
						end)
						if not ok then
							warn("[Attack3] Error:", err)
							attack3Running = false
							MOVES.finish("attack3")
						end
					end)
				end
				break
			end
		end
	end
end)

