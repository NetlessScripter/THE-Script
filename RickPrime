local function dodgeSparks(parent, position, count)
	local anchor = FX.part(parent, Enum.PartType.Block, ELEC.white, 1, Vector3.new(0.1, 0.1, 0.1), CFrame.new(position))
	FX.burst(anchor, count, {
		color = ELEC_SEQ,
		size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) }),
		speed = NumberRange.new(14, 34),
