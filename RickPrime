-- streak sparks with a single update loop (velocity aligned, gravity, fade)
function FX.sparkField(parent, origin, config)
	local palette = VFX.palette
	local accent = FX.accent()
	local count = config.count or 24
	local gravity = config.gravity or 40
	local thickness = config.thickness or 0.14
	local lengthScale = config.length or 0.05
	local maxLife = 0.1
	local sparks = {}
	for index = 1, count do
		local direction
		if config.direction then
			direction = (config.direction + FX.randomUnit() * (config.spread or 0.3)).Unit
		else
			direction = FX.randomUnit(config.minY, config.maxY)
		end
		local life = FX.rng:NextNumber(config.lifeMin or 0.3, config.lifeMax or 0.7)
		maxLife = math.max(maxLife, life)
		local roll = FX.rng:NextNumber()
		local color = roll < 0.45 and palette.hot or (roll < 0.8 and palette.bright or accent)
		sparks[index] = {
			velocity = direction * FX.rng:NextNumber(config.speedMin or 30, config.speedMax or 90),
			life = life,
			part = FX.part(parent, Enum.PartType.Block, color, 1, Vector3.new(thickness, thickness, 0.3), CFrame.new(origin)),
		}
	end
	FX.run(parent, maxLife, function(_, elapsed)
		for _, spark in ipairs(sparks) do
			local age = elapsed / spark.life
			if age >= 1 then
				spark.part.Transparency = 1
			else
				local position = origin + spark.velocity * elapsed * (1 - 0.5 * age) + Vector3.new(0, -0.5 * gravity * elapsed * elapsed, 0)
				local velocity = spark.velocity * (1 - age) + Vector3.new(0, -gravity * elapsed, 0)
				local speed = velocity.Magnitude
				if speed > 0.5 then
					spark.part.Size = Vector3.new(thickness, thickness, thickness + speed * lengthScale)
					spark.part.CFrame = FX.facing(position, velocity)
					spark.part.Transparency = age ^ 2.2
				end
			end
		end
	end, function()
		for _, spark in ipairs(sparks) do
			spark.part:Destroy()
		end
	end)
end

-- expanding ring made of spinning dashes (instead of a solid ring)
function FX.dashRing(parent, frame, config)
	local count = config.count or 30
	local fill = config.fill or 0.6
	local startTransparency = config.startTransparency or 0
	local dashes = {}
	for index = 1, count do
		dashes[index] = FX.part(parent, Enum.PartType.Block, config.color, 1, Vector3.new(0.2, 0.1, 0.1), frame)
	end
	FX.run(parent, config.duration, function(alpha)
		local eased = 1 - (1 - alpha) ^ 3
		local radius = config.startRadius + (config.endRadius - config.startRadius) * eased
		local thickness = math.max(config.thickness * (1 - 0.8 * alpha), 0.03)
		local transparency = startTransparency + (1 - startTransparency) * alpha ^ 1.5
		local spin = (config.spin or 1.5) * eased
		local chord = math.max(2 * radius * math.sin(math.pi / count) * fill, 0.05)
		for index, dash in ipairs(dashes) do
			local angle = spin + index / count * math.pi * 2
			dash.Size = Vector3.new(chord, thickness, thickness)
			dash.CFrame = frame * CFrame.Angles(0, 0, angle) * CFrame.new(radius, 0, 0) * CFrame.Angles(0, 0, math.pi / 2)
			dash.Transparency = transparency
		end
	end, function()
		for _, dash in ipairs(dashes) do
			dash:Destroy()
		end
	end)
end

-- glowing fissures that crawl out across the floor and cool off
function FX.groundCracks(parent, floorFrame, count, minLength, maxLength)
	local palette = VFX.palette
	local segmentCount = 7
	for index = 1, count do
		local heading = index / count * math.pi * 2 + FX.rng:NextNumber(-0.25, 0.25)
		local length = FX.rng:NextNumber(minLength, maxLength)
		local points = { Vector3.zero }
		for _ = 1, segmentCount do
			heading += FX.rng:NextNumber(-0.38, 0.38)
			points[#points + 1] = points[#points] + Vector3.new(math.cos(heading), math.sin(heading), 0) * (length / segmentCount)
		end
		for step = 1, #points - 1 do
			local pointA, pointB = points[step], points[step + 1]
			local middle = (pointA + pointB) / 2
			local delta = pointB - pointA
			local width = 0.12 + 0.42 * (1 - step / #points)
			local cframe = floorFrame * CFrame.new(middle.X, middle.Y, 0) * CFrame.Angles(0, 0, math.atan2(delta.Y, delta.X))
			local body = FX.part(parent, Enum.PartType.Block, palette.red, 1, Vector3.new(delta.Magnitude + width, width, width * 0.5), cframe)
			local core = FX.part(parent, Enum.PartType.Block, palette.hot, 1, Vector3.new(delta.Magnitude + width, width * 0.4, width * 0.4), cframe)
			task.delay(step / #points * 0.2, function()
				if not parent.Parent then
					return
				end
				body.Transparency = 0.1
				core.Transparency = 0
				FX.tween(body, 0.9 + step * 0.05, { Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				FX.tween(core, 0.55 + step * 0.04, { Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			end)
		end
	end
end

-- twin strands that spiral around the beam axis (braided light)
function FX.attack2Braid(parent, attachment0, attachment1, widthScale, amplitude)
	local palette = VFX.palette
	local colors = { palette.hot, FX.accent() }
	local strands = {}
	for index = 1, 2 do
		local beam = FX.beam(parent, attachment0, attachment1, ColorSequence.new(colors[index]), 0.15, 0.15, NumberSequence.new(0.05), 0.05)
		beam.Segments = 18
		strands[index] = beam
	end
	return function(direction, elapsed, scale, fade)
		if direction.Magnitude < 0.01 then
			return
		end
		local orientation = CFrame.lookAt(Vector3.zero, direction) * CFrame.Angles(0, 0, elapsed * 36)
		attachment0.CFrame = orientation
		attachment1.CFrame = orientation
		local bulge = (amplitude or 1.3) * math.min(scale, 1.3) * (1 + 0.25 * math.sin(elapsed * 71))
		strands[1].CurveSize0 = bulge
		strands[1].CurveSize1 = -bulge
		strands[2].CurveSize0 = -bulge
		strands[2].CurveSize1 = bulge
		local width = 0.15 * widthScale * math.clamp(scale, 0, 1.4)
		local transparency = NumberSequence.new(0.04 + 0.96 * fade ^ 2)
		for _, beam in ipairs(strands) do
			beam.Width0 = width
			beam.Width1 = width
			beam.Transparency = transparency
		end
	end
end

-- rotating floor sigil: dashed rings, locked hexagram, tick marks
function FX.attack2Sigil(stage, initialFrame, radius, options)
	options = options or {}
	local palette = VFX.palette
	local accent = FX.accent()
	local light = options.light == true
	local life = options.life or 2
	local fadeStart = options.fadeStart
	local sigil = { frame = initialFrame, intensity = 0, burstAt = nil }
	local elements = {}

	local function newPart(color, thickness)
		return FX.part(stage, Enum.PartType.Block, color, 1, Vector3.new(0.2, thickness, thickness), initialFrame)
	end
	local function addDashRing(ringIndex, count, color, thickness, fill)
		for index = 1, count do
			elements[#elements + 1] = {
				kind = "dash",
				part = newPart(color, thickness),
				ring = ringIndex,
				angle = index / count * math.pi * 2,
				count = count,
				fill = fill,
				thickness = thickness,
			}
		end
	end

	addDashRing(1, light and 24 or 40, palette.red, 0.16, 0.6)
	if not light then
		addDashRing(2, 28, palette.bright, 0.1, 0.5)
		addDashRing(3, 14, palette.hot, 0.1, 0.55)
	end
	for triangle = 1, 2 do
		local thickness = triangle == 1 and 0.2 or 0.11
		for edge = 0, 2 do
			elements[#elements + 1] = {
				kind = "edge",
				part = newPart(triangle == 1 and palette.bright or palette.hot, thickness),
				triangle = triangle,
				edge = edge,
				thickness = thickness,
			}
		end
	end
	local tickCount = light and 8 or 18
	for index = 1, tickCount do
		elements[#elements + 1] = {
			kind = "tick",
			part = newPart(accent, 0.12),
			angle = index / tickCount * math.pi * 2,
			thickness = 0.12,
		}
	end

	local lastClock = os.clock()
	local spinA, spinB = 0, 0
	FX.run(stage, life, function(_, elapsed)
		local now = os.clock()
		local dt = now - lastClock
		lastClock = now
		local intensity = sigil.intensity
		spinA += dt * (0.7 + 2.2 * intensity)
		spinB -= dt * (1.1 + 2.8 * intensity)

		local frame = sigil.frame
		local grow = 1 - (1 - math.clamp(elapsed / 0.25, 0, 1)) ^ 3
		local burstAge = sigil.burstAt and (now - sigil.burstAt) or nil
		local burst = burstAge and math.exp(-burstAge * 3.4) or 0
		local fade = 1
		if fadeStart and elapsed > fadeStart then
			fade = 1 - math.clamp((elapsed - fadeStart) / math.max(life - fadeStart, 0.05), 0, 1)
		end
		if burstAge and burstAge > 0.45 then
			fade = math.min(fade, 1 - math.clamp((burstAge - 0.45) / 0.8, 0, 1))
		end
		local pulse = 0.5 + 0.5 * math.sin(elapsed * 13)
		local visible = math.clamp(fade * (0.5 + 0.38 * intensity + 0.12 * pulse) + 0.45 * burst, 0, 1) * grow
		local transparency = 1 - visible
		local thicknessScale = 1 + 0.9 * intensity + 2.2 * burst
		local burstGrow = burstAge and (1 - math.exp(-burstAge * 6)) or 0
		local scale = radius * grow * (1 + 0.6 * burstGrow)

		local ringRadius = { scale, scale * 0.82, scale * 0.3 }
		local ringSpin = { spinB * 0.6, spinA, spinB * 2.2 }
		local triangleRadius = scale * 0.74

		for _, element in ipairs(elements) do
			local part = element.part
			local thickness = element.thickness * thicknessScale
			if element.kind == "dash" then
				local ringR = ringRadius[element.ring]
				local angle = ringSpin[element.ring] + element.angle
				local chord = math.max(2 * ringR * math.sin(math.pi / element.count) * element.fill, 0.05)
				part.Size = Vector3.new(chord, thickness, thickness)
				part.CFrame = frame * CFrame.Angles(0, 0, angle) * CFrame.new(ringR, 0, 0) * CFrame.Angles(0, 0, math.pi / 2)
			elseif element.kind == "edge" then
				local base = spinA * 0.5 + (element.triangle == 2 and math.pi / 3 or 0)
				local triR = triangleRadius * (1 + 0.025 * math.sin(elapsed * 11 + element.triangle * math.pi))
				local angleA = base + element.edge * math.pi * 2 / 3
				local angleB = base + (element.edge + 1) * math.pi * 2 / 3
				local pointA = Vector3.new(math.cos(angleA), math.sin(angleA), 0) * triR
				local pointB = Vector3.new(math.cos(angleB), math.sin(angleB), 0) * triR
				local middle = (pointA + pointB) / 2
				local delta = pointB - pointA
				part.Size = Vector3.new(delta.Magnitude + thickness, thickness, thickness)
				part.CFrame = frame * CFrame.new(middle.X, middle.Y, 0) * CFrame.Angles(0, 0, math.atan2(delta.Y, delta.X))
			else
				local angle = spinB * 0.5 + element.angle
				part.Size = Vector3.new(math.max(scale * 0.1, 0.05), thickness, thickness)
				part.CFrame = frame * CFrame.Angles(0, 0, angle) * CFrame.new(scale * 0.91, 0, 0)
			end
			part.Transparency = transparency
		end
	end, function()
		for _, element in ipairs(elements) do
			element.part:Destroy()
		end
	end)
	return sigil
end

-- spiked solar corona: tapered rays that rotate and breathe around a point
function FX.attack2Corona(stage, rayCount)
	local palette = VFX.palette
	local accent = FX.accent()
	local fullTurn = math.pi * 2
	local golden = math.pi * (3 - math.sqrt(5))
	local centerPart, centerAttachment = FX.node(stage)
	local rays = {}
	for index = 1, rayCount do
		local y = 1 - (index - 0.5) / rayCount * 2
		local flat = math.sqrt(math.max(1 - y * y, 0))
		local theta = golden * index
		local tipPart, tipAttachment = FX.node(stage)
		local color = index % 3 == 0 and palette.hot or (index % 3 == 1 and palette.bright or accent)
		local beam = FX.beam(stage, centerAttachment, tipAttachment, ColorSequence.new(color), 1, 0, NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.05),
			NumberSequenceKeypoint.new(1, 1),
		}), index % 2 == 0 and 0.02 or 0)
		rays[index] = {
			tip = tipPart,
			beam = beam,
			base = Vector3.new(math.cos(theta) * flat, y, math.sin(theta) * flat),
			axis = FX.randomUnit(),
			speed = FX.rng:NextNumber(0.6, 1.8) * (index % 2 == 0 and 1 or -1),
			phase = FX.rng:NextNumber(0, fullTurn),
			rate = FX.rng:NextNumber(4, 9),
			reach = FX.rng:NextNumber(0.7, 1.25),
		}
	end
	local corona = {}
	function corona.update(center, elapsed, intensity)
		centerPart.Position = center
		for _, ray in ipairs(rays) do
			local direction = CFrame.fromAxisAngle(ray.axis, ray.speed * elapsed):VectorToWorldSpace(ray.base)
			local flicker = 0.55 + 0.45 * math.abs(math.sin(elapsed * ray.rate + ray.phase))
			ray.tip.Position = center + direction * (2.4 + 5.2 * intensity) * ray.reach * flicker
			ray.beam.Width0 = (0.45 + 1.35 * intensity) * flicker
		end
	end
	function corona.destroy()
		centerPart:Destroy()
		for _, ray in ipairs(rays) do
			ray.tip:Destroy()
			ray.beam:Destroy()
		end
	end
	return corona
end

