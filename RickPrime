local function createGunPart(gunModel, handle, partName, partShape, partSize, partOffset, partColor, partMaterial)
	local isWedge = partShape == "Wedge"
	local gunPart = Instance.new(isWedge and "WedgePart" or "Part")
	gunPart.Name = partName
	if not isWedge then
		gunPart.Shape = partShape
	end
	gunPart.Size = partSize * GUN_SCALE
	gunPart.Color = partColor
	gunPart.Material = partMaterial
	gunPart.TopSurface = Enum.SurfaceType.Smooth
	gunPart.BottomSurface = Enum.SurfaceType.Smooth
	gunPart.Anchored = false
	gunPart.CanCollide = false
	gunPart.CanTouch = false
	gunPart.CanQuery = false
	gunPart.Massless = true

	local partWeld = Instance.new("Weld")
	partWeld.Name = partName .. "Weld"
	partWeld.Part0 = handle
	partWeld.Part1 = gunPart
	local shiftedOffset = GUN_ORIGIN_SHIFT * partOffset
	partWeld.C0 = CFrame.new(shiftedOffset.Position * GUN_SCALE) * shiftedOffset.Rotation
	partWeld.Parent = gunPart

	gunPart.Parent = gunModel
	return gunPart
end

local function wedgeRisesTowardPositiveZ()
	local probeSucceeded, risesTowardBack = pcall(function()
		local probeWedge = Instance.new("WedgePart")
		probeWedge.Size = Vector3.new(1, 1, 1)
		probeWedge.Anchored = true
		probeWedge.CanCollide = false
		probeWedge.CanQuery = true
		probeWedge.Transparency = 1
		probeWedge.CFrame = CFrame.new(0, 5000, 0)
		probeWedge.Parent = workspace

		local probeParams = RaycastParams.new()
		probeParams.FilterType = Enum.RaycastFilterType.Include
		probeParams.FilterDescendantsInstances = { probeWedge }

		local probeCenter = probeWedge.Position
		local backHit = workspace:Raycast(probeCenter + Vector3.new(0, 2, 0.4), Vector3.new(0, -4, 0), probeParams)
		local frontHit = workspace:Raycast(probeCenter + Vector3.new(0, 2, -0.4), Vector3.new(0, -4, 0), probeParams)
		probeWedge:Destroy()

		if not (backHit and frontHit) then
			return true
		end
		return backHit.Position.Y > frontHit.Position.Y
	end)
	return not probeSucceeded or risesTowardBack
end

