	local frame = FX.facing(floorHit.Position + Vector3.new(0, 0.12, 0), Vector3.yAxis)
	FX.shockRing(parent, frame, { startRadius = 1, endRadius = radius, duration = 0.35, thickness = 0.25, color = ELEC.cyan, segments = 36, startTransparency = 0.1 })
