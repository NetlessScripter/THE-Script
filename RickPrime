			trail = trail,
			tilt = CFrame.Angles(FX.rng:NextNumber(0, math.pi), FX.rng:NextNumber(0, fullTurn), 0),
			speed = (index % 2 == 0 and -1 or 1) * FX.rng:NextNumber(8, 13),
			radius = 3.4 + index * 0.9,
			phase = FX.rng:NextNumber(0, fullTurn),
		}
	end

	-- solar prominences: arched beams that flick in and out around the core
	local loops = {}
	for index = 1, 5 do
		local nodeA, attachmentA = FX.node(stage)
		local nodeB, attachmentB = FX.node(stage)
		local beam = FX.beam(stage, attachmentA, attachmentB, ColorSequence.new({
			ColorSequenceKeypoint.new(0, palette.hot),
			ColorSequenceKeypoint.new(0.5, accent),
			ColorSequenceKeypoint.new(1, palette.red),
		}), 0.3, 0.3, NumberSequence.new(1), 0.03)
		beam.Segments = 16
		loops[index] = { nodeA = nodeA, nodeB = nodeB, beam = beam, born = -1, life = 0.2, u = Vector3.yAxis, v = Vector3.xAxis, bulge = 3 }
	end

	-- closing vortex cage
	local cage = {}
	for index = 1, 6 do
		local footPart, footAttachment = FX.node(stage)
		local apexPart, apexAttachment = FX.node(stage)
		local beam = FX.beam(stage, footAttachment, apexAttachment, ColorSequence.new({
			ColorSequenceKeypoint.new(0, palette.red),
			ColorSequenceKeypoint.new(0.55, palette.bright),
			ColorSequenceKeypoint.new(1, palette.hot),
		}), 0.5, 0.06, NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.45),
			NumberSequenceKeypoint.new(1, 0.1),
		}), 0)
		beam.Segments = 20
		cage[index] = { foot = footPart, apex = apexPart, beam = beam }
	end

	-- embers rising off the floor
	local emberPart = FX.part(stage, Enum.PartType.Block, palette.hot, 1, Vector3.new(7, 0.2, 7), floorFrame)
	local embers = Instance.new("ParticleEmitter")
	embers.Rate = 55
	embers.LightEmission = 1
	embers.LightInfluence = 0
	embers.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, palette.hot),
		ColorSequenceKeypoint.new(0.4, accent),
		ColorSequenceKeypoint.new(1, palette.deep),
	})
	embers.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) })
	embers.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(0.7, 0.3),
		NumberSequenceKeypoint.new(1, 1),
	})
	embers.Lifetime = NumberRange.new(0.9, 1.7)
	embers.Speed = NumberRange.new(3, 9)
	embers.SpreadAngle = Vector2.new(25, 25)
	embers.EmissionDirection = Enum.NormalId.Front
	embers.Acceleration = Vector3.new(0, 12, 0)
	embers.Drag = 0.6
	embers.Rotation = NumberRange.new(0, 360)
	embers.RotSpeed = NumberRange.new(-120, 120)
	embers.Parent = emberPart

	local nextFloor, nextSpark, nextStar, nextBeat, nextRing = 0, 0, 0, 0, 0
	local ringFlip = false

	FX.run(stage, duration, function(alpha, elapsed)
		if targetRoot.Parent then
			lastPosition = targetRoot.Position
		end

		if elapsed >= nextFloor then
			nextFloor = elapsed + 0.1
			floorFrame = FX.floorFrameAt(lastPosition, floorIgnore, 0.12)
		end
		local groundFrame = floorFrame.Rotation + Vector3.new(lastPosition.X, floorFrame.Position.Y, lastPosition.Z)
		sigil.frame = groundFrame
		sigil.intensity = alpha
		emberPart.CFrame = groundFrame

		local pulse = 0.5 + 0.5 * math.sin(elapsed * (10 + 14 * alpha))
		local centerFrame = CFrame.new(lastPosition)

		-- core + force field shell
		local coreSize = (1 + 3.4 * alpha ^ 1.4) * (1 + 0.1 * math.sin(elapsed * 53) + 0.06 * math.sin(elapsed * 89))
		core.Size = Vector3.one * coreSize
		core.CFrame = centerFrame
		shell.Size = Vector3.one * coreSize * 1.9
		shell.CFrame = centerFrame * CFrame.Angles(elapsed * 1.3, elapsed * 0.9, 0)
		shell.Transparency = 0.5 + 0.2 * (1 - pulse)
		light.Brightness = 3 + 7 * alpha

		corona.update(lastPosition, elapsed, alpha)

		-- orbit ribbons
		for _, orbiter in ipairs(orbiters) do
			local angle = orbiter.phase + orbiter.speed * elapsed
			local radius = orbiter.radius * (1 - 0.25 * alpha) * (1 + 0.1 * math.sin(elapsed * 7 + orbiter.phase))
			local offset = orbiter.tilt:VectorToWorldSpace(Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius))
			orbiter.head.CFrame = CFrame.new(lastPosition + offset)
			orbiter.trail.Enabled = true
		end

		-- prominences
		for _, loop in ipairs(loops) do
			if elapsed >= loop.born + loop.life then
				loop.born = elapsed + FX.rng:NextNumber(0, 0.08)
				loop.life = FX.rng:NextNumber(0.14, 0.26)
				loop.u = FX.randomUnit()
				local axis = loop.u:Cross(FX.randomUnit())
				if axis.Magnitude < 0.1 then
					axis = Vector3.yAxis
				end
				loop.v = CFrame.fromAxisAngle(axis.Unit, math.rad(FX.rng:NextNumber(45, 90))):VectorToWorldSpace(loop.u)
				loop.bulge = FX.rng:NextNumber(2.5, 5)
			end
			local age = (elapsed - loop.born) / loop.life
			if age < 0 or age > 1 then
				loop.beam.Width0 = 0
				loop.beam.Width1 = 0
			else
				local envelope = math.sin(math.pi * age)
				local radius = 1.6 + 1.8 * alpha + 0.4 * coreSize
				loop.nodeA.CFrame = FX.axisFrame(lastPosition + loop.u * radius, loop.u)
				loop.nodeB.CFrame = FX.axisFrame(lastPosition + loop.v * radius, loop.v)
				loop.beam.CurveSize0 = loop.bulge * envelope
				loop.beam.CurveSize1 = loop.bulge * envelope
				local width = (0.28 + 0.2 * alpha) * envelope
				loop.beam.Width0 = width
				loop.beam.Width1 = width
				loop.beam.Transparency = NumberSequence.new(1 - 0.9 * envelope)
			end
		end

		-- vortex cage
		local cageVisible = math.clamp(elapsed / 0.2, 0, 1) * (0.85 + 0.15 * pulse)
		local floorY = groundFrame.Position.Y
		for index, strand in ipairs(cage) do
			local angle = elapsed * (0.9 + 1.4 * alpha) + (index - 1) * math.pi / 3
			local radial = Vector3.new(math.cos(angle), 0, math.sin(angle))
			local tangent = Vector3.new(-math.sin(angle), 0, math.cos(angle))
			local footPosition = Vector3.new(lastPosition.X, floorY, lastPosition.Z) + radial * sigilRadius * 0.85 * (1 - 0.4 * alpha)
			local apexPosition = lastPosition + Vector3.new(0, 15 - 7 * alpha, 0)
			strand.foot.CFrame = FX.axisFrame(footPosition, tangent)
			strand.apex.CFrame = FX.axisFrame(apexPosition, tangent)
			local bow = 3.4 * (1 - 0.55 * alpha)
			strand.beam.CurveSize0 = bow
			strand.beam.CurveSize1 = bow
			strand.beam.Width0 = 0.5 * cageVisible
			strand.beam.Width1 = 0.07 * cageVisible
		end

		-- target mark pulse
		highlight.FillTransparency = 0.8 - 0.3 * pulse * (0.4 + alpha)
		highlight.OutlineColor = palette.bright:Lerp(palette.hot, pulse)

		-- stars + sparks + floor beat rings
		if elapsed >= nextStar then
			nextStar = elapsed + 0.11
			FX.star(stage, lastPosition, 6 + 12 * alpha, 0.16, palette.bright)
		end
		if elapsed >= nextSpark then
			nextSpark = elapsed + 0.08
			FX.emitAt(stage, CFrame.new(lastPosition), 6, {
				speed = NumberRange.new(18, 50),
				spread = Vector2.new(180, 180),
				lifetime = NumberRange.new(0.15, 0.4),
				size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.34), NumberSequenceKeypoint.new(1, 0) }),
				color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, palette.hot),
					ColorSequenceKeypoint.new(0.4, accent),
					ColorSequenceKeypoint.new(1, palette.deep),
				}),
				acceleration = Vector3.new(0, -40, 0),
				drag = 2,
			})
		end
		if elapsed >= nextRing then
			nextRing = elapsed + 0.39
			ringFlip = not ringFlip
			FX.dashRing(stage, groundFrame, {
				count = 34,
				color = ringFlip and palette.hot or palette.red,
				startRadius = 1.5,
				endRadius = 9 + 7 * alpha,
				duration = 0.5,
				thickness = 0.28,
				spin = ringFlip and 1.8 or -1.8,
				fill = 0.6,
			})
		end

		if screen then
			screen.setCharge(alpha)
		end
		if a2screen and elapsed >= nextBeat then
			nextBeat = elapsed + 0.2
			a2screen.beat(0.35 + 0.4 * alpha)
		end
	end, function()
		core:Destroy()
		shell:Destroy()
		highlight:Destroy()
		corona.destroy()
		embers.Enabled = false
		Debris:AddItem(emberPart, 1.8)
		for _, orbiter in ipairs(orbiters) do
			orbiter.head:Destroy()
		end
		for _, loop in ipairs(loops) do
			loop.nodeA:Destroy()
			loop.nodeB:Destroy()
			loop.beam:Destroy()
		end
		for _, strand in ipairs(cage) do
			strand.foot:Destroy()
			strand.apex:Destroy()
			strand.beam:Destroy()
		end
	end)

	return { sigil = sigil }
end

-- the detonation: lens star, solar flares, light column, climbing rings, floor fissures
function FX.attack2Finale(stage, targetRoot, screen, handle, a2screen)
	if not (stage.Parent and targetRoot and targetRoot.Parent) then
		return
	end
	local palette = VFX.palette
	local accent = FX.accent()
	local position = targetRoot.Position
	local floorFrame = FX.floorFrameAt(position, FX.ignoreList(stage, targetRoot.Parent), 0.15)
	local floorPosition = floorFrame.Position

	if handle and handle.sigil then
		handle.sigil.burstAt = os.clock()
	end

	-- instant flash: stars, white ball, crimson ball, force field shock sphere
	FX.star(stage, position, 46, 0.5, Color3.new(1, 1, 1))
	FX.star(stage, position, 26, 0.36, palette.bright)
	local whiteBall = FX.part(stage, Enum.PartType.Ball, Color3.new(1, 1, 1), 0, Vector3.one * 3, CFrame.new(position))
	FX.tween(whiteBall, 0.32, { Size = Vector3.one * 24, Transparency = 1 })
	local crimsonBall = FX.part(stage, Enum.PartType.Ball, palette.red, 0.3, Vector3.one * 4, CFrame.new(position))
	FX.tween(crimsonBall, 0.5, { Size = Vector3.one * 38, Transparency = 1 })
	local shockSphere = FX.part(stage, Enum.PartType.Ball, palette.bright, 0.25, Vector3.one * 4, CFrame.new(position))
	shockSphere.Material = Enum.Material.ForceField
	FX.tween(shockSphere, 0.75, { Size = Vector3.one * 52, Transparency = 1 }, Enum.EasingStyle.Cubic)

	local light = Instance.new("PointLight")
	light.Color = palette.bright
	light.Range = 80
	light.Brightness = 16
	light.Shadows = false
	light.Parent = whiteBall
	FX.tween(light, 0.8, { Brightness = 0 })

	-- solar flares: tapered spikes thrown out in every direction
	local flareCenter, flareCenterAttachment = FX.node(stage)
	flareCenter.Position = position
	local flares = {}
	for index = 1, 26 do
		local tipPart, tipAttachment = FX.node(stage)
		local color = index % 3 == 0 and palette.hot or (index % 3 == 1 and palette.bright or accent)
		flares[index] = {
			tip = tipPart,
			beam = FX.beam(stage, flareCenterAttachment, tipAttachment, ColorSequence.new(color), 2.4, 0, NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 0.7),
			}), index % 2 == 0 and 0.02 or 0),
			direction = FX.randomUnit(-0.35, 1),
			length = FX.rng:NextNumber(20, 46) * (index <= 8 and 1.25 or 1),
			spin = FX.rng:NextNumber(-0.7, 0.7),
		}
	end
	FX.run(stage, 0.6, function(alpha, elapsed)
		local grow = 1 - (1 - math.clamp(elapsed / 0.16, 0, 1)) ^ 3
		for _, flare in ipairs(flares) do
			local direction = CFrame.fromAxisAngle(Vector3.yAxis, flare.spin * elapsed):VectorToWorldSpace(flare.direction)
			flare.tip.Position = position + direction * flare.length * grow
			flare.beam.Width0 = 2.4 * (1 - alpha) ^ 1.5
			flare.beam.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, alpha ^ 3),
				NumberSequenceKeypoint.new(1, math.min(0.7 + 0.3 * alpha, 1)),
			})
		end
	end, function()
		flareCenter:Destroy()
		for _, flare in ipairs(flares) do
			flare.tip:Destroy()
			flare.beam:Destroy()
		end
	end)

	-- light column
	local columnHeight = 130
	local columnFrame = CFrame.new(position + Vector3.new(0, columnHeight / 2 - 4, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	local column = FX.part(stage, Enum.PartType.Cylinder, palette.bright, 0.15, Vector3.new(columnHeight, 9, 9), columnFrame)
	FX.tween(column, 0.55, { Size = Vector3.new(columnHeight, 0.5, 0.5), Transparency = 1 }, Enum.EasingStyle.Cubic)
	local columnCore = FX.part(stage, Enum.PartType.Cylinder, palette.hot, 0, Vector3.new(columnHeight, 3.2, 3.2), columnFrame)
	FX.tween(columnCore, 0.9, { Size = Vector3.new(columnHeight, 0.08, 0.08), Transparency = 1 }, Enum.EasingStyle.Quart)

	-- rings climbing the column
	for step = 0, 6 do
		task.delay(step * 0.035, function()
			if not stage.Parent then
				return
			end
			FX.shockRing(stage, FX.facing(position + Vector3.new(0, step * 6 - 2, 0), Vector3.yAxis), {
				startRadius = 1.5,
				endRadius = 8 + step * 0.8,
				duration = 0.45,
				thickness = math.max(0.42 - step * 0.03, 0.15),
				color = step % 2 == 0 and palette.hot or palette.bright,
				segments = 24,
				startTransparency = 0.05,
			})
		end)
	end

	-- floor: dashed shock waves + fissures
	FX.dashRing(stage, floorFrame, { count = 52, color = palette.red, startRadius = 2, endRadius = 46, duration = 0.75, thickness = 0.9, spin = 2.2, fill = 0.62 })
	FX.dashRing(stage, floorFrame, { count = 40, color = palette.hot, startRadius = 1.5, endRadius = 30, duration = 0.5, thickness = 0.55, spin = -2.6, fill = 0.55 })
	FX.dashRing(stage, floorFrame, { count = 30, color = accent, startRadius = 1, endRadius = 18, duration = 0.38, thickness = 0.4, spin = 3.1, fill = 0.5 })
	FX.groundCracks(stage, floorFrame, 11, 16, 34)

	-- sparks, embers, smoke
	FX.sparkField(stage, position, {
		count = 70,
		speedMin = 45,
		speedMax = 150,
		lifeMin = 0.45,
		lifeMax = 1,
		gravity = 70,
		thickness = 0.2,
		length = 0.05,
		minY = -0.2,
		maxY = 1,
	})
	FX.sparkField(stage, floorPosition + Vector3.new(0, 0.4, 0), {
		count = 40,
		speedMin = 20,
		speedMax = 70,
		lifeMin = 0.4,
		lifeMax = 0.9,
		gravity = 40,
		direction = Vector3.yAxis,
		spread = 0.9,
	})
	FX.emitAt(stage, CFrame.new(position), 90, {
		speed = NumberRange.new(18, 60),
		spread = Vector2.new(180, 180),
		lifetime = NumberRange.new(0.8, 1.7),
		size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) }),
		color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, palette.hot),
			ColorSequenceKeypoint.new(0.4, accent),
			ColorSequenceKeypoint.new(1, palette.deep),
		}),
		acceleration = Vector3.new(0, 8, 0),
		drag = 3.2,
	})
	FX.emitAt(stage, FX.facing(floorPosition + Vector3.new(0, 1, 0), Vector3.yAxis), 16, {
		texture = "rbxasset://textures/particles/smoke_main.dds",
		lightEmission = 0.15,
		speed = NumberRange.new(10, 26),
		spread = Vector2.new(85, 85),
		lifetime = NumberRange.new(1.1, 1.8),
		size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 18) }),
		transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.35),
			NumberSequenceKeypoint.new(0.5, 0.6),
			NumberSequenceKeypoint.new(1, 1),
		}),
		color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(70, 8, 18)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(24, 12, 16)),
		}),
		acceleration = Vector3.new(0, 2, 0),
		drag = 2.5,
	})

	if screen then
		screen.flash(0.9, 0.4, palette.hot, 28)
		screen.speedLines()
		screen.release()
	end
	if a2screen then
		a2screen.finale()
	end
end

local ATTACK2_FOLLOW_START = 0.2
local ATTACK2_FOLLOW_END = 1.7
local ATTACK2_GUN_KICK_SCALE = 1.1
local ATTACK2_CLONE_LINGER = 0.6
local ATTACK2_GUN_FIRE_START = ATTACK2_FIRE_START
local ATTACK2_GUN_FIRE_END = ATTACK2_FIRE_END - 0.1
local ATTACK2_GUN_SHOT_INTERVAL = 0.02
local ATTACK2_GUN_SPREAD = 5.5
local ATTACK2_GUN_BEAM = { widthScale = 1.0, travelTime = 0.04, holdTime = 0.06, fadeTime = 0.12 }

local function startAttack2Clone(character, rootPart, getTargetRoot, stage)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return function() end
	end

	character.Archivable = true
	local clone = character:Clone()
	if not clone then
		return function() end
	end
	clone.Name = "RickPrimeClone"
	for _, descendant in ipairs(clone:GetDescendants()) do
		if descendant:IsA("LuaSourceContainer") then
			descendant:Destroy()
		end
	end
	local cloneHumanoid = clone:FindFirstChildOfClass("Humanoid")
	local cloneRoot = clone:FindFirstChild("HumanoidRootPart")
	if not cloneHumanoid or not cloneRoot then
		clone:Destroy()
		return function() end
	end
	cloneHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	cloneRoot.Anchored = true
	local cloneArm = clone:FindFirstChild("Left Arm")
	if cloneArm then
		for _, leftoverName in ipairs({ GUN_MODEL_NAME, WELD_NAME, LEGACY_WIELD_NAME }) do
			local leftoverInstance = cloneArm:FindFirstChild(leftoverName)
			if leftoverInstance then
				leftoverInstance:Destroy()
			end
		end
	end
	clone.Parent = workspace
	clone:PivotTo(rootPart.CFrame)
	local cloneBasePosition = cloneRoot.Position

	local gunModel = cloneArm and attachGun(cloneArm)
	local gunWeld = cloneArm and cloneArm:FindFirstChild(WELD_NAME)
	local gunBaseC0 = gunWeld and gunWeld.C0
	local cloneGunTrack
	if cloneHumanoid:FindFirstChildOfClass("Animator") then
		cloneGunTrack = playGunAnimation(cloneHumanoid)
	end
	local lastShotTime
	local gunKickConnection = RunService.PreRender:Connect(function()
		if not (gunWeld and gunWeld.Parent and lastShotTime) then return end
		local age = os.clock() - lastShotTime
		local rise = 1 - math.exp(-age * 90)
		gunWeld.C0 = gunBaseC0
			* CFrame.new(0, 0, VFX.gunKickBack * ATTACK2_GUN_KICK_SCALE * math.exp(-age * 11) * rise)
			* CFrame.Angles(VFX.gunKickPitch * ATTACK2_GUN_KICK_SCALE * math.exp(-age * 6.5) * rise, 0, 0)
	end)
	local function markGunShot()
		lastShotTime = os.clock()
	end

	local savedDisplayDistance = humanoid.DisplayDistanceType
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	local finished = false

	local function faceCloneAtTarget()
		local targetRoot = getTargetRoot()
		if targetRoot and targetRoot.Parent and clone.Parent then
			local targetPosition = targetRoot.Position
			local flatTarget = Vector3.new(targetPosition.X, cloneBasePosition.Y, targetPosition.Z)
			if (flatTarget - cloneBasePosition).Magnitude > 0.01 then
				local recoil = lastShotTime and 0.55 * math.exp(-(os.clock() - lastShotTime) * 16) or 0
				clone:PivotTo(CFrame.lookAt(cloneBasePosition, flatTarget)
					* CFrame.new(FX.rng:NextNumber(-1, 1) * recoil * 0.25, 0, recoil))
			end
		end
	end

	local function updateClone()
		faceCloneAtTarget()
	end
	updateClone()
	local restoreHide = FX.hideCharacter(character)
	pcall(FX.attack2CloneAura, stage, clone, cloneRoot, cloneBasePosition, gunModel, ATTACK2_FOLLOW_END)
	local cloneUpdateConnection = RunService.Heartbeat:Connect(updateClone)
	local cloneFaceConnection = RunService.PreRender:Connect(faceCloneAtTarget)

	local camera = workspace.CurrentCamera
	local savedCameraType, savedFov, savedCameraCFrame, cameraRig
	local cameraBindName = "RickPrimeAttack2Cam" .. tostring(os.clock())
	local cameraOk, cameraError = pcall(function()
		savedCameraType = camera.CameraType
		savedFov = camera.FieldOfView
		savedCameraCFrame = camera.CFrame
		camera.CameraType = Enum.CameraType.Scriptable
		local baseCameraCFrame = camera.CFrame
		local focus = cloneBasePosition + Vector3.new(0, 1.5, 0)
		local toFocus = focus - baseCameraCFrame.Position
		local aimRoot = getTargetRoot()
		local awayFromTarget = aimRoot and Vector3.new(cloneBasePosition.X - aimRoot.Position.X, 0, cloneBasePosition.Z - aimRoot.Position.Z) or Vector3.zero
		awayFromTarget = awayFromTarget.Magnitude > 0.05 and awayFromTarget.Unit or -rootPart.CFrame.LookVector
		if toFocus.Magnitude < 5 then
			baseCameraCFrame = CFrame.lookAt(focus + awayFromTarget * 9 + Vector3.new(0, 1.5, 0), focus)
		elseif baseCameraCFrame.LookVector:Dot(toFocus.Unit) < 0.8 then
			baseCameraCFrame = CFrame.lookAt(baseCameraCFrame.Position, focus)
		end
		cameraRig = FX.camera(cameraBindName, camera, baseCameraCFrame, savedFov, os.clock(), ATTACK2_CHARGE_TIME)
	end)
	if not cameraOk then
		warn("[Attack2] camera error:", cameraError)
		cameraRig = nil
		if camera and savedCameraType then
			camera.CameraType = savedCameraType
		end
	end

	local cameraReleased = false
	local function releaseCamera(restoreFrame)
		if cameraReleased then return end
		cameraReleased = true
		if not cameraOk then return end
		pcall(function()
			RunService:UnbindFromRenderStep(cameraBindName)
		end)
		camera.FieldOfView = savedFov
		camera.CameraType = savedCameraType
		if restoreFrame and savedCameraCFrame then
			camera.CFrame = savedCameraCFrame
		end
	end

	local gunIgnoreList = FX.ignoreList(stage, clone, character)
	local function shootGun(shotTargetRoot, isOpener)
		if finished or not (gunModel and gunModel.Parent and shotTargetRoot and shotTargetRoot.Parent) then
			return
		end
		markGunShot()
		local shotWidth = isOpener and 1 or ATTACK2_GUN_BEAM.widthScale * FX.rng:NextNumber(0.8, 1.5)
		local function muzzleFx(owner, origin, direction, palette)
			FX.attack2GunMuzzle(owner, origin, direction, palette, isOpener)
		end
		local function impactFx(owner, position, direction, palette)
			FX.attack2GunImpact(owner, position, direction, palette, isOpener)
		end
		local function beamFx(folder, attachment0, attachment1)
			return FX.attack2Braid(folder, attachment0, attachment1, shotWidth, 1.3)
		end
		local context
		if isOpener then
			context = {
				stage = stage,
				ignore = FX.ignoreList(stage, clone, character, shotTargetRoot.Parent),
				feetPosition = cloneBasePosition,
				muzzleFx = muzzleFx,
				impactFx = impactFx,
				beamFx = beamFx,
				onImpact = function()
					if cameraRig then
						cameraRig.impact()
					end
				end,
			}
			if cameraRig then
				cameraRig.fire()
			end
		else
			local spread = ATTACK2_GUN_SPREAD
			context = {
				stage = stage,
				ignore = gunIgnoreList,
				lite = true,
				aimOffset = Vector3.new(FX.rng:NextNumber(-spread, spread), FX.rng:NextNumber(-spread, spread), FX.rng:NextNumber(-spread, spread)),
				widthScale = shotWidth,
				travelTime = ATTACK2_GUN_BEAM.travelTime,
				holdTime = ATTACK2_GUN_BEAM.holdTime,
				fadeTime = ATTACK2_GUN_BEAM.fadeTime,
				muzzleFx = muzzleFx,
				impactFx = impactFx,
				beamFx = beamFx,
			}
		end
		pcall(fireBeam, gunModel, function() end, shotTargetRoot, context)
	end

	local lockConnections = {}
	local savedAutoRotate = humanoid.AutoRotate
	local lockDirection

	local function stopLock()
		for _, lockConnection in ipairs(lockConnections) do
			lockConnection:Disconnect()
		end
		table.clear(lockConnections)
	end

	local function pickLockDirection(targetRoot)
		local targetPosition = targetRoot.Position
		local myPosition = rootPart.Position
		local approach = Vector3.new(targetPosition.X - myPosition.X, 0, targetPosition.Z - myPosition.Z)
		if approach.Magnitude > 0.01 then
			lockDirection = approach.Unit
		else
			local look = targetRoot.CFrame.LookVector
			local flatLook = Vector3.new(look.X, 0, look.Z)
			lockDirection = flatLook.Magnitude > 0.01 and -flatLook.Unit or Vector3.new(0, 0, 1)
		end
	end

	local function lockBehindTarget()
		if finished then return end
		if not rootPart.Parent then
			stopLock()
			return
		end
		local targetRoot = getTargetRoot()
		if not (targetRoot and targetRoot.Parent and lockDirection) then return end

		local targetPosition = targetRoot.Position
		local anchorPosition = targetPosition
		if LOCK_PREDICT_LATENCY then
			local leadTime = math.clamp(localPlayer:GetNetworkPing(), 0, LOCK_MAX_PREDICT_TIME)
			local lead = targetRoot.AssemblyLinearVelocity * leadTime
			if lead.Magnitude > LOCK_MAX_LEAD then
				lead = lead.Unit * LOCK_MAX_LEAD
			end
			anchorPosition = targetPosition + lead
		end

		local behindPosition = anchorPosition + lockDirection * BEHIND_DISTANCE
		local facePoint = Vector3.new(targetPosition.X, behindPosition.Y, targetPosition.Z)
		if (facePoint - behindPosition).Magnitude < 0.01 then
			facePoint = behindPosition - lockDirection
		end

		rootPart.CFrame = CFrame.lookAt(behindPosition, facePoint)
		rootPart.AssemblyLinearVelocity = Vector3.zero
		rootPart.AssemblyAngularVelocity = Vector3.zero
	end

	task.delay(ATTACK2_FOLLOW_START, function()
		if finished or not clone.Parent then return end
		local targetRoot = getTargetRoot()
		if not (targetRoot and targetRoot.Parent) then return end
		humanoid.AutoRotate = false
		pickLockDirection(targetRoot)
		lockBehindTarget()
		table.insert(lockConnections, RunService.PreSimulation:Connect(lockBehindTarget))
		table.insert(lockConnections, RunService.Heartbeat:Connect(lockBehindTarget))
		table.insert(lockConnections, RunService.PreRender:Connect(lockBehindTarget))
	end)

	local function cleanup()
		if finished then return end
		finished = true
		cloneUpdateConnection:Disconnect()
		cloneFaceConnection:Disconnect()
		gunKickConnection:Disconnect()
		stopLock()
		humanoid.AutoRotate = savedAutoRotate

		local gunTimePosition = cloneGunTrack and cloneGunTrack.TimePosition or ANIMATION_PAUSE_TIME
		if rootPart.Parent and humanoid.Health > 0 then
			rootPart.CFrame = CFrame.new(cloneBasePosition) * clone:GetPivot().Rotation
			rootPart.AssemblyLinearVelocity = Vector3.zero
			rootPart.AssemblyAngularVelocity = Vector3.zero
		end

		restoreHide()
		releaseCamera()
		humanoid.DisplayDistanceType = savedDisplayDistance
		clone:Destroy()

		if humanoid.Health > 0 then
			local animator = humanoid:FindFirstChildOfClass("Animator")
			if animator then
				for _, playingTrack in ipairs(animator:GetPlayingAnimationTracks()) do
					if playingTrack.Animation and playingTrack.Animation.AnimationId == GUN_ANIMATION_ID then
						playingTrack:Stop(0)
					end
				end
			end
			resumeGunAnimation(humanoid, gunTimePosition)
		end
	end

	return cleanup, shootGun, releaseCamera
end

local function runAttack2(character, root)
	if attack2Running then return end
	local targetRoot = getClosestTargetRoot(root.Position)
	if not targetRoot then return end
	if not MOVES.tryStart("attack2") then return end
	attack2Running = true

	local stage = Instance.new("Folder")
	stage.Name = "DroneAttack2Stage"
	stage.Parent = workspace
	Debris:AddItem(stage, ATTACK2_STAGE_LIFETIME)

	local cloneOk, returnToPlayer, shootGun, releaseCloneCamera = pcall(startAttack2Clone, character, root, function()
		return targetRoot
	end, stage)
	if not cloneOk then
		warn("[Attack2] clone error:", returnToPlayer)
		returnToPlayer = function() end
		shootGun = nil
		releaseCloneCamera = nil
	end
	local attack2Finished = false
	local function finishAttack2()
		if attack2Finished then return end
		attack2Finished = true
		returnToPlayer()
		FX.releaseAttack2Camera = function() end
		attack2Running = false
		MOVES.finish("attack2")
	end
	task.delay(ATTACK2_FOLLOW_END, finishAttack2)

	local shakeOk, cancelShake = pcall(FX.attack2Shake)
	local screenOk, screenFx = pcall(FX.screen, workspace.CurrentCamera)
	if not screenOk then
		screenFx = nil
	end
	local a2screenOk, a2screen = pcall(FX.attack2Screen, workspace.CurrentCamera)
	if not a2screenOk then
		warn("[Attack2] screen error:", a2screen)
		a2screen = nil
	end
	FX.releaseAttack2Camera = function()
		if releaseCloneCamera then
			pcall(releaseCloneCamera, true)
		end
		if shakeOk and cancelShake then
			cancelShake()
		end
		if screenFx then
			pcall(screenFx.destroy)
		end
		if a2screen then
			pcall(a2screen.destroy)
		end
	end

	local chargeOk, chargeError = pcall(function()
		FX.attack2Charge(-1, targetRoot, stage, ATTACK2_CHARGE_TIME)
		FX.attack2Charge(1, targetRoot, stage, ATTACK2_CHARGE_TIME)
	end)
	if not chargeOk then
		warn("[Attack2] charge error:", chargeError)
	end

	local pressureOk, pressureHandle = pcall(FX.attack2Pressure, stage, targetRoot, ATTACK2_FIRE_END - ATTACK2_FINALE_LEAD, screenFx, a2screen)
	if not pressureOk then
		warn("[Attack2] pressure error:", pressureHandle)
		pressureHandle = nil
	end
	task.delay(ATTACK2_FIRE_END - ATTACK2_FINALE_LEAD, function()
		local finaleOk, finaleError = pcall(FX.attack2Finale, stage, targetRoot, screenFx, pressureHandle, a2screen)
		if not finaleOk then
			warn("[Attack2] finale error:", finaleError)
		end
	end)
	task.delay(ATTACK2_FIRE_END + 1, function()
		if screenFx then
			pcall(screenFx.destroy)
		end
	end)
	task.delay(ATTACK2_FIRE_END + 1.7, function()
		if a2screen then
			pcall(a2screen.destroy)
		end
	end)

	task.spawn(function()
		local startClock = os.clock()
		local shotTime = ATTACK2_FIRE_START
		local volley = 0
		while shotTime < ATTACK2_FIRE_END - 0.001 do
			local waitTime = startClock + shotTime - os.clock()
			if waitTime > 0 then
				task.wait(waitTime)
			end
			if not stage.Parent or not character.Parent then break end
			if not targetRoot.Parent then
				targetRoot = getClosestTargetRoot(root.Position)
				if not targetRoot then break end
			end
			volley += 1
			if a2screen and volley % 2 == 1 then
				a2screen.beat(0.32)
			end
			for _ = 1, ATTACK2_DRONE_BURST do
				pcall(FX.attack2Ray, -1, targetRoot, stage)
				pcall(FX.attack2Ray, 1, targetRoot, stage)
			end
			shotTime += ATTACK2_SHOT_INTERVAL
		end
		if shotTime < ATTACK2_FIRE_END - 0.001 then
			finishAttack2()
		end
	end)

	if shootGun then
		task.spawn(function()
			local gunStartClock = os.clock()
			local shotTime = ATTACK2_GUN_FIRE_START
			local round = 0
			while shotTime < ATTACK2_GUN_FIRE_END - 0.001 do
				local waitTime = gunStartClock + shotTime - os.clock()
				if waitTime > 0 then
					task.wait(waitTime)
				end
				if attack2Finished or not stage.Parent or not character.Parent then break end
				if targetRoot and targetRoot.Parent then
					round += 1
					shootGun(targetRoot, round == 1)
				end
				shotTime += ATTACK2_GUN_SHOT_INTERVAL
			end
		end)
	end
end

local function spawnHitbox(root, character, onHit)
	local overlapParams = OverlapParams.new()
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude
	overlapParams.FilterDescendantsInstances = { character }

	local startedAt = os.clock()
	local connection
	connection = RunService.Heartbeat:Connect(function()
		if not root.Parent or os.clock() - startedAt > M1.hitWindow then
			connection:Disconnect()
			return
		end
		local ok, victim = pcall(M1.findVictim, root, character, overlapParams)
		if not ok then
			warn("[RickPrime M1] hit detection failed: " .. tostring(victim))
			connection:Disconnect()
			return
		end
		if victim then
			connection:Disconnect()
			onHit(victim)
		end
	end)
end

local function hookCharacter(character)
	local humanoid = character:WaitForChild("Humanoid")
	local root = character:WaitForChild("HumanoidRootPart")
	humanoid.AnimationPlayed:Connect(function(track)
		if ownTracks[track] then return end
		local id = track.Animation and track.Animation.AnimationId
		if id and string.find(id, TRIGGER_ANIM_IDS.ATTACK2, 1, true) then
			if MOVES.armed() then
				runAttack2(character, root)
			end
			return
		end

		local replacement = COMBO_ANIMS[id]
		if not replacement then return end

		local comboTrack = track
		if replacement ~= id then
			track:Stop(M1.crossFade)
			local anim = Instance.new("Animation")
			anim.AnimationId = replacement
			local newTrack = humanoid:LoadAnimation(anim)
			ownTracks[newTrack] = true
			newTrack:Play(M1.crossFade)
			comboTrack = newTrack
		end
		M1.smoothEnd(comboTrack)

		local power = COMBO_POWER[id] or 1
		spawnHitbox(root, character, function(hitModel)
			local targetRoot = hitModel:FindFirstChild("HumanoidRootPart")
			if not targetRoot then return end
			local stage = Instance.new("Folder")
			stage.Name = "DroneHitStage"
			stage.Parent = workspace
			Debris:AddItem(stage, 2.5)

			local leftArm = character:FindFirstChild("Left Arm")
			local gunModel = GUN_BEAM_COMBO_IDS[id] and leftArm and leftArm:FindFirstChild(GUN_MODEL_NAME)
			if GUN_BEAM_COMBO_IDS[id] then
				if gunModel then
					M1.guard("gun charge", chargeGunM1, gunModel, targetRoot, stage, DRONE_HIT_DELAY, M1.gunCharge)
				else
					warn("[RickPrime M1] 4th hit: no " .. GUN_MODEL_NAME .. " on the left arm, so there is no gun shot")
				end
			else
				if not findDroneRig(COMBO_SIDE[id]) then
					warn("[RickPrime M1] no drone on side " .. tostring(COMBO_SIDE[id]) .. " (still warping in, or hidden)")
				end
				M1.guard("drone charge", chargeDroneM1, COMBO_SIDE[id], targetRoot, stage, DRONE_HIT_DELAY, power)
			end

			task.delay(DRONE_HIT_DELAY, function()
				if not targetRoot.Parent then return end
				if GUN_BEAM_COMBO_IDS[id] then
					if gunModel and gunModel.Parent then
						local ignoreList = FX.ignoreList(stage, character, hitModel)
						local comboShake = FX.comboShake(GUN_SHAKE_DURATION)
						local gunShotContext = {
							stage = stage,
							ignore = ignoreList,
							feetPosition = root.Position,
							onImpact = comboShake.impact,
							calm = true,
							travelTime = M1.gunTravel,
							holdTime = M1.gunHold,
							fadeTime = M1.gunFade,
							muzzleFx = function(fxStage, origin, direction, palette)
								FX.m1GunMuzzle(fxStage, origin, direction, palette, root.Position, ignoreList)
							end,
							impactFx = function(fxStage, position, direction, palette)
								FX.m1GunImpact(fxStage, position, direction, palette, hitModel, ignoreList)
							end,
						}
						comboShake.fire()
						M1.guard("gun beam", fireBeam, gunModel, function() end, targetRoot, gunShotContext)
					end
					return
				end
				M1.guard("drone shot", fireDroneM1, COMBO_SIDE[id], targetRoot, stage, power, function()
					FX.m1Shake(DRONE_SHAKE_DURATION, COMBO_SIDE[id], power)
				end)
			end)
		end)
	end)
end

if player.Character then
	task.spawn(hookCharacter, player.Character)
end
