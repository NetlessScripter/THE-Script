			}),
			acceleration = Vector3.new(0, -30, 0),
			drag = 2.5,
		})
		local floorFrame, floorHit = FX.floorFrameAt(position, ignore, 0.14)
		if floorHit and (position - floorHit.Position).Magnitude < 10 then
			FX.dashRing(stage, floorFrame, { count = 34, color = palette.bright, startRadius = 1.2, endRadius = 9, duration = 0.55, thickness = 0.3, spin = 1.6, fill = 0.58, startTransparency = 0.1 })
			FX.dashRing(stage, floorFrame, { count = 26, color = palette.hot, startRadius = 0.8, endRadius = 5.5, duration = 0.4, thickness = 0.2, spin = -2, fill = 0.5, startTransparency = 0.15 })
			FX.groundCracks(stage, floorFrame, 5, 4, 9)
		end
	end)
end

local ATTACK2_CHARGE_TIME = 0.2
local ATTACK2_FIRE_START = 0.2
local ATTACK2_FIRE_END = 1.7
local ATTACK2_SHOT_INTERVAL = 0.05
local ATTACK2_STAGE_LIFETIME = 4.4
local ATTACK2_DRONE_BURST = 2
local ATTACK2_FINALE_LEAD = 0.14
local ATTACK2_FINALE_BACK = 2.4
local ATTACK2_FINALE_FOV = 14
local ATTACK2_FINALE_PITCH = math.rad(6)
local ATTACK2_FINALE_ROLL = math.rad(9)
local attack2Running = false

local ATTACK2_SHAKE_START = 0.2
local ATTACK2_SHAKE_END = 1.7
local ATTACK2_SHAKE_FADE_IN = 0.02
local ATTACK2_SHAKE_FADE_OUT = 0.12
local ATTACK2_SHAKE_NOISE_SPEED = 140
local ATTACK2_SHAKE_POSITION = 0.95
local ATTACK2_SHAKE_ROTATION = math.rad(3.4)
local ATTACK2_SHAKE_PUNCH_BACK = 1.2
local ATTACK2_SHAKE_PUNCH_PITCH = math.rad(3.2)
local ATTACK2_SHAKE_PUNCH_ROLL = math.rad(5.5)
local ATTACK2_SHAKE_PUNCH_DECAY = 32
local ATTACK2_SHAKE_FOV_PUNCH = 9

function FX.attack2Shake()
	local noiseSeed = FX.rng:NextNumber(1, 90)
	local startedAt = os.clock()
	local bindName = "RickPrimeAttack2Shake" .. tostring(startedAt)
	local duration = ATTACK2_SHAKE_END - ATTACK2_SHAKE_START

	RunService:BindToRenderStep(bindName, Enum.RenderPriority.Last.Value + 1, function()
		local camera = workspace.CurrentCamera
		local age = os.clock() - startedAt - ATTACK2_SHAKE_START
		if not camera or age >= duration then
			RunService:UnbindFromRenderStep(bindName)
			return
		end
		if age < 0 then return end

		local build = 1 + 0.9 * math.clamp(age / duration, 0, 1)
		local intensity = math.clamp(age / ATTACK2_SHAKE_FADE_IN, 0, 1)
			* math.clamp((duration - age) / ATTACK2_SHAKE_FADE_OUT, 0, 1)
			* build
		local punch = math.exp(-(age % ATTACK2_SHOT_INTERVAL) * ATTACK2_SHAKE_PUNCH_DECAY) * intensity
		local rollSign = math.floor(age / ATTACK2_SHOT_INTERVAL) % 2 == 0 and 1 or -1
		local finaleAge = age - (duration - ATTACK2_FINALE_LEAD)
		local finale = finaleAge > 0 and math.exp(-finaleAge * 9) or 0
		local function noise(offset)
			return math.noise(age * ATTACK2_SHAKE_NOISE_SPEED, noiseSeed, offset) * 2 * intensity
		end

		if camera.CameraType == Enum.CameraType.Scriptable then
			camera.FieldOfView = math.clamp(camera.FieldOfView - ATTACK2_SHAKE_FOV_PUNCH * punch + ATTACK2_FINALE_FOV * finale, 20, 120)
		end

		camera.CFrame = camera.CFrame
			* CFrame.new(
				noise(0.13) * ATTACK2_SHAKE_POSITION,
				noise(0.37) * ATTACK2_SHAKE_POSITION,
				ATTACK2_SHAKE_PUNCH_BACK * punch + ATTACK2_FINALE_BACK * finale
			)
			* CFrame.Angles(
				noise(0.61) * ATTACK2_SHAKE_ROTATION + ATTACK2_SHAKE_PUNCH_PITCH * punch + ATTACK2_FINALE_PITCH * finale,
				noise(0.83) * ATTACK2_SHAKE_ROTATION,
				noise(0.97) * ATTACK2_SHAKE_ROTATION + rollSign * (ATTACK2_SHAKE_PUNCH_ROLL * punch + ATTACK2_FINALE_ROLL * finale)
			)
	end)

	return function()
		pcall(function()
			RunService:UnbindFromRenderStep(bindName)
		end)
	end
end

function FX.arc(parent, startPoint, endPoint, thickness, life, segments, jag)
	local delta = endPoint - startPoint
	if delta.Magnitude < 0.1 then
		return
	end
	local palette = VFX.palette
	local frame = FX.facing(startPoint, delta)
	local points = { startPoint }
	for index = 1, segments - 1 do
		local alpha = index / segments
		local spread = jag * math.sin(math.pi * alpha)
		points[#points + 1] = startPoint + delta * alpha
			+ frame.RightVector * FX.rng:NextNumber(-1, 1) * spread
			+ frame.UpVector * FX.rng:NextNumber(-1, 1) * spread
	end
	points[#points + 1] = endPoint
	for index = 1, #points - 1 do
		local pointA, pointB = points[index], points[index + 1]
		local length = (pointB - pointA).Magnitude
		if length > 0.01 then
			local cframe = FX.facing((pointA + pointB) / 2, pointB - pointA)
			local body = FX.part(parent, Enum.PartType.Block, palette.red, 0.1, Vector3.new(thickness, thickness, length + thickness * 0.6), cframe)
			local core = FX.part(parent, Enum.PartType.Block, palette.hot, 0, Vector3.new(thickness * 0.4, thickness * 0.4, length + thickness * 0.6), cframe)
			FX.tween(body, life, { Transparency = 1, Size = Vector3.new(thickness * 0.2, thickness * 0.2, length) })
			FX.tween(core, life * 0.8, { Transparency = 1 })
			task.delay(life + 0.05, function()
				body:Destroy()
				core:Destroy()
			end)
		end
	end
end

