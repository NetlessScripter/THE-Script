function FX.part(parent, shape, color, transparency, size, cframe)
	local part = Instance.new("Part")
	part.Shape = shape
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Transparency = transparency
	part.Size = size
	part.CFrame = cframe
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Parent = parent
	return part
end

function FX.tween(instance, duration, properties, style, direction)
	local tween = TweenService:Create(instance, TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), properties)
	tween:Play()
	return tween
end

function FX.facing(position, direction)
	local up = math.abs(direction.Unit.Y) > 0.98 and Vector3.zAxis or Vector3.yAxis
	return CFrame.lookAt(position, position + direction, up)
end

function FX.sound(soundId, parent)
	if not soundId or soundId == "" then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Volume = VFX.sounds.volume
	sound.Parent = parent
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	sound:Play()
	task.delay(10, function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
end

function FX.run(owner, duration, step, onDone)
	local startTime = os.clock()
	local connection
	connection = RunService.PreRender:Connect(function()
		if owner and not owner.Parent then
			connection:Disconnect()
			return
		end
		local elapsed = os.clock() - startTime
		local alpha = math.clamp(elapsed / duration, 0, 1)
		local ok, err = pcall(step, alpha, elapsed)
		if not ok then
			warn("[RickPrimeGun] vfx error:", err)
			connection:Disconnect()
			return
		end
		if alpha >= 1 then
			connection:Disconnect()
			if onDone then
				onDone()
			end
		end
	end)
	return connection
end

function FX.newRing(parent, segmentCount, color)
	local ring = { count = segmentCount, segments = {} }
	for index = 1, segmentCount do
		ring.segments[index] = FX.part(parent, Enum.PartType.Block, color, 1, Vector3.new(0.1, 0.05, 0.05), CFrame.new())
	end
	return ring
end

function FX.setRing(ring, frame, radius, thickness, transparency, spin)
	local count = ring.count
	local chord = 2 * radius * math.sin(math.pi / count) * 1.1 + thickness
	for index, segment in ipairs(ring.segments) do
		local angle = spin + index / count * 2 * math.pi
		segment.Size = Vector3.new(chord, thickness, thickness)
		segment.CFrame = frame * CFrame.Angles(0, 0, angle) * CFrame.new(radius, 0, 0) * CFrame.Angles(0, 0, math.pi / 2)
		segment.Transparency = transparency
	end
end

function FX.destroyRing(ring)
	for _, segment in ipairs(ring.segments) do
		segment:Destroy()
	end
	table.clear(ring.segments)
end

function FX.shockRing(owner, frame, options)
	local ring = FX.newRing(owner, options.segments or 32, options.color)
	local startTransparency = options.startTransparency or 0
	FX.run(owner, options.duration, function(alpha)
		local eased, thickness, transparency
		if options.easeIn then
			eased = alpha ^ 2.2
			thickness = options.thickness * (0.35 + 0.65 * math.sin(math.pi * alpha))
			transparency = 1 - (1 - startTransparency) * math.sin(math.pi * alpha) ^ 0.5
		else
			eased = 1 - (1 - alpha) ^ 3
			thickness = options.thickness * (1 - 0.85 * alpha)
			transparency = startTransparency + (1 - startTransparency) * alpha ^ 1.4
		end
		local radius = options.startRadius + (options.endRadius - options.startRadius) * eased
		FX.setRing(ring, frame, radius, math.max(thickness, 0.02), transparency, 0)
	end, function()
		FX.destroyRing(ring)
	end)
end

