local function runAttack3(character, animator, onDone)
	pcall(FX.releaseAttack2Camera)
	local root = character:FindFirstChild("HumanoidRootPart")
	local camera = workspace.CurrentCamera
	local legs = {
		{ part = character:FindFirstChild("Right Leg") or character:FindFirstChild("RightFoot"), rest = Vector3.new(0.5, -3, 0) },
		{ part = character:FindFirstChild("Left Leg") or character:FindFirstChild("LeftFoot"), rest = Vector3.new(-0.5, -3, 0) },
	}
	local kick = legs[1].part and legs[1] or legs[2]
	if not root or not camera or not kick.part then
		onDone()
		return
	end

	local animation = Instance.new("Animation")
	animation.AnimationId = ATTACK3_ANIM_ID
	local track = animator:LoadAnimation(animation)
	local waited = 0
	while track.Length == 0 and waited < 2 do
		waited = waited + task.wait()
	end
	track.Priority = Enum.AnimationPriority.Action4
	track.Looped = false
	track:Play(0)
	track.TimePosition = ATTACK3_START_TIME

	local rng = FX.rng
	local ball, block = Enum.PartType.Ball, Enum.PartType.Block
	local lighting = game:GetService("Lighting")
	local fxFolder = Instance.new("Folder")
	fxFolder.Name = "Attack3FX"
	fxFolder.Parent = workspace
	local ignore = FX.ignoreList(fxFolder, workspace:FindFirstChild(DUMMY_FOLDER_NAME))

	local attackTargetRoot = getClosestTargetRoot(root.Position)

	local hitbox = Instance.new("Part")
	hitbox.Name = "Attack3Hitbox"
	hitbox.Size = ATTACK3_HITBOX_SIZE
	hitbox.Anchored = true
	hitbox.CanCollide = false
	hitbox.CanTouch = false
	hitbox.CanQuery = false
	hitbox.CastShadow = false
	hitbox.Material = Enum.Material.Neon
	hitbox.Color = ELEC.cyan
	hitbox.Transparency = ATTACK3_HITBOX_VISIBLE and 0.7 or 1
	hitbox.CFrame = root.CFrame * ATTACK3_HITBOX_OFFSET
	hitbox.Parent = fxFolder

	local hitTarget
	local stopFollow
	local hitboxConnection
	local function scanHitbox()
		if not hitbox.Parent or not root.Parent then
			return
		end

		local ok, touched = pcall(function()
			hitbox.CFrame = root.CFrame * ATTACK3_HITBOX_OFFSET
			return findTouchedTarget(hitbox)
		end)
		if not ok then
			warn("[Attack3] hitbox scan error:", touched)
		elseif touched and not hitTarget then
			hitTarget = touched
		end
	end
	local function stopHitbox()
		if hitboxConnection then
			hitboxConnection:Disconnect()
			hitboxConnection = nil
		end
		hitbox:Destroy()
	end
	local hitboxBorn = os.clock()
	local hitboxResolved = false

	local function resolveHitbox()
		if hitboxResolved then
			return
		end
		hitboxResolved = true
		scanHitbox()
		local boxCFrame = root.CFrame * ATTACK3_HITBOX_OFFSET
		print("[Attack3] Weakest Dummy:", describeDummy())
		stopHitbox()
		if hitTarget then
			print("[Attack3] HIT ->", hitTarget.Parent and hitTarget.Parent.Name or hitTarget.Name)
		else

			local reach = ATTACK3_HITBOX_SIZE / 2 + Vector3.one * ATTACK3_HITBOX_TOUCH_PADDING
			print(string.format("[Attack3] box reach (x,y,z) = %.1f, %.1f, %.1f", reach.X, reach.Y, reach.Z))
			for _, candidateRoot in ipairs(getAllTargetRoots()) do
				local localPosition = boxCFrame:PointToObjectSpace(candidateRoot.Position)
				print(string.format(
					"[Attack3]   %s is at (x,y,z) = %.1f, %.1f, %.1f from the box center",
					candidateRoot.Parent and candidateRoot.Parent.Name or candidateRoot.Name,
					localPosition.X, localPosition.Y, localPosition.Z
				))
			end
		end
		if not hitTarget then

			local nearestRoot = (attackTargetRoot and attackTargetRoot.Parent and attackTargetRoot) or getClosestTargetRoot(root.Position)
			if nearestRoot then
				print("[Attack3] MISS -> following", nearestRoot.Parent and nearestRoot.Parent.Name or nearestRoot.Name)
				local followOk, followResult = pcall(followBehindTarget, character, nearestRoot)
				if followOk then
					stopFollow = followResult
				else
					warn("[Attack3] miss follow error:", followResult)
				end
			else
				print("[Attack3] MISS, but there is no target (no other live player and no Weakest Dummy)")
			end
		end
	end
	hitboxConnection = RunService.Heartbeat:Connect(function()
		scanHitbox()
		if os.clock() - hitboxBorn >= ATTACK3_HITBOX_LIFETIME then
			resolveHitbox()
		end
	end)
	task.delay(ATTACK3_HITBOX_LIFETIME + 0.05, resolveHitbox)

	local function randomUnit()
		local vector = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-1, 1), rng:NextNumber(-1, 1))
		return vector.Magnitude > 0.01 and vector.Unit or Vector3.yAxis
	end

	local grade = Instance.new("ColorCorrectionEffect")
	grade.Parent = lighting
	local blur = Instance.new("BlurEffect")
	blur.Size = 0
	blur.Parent = lighting

	local aura = Instance.new("Highlight")
	aura.Adornee = character
	aura.FillColor = ELEC.blue
	aura.OutlineColor = ELEC.cyan
	aura.FillTransparency = 1
	aura.OutlineTransparency = 1
	aura.DepthMode = Enum.HighlightDepthMode.Occluded
	aura.Parent = fxFolder

	local legGlow = Instance.new("Highlight")
	legGlow.FillColor = ELEC.blue
	legGlow.OutlineColor = ELEC.cyan
	legGlow.FillTransparency = 1
	legGlow.OutlineTransparency = 1
	legGlow.DepthMode = Enum.HighlightDepthMode.Occluded
	legGlow.Parent = fxFolder

	local orb = FX.part(fxFolder, ball, ELEC.blue, 0.45, Vector3.one * 0.15, CFrame.new(root.Position))
	local orbShell = FX.part(fxFolder, ball, ELEC.blue, 0.85, Vector3.one * 0.4, CFrame.new(root.Position))
	local orbLight = Instance.new("PointLight")
	orbLight.Color = ELEC.blue
	orbLight.Range = 12
	orbLight.Brightness = 0
	orbLight.Shadows = false
	orbLight.Parent = orb

	local trailBits = {}
	for _, leg in ipairs(legs) do
		if leg.part then
			local half = leg.part.Size.Y / 2
			local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
			a0.Position = Vector3.new(0, half, 0)
			a1.Position = Vector3.new(0, -half - 0.4, 0)
			a0.Parent, a1.Parent = leg.part, leg.part
			local trail = Instance.new("Trail")
			trail.Attachment0, trail.Attachment1 = a0, a1
			trail.Lifetime = 0.3
			trail.LightEmission = 1
			trail.LightInfluence = 0
			trail.FaceCamera = false
			trail.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, ELEC.cyan),
				ColorSequenceKeypoint.new(0.5, ELEC.blue),
				ColorSequenceKeypoint.new(1, ELEC.deep),
			})
			trail.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.3),
				NumberSequenceKeypoint.new(0.5, 0.55),
				NumberSequenceKeypoint.new(1, 1),
			})
			trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.2) })
			trail.Parent = leg.part
			table.insert(trailBits, a0)
			table.insert(trailBits, a1)
			table.insert(trailBits, trail)
		end
	end

	local startClock = os.clock()
	local baseFov = camera.FieldOfView
	local seed = rng:NextNumber(1, 90)
	local shakeStart, shakeRoll
	local fired, fireElapsed = false, 0
	local zapRoot
	local nextArc, nextZap = 0, 0
	local streaks = {}
	local streakDebt = 0
	local HELIX_POINTS = 8
	local helixParts = { {}, {} }
	for strand = 1, 2 do
		for index = 1, HELIX_POINTS do
			helixParts[strand][index] = FX.part(fxFolder, block, strand == 1 and ELEC.cyan or ELEC.blue, 1, Vector3.new(0.05, 0.05, 0.5), CFrame.new(root.Position))
		end
	end
	local function streakAt(streak, foot, e)
		return foot + CFrame.Angles(0, streak.swirl * e, 0) * (streak.rel * (1 - e))
	end

	local floorHit = FX.floorAt(root.Position, ignore)
	local floorPos = floorHit and (floorHit.Position + Vector3.new(0, 0.2, 0)) or (root.Position - Vector3.new(0, 2.8, 0))
	if floorHit then
		local floorFrame = FX.facing(floorHit.Position + floorHit.Normal * 0.15, floorHit.Normal)
		FX.shockRing(fxFolder, floorFrame, { startRadius = 10, endRadius = 1, duration = ATTACK3_WINDUP + 0.05, thickness = 0.2, color = ELEC.blue, segments = 44, easeIn = true, startTransparency = 0.45 })
		FX.shockRing(fxFolder, floorFrame, { startRadius = 6, endRadius = 0.6, duration = ATTACK3_WINDUP, thickness = 0.14, color = ELEC.cyan, segments = 36, easeIn = true, startTransparency = 0.55 })
	end
	FX.sound(ATTACK3_SOUNDS.charge, root)

	local lastOffset, lastApplied = CFrame.identity, nil
	RunService:BindToRenderStep("Attack3CamPre", Enum.RenderPriority.First.Value, function()
		if lastApplied and camera.CFrame == lastApplied then
			camera.CFrame = camera.CFrame * lastOffset:Inverse()
		end
		lastApplied = nil
	end)
	RunService:BindToRenderStep("Attack3CamPost", Enum.RenderPriority.Last.Value, function()
		local now = os.clock()
		local shake, fov, roll, push = 0, baseFov, 0, 0
		if shakeStart then
			local age = now - shakeStart
			shake = math.exp(-age * 4.2)
			fov = baseFov + 26 * math.exp(-age * 7.5) + 4 * math.sin(age * 14) * math.exp(-age * 5)
			roll = shakeRoll * 0.12 * shake * math.cos(age * 30)
			push = 2.5 * math.exp(-age * 9) * math.cos(age * 18)
		else
			local windup = math.clamp((now - startClock) / ATTACK3_WINDUP, 0, 1)
			shake = windup ^ 3 * 0.3
			fov = baseFov - 10 * windup ^ 2
		end
		local t = now * 55
		lastOffset = CFrame.new(math.noise(t, seed, 0.5) * 3.2 * shake, math.noise(t, seed + 7, 0.5) * 3.2 * shake, push)
			* CFrame.Angles(math.noise(t, seed + 13, 0.5) * 0.2 * shake, math.noise(t, seed + 21, 0.5) * 0.2 * shake, roll)
		camera.CFrame = camera.CFrame * lastOffset
		lastApplied = camera.CFrame
		camera.FieldOfView = fov
	end)

	local slashStep, slashBorn
	local function launchSlash(origin, dir)
		local length = ATTACK3_SLASH_LENGTH
		local right = dir:Cross(Vector3.yAxis)
		right = right.Magnitude > 0.01 and right.Unit or Vector3.xAxis
		local up = right:Cross(dir).Unit

		local tailPart, tailAtt = FX.node(fxFolder)
		local midPart, midAtt = FX.node(fxFolder)
		local headPart, headAtt = FX.node(fxFolder)
		local layers = {
			{ scale = 2.4, base = 0.72, z = 0, tail = ColorSequence.new(ELEC.blue, ELEC.cyan), head = ColorSequence.new(ELEC.cyan, ELEC.blue) },
			{
				scale = 1,
				base = 0.1,
				z = 1,
				tail = ColorSequence.new(ELEC.cyan, ELEC.white),
				head = ColorSequence.new({
					ColorSequenceKeypoint.new(0, ELEC.white),
					ColorSequenceKeypoint.new(0.45, ELEC.cyan),
					ColorSequenceKeypoint.new(1, ELEC.blue),
				}),
			},
			{ scale = 0.35, base = 0, z = 2, tail = ColorSequence.new(ELEC.white), head = ColorSequence.new(ELEC.white) },
		}
		local beams = {}
		for _, layer in ipairs(layers) do
			local tailBeam = FX.beam(fxFolder, tailAtt, midAtt, layer.tail, 0, 0, NumberSequence.new(layer.base), layer.z)
			local headBeam = FX.beam(fxFolder, midAtt, headAtt, layer.head, 0, 0, NumberSequence.new(layer.base), layer.z)
			table.insert(beams, { tail = tailBeam, head = headBeam, scale = layer.scale })
		end

		for _ = 1, 4 do
			local offset = right * rng:NextNumber(-1.2, 1.2) + up * rng:NextNumber(-0.8, 1.2)
			elecBolt(fxFolder, origin + offset * 0.3, origin + offset + dir * length * rng:NextNumber(0.55, 1), 0.34, 0.24, 14, 1.3)
		end
		for _ = 1, 8 do
			local p = origin + dir * length * rng:NextNumber(0.05, 0.85)
			local q = p + right * rng:NextNumber(-6, 6) + up * rng:NextNumber(-3, 4) + dir * rng:NextNumber(0, 4)
			elecBolt(fxFolder, p, q, 0.2, 0.16, 6, 0.9)
		end

		for _ = 1, 5 do
			local height = rng:NextNumber(12, 24)
			local base = origin + right * rng:NextNumber(-1.8, 1.8) + dir * rng:NextNumber(-0.5, 5)
			local streak = FX.part(fxFolder, block, ELEC.white, 0.05, Vector3.new(0.14, height, 0.14), CFrame.new(base.X, floorPos.Y + height / 2, base.Z))
			FX.tween(streak, rng:NextNumber(0.18, 0.3), { Transparency = 1, Size = Vector3.new(0.02, height * 1.2, 0.02) })
		end

		for _ = 1, 5 do
			local _, aAtt = FX.node(fxFolder)
			local _, bAtt = FX.node(fxFolder)
			local start = origin + right * rng:NextNumber(-3, 3) + up * rng:NextNumber(-1.5, 2) + dir * rng:NextNumber(0, 4)
			aAtt.Parent.CFrame = CFrame.new(start)
			bAtt.Parent.CFrame = CFrame.new(start + dir * length * rng:NextNumber(0.45, 0.9))
			local streakBeam = FX.beam(
				fxFolder,
				aAtt,
				bAtt,
				ColorSequence.new(ELEC.white, ELEC.cyan),
				0.5,
				0,
				NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(0.3, 0.2), NumberSequenceKeypoint.new(1, 1) }),
				0
			)
			FX.tween(streakBeam, rng:NextNumber(0.25, 0.45), { Width0 = 0 })
		end

		local nextBolt = 0
		return function(t)
			local grow = 1 - (1 - math.clamp(t / 0.1, 0, 1)) ^ 3
			local leave = math.clamp((t - 0.16) / 0.5, 0, 1) ^ 2
			local head = origin + dir * length * grow
			local tail = origin + dir * length * 0.8 * leave
			local mid = tail + (head - tail) * 0.22
			tailPart.CFrame, midPart.CFrame, headPart.CFrame = CFrame.new(tail), CFrame.new(mid), CFrame.new(head)

			local width = (6.5 * math.exp(-t * 9) + 1.1 * math.exp(-t * 3.2)) * math.clamp(1 - t / 0.8, 0, 1)
			for _, set in ipairs(beams) do
				set.tail.Width1 = width * set.scale
				set.head.Width0 = width * set.scale
			end

			if t < 0.5 and t >= nextBolt then
				nextBolt = t + 0.04
				for _ = 1, 3 do
					local p = tail:Lerp(head, rng:NextNumber(0.02, 0.9)) + right * rng:NextNumber(-2, 2) + up * rng:NextNumber(-1.5, 1.5)
					local q = p + dir * rng:NextNumber(6, 16) + right * rng:NextNumber(-2.5, 2.5) + up * rng:NextNumber(-2, 2)
					elecBolt(fxFolder, p, q, rng:NextNumber(0.18, 0.34), rng:NextNumber(0.12, 0.2), 6, 0.9)
				end
			end
			return t < 0.9
		end
	end

	local function impact(foot)
		local look = root.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		flat = flat.Magnitude > 0.05 and flat.Unit or look
		local position = foot + flat * 0.4
		shakeStart, shakeRoll = os.clock(), rng:NextNumber() < 0.5 and -1 or 1

		orb:Destroy()
		orbShell:Destroy()

		local flash = FX.part(fxFolder, ball, ELEC.white, 0, Vector3.one * 1.2, CFrame.new(position))
		FX.tween(flash, 0.12, { Transparency = 1, Size = Vector3.one * 5 })
		local light = Instance.new("PointLight")
		light.Color = ELEC.cyan
		light.Brightness = 14
		light.Range = 30
		light.Shadows = false
		light.Parent = flash
		FX.tween(light, 0.35, { Brightness = 0 })
		FX.sound(ATTACK3_SOUNDS.impact, flash)

		slashStep, slashBorn = launchSlash(position, flat), os.clock()

		local smokeSize = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 7) })
		local smokeFade = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(0.5, 0.85), NumberSequenceKeypoint.new(1, 1) })
		local smokeColor = ColorSequence.new(Color3.fromRGB(200, 225, 245), Color3.fromRGB(160, 195, 235))
		local plume = FX.part(fxFolder, block, ELEC.white, 1, Vector3.new(0.1, 0.1, 0.1), FX.facing(position, flat))
		FX.burst(plume, 8, { texture = SMOKE_TEXTURE, color = smokeColor, size = smokeSize, transparency = smokeFade, lightEmission = 0.2, speed = NumberRange.new(12, 30), spread = Vector2.new(40, 40), lifetime = NumberRange.new(0.35, 0.65), acceleration = Vector3.new(0, 3, 0), drag = 3 })
		local dust = FX.part(fxFolder, block, ELEC.white, 1, Vector3.new(0.1, 0.1, 0.1), FX.facing(floorPos, Vector3.yAxis))
		FX.burst(dust, 5, { texture = SMOKE_TEXTURE, color = smokeColor, size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 5) }), transparency = smokeFade, lightEmission = 0.1, speed = NumberRange.new(8, 20), spread = Vector2.new(80, 80), lifetime = NumberRange.new(0.4, 0.7), acceleration = Vector3.new(0, 1, 0), drag = 3 })

		local targetRoot = getClosestTargetRoot(position)
		if targetRoot and (targetRoot.Position - position).Magnitude < 9 then
			zapRoot = targetRoot
			local highlight = Instance.new("Highlight")
			highlight.Adornee = targetRoot.Parent
			highlight.FillColor = ELEC.cyan
			highlight.OutlineColor = ELEC.white
			highlight.FillTransparency = 0.1
			highlight.OutlineTransparency = 0
			highlight.DepthMode = Enum.HighlightDepthMode.Occluded
			highlight.Parent = fxFolder
