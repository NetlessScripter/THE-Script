function Geo.mirrorOutline(right)
	local n = #right
	local out = {}
	for i = 1, n do
		local p = right[i]
		out[i] = { p[1], p[2], p[3] or 0, p[4] or 0 }
	end
	local prev = right[n - 1]
	out[n][4] = (prev and prev[4]) or 0
	for i = n - 1, 2, -1 do
		local p, before = right[i], right[i - 1]
		out[#out + 1] = { -p[1], p[2], p[3] or 0, before[4] or 0 }
	end
	return out
end

function Geo.flipX(points)
	local out = {}
	for i, p in ipairs(points) do
		out[i] = { -p[1], p[2], p[3] or 0, p[4] or 0 }
	end
	return out
end

function Geo.tessellate(points, curve, bend, detail)
	local n = #points
	local P, R, B = {}, {}, {}
	for i = 1, n do
		local p = points[i]
		P[i] = Vector2.new(p[1], p[2])
		R[i] = p[3] or 0
		B[i] = p[4] or 0
	end

	local area = 0
	for i = 1, n do
		local a, b = P[i], P[i % n + 1]
		area = area + (a.X * b.Y - b.X * a.Y)
	end
	local sgn = (area >= 0) and 1 or -1

	local function effR(r)
		local c = math.clamp(curve, -1, 1)
		local v
		if c < 0 then v = r * (1 + c) else v = r + (1 - r) * c end
		return math.clamp(v, 0, 1)
	end

	local t = {}
	for i = 1, n do
		local a, v, c = P[(i - 2) % n + 1], P[i], P[i % n + 1]
		local da, dc = a - v, c - v
		local la, lc = da.Magnitude, dc.Magnitude
		local straight = math.abs(da.X * dc.Y - da.Y * dc.X) < 1e-5 * la * lc
		if straight then
			t[i] = 0
		else
			t[i] = effR(R[i]) * 0.5 * math.min(la, lc)
		end
	end

	local out = {}
	local function push(v)
		local last = out[#out]
		if not last or (v - last).Magnitude > 1e-5 then
			out[#out + 1] = v
		end
	end
	local function quad(p0, c, p2, k, m)
		local u = k / m
		local w = 1 - u
		return p0 * (w * w) + c * (2 * w * u) + p2 * (u * u)
	end

	for i = 1, n do
		local a, v, c = P[(i - 2) % n + 1], P[i], P[i % n + 1]
		if t[i] > 1e-6 then
			local e0 = v + (a - v).Unit * t[i]
			local s1 = v + (c - v).Unit * t[i]
			for k = 0, detail do
				push(quad(e0, v, s1, k, detail))
			end
		else
			push(v)
		end

		local j = i % n + 1
		local d = P[j] - P[i]
		local dn = d.Unit
		local S = P[i] + dn * t[i]
		local E = P[j] - dn * t[j]
		local bb = B[i] + bend
		local chord = (E - S).Magnitude
		if math.abs(bb) > 1e-5 and chord > 1e-5 then
			local mid = (S + E) / 2
			local nrm = Vector2.new(dn.Y, -dn.X) * sgn
			local ctrl = mid + nrm * (2 * bb * chord)
			for k = 1, detail - 1 do
				push(quad(S, ctrl, E, k, detail))
			end
		end
	end

	if #out > 1 and (out[1] - out[#out]).Magnitude <= 1e-5 then
		out[#out] = nil
	end
	return out
end

function Geo.triangulate(poly)
	local n = #poly
	local tris = {}
	if n < 3 then return tris end

	local idx = {}
	for i = 1, n do idx[i] = i end

	local area = 0
	for i = 1, n do
		local a, b = poly[i], poly[i % n + 1]
		area = area + (a.X * b.Y - b.X * a.Y)
	end
	if area < 0 then
		for i = 1, math.floor(n / 2) do
			idx[i], idx[n - i + 1] = idx[n - i + 1], idx[i]
		end
	end

	local function cross(o, a, b)
		return (a.X - o.X) * (b.Y - o.Y) - (a.Y - o.Y) * (b.X - o.X)
	end
	local function inside(p, a, b, c)
		return cross(a, b, p) >= -1e-9 and cross(b, c, p) >= -1e-9 and cross(c, a, p) >= -1e-9
	end

	local guard = 0
	while #idx > 3 and guard < 5000 do
		guard = guard + 1
		local m = #idx
		local clipAt = nil
		local bestCross, bestK = -math.huge, 1

		for k = 1, m do
			local ia, ib, ic = idx[(k - 2) % m + 1], idx[k], idx[k % m + 1]
			local a, b, c = poly[ia], poly[ib], poly[ic]
			local cr = cross(a, b, c)
			if cr > bestCross then
				bestCross, bestK = cr, k
			end
			if cr > 1e-9 then
				local ok = true
				for j = 1, m do
					local ij = idx[j]
					if ij ~= ia and ij ~= ib and ij ~= ic and inside(poly[ij], a, b, c) then
						ok = false
						break
					end
				end
				if ok then
					clipAt = k
					break
				end
			end
		end

		if not clipAt then clipAt = bestK end

		local ia, ib, ic = idx[(clipAt - 2) % m + 1], idx[clipAt], idx[clipAt % m + 1]
		if cross(poly[ia], poly[ib], poly[ic]) > 1e-12 then
			tris[#tris + 1] = { ia, ib, ic }
		end
		table.remove(idx, clipAt)
	end
	if #idx == 3 then
		tris[#tris + 1] = { idx[1], idx[2], idx[3] }
	end
	return tris
end

local function makeBuilder(model)
	local B = {}

	local function finish(p, name, color, material, solid)
		p.Name = name
		p.Color = color
		p.Material = material
		p.Anchored = true
		p.CanCollide = solid and CONFIG.Collide or false
		if material == NEON then p.CastShadow = false end
		p.Parent = model
		return p
	end

	function B.block(name, size, pos, color, material)
		local k = CONFIG.Scale
		local p = Instance.new("Part")
		p.Size = size * k
		p.CFrame = CFrame.new(pos * k)
		return finish(p, name, color, material, false)
	end

	function B.bar(name, p1, p2, width, depth, z, color, material)
		local k = CONFIG.Scale
		local d = p2 - p1
		local len = d.Magnitude
		local mid = (p1 + p2) / 2
		local angle = math.atan2(-d.X, d.Y)
		local p = Instance.new("Part")
		p.Size = Vector3.new(width, len, depth) * k
		p.CFrame = CFrame.new(mid.X * k, mid.Y * k, z * k) * CFrame.Angles(0, 0, angle)
		return finish(p, name, color, material, false)
	end

	function B.disc(name, w, h, depth, pos, color, material)
		local k = CONFIG.Scale
		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(depth, h, w) * k
		p.CFrame = CFrame.new(pos * k) * CFrame.Angles(0, math.rad(90), 0)
		return finish(p, name, color, material, false)
	end

	function B.ball(name, d, pos, color, material)
		local k = CONFIG.Scale
		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.new(d, d, d) * k
		p.CFrame = CFrame.new(pos * k)
		return finish(p, name, color, material, false)
	end

	local function triangle(name, a, b, c, thickness, color, material)
		local k = CONFIG.Scale
		a, b, c = a * k, b * k, c * k
		local t = thickness * k

		local ab, ac, bc = b - a, c - a, c - b
		if ab:Cross(ac).Magnitude < 1e-6 then return end

		local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
		if abd > acd and abd > bcd then
			c, a = a, c
		elseif acd > bcd and acd > abd then
			a, b = b, a
		end
		ab, ac, bc = b - a, c - a, c - b

		local right = ac:Cross(ab).Unit
		local up = bc:Cross(right).Unit
		local back = bc.Unit
		local height = math.abs(ab:Dot(up))

		local w1 = Instance.new("WedgePart")
		w1.Size = Vector3.new(t, height, math.abs(ab:Dot(back)))
		w1.CFrame = CFrame.fromMatrix((a + b) / 2, right, up, back)
		finish(w1, name, color, material, true)

		local w2 = Instance.new("WedgePart")
		w2.Size = Vector3.new(t, height, math.abs(ac:Dot(back)))
		w2.CFrame = CFrame.fromMatrix((a + c) / 2, -right, up, -back)
		finish(w2, name, color, material, true)
	end

	function B.polygon(name, poly, z, thickness, color, material)
		local tris = Geo.triangulate(poly)
		for _, t in ipairs(tris) do
			local a, b, c = poly[t[1]], poly[t[2]], poly[t[3]]
			triangle(name,
				Vector3.new(a.X, a.Y, z),
				Vector3.new(b.X, b.Y, z),
				Vector3.new(c.X, c.Y, z),
				thickness, color, material)
		end
	end

	return B
end

