-- the victim of a swing: nearest humanoid inside the hit box
-- (overlap query instead of Touched, which never fires for resting or anchored targets)
function M1.findVictim(root, character, overlapParams)
	local boxFrame = root.CFrame * CFrame.new(0, 0, -M1.hitForward)
	local best, bestDistance

	local function consider(model)
		if not model or model == character or model.Name == "RickPrimeClone" then
			return
		end
		if not model:FindFirstChildOfClass("Humanoid") then
			return
		end
		local targetRoot = model:FindFirstChild("HumanoidRootPart")
		if not targetRoot then
			return
		end
		local distance = (targetRoot.Position - root.Position).Magnitude
		if not bestDistance or distance < bestDistance then
			best, bestDistance = model, distance
		end
	end

	for _, part in ipairs(workspace:GetPartBoundsInBox(boxFrame, M1.hitSize, overlapParams)) do
		consider(part:FindFirstAncestorOfClass("Model"))
	end
	if best then
		return best
	end

	-- fallback for targets whose parts can't be queried: test their root against the same box
	local live = workspace:FindFirstChild(DUMMY_FOLDER_NAME)
	if live then
		local reach = M1.hitSize / 2 + Vector3.one * M1.hitMargin
		for _, model in ipairs(live:GetChildren()) do
			local targetRoot = model:IsA("Model") and model:FindFirstChild("HumanoidRootPart")
			if targetRoot then
				local offset = boxFrame:PointToObjectSpace(targetRoot.Position)
				if math.abs(offset.X) <= reach.X and math.abs(offset.Y) <= reach.Y and math.abs(offset.Z) <= reach.Z then
					consider(model)
				end
			end
		end
	end
	return best
end

-- fades the swing out before it ends so the arm eases back to idle instead of snapping
function M1.smoothEnd(comboTrack)
	local connection
	connection = RunService.Heartbeat:Connect(function()
		if not comboTrack.IsPlaying then
			connection:Disconnect()
			return
		end
		local length = comboTrack.Length
		if length > M1.endFade * 2 and not comboTrack.Looped and comboTrack.TimePosition >= length - M1.endFade then
			connection:Disconnect()
			comboTrack:Stop(M1.endFade)
		end
	end)
end

-- extra drone motion during an M1: turns toward the victim, springs back when it fires
function M1.dronePose(rig, pose, now)
	local aim = rig.m1Aim
	if aim then
		local blendIn = math.clamp((now - aim.start) / M1.aimIn, 0, 1)
		local blendOut = math.clamp((now - aim.releaseAt) / M1.aimOut, 0, 1)
		if blendOut >= 1 then
			rig.m1Aim = nil
		else
			if aim.root.Parent then
				aim.last = aim.root.Position
			end
			local toTarget = aim.last - pose.Position
			if toTarget.Magnitude > 0.5 then
				local weight = blendIn * blendIn * (3 - 2 * blendIn) * (1 - blendOut * blendOut * (3 - 2 * blendOut)) * M1.aimStrength
				local lookRotation = FX.facing(pose.Position, toTarget).Rotation
				pose = pose.Rotation:Lerp(lookRotation, weight) + pose.Position
			end
		end
	end

	local kick = rig.m1Kick
	if kick then
		local age = now - kick.start
		if age >= M1.kickTime then
			rig.m1Kick = nil
		else
			local spring = math.exp(-age * M1.kickDecay) * math.sin(age * M1.kickFreq)
			pose = (pose + kick.direction * (M1.kickDistance * kick.power * spring)) * CFrame.Angles(M1.kickPitch * kick.power * spring, 0, 0)
		end
	end
	return pose
end

