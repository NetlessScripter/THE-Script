local function elecBolt(parent, p0, p1, thickness, life, segments, jag, flat, dim)
	local delta = p1 - p0
	if delta.Magnitude < 0.1 then
		return
	end
	local frame = FX.facing(p0, delta)
	local points = { p0 }
	for index = 1, segments - 1 do
		local alpha = index / segments
		local spread = jag * math.sin(math.pi * alpha)
		local offset = frame.RightVector * FX.rng:NextNumber(-1, 1) * spread
			+ frame.UpVector * FX.rng:NextNumber(-1, 1) * spread * (flat and 0.15 or 1)
		points[#points + 1] = p0 + delta * alpha + offset
	end
	points[#points + 1] = p1
	for index = 1, #points - 1 do
		local a, b = points[index], points[index + 1]
		local length = (b - a).Magnitude
		if length > 0.01 then
			local cframe = FX.facing((a + b) / 2, b - a)
			local body = FX.part(parent, Enum.PartType.Block, dim and ELEC.blue or ELEC.cyan, dim and 0.45 or 0.05, Vector3.new(thickness, thickness, length + thickness * 0.6), cframe)
			local core = FX.part(parent, Enum.PartType.Block, dim and ELEC.cyan or ELEC.white, dim and 0.3 or 0, Vector3.new(thickness * 0.4, thickness * 0.4, length + thickness * 0.6), cframe)
			FX.tween(body, life, { Transparency = 1, Size = Vector3.new(thickness * 0.2, thickness * 0.2, length) })
			FX.tween(core, life * 0.8, { Transparency = 1 })
			task.delay(life + 0.05, function()
				body:Destroy()
				core:Destroy()
			end)
		end
	end
end

local function legTip(leg)
	return leg.part.CFrame * Vector3.new(0, -leg.part.Size.Y / 2, 0)
end

local function pickKickLeg(legs, root, current)
	local best, bestScore = current, -1
	for _, leg in ipairs(legs) do
		if leg.part then
			local score = (legTip(leg) - root.CFrame * leg.rest).Magnitude + (leg == current and 0.4 or 0)
			if score > bestScore then
				best, bestScore = leg, score
			end
		end
	end
	return best
end

