-- gun finisher camera: spring kicks on fire and on impact, slow noise on top (no per-frame random)
function FX.comboShake(duration)
	local rollSign = FX.rng:NextNumber() < 0.5 and -1 or 1
	local noiseSeed = FX.rng:NextNumber(1, 90)
	local startedAt = os.clock()
	local bindName = "RickPrimeComboShake" .. tostring(startedAt)
	local kicks = {}
	local shake = {}
	local lastKickAt = startedAt
	local baseFov, lastFov

	local function addKick(strength, roll)
		lastKickAt = os.clock()
		table.insert(kicks, { time = lastKickAt, strength = strength, roll = roll })
	end

	function shake.fire()
		addKick(1, rollSign)
	end

	function shake.impact()
		addKick(1.25, -rollSign)
	end

	RunService:BindToRenderStep(bindName, Enum.RenderPriority.Camera.Value + 1, function()
		local camera = workspace.CurrentCamera
		local now = os.clock()
		if not camera or now - lastKickAt > duration then
			RunService:UnbindFromRenderStep(bindName)
			if camera and baseFov and lastFov and math.abs(camera.FieldOfView - lastFov) < 0.01 then
				camera.FieldOfView = baseFov
			end
			return
		end

		baseFov = baseFov or camera.FieldOfView
		local back, roll, fov, calm = 0, 0, 0, 0
		for _, kick in ipairs(kicks) do
			local age = now - kick.time
			if age >= 0 and age < duration then
				local punch = math.exp(-age * 8) * math.sin(age * 28)
				local follow = math.exp(-age * 5.5) * math.sin(age * 16)
				back += kick.strength * punch
				roll += kick.strength * kick.roll * follow
				fov += kick.strength * punch
				calm += kick.strength * (1 - age / duration) ^ 2
			end
		end
		calm = math.min(calm, 1.6)

		local function drift(offset)
			return math.noise((now - startedAt) * 9, noiseSeed, offset) * 2 * calm
		end

		lastFov = baseFov - 4 * fov
		camera.FieldOfView = lastFov
		camera.CFrame = camera.CFrame
			* CFrame.new(drift(0.13) * 0.11, drift(0.37) * 0.11, 0.9 * back)
			* CFrame.Angles(
				0.04 * back + drift(0.61) * 0.007,
				drift(0.83) * 0.007,
				0.05 * roll + drift(0.97) * 0.006
			)
	end)

	return shake
end

-- drone M1 camera: one spring impulse + slow noise, settles smoothly instead of buzzing
function FX.m1Shake(duration, side, power)
	power = power or 1
	local noiseSeed = FX.rng:NextNumber(1, 90)
	local startedAt = os.clock()
	local bindName = "RickPrimeM1Shake" .. tostring(startedAt)
	local baseFov, lastFov

	RunService:BindToRenderStep(bindName, Enum.RenderPriority.Camera.Value + 1, function()
		local camera = workspace.CurrentCamera
		local age = os.clock() - startedAt
		if not camera or age >= duration then
			RunService:UnbindFromRenderStep(bindName)
			if camera and baseFov and lastFov and math.abs(camera.FieldOfView - lastFov) < 0.01 then
				camera.FieldOfView = baseFov
			end
			return
		end

		baseFov = baseFov or camera.FieldOfView
		local calm = (1 - age / duration) ^ 2
		local punch = math.exp(-age * 9) * math.sin(age * 32)
		local follow = math.exp(-age * 6.5) * math.sin(age * 18)
		local function drift(offset)
			return math.noise(age * 9, noiseSeed, offset) * 2 * calm
		end

		lastFov = baseFov - 3 * power * punch
		camera.FieldOfView = lastFov
		camera.CFrame = camera.CFrame
			* CFrame.new(drift(0.13) * 0.08 * power, drift(0.37) * 0.08 * power, 0.7 * power * punch)
			* CFrame.Angles(
				0.035 * power * punch + drift(0.61) * 0.006,
				drift(0.83) * 0.006,
				side * 0.05 * power * follow + drift(0.97) * 0.005
			)
	end)
end

local function findDroneRig(side)
	for _, rig in ipairs(rigs) do
		if rig.side == side and rig.model.Parent then
			return rig
		end
	end
end

-- shared muzzle charge (drones + gun finisher): soft core, inward gather, lens star, lock-on line
function M1.charge(stage, duration, power, getFrame, getTarget)
	local palette = VFX.palette
	local accent = FX.accent()

	local startFrame = getFrame()
	local core = FX.part(stage, Enum.PartType.Ball, palette.hot, 0, Vector3.one * 0.05, startFrame)
	local halo = FX.part(stage, Enum.PartType.Ball, palette.red, 0.5, Vector3.one * 0.1, startFrame)
	local aura = FX.part(stage, Enum.PartType.Ball, palette.deep, 0.88, Vector3.one * 0.2, startFrame)

	local light = Instance.new("PointLight")
	light.Color = palette.bright
	light.Range = 6
	light.Brightness = 1
	light.Shadows = false
	light.Parent = core

	-- four point star
	local starPart, starAttachment = FX.node(stage)
	local spikes = {}
	for index = 1, 4 do
		local tipPart, tipAttachment = FX.node(stage)
		spikes[index] = {
			part = tipPart,
			beam = FX.beam(stage, starAttachment, tipAttachment, ColorSequence.new(index % 2 == 0 and palette.bright or palette.hot), 0.3, 0, NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 0.85),
			}), 0.03),
		}
	end

	-- energy gathering inward (particles travel toward the centre)
	local gatherPart = FX.part(stage, Enum.PartType.Block, palette.hot, 1, Vector3.one * M1.gatherSize, startFrame)
	local gather = Instance.new("ParticleEmitter")
	gather.Rate = 0
	gather.LightEmission = 1
	gather.LightInfluence = 0
	gather.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, palette.hot),
		ColorSequenceKeypoint.new(0.5, accent),
		ColorSequenceKeypoint.new(1, palette.red),
	})
	gather.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.08),
		NumberSequenceKeypoint.new(0.3, 0.28),
		NumberSequenceKeypoint.new(1, 0),
	})
	gather.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, 0.1),
		NumberSequenceKeypoint.new(1, 0.35),
	})
	gather.Lifetime = NumberRange.new(0.14, 0.18)
	gather.Speed = NumberRange.new(14, 18)
	gather.Rotation = NumberRange.new(0, 360)
	gather.Drag = 0
	gather.Acceleration = Vector3.zero
	pcall(function()
		gather.Shape = Enum.ParticleEmitterShape.Sphere
		gather.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		gather.ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward
	end)
	gather.Parent = gatherPart

	-- lock-on line toward the victim
	local laserFar, laserFarAttachment = FX.node(stage)
	local laserNear, laserNearAttachment = FX.node(stage)
	local laser = FX.beam(stage, laserNearAttachment, laserFarAttachment, ColorSequence.new(palette.red), 0.07, 0.03, NumberSequence.new(1), 0)

	FX.run(stage, duration, function(progress, elapsed)
		local center = getFrame() * CFrame.new(0, 0, -0.2)
		local swell = progress * progress * (3 - 2 * progress)
		local breath = 1 + 0.05 * math.sin(elapsed * 23)
		local size = (0.05 + M1.coreMax * power * swell ^ 1.4) * breath
		core.Size = Vector3.one * size
		core.CFrame = center
		halo.Size = Vector3.one * size * 2.2
		halo.CFrame = center
		aura.Size = Vector3.one * size * 3.4
		aura.CFrame = center
		light.Brightness = (1 + 5 * swell) * power
		light.Range = 6 + 5 * swell
		gatherPart.CFrame = center
		gather.Rate = M1.gatherRate * (0.35 + 0.65 * swell)

		starPart.Position = center.Position
		local reach = (0.4 + 2.6 * swell) * power
		local spin = elapsed * 3.4
		for index, spike in ipairs(spikes) do
			local angle = spin + (index - 1) * math.pi / 2
			local direction = center.RightVector * math.cos(angle) + center.UpVector * math.sin(angle)
			spike.part.Position = center.Position + direction * reach * (index % 2 == 0 and 0.62 or 1)
			spike.beam.Width0 = 0.3 * (0.35 + swell) * power
		end

		laserNear.Position = center.Position
		laserFar.Position = getTarget()
		laser.Transparency = NumberSequence.new(1 - 0.55 * swell * swell)
	end, function()
		-- soft hand-off: the shot's own flare takes over at this size, so nothing pops out
		FX.tween(core, 0.12, { Size = core.Size * 1.6, Transparency = 1 })
		FX.tween(halo, 0.16, { Size = halo.Size * 1.7, Transparency = 1 })
		FX.tween(aura, 0.2, { Size = aura.Size * 1.8, Transparency = 1 })
		FX.tween(light, 0.18, { Brightness = 0 })
		gather.Enabled = false
		starPart:Destroy()
		laserFar:Destroy()
		laserNear:Destroy()
		laser:Destroy()
		for _, spike in ipairs(spikes) do
			spike.part:Destroy()
			spike.beam:Destroy()
		end
		Debris:AddItem(core, 0.4)
		Debris:AddItem(halo, 0.4)
		Debris:AddItem(aura, 0.4)
		Debris:AddItem(gatherPart, 0.4)
	end)
end

local function chargeDroneM1(side, targetRoot, shotStage, duration, power)
	local shooter = findDroneRig(side)
	if not shooter or not targetRoot or not targetRoot.Parent then
		return
	end

	-- the drone turns to face the victim for the whole charge
	local now = os.clock()
	local lastTargetPosition = targetRoot.Position
	shooter.m1Aim = { root = targetRoot, last = lastTargetPosition, start = now, releaseAt = now + duration + M1.aimHold }

	local function getFrame()
		local pivot = shooter.model:GetPivot()
		local muzzlePosition = (pivot * CFrame.new(0, 0, -0.09)).Position
		if targetRoot.Parent then
			lastTargetPosition = targetRoot.Position
		end
		local offset = lastTargetPosition - muzzlePosition
		if offset.Magnitude < 0.1 then
			return pivot.Rotation + muzzlePosition
		end
		return FX.facing(muzzlePosition, offset)
	end

	M1.charge(shotStage, duration, power, getFrame, function()
		return lastTargetPosition
	end)
end

-- 4th hit: the same charge, at the gun's muzzle
local function chargeGunM1(gunModel, targetRoot, shotStage, duration, power)
	local muzzlePlug = gunModel.Parent and gunModel:FindFirstChild("MuzzlePlug")
	if not muzzlePlug or not targetRoot or not targetRoot.Parent then
		return
	end

	local lastOrigin = muzzlePlug.CFrame:PointToWorldSpace(Vector3.new(muzzlePlug.Size.X / 2, 0, 0))
	local lastTargetPosition = targetRoot.Position

	local function getFrame()
		if muzzlePlug.Parent then
			lastOrigin = muzzlePlug.CFrame:PointToWorldSpace(Vector3.new(muzzlePlug.Size.X / 2, 0, 0))
		end
		if targetRoot.Parent then
			lastTargetPosition = targetRoot.Position
		end
		local offset = lastTargetPosition - lastOrigin
		if offset.Magnitude < 0.1 then
			return CFrame.new(lastOrigin)
		end
		return FX.facing(lastOrigin, offset)
	end

	M1.charge(shotStage, duration, power, getFrame, function()
		return lastTargetPosition
	end)
end

local function fireDroneM1(side, targetRoot, shotStage, power, onImpact)
	if not targetRoot or not targetRoot.Parent then
		return
	end

	local shooter = findDroneRig(side)
	if not shooter then
		return
	end

	local palette = VFX.palette
	local accent = FX.accent()
	local ball = Enum.PartType.Ball

	local function getMuzzlePosition()
		return (shooter.model:GetPivot() * CFrame.new(0, 0, -0.09)).Position
	end

	local startPosition = getMuzzlePosition()
	local lastTargetPosition = targetRoot.Position
	local initialOffset = lastTargetPosition - startPosition
	local initialDirection = initialOffset.Magnitude > 0.1 and initialOffset.Unit or shooter.model:GetPivot().LookVector
	local totalTime = M1.travelTime + M1.holdTime + M1.collapseTime

	-- the drone holds its aim a moment longer and recoils
	local now = os.clock()
	if shooter.m1Aim then
		shooter.m1Aim.releaseAt = now + M1.aimHold
	end
	shooter.m1Kick = { start = now, direction = -initialDirection, power = power }

	-- release: the charge core blooms outward from the size it ended at
	local flareSize = 0.05 + M1.coreMax * power
	local flare = FX.part(shotStage, ball, palette.hot, 0, Vector3.one * flareSize, CFrame.new(startPosition))
	FX.tween(flare, 0.2, { Size = Vector3.one * 2.1 * power, Transparency = 1 })
	local flareHalo = FX.part(shotStage, ball, palette.red, 0.4, Vector3.one * flareSize * 2.2, CFrame.new(startPosition))
	FX.tween(flareHalo, 0.28, { Size = Vector3.one * 3.6 * power, Transparency = 1 })
	Debris:AddItem(flare, 0.4)
	Debris:AddItem(flareHalo, 0.4)
	FX.star(shotStage, startPosition + initialDirection * 0.3, 3.6 * power, 0.2, palette.hot)
	FX.emitAt(shotStage, FX.facing(startPosition, initialDirection), 8, {
		speed = NumberRange.new(22, 52),
		spread = Vector2.new(18, 18),
		lifetime = NumberRange.new(0.08, 0.2),
		size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.28), NumberSequenceKeypoint.new(1, 0) }),
		acceleration = Vector3.zero,
		drag = 3,
	})
	FX.comboFlash(shotStage, startPosition, lastTargetPosition, palette.bright, 7, 0.4)
	FX.shockRing(shotStage, FX.facing(startPosition + initialDirection * 0.5, initialDirection), {
		startRadius = 0.3,
		endRadius = 2.6 * power,
		duration = 0.24,
		thickness = 0.12,
		color = palette.bright,
		segments = 20,
		startTransparency = 0.1,
	})

	local headPart, headAttachment = FX.node(shotStage)
	local tailPart, tailAttachment = FX.node(shotStage)
	local cometPart, cometAttachment = FX.node(shotStage)
	headPart.Position = startPosition
	tailPart.Position = startPosition
	cometPart.Position = startPosition
	local auraBeam = FX.beam(shotStage, tailAttachment, headAttachment, ColorSequence.new(palette.red), 1.3 * power, 1.3 * power, NumberSequence.new(0.8), 0)
	local glowBeam = FX.beam(shotStage, tailAttachment, headAttachment, ColorSequence.new(palette.bright, palette.red), 0.55 * power, 0.55 * power, NumberSequence.new(0.2), 0.02)
	local coreBeam = FX.beam(shotStage, tailAttachment, headAttachment, ColorSequence.new(palette.hot), 0.2 * power, 0.2 * power, NumberSequence.new(0), 0.04)
	-- comet: a white-hot leading edge that fades back into the beam while it travels
	local cometBeam = FX.beam(
		shotStage,
		cometAttachment,
		headAttachment,
		ColorSequence.new({
			ColorSequenceKeypoint.new(0, palette.red),
			ColorSequenceKeypoint.new(0.6, palette.hot),
			ColorSequenceKeypoint.new(1, Color3.new(1, 1, 1)),
		}),
		0.05,
		0.9 * power,
		NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.35, 0.3),
			NumberSequenceKeypoint.new(1, 0),
		}),
		0.06
	)
	local headBall = FX.part(shotStage, ball, Color3.new(1, 1, 1), 0, Vector3.one * 0.6 * power, CFrame.new(startPosition))

	-- glitter shed along the whole beam (box shaped emitter stretched over the path)
	local sparklePart = FX.part(shotStage, Enum.PartType.Block, palette.hot, 1, Vector3.new(0.5, 0.5, 1), CFrame.new(startPosition))
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Enabled = false
	sparkle.Rate = 0
	sparkle.LightEmission = 1
	sparkle.LightInfluence = 0
	sparkle.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, palette.hot),
		ColorSequenceKeypoint.new(0.45, accent),
		ColorSequenceKeypoint.new(1, palette.deep),
	})
	sparkle.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(0.25, 0.3),
		NumberSequenceKeypoint.new(1, 0),
	})
	sparkle.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(0.6, 0.35),
		NumberSequenceKeypoint.new(1, 1),
	})
	sparkle.Lifetime = NumberRange.new(0.35, 0.6)
	sparkle.Speed = NumberRange.new(0.5, 3)
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.Acceleration = Vector3.new(0, 5, 0)
	sparkle.Drag = 2.5
	sparkle.Rotation = NumberRange.new(0, 360)
	sparkle.RotSpeed = NumberRange.new(-90, 90)
	local sparkleShaped = pcall(function()
		sparkle.Shape = Enum.ParticleEmitterShape.Box
		sparkle.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	end)
	sparkle.Parent = sparklePart

	local scorch, scorchLight, impactAt

	local function spawnImpact(impactPosition, impactDirection)
		impactAt = os.clock()

		-- white-hot flash and a wider red bloom
		local impactFlash = FX.part(shotStage, ball, palette.hot, 0.05, Vector3.one * 0.9 * power, CFrame.new(impactPosition))
		FX.tween(impactFlash, 0.2, { Size = Vector3.one * 3.4 * power, Transparency = 1 })
		local impactBloom = FX.part(shotStage, ball, palette.red, 0.45, Vector3.one * 1.4 * power, CFrame.new(impactPosition))
		FX.tween(impactBloom, 0.32, { Size = Vector3.one * 5.2 * power, Transparency = 1 })
		Debris:AddItem(impactFlash, 0.5)
		Debris:AddItem(impactBloom, 0.5)

		-- lingering scorch glow that cools with the beam
		scorch = FX.part(shotStage, ball, palette.red, 0.5, Vector3.one * 0.9 * power, CFrame.new(impactPosition))
		scorchLight = Instance.new("PointLight")
		scorchLight.Color = palette.bright
		scorchLight.Range = 9
		scorchLight.Brightness = 5
		scorchLight.Shadows = false
		scorchLight.Parent = scorch

		FX.star(shotStage, impactPosition, 4.6 * power, 0.24, palette.hot)
		FX.emitAt(shotStage, FX.facing(impactPosition, -impactDirection), 14, {
			speed = NumberRange.new(14, 42),
			spread = Vector2.new(70, 70),
			lifetime = NumberRange.new(0.14, 0.32),
			size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.32), NumberSequenceKeypoint.new(1, 0) }),
			color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, palette.hot),
				ColorSequenceKeypoint.new(0.4, accent),
				ColorSequenceKeypoint.new(1, palette.deep),
			}),
			acceleration = Vector3.new(0, -30, 0),
			drag = 2.5,
		})
		FX.sparkField(shotStage, impactPosition, {
			count = 10,
			speedMin = 14,
			speedMax = 40,
			lifeMin = 0.2,
			lifeMax = 0.45,
			gravity = 45,
			thickness = 0.1,
			direction = -impactDirection,
			spread = 0.9,
		})
		FX.shockRing(shotStage, FX.facing(impactPosition - impactDirection * 0.4, impactDirection), {
			startRadius = 0.3,
			endRadius = 3.4 * power,
			duration = 0.28,
			thickness = 0.16,
			color = palette.bright,
			segments = 22,
			startTransparency = 0.1,
		})
		local disc = FX.part(shotStage, Enum.PartType.Cylinder, palette.bright, 0.25, Vector3.new(0.05, 0.6, 0.6), FX.axisFrame(impactPosition, impactDirection))
		FX.tween(disc, 0.18, { Size = Vector3.new(0.03, 5 * power, 5 * power), Transparency = 1 }).Completed:Once(function()
			disc:Destroy()
		end)

		-- ring on the floor under the victim
		local floorFrame, floorHit = FX.floorFrameAt(impactPosition, FX.ignoreList(shotStage, targetRoot.Parent), 0.12)
		if floorHit and (impactPosition - floorHit.Position).Magnitude < 9 then
			FX.dashRing(shotStage, floorFrame, {
				count = 20,
				color = palette.bright,
				startRadius = 0.8,
				endRadius = 4.4 * power,
				duration = 0.42,
				thickness = 0.14,
				spin = 1.4,
				fill = 0.55,
				startTransparency = 0.15,
			})
		end

		-- the victim heats up and cools off
		local victim = targetRoot.Parent
		if victim and victim:IsA("Model") then
			local heat = Instance.new("Highlight")
			heat.Adornee = victim
			heat.FillColor = palette.bright
			heat.OutlineColor = palette.hot
			heat.FillTransparency = 0.35
			heat.OutlineTransparency = 0.1
			heat.DepthMode = Enum.HighlightDepthMode.Occluded
			heat.Parent = shotStage
			FX.tween(heat, 0.38, { FillTransparency = 1, OutlineTransparency = 1 })
		end

		if onImpact then
			pcall(onImpact)
		end
	end

	local hasImpacted = false
	FX.run(shotStage, totalTime, function(_, elapsed)
		local muzzlePosition = getMuzzlePosition()
		if targetRoot.Parent then
			lastTargetPosition = targetRoot.Position
		end
		local offset = lastTargetPosition - muzzlePosition
		local distance = math.max(offset.Magnitude, 0.1)
		local direction = offset.Magnitude > 0.1 and offset.Unit or initialDirection

		local travelAlpha = math.clamp(elapsed / M1.travelTime, 0, 1)
		local collapseAlpha = math.clamp((elapsed - M1.travelTime - M1.holdTime) / M1.collapseTime, 0, 1)
		local fall = 1 - collapseAlpha * collapseAlpha * (3 - 2 * collapseAlpha)
		local travelled = (distance + M1.cometLength) * travelAlpha
		local headDistance = math.min(travelled, distance)
		local cometDistance = math.clamp(travelled - M1.cometLength, 0, distance)
		local tailDistance = distance * collapseAlpha ^ 1.8

		headPart.Position = muzzlePosition + direction * headDistance
		tailPart.Position = muzzlePosition + direction * tailDistance
		cometPart.Position = muzzlePosition + direction * math.max(cometDistance, tailDistance)
		cometBeam.Enabled = cometDistance < distance - 0.05

		if not hasImpacted and headDistance >= distance - 0.01 then
			hasImpacted = true
			spawnImpact(lastTargetPosition, direction)
			if sparkleShaped then
				sparklePart.Size = Vector3.new(0.5, 0.5, distance)
				sparklePart.CFrame = FX.facing(muzzlePosition + direction * distance / 2, direction)
				sparkle:Emit(34)
			end
			if distance > 6 then
				for index, fraction in ipairs({ 0.3, 0.62 }) do
					FX.shockRing(shotStage, FX.facing(muzzlePosition + direction * distance * fraction, direction), {
						startRadius = 0.3,
						endRadius = 1.1 + index * 0.2,
						duration = 0.26,
						thickness = 0.1,
						color = index % 2 == 0 and palette.hot or palette.bright,
						segments = 16,
						startTransparency = 0.25,
					})
				end
			end
		end

		local swell = 1 + 0.8 * math.exp(-elapsed * 26)
		local breath = 1 + 0.05 * math.sin(elapsed * 38)
		local scale = fall ^ 1.2 * swell * breath
		auraBeam.Width0 = 1.3 * power * scale
		auraBeam.Width1 = 1.3 * power * scale
		glowBeam.Width0 = 0.55 * power * scale
		glowBeam.Width1 = 0.55 * power * scale
		coreBeam.Width0 = 0.2 * power * scale
		coreBeam.Width1 = 0.2 * power * scale
		auraBeam.Transparency = NumberSequence.new(0.8 + 0.2 * collapseAlpha)
		glowBeam.Transparency = NumberSequence.new(0.2 + 0.8 * collapseAlpha ^ 2)
		coreBeam.Transparency = NumberSequence.new(collapseAlpha ^ 2.5)

		headBall.CFrame = CFrame.new(headPart.Position)
		headBall.Size = Vector3.one * math.max(0.6 * power * fall, 0.05)
		headBall.Transparency = collapseAlpha

		if scorch then
			scorch.CFrame = CFrame.new(lastTargetPosition)
			scorch.Size = Vector3.one * (0.9 + 1.4 * math.exp(-(os.clock() - impactAt) * 9)) * power * math.max(fall, 0.05)
			scorch.Transparency = 0.45 + 0.55 * collapseAlpha
			scorchLight.Brightness = 5 * fall
		end
	end, function()
		headBall:Destroy()
		headPart:Destroy()
		tailPart:Destroy()
		cometPart:Destroy()
		auraBeam:Destroy()
		glowBeam:Destroy()
		coreBeam:Destroy()
		cometBeam:Destroy()
		sparklePart:Destroy()
		if scorch then
			scorch:Destroy()
		end
	end)
end

-- gun finisher muzzle: the original big blast, plus lens stars, embers and a floor ring
function FX.m1GunMuzzle(stage, origin, direction, palette, feetPosition, ignore)
	FX.muzzleBurst(stage, origin, direction)
	local feetHit = feetPosition and FX.floorAt(feetPosition, ignore)
	if feetHit then
		local floorFrame = FX.facing(feetHit.Position + feetHit.Normal * 0.12, feetHit.Normal)
		FX.shockRing(stage, floorFrame, { startRadius = 0.8, endRadius = 13, duration = 0.4, thickness = 0.4, color = palette.red, segments = 40, startTransparency = 0.05 })
		FX.shockRing(stage, floorFrame, { startRadius = 0.6, endRadius = 8, duration = 0.28, thickness = 0.25, color = palette.hot, segments = 36, startTransparency = 0.1 })
		pcall(FX.dashRing, stage, floorFrame, {
			count = 30,
			color = palette.bright,
			startRadius = 1,
			endRadius = 9,
			duration = 0.5,
			thickness = 0.26,
			spin = 1.6,
			fill = 0.58,
			startTransparency = 0.15,
		})
	end
	pcall(function()
		FX.star(stage, origin + direction * 0.5, 8, 0.26, Color3.new(1, 1, 1))
		FX.star(stage, origin + direction * 0.5, 5, 0.2, palette.bright)
		FX.comboFlash(stage, origin, origin + direction * 4, palette.bright, 14, 0.45)
		FX.sparkField(stage, origin, {
			count = 12,
			speedMin = 30,
			speedMax = 80,
			lifeMin = 0.2,
			lifeMax = 0.5,
			gravity = 30,
			direction = direction,
			spread = 0.5,
		})
	end)
end

-- gun finisher impact: the original big impact, plus lens stars, embers, floor rings and cracks
function FX.m1GunImpact(stage, position, direction, palette, hitModel, ignore)
