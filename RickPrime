		gui.Parent = playerGui

		local function makeStreak(color, zIndex)
			local frame = Instance.new("Frame")
			frame.AnchorPoint = Vector2.new(0.5, 0.5)
			frame.Position = UDim2.fromScale(0.5, 0.5)
			frame.Size = UDim2.new(1.4, 0, 0, 2)
			frame.BorderSizePixel = 0
			frame.BackgroundColor3 = color
			frame.BackgroundTransparency = 1
			frame.ZIndex = zIndex
			local gradient = Instance.new("UIGradient")
			gradient.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0),
				NumberSequenceKeypoint.new(1, 1),
			})
			gradient.Parent = frame
			frame.Parent = gui
			return frame
		end
		streakSoft = makeStreak(palette.bright, 1)
		streak = makeStreak(palette.hot, 2)
	end

	local connection = RunService.PreRender:Connect(function()
		if destroyed then
			return
		end
		local now = os.clock()
		local elapsed = now - startedAt
		local beat = beatAt and beatStrength * math.exp(-(now - beatAt) * 13) or 0
		local finale = finaleAt and math.exp(-(now - finaleAt) * 3.2) or 0
		bloom.Intensity = 0.25 + 0.55 * math.clamp(elapsed / 1.5, 0, 1) + 0.5 * beat + 2.4 * finale
		bloom.Size = 26 + 20 * finale
		if streak then
			local strength = math.clamp(0.18 + 0.5 * beat + 1.2 * finale, 0, 1)
			local height = 2 + 7 * beat + 30 * finale
			streak.Size = UDim2.new(1.4, 0, 0, height)
			streak.BackgroundTransparency = 1 - strength
			streakSoft.Size = UDim2.new(1.6, 0, 0, height * 7)
			streakSoft.BackgroundTransparency = 1 - math.clamp(strength * 0.28, 0, 0.5)
		end
	end)

	function screen.beat(strength)
		beatAt = os.clock()
		beatStrength = strength or 0.4
	end

	function screen.finale()
		if destroyed then
			return
		end
		finaleAt = os.clock()
		if not gui then
			return
		end
		local viewport = camera.ViewportSize
		local diameter = math.max(viewport.X, viewport.Y) * 2.4
		for index = 1, 2 do
			task.delay((index - 1) * 0.1, function()
				if destroyed then
					return
				end
				local ring = Instance.new("Frame")
				ring.AnchorPoint = Vector2.new(0.5, 0.5)
				ring.Position = UDim2.fromScale(0.5, 0.5)
				ring.Size = UDim2.fromOffset(40, 40)
				ring.BackgroundTransparency = 1
				ring.BorderSizePixel = 0
				ring.ZIndex = 3
				local corner = Instance.new("UICorner")
				corner.CornerRadius = UDim.new(0.5, 0)
				corner.Parent = ring
				local stroke = Instance.new("UIStroke")
				stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
				stroke.Color = index == 1 and palette.hot or palette.red
				stroke.Thickness = index == 1 and 10 or 16
				stroke.Transparency = 0.05
				stroke.Parent = ring
				ring.Parent = gui
				FX.tween(ring, 0.8, { Size = UDim2.fromOffset(diameter, diameter) }, Enum.EasingStyle.Cubic)
				FX.tween(stroke, 0.8, { Transparency = 1, Thickness = 1 })
				Debris:AddItem(ring, 1)
			end)
		end
	end

	function screen.destroy()
		if destroyed then
			return
		end
		destroyed = true
		connection:Disconnect()
		if gui then
			gui:Destroy()
		end
		bloom:Destroy()
	end

	task.delay(6, screen.destroy)
	return screen
end

-- drone charge: gathering motes, four point star, lock-on laser
function FX.attack2Charge(side, targetRoot, stage, duration)
	local shooter = findDroneRig(side)
	if not shooter or not targetRoot or not targetRoot.Parent then
		return
	end
	local palette = VFX.palette
	local accent = FX.accent()
	local lastTarget = targetRoot.Position

	local function getFrame()
		local pivot = shooter.model:GetPivot()
		local muzzle = (pivot * CFrame.new(0, 0, -0.09)).Position
		if targetRoot.Parent then
			lastTarget = targetRoot.Position
		end
		local offset = lastTarget - muzzle
		if offset.Magnitude < 0.1 then
			return pivot.Rotation + muzzle
		end
		return CFrame.lookAt(muzzle, muzzle + offset.Unit)
	end

	local startFrame = getFrame()
	local core = FX.part(stage, Enum.PartType.Ball, palette.hot, 0, Vector3.one * 0.05, startFrame)
	local halo = FX.part(stage, Enum.PartType.Ball, palette.red, 0.55, Vector3.one * 0.1, startFrame)
	local light = Instance.new("PointLight")
	light.Color = palette.bright
	light.Range = 8
	light.Brightness = 1
	light.Shadows = false
	light.Parent = core

	-- four point star
	local starPart, starAttachment = FX.node(stage)
	local spikes = {}
	for index = 1, 4 do
		local tipPart, tipAttachment = FX.node(stage)
		spikes[index] = {
			part = tipPart,
			beam = FX.beam(stage, starAttachment, tipAttachment, ColorSequence.new(index % 2 == 0 and palette.bright or palette.hot), 0.4, 0, NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 0.85),
			}), 0.03),
		}
	end

	-- energy gathering inward (sphere shell, particles travel toward the centre)
	local gatherPart = FX.part(stage, Enum.PartType.Block, palette.hot, 1, Vector3.one * 7, startFrame)
	local gather = Instance.new("ParticleEmitter")
	gather.Rate = 190
	gather.LightEmission = 1
	gather.LightInfluence = 0
	gather.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, palette.hot),
		ColorSequenceKeypoint.new(0.5, accent),
		ColorSequenceKeypoint.new(1, palette.red),
	})
	gather.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(0.3, 0.34),
		NumberSequenceKeypoint.new(1, 0),
	})
	gather.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, 0.05),
		NumberSequenceKeypoint.new(1, 0.3),
	})
	gather.Lifetime = NumberRange.new(0.15, 0.19)
	gather.Speed = NumberRange.new(18, 22)
	gather.Rotation = NumberRange.new(0, 360)
	gather.Drag = 0
	gather.Acceleration = Vector3.zero
	pcall(function()
		gather.Shape = Enum.ParticleEmitterShape.Sphere
		gather.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		gather.ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward
	end)
	gather.Parent = gatherPart

	-- lock-on laser
	local laserFar, laserFarAttachment = FX.node(stage)
	local laserNear, laserNearAttachment = FX.node(stage)
	local laser = FX.beam(stage, laserNearAttachment, laserFarAttachment, ColorSequence.new(palette.red), 0.06, 0.06, NumberSequence.new(1), 0)

	FX.run(stage, duration, function(progress, elapsed)
		local frame = getFrame()
		local center = frame * CFrame.new(0, 0, -0.2)
		local flicker = 1 + 0.12 * math.sin(elapsed * 71) + 0.06 * math.sin(elapsed * 113)
		local size = (0.08 + 1.9 * progress ^ 1.6) * flicker
		core.Size = Vector3.one * size
		core.CFrame = center
		halo.Size = Vector3.one * size * 2.3
		halo.CFrame = center
		light.Brightness = 1 + 7 * progress
		light.Range = 8 + 6 * progress
		gatherPart.CFrame = center

		starPart.Position = center.Position
		local reach = (0.6 + 3.8 * progress ^ 1.3) * (1 + 0.1 * math.sin(elapsed * 63))
		local spin = elapsed * 9
		for index, spike in ipairs(spikes) do
			local angle = spin + (index - 1) * math.pi / 2
			local direction = center.RightVector * math.cos(angle) + center.UpVector * math.sin(angle)
			spike.part.Position = center.Position + direction * reach * (index % 2 == 0 and 0.62 or 1)
			spike.beam.Width0 = 0.5 * (0.4 + progress)
		end

		laserNear.Position = center.Position
		laserFar.Position = lastTarget
		laser.Transparency = NumberSequence.new(1 - 0.55 * progress)
	end, function()
		core:Destroy()
		halo:Destroy()
		gatherPart:Destroy()
		starPart:Destroy()
		laserFar:Destroy()
		laserNear:Destroy()
		laser:Destroy()
		for _, spike in ipairs(spikes) do
			spike.part:Destroy()
			spike.beam:Destroy()
		end
	end)
end

-- one braided death ray from a drone
function FX.attack2Ray(side, targetRoot, stage)
	if not (targetRoot and targetRoot.Parent and stage.Parent) then
		return
	end
	local shooter = findDroneRig(side)
	if not shooter then
		return
	end
	local palette = VFX.palette
	local accent = FX.accent()
	local rng = FX.rng

	local function getMuzzlePosition()
		return (shooter.model:GetPivot() * CFrame.new(0, 0, -0.09)).Position
	end

	local jitter = Vector3.new(rng:NextNumber(-2.6, 2.6), rng:NextNumber(-3, 3), rng:NextNumber(-2.6, 2.6))
	local startPosition = getMuzzlePosition()
	local lastTarget = targetRoot.Position + jitter
	local initialOffset = lastTarget - startPosition
	local initialDirection = initialOffset.Magnitude > 0.1 and initialOffset.Unit or shooter.model:GetPivot().LookVector
	local totalTime = DRONE_BEAM_TRAVEL_TIME + DRONE_BEAM_HOLD_TIME + DRONE_BEAM_COLLAPSE_TIME
	local widthMul = rng:NextNumber(0.85, 1.4)
	local overshoot = rng:NextNumber(2.5, 6)

	-- muzzle: lens star + spark spray + light
	FX.star(stage, startPosition + initialDirection * 0.3, rng:NextNumber(3.4, 5), 0.14, palette.hot)
	FX.emitAt(stage, CFrame.lookAt(startPosition, startPosition + initialDirection), 5, {
		speed = NumberRange.new(24, 58),
		spread = Vector2.new(15, 15),
		lifetime = NumberRange.new(0.07, 0.17),
		size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) }),
		acceleration = Vector3.zero,
		drag = 3,
	})
	if rng:NextNumber() < 0.5 then
		FX.comboFlash(stage, startPosition, lastTarget, palette.bright, 5, 0.18)
	end

	local headPart, headAttachment = FX.node(stage)
	local tailPart, tailAttachment = FX.node(stage)
	headPart.Position = startPosition
	tailPart.Position = startPosition
	local auraBeam = FX.beam(stage, tailAttachment, headAttachment, ColorSequence.new(palette.red), 1.5 * widthMul, 1.5 * widthMul, NumberSequence.new(0.82), 0)
	local glowBeam = FX.beam(stage, tailAttachment, headAttachment, ColorSequence.new(palette.bright, palette.red), 0.6 * widthMul, 0.6 * widthMul, NumberSequence.new(0.2), 0.02)
	local coreBeam = FX.beam(stage, tailAttachment, headAttachment, ColorSequence.new(palette.hot), 0.2 * widthMul, 0.2 * widthMul, NumberSequence.new(0), 0.04)
	local braid = FX.attack2Braid(stage, tailAttachment, headAttachment, widthMul, 1.5)
	local headBall = FX.part(stage, Enum.PartType.Ball, palette.hot, 0, Vector3.one * 0.6 * widthMul, CFrame.new(startPosition))

	local function spawnImpact(position, direction)
		FX.star(stage, position, rng:NextNumber(4, 6.5), 0.2, palette.hot)
		FX.emitAt(stage, FX.facing(position, -direction), 8, {
			speed = NumberRange.new(14, 44),
			spread = Vector2.new(70, 70),
			lifetime = NumberRange.new(0.12, 0.3),
			size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.34), NumberSequenceKeypoint.new(1, 0) }),
			color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, palette.hot),
				ColorSequenceKeypoint.new(0.4, accent),
				ColorSequenceKeypoint.new(1, palette.deep),
			}),
			acceleration = Vector3.new(0, -30, 0),
			drag = 2.5,
		})
		local disc = FX.part(stage, Enum.PartType.Cylinder, palette.bright, 0.25, Vector3.new(0.05, 0.6, 0.6), FX.axisFrame(position, direction))
		FX.tween(disc, 0.16, { Size = Vector3.new(0.03, 5.5, 5.5), Transparency = 1 }).Completed:Once(function()
			disc:Destroy()
		end)
		local lance = FX.part(stage, Enum.PartType.Block, palette.bright, 0.1, Vector3.new(0.22, 0.22, 6), CFrame.lookAt(position + direction * 3, position + direction * 6))
		FX.tween(lance, 0.12, { Transparency = 1, Size = Vector3.new(0.03, 0.03, 12) }).Completed:Once(function()
			lance:Destroy()
		end)
	end

	local hasImpacted = false
	FX.run(stage, totalTime, function(_, elapsed)
		local muzzlePosition = getMuzzlePosition()
		if targetRoot.Parent then
			lastTarget = targetRoot.Position + jitter
		end
		local offset = lastTarget - muzzlePosition
		local distance = math.max(offset.Magnitude, 0.1)
		local direction = offset.Magnitude > 0.1 and offset.Unit or initialDirection

		local travelAlpha = math.clamp(elapsed / DRONE_BEAM_TRAVEL_TIME, 0, 1)
		local collapseAlpha = math.clamp((elapsed - DRONE_BEAM_TRAVEL_TIME - DRONE_BEAM_HOLD_TIME) / DRONE_BEAM_COLLAPSE_TIME, 0, 1)
		local reach = distance + overshoot
		local headDistance = reach * (1 - (1 - travelAlpha) ^ 2)
		local tailDistance = reach * collapseAlpha ^ 2.2
		headPart.Position = muzzlePosition + direction * headDistance
		tailPart.Position = muzzlePosition + direction * tailDistance

		if not hasImpacted and headDistance >= distance then
			hasImpacted = true
			spawnImpact(lastTarget, direction)
		end

		local widthScale = (1 - collapseAlpha) ^ 1.4 * (1 + 0.9 * math.exp(-elapsed * 45)) * (1 + 0.07 * math.sin(elapsed * 220))
		auraBeam.Width0 = 1.5 * widthMul * widthScale
		auraBeam.Width1 = 1.5 * widthMul * widthScale
		glowBeam.Width0 = 0.6 * widthMul * widthScale
		glowBeam.Width1 = 0.6 * widthMul * widthScale
		coreBeam.Width0 = 0.2 * widthMul * widthScale
		coreBeam.Width1 = 0.2 * widthMul * widthScale
		auraBeam.Transparency = NumberSequence.new(0.82 + 0.18 * collapseAlpha)
		glowBeam.Transparency = NumberSequence.new(0.2 + 0.8 * collapseAlpha ^ 2)
		coreBeam.Transparency = NumberSequence.new(collapseAlpha ^ 3)
		braid(direction, elapsed, widthScale, collapseAlpha)

		headBall.CFrame = CFrame.new(headPart.Position)
		headBall.Size = Vector3.one * math.max(0.6 * widthMul * (1 - collapseAlpha), 0.05)
		headBall.Transparency = collapseAlpha
	end, function()
		headBall:Destroy()
		headPart:Destroy()
		tailPart:Destroy()
		auraBeam:Destroy()
		glowBeam:Destroy()
		coreBeam:Destroy()
	end)
end

-- clone gun: cross shaped muzzle flash, petals, spray, ejected casing
function FX.attack2GunMuzzle(owner, origin, direction, palette, big)
