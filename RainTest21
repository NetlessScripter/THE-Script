---------------------------------------------------------------- spawn rays
local function areaRay()
	local R = CFG.AreaRadius
	local a, r = rand(0, 2 * pi), R * sqrt(rng:NextNumber())
	local c = camPos + flatLook * (R * 0.4)
	local target = V3(c.X + cos(a) * r, camPos.Y, c.Z + sin(a) * r)
	local H = CFG.RoofHeight
	local vel = V3(W.X, -terminalSpeed(sampleDiameter()) * VS, W.Z)
	local dir = vel.Unit
	local res = ray(target - dir * H, dir * (H + 90))
	if res and not isBodyPart(proxyOf[res.Instance] or res.Instance) then newDrop(res, 1) end
end

---------------------------------------------------------------- main update
local spawnAcc, nextCam = 0, 0
local function update(delta)
	dt = clamp(delta, 1 / 240, 0.1)
	now = os.clock()
	rays, splashN = 0, 0
	cam = Workspace.CurrentCamera
	if not cam then return end
	local cf = cam.CFrame
	camPos = cf.Position
	local lk = cf.LookVector
	flatLook = V3(lk.X, 0, lk.Z)
	flatLook = flatLook.Magnitude > 0.01 and flatLook.Unit or ZERO

	-- quality governor
	fpsAvg += (1 / dt - fpsAvg) * 0.04
	if CFG.AutoQuality then
		if fpsAvg < CFG.TargetFPS then q = max(0.3, q - dt * 0.15)
		elseif fpsAvg > CFG.TargetFPS + 8 then q = min(1, q + dt * 0.05) end
	else q = 1 end
	rayCap = floor(40 * q) + 10

	-- physics scales follow Workspace.Gravity / WorldScale / Intensity live
	updatePhysics()
	if GE ~= pGE or LS ~= pLS then pGE, pLS = GE, LS; syncSplash() end

	-- wind: horizontal air velocity (m/s -> studs/s). Drops move with the air sideways and fall at their own terminal speed
	if CFG.Wind then
		local a = rad(CFG.WindDir)
		local gust = 1 + CFG.Gustiness * math.noise(now * CFG.GustSpeed, 17.3) * 2
		W = V3(sin(a), 0, cos(a)) * (CFG.WindStrength * max(gust, 0) * VS)
	else W = ZERO end
	local rainVel = V3(W.X, -terminalSpeed(meanD) * VS, W.Z) -- representative drop: used for roof checks and the density scaling
	rainDir = rainVel.Unit
	rainSpeed = rainVel.Magnitude

	if filtersDirty then setFilters() end
	if now >= nextChars then nextChars = now + 0.5; refreshChars() end
	if now >= nextCam then nextCam = now + 0.25; camSh = sheltered(camPos) end
	ap = max(CFG.AppearTime, 0.02)

	-- spawn
	if CFG.Enabled and not camSh then
		local want = CFG.Rate * q * dt + spawnAcc
		local n = floor(want)
		spawnAcc = want - n
		for _ = 1, min(n, 8) do
			if rays >= rayCap then break end
			areaRay()
		end
	else spawnAcc = 0 end

	-- statics
	for i = #S, 1, -1 do
		local o = S[i]
		local age = now - o.born
		if age >= o.life then
			vanish(o.p, V3(o.sz, o.sz * o.fl, o.sz)); rem(S, i)
		else
			if age < ap then
				o.p.Size = V3(o.sz, o.sz * o.fl, o.sz) * (0.25 + 0.75 * age / ap)
			elseif not o.full then
				o.p.Size = V3(o.sz, o.sz * o.fl, o.sz); o.full = true
			end
			local h = o.host
			if h then
				if h.Parent == nil then
					drop(o.p); rem(S, i)
				else
					local c = h.CFrame
					if c ~= o.hcf then
						local d = c * o.hcf:Inverse()
						o.hcf = c; o.cf = d * o.cf
						mv(o.p, o.cf)
					end
				end
			end
		end
	end

	-- sliders
	for i = #L, 1, -1 do
		local s = L[i]
		local status = 0
		local h = s.host
		if h then
			if h.Parent == nil then
				status = 1
			else
				local c = h.CFrame
				if c ~= s.hcf then
					local d = c * s.hcf:Inverse()
					s.hcf = c
					s.pos = d * s.pos; s.tail = d * s.tail
					s.nrm = d:VectorToWorldSpace(s.nrm)
					s.vel = d:VectorToWorldSpace(s.vel)
					s.out = d:VectorToWorldSpace(s.out)
				end
			end
		end
		if status == 0 then
			if now - s.born > s.life then
				status = 1
			else
				s.acc += dt
				if s.acc >= s.nxt and rays < rayCap then
					local hh = min(s.acc, 0.15)
					s.acc = 0; s.nxt = rand(CFG.StepMin, CFG.StepMax)
					status = stepSlider(s, hh)
				end
			end
		end
		if status == 1 then finishSlider(s); rem(L, i)
		elseif status == 2 then rem(L, i)
		else drawSlider(s) end
	end

	-- trails
	for i = #T, 1, -1 do
		local t = T[i]
		local age = now - t.born
		if age >= t.life then
			drop(t.p); rem(T, i)
		else
			local h = t.host
			if h then
				if h.Parent == nil then
					drop(t.p); rem(T, i); continue
				end
				local c = h.CFrame
				if c ~= t.hcf then
					local d = c * t.hcf:Inverse()
					t.hcf = c; t.cf = d * t.cf
					mv(t.p, t.cf)
				end
			end
			if now >= t.nu then
				local f = age / t.life
				local k = 1 - CFG.AgeTaper * f
				t.p.Size = V3(t.len, t.th * k, t.sw * k)
				t.p.Transparency = t.t0 + (1 - t.t0) * f * f * f
				t.nu = now + t.life / 10
			end
		end
	end

	-- drips: ballistic under world gravity, with quadratic air drag toward each bead's own terminal speed (relative to the wind)
	for i = #D, 1, -1 do
		local d = D[i]
		local h = min(dt, 0.05)
		local vtE = d.vt * VS
		local c = GE * (d.vel - W).Magnitude / (vtE * vtE)
		local v = (d.vel + (V3(0, -GE, 0) + W * c) * h) / (1 + c * h)
		local rel = v - W -- speed through the air can't overshoot terminal speed on a long frame (a bead dropped into a gust may start above it)
		local relMax = max(vtE * 1.1, (d.vel - W).Magnitude)
		local relMag = rel.Magnitude
		if relMag > relMax then v = W + rel * (relMax / relMag) end
		local spd = v.Magnitude
		local step = v * h
		local done = false
		if now - d.born > 3.5 or d.pos.Y < camPos.Y - 160 then
			done = true
		else
			local res = nil
			if rays < rayCap + 25 then res = ray(d.pos, step + v.Unit * d.sz) end
			if res then
				if res.Material ~= Enum.Material.Water then
					splash(res.Position, res.Normal, 2)
					if CFG.Relanding then newDrop(res, 1.1) end
				end
				done = true
			else
				d.pos = d.pos + step; d.vel = v
				local dirv = v / max(spd, 1e-3)
				d.p.Size = V3(d.sz + spd * CFG.Shutter, d.sz * 0.9, d.sz * 0.9) -- motion blur grows with speed
				mv(d.p, frame(d.pos, perp(dirv), dirv))
			end
		end
		if done then drop(d.p); rem(D, i) end
	end


	-- vanishing
	for i = #V, 1, -1 do
		local v = V[i]
		local k = 1 - (now - v.t0) / 0.18
		if k <= 0 then drop(v.p); rem(V, i) else v.p.Size = v.sz * k end
	end

	if CFG.Enabled and not camSh then
		local wantedDrops = CFG.FallRate * q * dt * (rainSpeed / REF_SPEED) + fallSpawnAccumulator
		local spawnCount = floor(wantedDrops)
		fallSpawnAccumulator = wantedDrops - spawnCount
		for _ = 1, min(spawnCount, 100) do
			if #fallDrops >= CFG.MaxFall then break end
			spawnFallDrop()
		end

		if #chars > 0 then
			local wantedBodyDrops = CFG.BodyRate * q * dt * min(#chars, 6) + bodyDropAccumulator
			local bodySpawnCount = floor(wantedBodyDrops)
			bodyDropAccumulator = wantedBodyDrops - bodySpawnCount
			for _ = 1, min(bodySpawnCount, 60) do
				if #fallDrops >= CFG.MaxFall then break end
				local character = chars[rng:NextInteger(1, #chars)]
				local cameraInsideLocal = character.loc and (camPos - character.r.Position).Magnitude < 2.2
				if not character.sh and not cameraInsideLocal then
					spawnFallDrop(character.r.Position + V3(rand(-1.7, 1.7), 0, rand(-1.7, 1.7)))
				end
			end
		end
	else
		fallSpawnAccumulator = 0
		bodyDropAccumulator = 0
	end

	for dropIndex = #fallDrops, 1, -1 do
		local fallDrop = fallDrops[dropIndex]
		local age = now - fallDrop.birth
		if age >= fallDrop.lifetime then
			if fallDrop.onBody then
				local fallDirection = fallDrop.velocity.Unit
				local currentPosition = fallDrop.origin + fallDrop.velocity * age
				local bodyHit = fallRaycast(currentPosition - fallDirection * 1.2, fallDirection * 4)
				if bodyHit and isBodyPart(proxyOf[bodyHit.Instance] or bodyHit.Instance)
					and (bodyHit.Position - camPos).Magnitude > 2.2 then
					newDrop(bodyHit, 1)
				end
			end
			if fallDrop.landing and rng:NextNumber() < CFG.FallSplash then
				splash(fallDrop.landing, fallDrop.normal, 1)
			end
			fallDrop.part.Parent = nil
			fallFree[#fallFree + 1] = fallDrop
			rem(fallDrops, dropIndex)
		else
			mv(fallDrop.part, fallDrop.rotation + (fallDrop.origin + fallDrop.velocity * age))
		end
	end

	-- apply moves
	if mvN > 0 then
		Workspace:BulkMoveTo(mvP, mvC, Enum.BulkMoveMode.FireCFrameChanged)
		table.clear(mvP); table.clear(mvC); mvN = 0
	end
end

local errd = false
conns[#conns + 1] = RunService.RenderStepped:Connect(function(delta)
	if not alive then return end
	local ok, err = pcall(update, delta)
	if not ok and not errd then errd = true; warn("RealRain:", err) end
end)

---------------------------------------------------------------- look / hooks
local function applyLook()
	MAT = Enum.Material[CFG.Material]
	COL = COLORS[CFG.WaterColor] or COLORS[1]
	for _, p in ipairs(beads) do
		p.Material = MAT; p.Color = COL; p.CastShadow = CFG.CastShadow
	end
	for _, part in ipairs(fallParts) do
		part.Material = MAT; part.Color = COL; part.Transparency = CFG.FallTrans
	end
end

local ctrls = {}
local HOOKS = {
	Material = applyLook, WaterColor = applyLook, CastShadow = applyLook, FallTrans = applyLook,
	PreciseMesh = function(v)
		if v then nextScan = 0; for _, c in ipairs(chars) do scanChar(c.m) end end
	end,
}
local function set(key, v)
	CFG[key] = v
	local h = HOOKS[key]
	if h then h(v) end
	local c = ctrls[key]
	if c then c() end
end
local function preset(name)
	local p = PRESETS[name]
	if not p then return end
	for k, v in pairs(p) do set(k, v) end
end

