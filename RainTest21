local function underObject(position, length)
	local remaining = length or 120
	local origin = position
	local ignoreList = getIgnoreList()
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = ignoreList
	raycastParams.IgnoreWater = true

	for _ = 1, 32 do
		local result = workspace:Raycast(origin, UP_VEC * remaining, raycastParams)
		if not result then
			return false
		end

		local hit = result.Instance
		if not hit:IsA("BasePart") or hit.Transparency < 1 then
			return true
		end

		table.insert(ignoreList, hit)
		raycastParams.FilterDescendantsInstances = ignoreList
		remaining -= (result.Position - origin).Magnitude + 0.01
		if remaining <= 0 then
			return false
		end
		origin = result.Position + UP_VEC * 0.01
	end

	return false
end

local function createDroplet()
	local scale = Settings.Size * (0.8 + math.random() * 0.4)
	local mainOffset = CFrame.new(math.random() * 2.4 - 1.2, math.random() * 2 - 1, -1)

	local function addDroplet(partScale, offset)
		local droplet = DropletPool:Get()
		local mesh = droplet:FindFirstChild("Mesh")
		mesh.Scale = Vector3.new(partScale, partScale, partScale)
		mesh.Offset = EMPTY_VEC
		droplet.Color = Settings.Tint
		droplet.Transparency = 0.7
		Offsets[droplet] = offset
		Animations[droplet] = {
			startClock = os.clock(),
			scale = partScale,
			stretch = (0.5 + math.random() * 0.5) * partScale,
			mesh = mesh,
		}
		droplet.Parent = ScreenDroplets
	end

	addDroplet(scale, mainOffset)

	for _ = 1, math.random(1, 4) do
		local extrusionScale = math.max(scale / 1.5 + ((math.random() * 2 - 1) * (scale / 3)), scale * 0.1)
		local radius = extrusionScale * 0.6
		local extrusionOffset = mainOffset * CFrame.new(math.random() * 2 * radius - radius, math.random() * 2 * radius - radius, 0)
		addDroplet(extrusionScale, extrusionOffset)
	end
end

task.spawn(function()
	local accumulatedChance = 0
	local lastCheck = os.clock()

	while true do
		task.wait(math.max(Settings.UpdateFreq, 1 / 240))
		local now = os.clock()

		for droplet, data in pairs(Animations) do
			local elapsed = now - data.startClock
			if elapsed >= Settings.Fade then
				cleanup(droplet)
			else
				local alpha = elapsed / Settings.Fade
				local y = data.scale + data.stretch * alpha * alpha * alpha * alpha
				droplet.Transparency = 0.7 + 0.3 * alpha * alpha
				data.mesh.Scale = Vector3.new(data.scale, y, data.scale)
				data.mesh.Offset = Vector3.new(0, y / -2, 0)
			end
		end

		if GlassGraphics and CameraCF.LookVector.Y > -0.4 and not underObject(CameraCF.Position) then
			accumulatedChance += (now - lastCheck) * Settings.Rate
			local count = math.floor(accumulatedChance)
			for _ = 1, count do
				createDroplet()
			end
			accumulatedChance %= 1
		else
			accumulatedChance %= 1
		end

		lastCheck = now
	end
end)

