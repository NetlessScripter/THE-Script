local rainVelV = V3(0, -CFG.RefSpeed, 0)
local TH_MIN, TH_MAX = rad(15), rad(150)
local VMIN, VSAT = pi * (0.35e-3) ^ 3 / 6, pi * (0.5e-3) ^ 3 / 6

local function terminalSpeed(dmm)
	if dmm < 0.3 then dmm = 0.3 end
	return 9.65 - 10.3 * exp(-0.6 * dmm)
end

local function gammaDraw(shape, theta)
	local p = 1
	for _ = 1, shape do p = p * (rng:NextNumber() + 1e-9) end
	return -theta * math.log(p)
end

local function sampleDiameter()
	local theta = 1 / lamV
	for _ = 1, 4 do
		local d = gammaDraw(4, theta)
		if d >= CFG.DropMinMM and d <= CFG.DropMaxMM then return d end
	end
	return meanD
end

local function sampleVisible()
	local theta = 1 / lamV
	local k = clamp(floor(CFG.VisibleExp + 0.5), 0, 4) + 1
	for _ = 1, 4 do
		local d = gammaDraw(k, theta)
		if d >= CFG.DropMinMM and d <= CFG.DropMaxMM then return d end
	end
	return clamp(k * theta, CFG.DropMinMM, CFG.DropMaxMM)
end

local function updatePhysics()
	G0, RHO_W, GAMMA, MU_W = CFG.GravityEarth, CFG.WaterDensity, CFG.SurfaceTension, CFG.WaterViscosity
	WIND_K = 0.665 * CFG.DragCoef * CFG.AirDensity / RHO_W
	GE = max(Workspace.Gravity, 1)
	LS = max(CFG.WorldScale, 0.1)
	AS = GE / G0
	TS = sqrt(AS / LS)
	VS = LS * TS
	local R = max(CFG.Intensity, 0.1)
	lamV = 4.1 * R ^ (-0.21)
	meanD = clamp(4 / lamV, CFG.DropMinMM, CFG.DropMaxMM)
	rateVis = (R / CFG.RefIntensity) ^ CFG.RateExpVisible
	rateImp = (R / CFG.RefIntensity) ^ CFG.RateExpImpact
end

local function capGeom(V, th)
	th = clamp(th, TH_MIN, TH_MAX)
	local s, c = sin(th), cos(th)
	local f = (2 - 3 * c + c * c * c) / (3 * s * s * s)
	local a = (V / (pi * f)) ^ (1 / 3)
	return a, a * math.tan(th * 0.5), th
end

local function beadDims(a, h, th, vis)
	if th <= pi * 0.5 then
		return 2 * a * vis, 2 * h * vis, 0
	end
	local Rs = a / sin(th)
	return 2 * Rs * vis, 2 * Rs * vis, (h - Rs) * vis
end

local function forces(n, V, a, h, hyst, flow, out)
	local drive = V3(0, -GE, 0)
	drive = drive - n * drive:Dot(n)
	if W.X ~= 0 or W.Z ~= 0 then
		local wt = W - n * W:Dot(n)
		local wm = wt.Magnitude
		if wm > 1e-3 then
			local u = wm / VS * CFG.SlideInfluence
			drive = drive + wt * ((WIND_K * a * h / V * u * u * AS) / wm)
		end
	end
	if flow then
		if drive.Magnitude < GE * 0.2 then drive = drive + out * (GE * 0.3) end
		return drive, 0
	end
	return drive, 2 * GAMMA * a * hyst / (RHO_W * V) * AS
end

local function splashCount(Dmm, vn)
	if not vn or vn <= 0 then return 0 end
	local D = Dmm * 0.001
	local We = RHO_W * vn * vn * D / GAMMA
	local Oh = MU_W / sqrt(RHO_W * GAMMA * D)
	local K = sqrt(We) * Oh ^ -0.25
	if K < CFG.SplashK then return 0 end
	return min(5, floor(K / CFG.SplashK))
end

