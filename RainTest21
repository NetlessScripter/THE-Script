local chars, nextChars, nextScan = {}, 0, 0
local function refreshChars()
	local list, ms = {}, {}
	for _, pl in ipairs(Players:GetPlayers()) do
		local c = pl.Character
		local r = c and c:FindFirstChild("HumanoidRootPart")
		if r then
			ms[#ms + 1] = c
			if pl == plr or (r.Position - camPos).Magnitude < 55 then
				list[#list + 1] = { m = c, r = r, loc = pl == plr, sh = false }
			end
		end
	end
	models = ms
	filtersDirty = true
	setFilters()
	for _, c in ipairs(list) do c.sh = sheltered(c.r.Position + V3(0, 3, 0)) end
	chars = list
	if now >= nextScan then
		nextScan = now + 2
		for i = 1, min(#list, 6) do scanChar(list[i].m) end
	end
end

---------------------------------------------------------------- falling drops
local fallParts, fallFree, fallDrops = {}, {}, {}
local fallSpawnAccumulator = 0
local bodyDropAccumulator = 0
local bodyPartCache = setmetatable({}, { __mode = "k" })

function isBodyPart(instance)
	local cached = bodyPartCache[instance]
	if cached ~= nil then return cached end
	local model = instance:FindFirstAncestorOfClass("Model")
	local result = model ~= nil and model:FindFirstChildOfClass("Humanoid") ~= nil
	bodyPartCache[instance] = result
	return result
end

local function newFallDrop()
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Cylinder
	part.Anchored = true; part.CanCollide = false; part.CanTouch = false; part.CanQuery = false
	part.CastShadow = false; part.Material = MAT; part.Color = COL; part.Transparency = CFG.FallTrans
	part.Size = V3(1, 0.05, 0.05)
	fallParts[#fallParts + 1] = part
	return { part = part }
end

local function fallRaycast(origin, direction)
	local unit = direction.Unit
	for _ = 1, 3 do
		local result = Workspace:Raycast(origin, direction, rp)
		if not result then return nil end
		local base = proxyOf[result.Instance] or result.Instance
		if base.Transparency <= 0.9 and base.LocalTransparencyModifier <= 0.9 then return result end
		local advance = (result.Position - origin).Magnitude + 0.05
		if advance >= direction.Magnitude then return nil end
		origin = origin + unit * advance
		direction = unit * (direction.Magnitude - advance)
	end
	return nil
end

local function spawnFallDrop(aimPoint)
	local target = aimPoint
	if not target then
		local nearZone = rng:NextNumber() < CFG.FallNearShare
		local zoneRadius = nearZone and CFG.FallNearRadius or CFG.FallFarRadius
		local angle = rand(0, 2 * pi)
		local offsetDistance = zoneRadius * sqrt(rng:NextNumber())
		local center = camPos + flatLook * (zoneRadius * (nearZone and 0.35 or 0.5))
		target = V3(center.X + cos(angle) * offsetDistance, camPos.Y, center.Z + sin(angle) * offsetDistance)
	end
	-- every drop has its own size, hence its own terminal speed; horizontally it moves with the air, so bigger drops fall steeper in wind
	local diameter = sampleDiameter()
	local velocity = V3(W.X, -terminalSpeed(diameter) * VS * rand(0.97, 1.03), W.Z)
	local speed = velocity.Magnitude
	local direction = velocity / speed
	local startHeight = CFG.RoofHeight
	local origin = target - direction * startHeight
	local travelLimit = startHeight + 60
	local hit = fallRaycast(origin, direction * travelLimit)
	local travel = hit and (hit.Position - origin).Magnitude or travelLimit
	local cameraDistance = (target - camPos).Magnitude
	local length = speed * CFG.Shutter * (1 + cameraDistance / 60) -- motion-blur streak = speed x exposure time
	local width = CFG.FallWidth * (diameter / 2) * (1 + cameraDistance / 35)
	local lifetime = (travel - length * 0.5) / speed
	if lifetime <= 0.02 then return end

	local fallDrop = table.remove(fallFree) or newFallDrop()
	local part = fallDrop.part
	local rotation = CFrame.fromMatrix(ZERO, direction, direction:Cross(Vector3.xAxis).Unit)
	local birth = now - rand(0, dt)
	part.Size = V3(length, width, width)
	part.Transparency = 1 - (1 - CFG.FallTrans) * clamp(diameter / 2, 0.35, 2) -- a streak's brightness scales with the drop's diameter
	part.CFrame = rotation + (origin + velocity * (now - birth))
	part.Parent = rainF
	fallDrop.origin = origin
	fallDrop.velocity = velocity
	fallDrop.rotation = rotation
	fallDrop.birth = birth
	fallDrop.lifetime = lifetime
	local hitBase = hit and (proxyOf[hit.Instance] or hit.Instance)
	fallDrop.onBody = hitBase ~= nil and isBodyPart(hitBase)
	fallDrop.landing = not fallDrop.onBody and hit and hit.Material ~= Enum.Material.Water and hit.Normal.Y > 0.3 and hit.Position or nil
	fallDrop.normal = fallDrop.landing and hit.Normal or nil
	fallDrops[#fallDrops + 1] = fallDrop
end


---------------------------------------------------------------- gui
local function parentGui(g)
	local ok = pcall(function() g.Parent = gethui and gethui() or plr:WaitForChild("PlayerGui") end)
	if not ok then g.Parent = plr:WaitForChild("PlayerGui") end
