api.Disable = function() set("Enabled", false) end
api.Toggle = function() set("Enabled", not CFG.Enabled) end
api.Panel = function(v) showPanel(v ~= false) end
api.Destroy = function()
	alive = false
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	for _, s in ipairs(splashes) do pcall(function() s.a:Destroy() end) end
	for _, d in pairs({ rainF, proxyF, panel }) do pcall(function() d:Destroy() end) end
	env.RealRain = nil
end
env.RealRain = api
return api
