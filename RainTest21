local function splash(pos, n, cnt)
	if splashN >= 6 or not CFG.Enabled then return end
	splashN += 1
	splashI = splashI % #splashes + 1
	local s = splashes[splashI]
	s.a.WorldCFrame = frame(pos + n * 0.02, n)
	s.e:Emit(cnt or 2)
end

local pGE, pLS = 0, 0
local function syncSplash() -- ejected droplets are ballistic too: world gravity, ~0.6-1.8 m/s ejection, flight time follows
	local flight = 2.2 * VS / GE
	for _, s in ipairs(splashes) do
		s.e.Acceleration = V3(0, -GE, 0)
		s.e.Speed = NumberRange.new(0.6 * VS, 1.8 * VS)
		s.e.Lifetime = NumberRange.new(flight * 0.5, flight * 1.5)
	end
end

---------------------------------------------------------------- droplets
local newDrop, startDrip, isBodyPart
local ap = 0.12

function newDrop(res, sizeMul)
	local inst, n, pos = res.Instance, res.Normal, res.Position
	if res.Material == Enum.Material.Water then return end
	local dist = (pos - camPos).Magnitude
	if dist > 85 then return end
	if n.Y > 0.3 and rng:NextNumber() < 0.5 then splash(pos, n, 2) end
	local p = getBead()
	if not p then return end
	local f = rand(CFG.SizeMin, CFG.SizeMax) * (sizeMul or 1) -- one random factor drives the drawn size and the physical diameter
	local sz = CFG.DropSize * f * (1 + dist / 40)
	local Dm = CFG.NominalDiameter * f * 0.001 -- bead diameter in metres
	local fl = CFG.Flatness
	local tr = rand(CFG.TransMin, CFG.TransMax)
	p.Transparency = tr
	p.Size = V3(sz, sz * fl, sz) * 0.25
	local cf = frame(pos + n * (sz * fl * 0.2), n)
	p.CFrame = cf
	p.Parent = rainF

	local host, hcf = nil, nil
	if not inst.Anchored then host = inst; hcf = inst.CFrame end

	-- can this bead run? gravity along the surface (+ wind) has to beat the contact-line pinning of its material
	if #L < CFG.MaxSliders * q and dist < 60 and rng:NextNumber() < CFG.SlideChance then
		local body = isBodyPart(proxyOf[inst] or inst)
		local hBase = body and 0.45 or (HYST[res.Material.Name] or 0.5)
		local hyst = hBase * CFG.Hysteresis * rand(0.75, 1.3)
		local small = n.Y > 0.5 and inst.Size.Magnitude < 14 and hBase < 1.2
		local out = pos - inst.Position
		out = out - n * out:Dot(n)
		out = out.Magnitude > 1e-3 and out.Unit or perp(n)
		local drive, pin = forces(n, Dm, hyst, small, out)
		if drive.Magnitude > pin * 1.1 or n.Y < CFG.DetachAngle then
			local V0 = pi * Dm * Dm * Dm / 6
			local s = {
				p = p, pos = pos, nrm = n, vel = ZERO, sz = sz, sz0 = sz, fl = fl, tr = tr,
				sw = sz * rand(CFG.WidthMin, CFG.WidthMax), th = sz * fl * 0.6,
				tail = pos, born = now, life = rand(CFG.SliderLifeMin, CFG.SliderLifeMax),
				acc = 0, nxt = rand(CFG.StepMin, CFG.StepMax), ph = rand(0, 6.28),
				out = out, flow = small, slow = 0, host = host, hcf = hcf, hi = inst,
				segMax = max(sz * 5, 0.25),
				Dm = Dm, Dm0 = Dm, V = V0, V0 = V0, hyst = hyst,
			}
			s.sw0 = s.sw
			if CFG.Trails then
				local seg = getBead()
				if seg then
					seg.Transparency = min(1, tr + 0.12); seg.Size = V3(0.01, 0.01, 0.01)
					seg.CFrame = cf; seg.Parent = rainF
					s.seg = seg
				end
			end
			L[#L + 1] = s
			return
		end
	end
	S[#S + 1] = {
		p = p, pos = pos, nrm = n, sz = sz, fl = fl, cf = cf, born = now,
		life = rand(CFG.StaticLifeMin, CFG.StaticLifeMax), host = host, hcf = hcf,
	}
end

function startDrip(pos, vel, sz, bead, Dm)
	if not CFG.Drips or #D >= 60 then
		vanish(bead, bead.Size)
		return
	end
	D[#D + 1] = { p = bead, pos = pos, vel = vel, sz = sz, born = now, vt = terminalSpeed((Dm or 0.003) * 1000) }
end

local function segCF(s, a, b)
	local d = b - a
	local l = d.Magnitude
	if l < 1e-4 then return nil, nil end
	return V3(l + s.sw, s.th, s.sw), frame((a + b) * 0.5 + s.nrm * (s.th * 0.25), s.nrm, d / l)
end

local function stampTrail(s, keep)
	local seg = s.seg
	if not seg then return end
	local size, cf = segCF(s, s.tail, s.pos)
	if not size then
		if not keep then drop(seg); s.seg = nil end
		return
	end
	seg.Size = size; seg.CFrame = cf
	T[#T + 1] = {
		p = seg, born = now, life = rand(CFG.TrailLifeMin, CFG.TrailLifeMax), len = size.X, th = s.th, sw = s.sw,
		t0 = seg.Transparency, nu = now + 0.1, host = s.host, hcf = s.hcf, cf = cf,
	}
	s.seg = nil
	if keep then
		local nb = getBead()
		if nb then
			nb.Transparency = min(1, s.tr + 0.12); nb.Size = V3(0.01, 0.01, 0.01)
			nb.CFrame = cf; nb.Parent = rainF
			s.seg = nb
		end
	end
	s.tail = s.pos
end

local function finishSlider(s)
	stampTrail(s, false)
	vanish(s.p, s.p.Size)
end

-- returns 0 = keep, 1 = end, 2 = became a drip
local function stepSlider(s, h)
	local n, pos = s.nrm, s.pos

	-- pendant bead: on an underside it hangs, elongates as it swells, then pinches off from rest
	if not s.hang and n.Y < CFG.DetachAngle then
		stampTrail(s, false)
		s.hang = now; s.hangT = rand(0.12, 0.4); s.fl0 = s.fl; s.vel = ZERO
	end
	if s.hang then
		local k = clamp((now - s.hang) / s.hangT, 0, 1)
		s.fl = s.fl0 + (1.15 - s.fl0) * k * k
		if k >= 1 then
			startDrip(pos + n * 0.02, ZERO, s.sz, s.p, s.Dm)
			return 2
		end
		return 0
	end

	-- force balance along the surface: gravity + wind shear - contact-line pinning, resisted by contact-line friction
	local drive, pin = forces(n, s.Dm, s.hyst, s.flow, s.out)
	local dm = drive.Magnitude
	local net = dm > pin and drive * (1 - pin / dm) or ZERO
	local cE = 6 * CFG.ContactFriction / (pi * RHO_W * s.Dm * s.Dm) * TS
	local v = (s.vel + net * h) / (1 + cE * h)
	v = v - n * v:Dot(n)
	local spd = v.Magnitude
	if spd < CFG.MinFlow then s.slow += h else s.slow = 0 end
	if s.slow > 0.4 then return 1 end

	local d = v * h
	if spd > 0.02 then
		d = d + n:Cross(v / spd) * (sin(now * CFG.WobbleSpeed + s.ph) * CFG.Wobble * spd * h)
	end
	local dl = d.Magnitude
	if dl < 1e-5 then s.vel = v; return 0 end
	local dir = d / dl
	local snap = CFG.SurfaceSnap
	local np = pos + d
	local res

	-- obstacle ahead (inner corner / wall)
	res = ray(pos + n * snap, dir * (dl + s.sz * 0.6))
	if res and res.Normal:Dot(n) < 0.95 then
		np = res.Position
	else
		res = ray(np + n * snap, -n * (snap * 2 + s.sz))
		if not res then
			res = ray(np + dir * CFG.SeamForgive + n * snap, -n * (snap * 2 + s.sz))
		end
		if not res then
			-- wrap around the edge onto the side face
			res = ray(np - n * 0.3, -dir * (dl + 0.4))
		end
		if not res then
			-- ran off an edge: the bead leaves with the speed it had
			stampTrail(s, false)
			startDrip(np + n * 0.01, v, s.sz, s.p, s.Dm)
			return 2
		end
	end

	local rn = res.Normal
	local nn
	if n:Dot(rn) > 0.5 then
		nn = n * CFG.NormalSmoothing + rn * (1 - CFG.NormalSmoothing)
		nn = nn.Magnitude > 1e-3 and nn.Unit or rn
	else
		nn = rn
	end
	s.pos = res.Position; s.nrm = nn
	s.vel = v - nn * v:Dot(nn)
	local hi = res.Instance
	if hi ~= s.hi then
		s.hi = hi
		if hi.Anchored then s.host = nil; s.hcf = nil else s.host = hi; s.hcf = hi.CFrame end
	end

	-- the moving bead leaves a thin film behind it: it loses volume, shrinks, and stops once pinning wins (pinning grows as 1/D^2)
	local ds = (res.Position - pos).Magnitude / LS
	s.V -= 0.5 * s.Dm * CFG.FilmThickness * 1e-6 * ds
	if s.V < s.V0 * 0.166 then return 1 end
	s.Dm = (6 * s.V / pi) ^ (1 / 3)
	local sh = s.Dm / s.Dm0
	s.sz = s.sz0 * sh; s.th = s.sz * s.fl * 0.6; s.sw = s.sw0 * sh

	if s.seg and (s.pos - s.tail).Magnitude >= s.segMax then stampTrail(s, true) end
	return 0
end

local function drawSlider(s)
	local age = now - s.born
	local k = min(1, 0.25 + 0.75 * age / ap)
	local spd = s.vel.Magnitude
	local dir = spd > 0.02 and s.vel / spd or s.out
	local pp = s.pos + s.vel * s.acc
	local n = s.nrm
	local st = 1 + CFG.SlideStretch * clamp(spd / 3, 0, 1) * 2
	s.p.Size = V3(s.sz * st, s.sz * s.fl, s.sz) * k
	mv(s.p, frame(pp + n * (s.sz * s.fl * 0.2), n, dir))
	if s.seg then
		local size, cf = segCF(s, s.tail, pp)
		if size then s.seg.Size = size; mv(s.seg, cf) end
	end
end

---------------------------------------------------------------- precise characters (accessories / special meshes)
local queued, pq = {}, {}
local function scanChar(m)
	if not CFG.PreciseMesh then return end
	for _, d in ipairs(m:GetDescendants()) do
		if not queued[d] then
			if d:IsA("MeshPart") and d.MeshId ~= "" then
				queued[d] = true
				pq[#pq + 1] = { part = d, id = d.MeshId }
			elseif d:IsA("SpecialMesh") and d.MeshType == Enum.MeshType.FileMesh and d.MeshId ~= "" and d.Parent and d.Parent:IsA("BasePart") then
				queued[d] = true
				pq[#pq + 1] = { part = d.Parent, id = d.MeshId, sm = d }
			end
		end
	end
end

local function makeProxy(job)
	local orig = job.part
	if not orig.Parent or not CFG.PreciseMesh then return end
	local mp = AssetService:CreateMeshPartAsync(Content.fromUri(job.id), { CollisionFidelity = Enum.CollisionFidelity.PreciseConvexDecomposition })
	if not alive or not orig:IsDescendantOf(Workspace) then mp:Destroy(); return end
	local off = CFrame.identity
	if job.sm then
		mp.Size = mp.Size * job.sm.Scale
		off = CFrame.new(job.sm.Offset)
	else
		mp.Size = orig.Size
	end
	mp.CFrame = orig.CFrame * off
	mp.Anchored = false; mp.CanCollide = false; mp.CanQuery = true; mp.CanTouch = false
	mp.Massless = true; mp.Transparency = 1; mp.CastShadow = false
	mp.Parent = proxyF
	local w = Instance.new("WeldConstraint"); w.Part0 = orig; w.Part1 = mp; w.Parent = mp
	proxyOf[mp] = orig
	excl[#excl + 1] = orig
	filtersDirty = true
	orig.Destroying:Connect(function()
		proxyOf[mp] = nil
		mp:Destroy()
		filtersDirty = true
	end)
end

task.spawn(function()
	while alive do
		local job = table.remove(pq, 1)
		if job then
			pcall(makeProxy, job)
			task.wait(0.12)
		else
			task.wait(0.4)
		end
	end
end)

