local function newStatic(p, pos, n, V, ca, hyst, mat, inst, vis, host, tr, small, out, noAppear)
	local a, h
	a, h, ca = capGeom(V, ca)
	local sx, sy, cy = beadDims(a, h, ca, vis)
	sy = sy * CFG.Flatness
	local soak = SOAK[mat]
	local cf = frame(pos + n * cy, n)
	local o = {
		p = p, pos = pos, nrm = n, V = V, a = a, h = h, ca = ca, hyst = hyst, mat = mat, inst = inst, vis = vis, tr = tr,
		sx = sx, sy = sy, cy = cy, ra = sx * 0.5, cf = cf, born = noAppear and (now - ap) or now,
		exp = now + (soak and soak * CFG.SoakScale or CFG.HoldTime) * rand(0.7, 1.4), small = small, out = out or perp(n),
		host = host, hcf = host and host.CFrame or nil, cullT = now + 0.5, full = false,
	}
	p.Size = noAppear and V3(sx, sy, sx) or V3(sx, sy, sx) * 0.25
	p.CFrame = cf; p.Parent = rainF
	if CFG.Coalesce and not host then gridAdd(o) end
	S[#S + 1] = o
	return o
end

local function nearStatic(pos, n, inst, ra)
	local cs = CFG.MergeCell
	local ix, iy, iz = floor(pos.X / cs), floor(pos.Y / cs), floor(pos.Z / cs)
	local best, bd = nil, 1e9
	for dx = -1, 1 do
		for dy = -1, 1 do
			for dz = -1, 1 do
				local c = grid[cellKeyI(ix + dx, iy + dy, iz + dz)]
				if c then
					for k = 1, #c do
						local o = c[k]
						if o.inst == inst and not o.dead then
							local d = (o.pos - pos).Magnitude
							if d < min((o.ra + ra) * CFG.MergeReach, cs) and d < bd and n:Dot(o.nrm) > 0.85 then best, bd = o, d end
						end
					end
				end
			end
		end
	end
	return best
end

local function mergeStatic(o, pos, V)
	local V2 = o.V + V
	o.pos = (o.pos * o.V + pos * V) / V2
	o.V = V2
	local a, h = capGeom(V2, o.ca)
	o.a, o.h = a, h
	local sx, sy, cy = beadDims(a, h, o.ca, o.vis)
	o.sx, o.sy, o.cy, o.ra = sx, sy * CFG.Flatness, cy, sx * 0.5
	o.cf = frame(o.pos + o.nrm * cy, o.nrm)
	o.p.Size = V3(sx, o.sy, sx); o.p.CFrame = o.cf; o.full = true
	o.exp = max(o.exp, now + min(SOAK[o.mat] or 4, 4)); o.check = true
	gridDel(o); gridAdd(o)
end

local function canRun(n, V, a, h, hyst, small, out)
	local drive, pin = forces(n, V, a, h, hyst, small, out)
	return drive.Magnitude > pin * 1.1
end

local function makeSlider(p, pos, n, V, ca, hyst, inst, host, vis, out, small, tr, mat, born)
	local a, h
	a, h, ca = capGeom(V, ca)
	local sx, sy, cy = beadDims(a, h, ca, vis)
	sy = sy * CFG.Flatness
	local cf = frame(pos + n * cy, n)
	local s = {
		p = p, pos = pos, nrm = n, vel = ZERO, tr = tr, born = born or now, dieAt = now + rand(CFG.SliderLifeMin, CFG.SliderLifeMax),
		V = V, a = a, h = h, ca = ca, vis = vis, hyst = hyst, mat = mat, sx = sx, sy = sy, cy = cy, ra = sx * 0.5,
		wf = rand(CFG.WidthMin, CFG.WidthMax), sw = sx * 0.5, th = sy * CFG.TrailThick, vacc = 0,
		tail = pos, acc = 0, nxt = rand(CFG.StepMin, CFG.StepMax), ph = rand(0, 6.28),
		out = out, flow = small, slow = 0, host = host, hcf = host and host.CFrame or nil, hi = inst,
		segMax = max(sx * 5, 0.25), cullT = now + 0.5,
	}
	s.sw = sx * s.wf
	p.Size = born and V3(sx, sy, sx) or V3(sx, sy, sx) * 0.25
	p.CFrame = cf; p.Parent = rainF
	if CFG.Trails then
		local seg = getBead()
		if seg then
			seg.Transparency = min(1, tr + 0.12); seg.Size = V3(0.01, 0.01, 0.01)
			seg.CFrame = cf; seg.Parent = rainF
			s.seg = seg
		end
	end
	L[#L + 1] = s
	return s
end

local function reshape(s)
	local a, h = capGeom(s.V, s.ca)
	s.a, s.h = a, h
	local sx, sy, cy = beadDims(a, h, s.ca, s.vis)
	sy = sy * CFG.Flatness
	s.sx, s.sy, s.cy, s.ra = sx, sy, cy, sx * 0.5
	s.sw = sx * s.wf; s.th = sy * CFG.TrailThick
end

local function evictStatic()
	local n = #S
	if n == 0 then return nil end
	local best, bi, bs = nil, 0, -1
	for _ = 1, 6 do
		local i = rng:NextInteger(1, n)
		local o = S[i]
		if not o.dead then
			local sc = (now - o.born) + (o.cf.Position - camPos).Magnitude * 0.15
			if sc > bs then best, bi, bs = o, i, sc end
		end
	end
	if not best then return nil end
	gridDel(best); rem(S, bi)
	best.p.Parent = nil
	return best.p
end

local function absorbAlong(s)
	local cs = CFG.MergeCell
	local pos = s.pos
	local ix, iy, iz = floor(pos.X / cs), floor(pos.Y / cs), floor(pos.Z / cs)
	local took = 0
	for dx = -1, 1 do
		for dy = -1, 1 do
			for dz = -1, 1 do
				local c = grid[cellKeyI(ix + dx, iy + dy, iz + dz)]
				if c then
					for k = #c, 1, -1 do
						local o = c[k]
						if o and took < 4 and not o.dead and o.inst == s.hi then
							if (o.pos - pos).Magnitude < min((s.ra + o.ra) * CFG.MergeReach, cs) and s.nrm:Dot(o.nrm) > 0.8 then
								local V2 = s.V + o.V
								s.vel = s.vel * (s.V / V2)
								s.V = V2
								o.dead = true
								gridDel(o)
								drop(o.p)
								took += 1
							end
						end
					end
				end
			end
		end
	end
	if took > 0 then reshape(s) end
end

local function leaveBead(s, pos, n, V)
	local p = getBead()
	if not p then return end
	p.Transparency = min(1, s.tr + 0.05)
	newStatic(p, pos, n, V, s.ca, s.hyst, s.mat, s.hi, s.vis, s.host, s.tr, s.flow, s.out)
end

function newDrop(res, Dmm, vn)
	local inst, n, pos = res.Instance, res.Normal, res.Position
	local dist = (pos - camPos).Magnitude
	if res.Material == Enum.Material.Water then
		ripple(pos, n, Dmm)
		return true
	end
	if dist > CFG.BeadDist then return false end
	local body = isBodyPart(proxyOf[inst] or inst)

	if not body and n.Y > 0.6 and pos.Y > camPos.Y + 0.5 then return false end
	local mat = res.Material.Name
	if n.Y > 0.3 then
		local ns = splashCount(Dmm, vn)
		if ns > 0 and rng:NextNumber() < CFG.ImpactSplash then splash(pos, n, ns) end
	end

	local V = pi * (Dmm * 0.001) ^ 3 / 6
	local a, h, ca = capGeom(V, rad(body and CFG.BodyContact or (THETA[mat] or CFG.DefaultContact)))
	local vis = LS * CFG.VisualGain * (1 + dist / CFG.DistanceGrow)
	local host = nil
	if not inst.Anchored then host = inst end
	if CFG.Coalesce and not host then
		local o = nearStatic(pos, n, inst, a * vis)
		if o then mergeStatic(o, pos, V); return true end
	end
	local p = getBead() or evictStatic()
	if not p then return true end
	local tr = rand(CFG.TransMin, CFG.TransMax)
	p.Transparency = tr

	local hBase = body and CFG.BodyHyst or (HYST[mat] or CFG.DefaultHyst)
	local hyst = hBase * CFG.Hysteresis * rand(0.75, 1.3)
	local small = n.Y > 0.5 and inst.Size.Magnitude < 14 and hBase < 1.2
	local out = pos - inst.Position
	out = out - n * out:Dot(n)
	out = out.Magnitude > 1e-3 and out.Unit or perp(n)
	if #L < CFG.MaxSliders * q and dist < CFG.SlideDist and rng:NextNumber() < CFG.SlideChance then
		if n.Y < CFG.DetachAngle or canRun(n, V, a, h, hyst, small, out) then
			makeSlider(p, pos, n, V, ca, hyst, inst, host, vis, out, small, tr, mat)
			return true
		end
	end
	newStatic(p, pos, n, V, ca, hyst, mat, inst, vis, host, tr, small, out)
	return true
end

function startDrip(pos, vel, sz, bead, Dm)
	if not CFG.Drips or #D >= 60 then
		vanish(bead, bead.Size)
		return
	end
	D[#D + 1] = { p = bead, pos = pos, vel = vel, sz = sz, born = now, vt = terminalSpeed((Dm or 0.003) * 1000), D = (Dm or 0.003) * 1000 }
end

local function segCF(s, a, b)
	local d = b - a
	local l = d.Magnitude
	if l < 1e-4 then return nil, nil end
	return V3(l + s.sw, s.th, s.sw), frame((a + b) * 0.5 + s.nrm * (s.th * 0.25), s.nrm, d / l)
end

local function stampTrail(s, keep)
	local seg = s.seg
	if not seg then return end
	local size, cf = segCF(s, s.tail, s.pos)
	if not size then
		if not keep then drop(seg); s.seg = nil end
		return
	end
	seg.Size = size; seg.CFrame = cf
	T[#T + 1] = {
		p = seg, born = now, life = rand(CFG.TrailLifeMin, CFG.TrailLifeMax), len = size.X, th = s.th, sw = s.sw,
		t0 = seg.Transparency, nu = now + 0.1, host = s.host, hcf = s.hcf, cf = cf,
	}
	s.seg = nil
	if keep then
		local nb = getBead()
		if nb then
			nb.Transparency = min(1, s.tr + 0.12); nb.Size = V3(0.01, 0.01, 0.01)
			nb.CFrame = cf; nb.Parent = rainF
			s.seg = nb
		end
	end
	s.tail = s.pos
end

local function finishSlider(s, asBead)
	stampTrail(s, false)
	if asBead and s.V >= VMIN * 4 then
		newStatic(s.p, s.pos, s.nrm, s.V, s.ca, s.hyst, s.mat, s.hi, s.vis, s.host, s.tr, s.flow, s.out, true)
	else
		vanish(s.p, s.p.Size)
	end
end

local function stepSlider(s, h)
	local n, pos = s.nrm, s.pos

	if not s.hang and n.Y < CFG.DetachAngle then
		stampTrail(s, false)
		local Vc = 2 * pi * s.a * GAMMA * 0.6 / (RHO_W * G0)
		s.hang = now; s.hangT = rand(0.12, 0.4) * clamp(Vc / s.V, 1, 6); s.sy0 = s.sy; s.vel = ZERO
	end
	if s.hang then
		local k = clamp((now - s.hang) / s.hangT, 0, 1)
		s.sy = s.sy0 + (s.sx * 1.15 - s.sy0) * k * k
		if k >= 1 then
			local Dm = (6 * s.V / pi) ^ (1 / 3)
			startDrip(pos + n * 0.02, ZERO, Dm * s.vis, s.p, Dm)
			return 2
		end
		return 0
	end

	local drive, pin = forces(n, s.V, s.a, s.h, s.hyst, s.flow, s.out)
	local dm = drive.Magnitude
	local net = dm > pin and drive * (1 - pin / dm) or ZERO
	local cE = 2 * CFG.ContactFriction * s.a / (RHO_W * s.V) * TS
	local v = (s.vel + net * h) / (1 + cE * h)
	v = v - n * v:Dot(n)
	local spd = v.Magnitude
	if spd < CFG.MinFlow then s.slow += h else s.slow = 0 end
	if s.slow > 0.4 then return 3 end

	local d = v * h
	if spd > 0.02 then
		d = d + n:Cross(v / spd) * (sin(now * CFG.WobbleSpeed + s.ph) * CFG.Wobble * spd * h)
	end
	local dl = d.Magnitude
	if dl < 1e-5 then s.vel = v; return 0 end
	local dir = d / dl
	local snap = CFG.SurfaceSnap
	local np = pos + d
	local res

	res = ray(pos + n * snap, dir * (dl + s.sx * 0.6))
	if res and res.Normal:Dot(n) < 0.95 then
		np = res.Position
	else
		res = ray(np + n * snap, -n * (snap * 2 + s.sx))
		if not res then
			res = ray(np + dir * CFG.SeamForgive + n * snap, -n * (snap * 2 + s.sx))
		end
		if not res then

			res = ray(np - n * 0.3, -dir * (dl + 0.4))
		end
		if not res then

			stampTrail(s, false)
			local Dm = (6 * s.V / pi) ^ (1 / 3)
			startDrip(np + n * 0.01, v, Dm * s.vis, s.p, Dm)
			return 2
		end
	end

	local rn = res.Normal
	local nn
	if n:Dot(rn) > 0.5 then
		nn = n * CFG.NormalSmoothing + rn * (1 - CFG.NormalSmoothing)
		nn = nn.Magnitude > 1e-3 and nn.Unit or rn
	else
		nn = rn
	end
	s.pos = res.Position; s.nrm = nn
	s.vel = v - nn * v:Dot(nn)
	local hi = res.Instance
	if hi ~= s.hi then
		s.hi = hi
		if hi.Anchored then s.host = nil; s.hcf = nil else s.host = hi; s.hcf = hi.CFrame end
	end

	local ds = (res.Position - pos).Magnitude / LS
	if ds > 0 then
		local Ca = MU_W * (ds / h / TS) / GAMMA
		local tf = clamp(1.34 * s.a * Ca ^ (2 / 3), 1e-6, 8e-5) * CFG.FilmScale
		local dV = tf * 2 * s.a * ds
		s.V -= dV
		if CFG.Satellites then
			s.vacc += dV * clamp((math.deg(s.ca) - 45) / 60, 0, 1)
			if s.vacc > VSAT then leaveBead(s, pos, n, s.vacc); s.vacc = 0 end
		end
	end
	if s.V < VMIN then return 1 end
	if CFG.Coalesce then absorbAlong(s) end
	reshape(s)

	if s.seg and (s.pos - s.tail).Magnitude >= s.segMax then stampTrail(s, true) end
	return 0
end

local function drawSlider(s)
	local age = now - s.born
	local k = min(1, 0.25 + 0.75 * age / ap)
	local spd = s.vel.Magnitude
	local dir = spd > 0.02 and s.vel / spd or s.out
	local pp = s.pos + s.vel * s.acc
	local n = s.nrm
	local st = 1 + CFG.SlideStretch * clamp(spd / 3, 0, 1) * 2
	s.p.Size = V3(s.sx * st, s.sy, s.sx) * k
	mv(s.p, frame(pp + n * s.cy, n, dir))
	if s.seg then
		local size, cf = segCF(s, s.tail, pp)
		if size then s.seg.Size = size; mv(s.seg, cf) end
	end
end

local queued, pq = setmetatable({}, { __mode = "k" }), {}
local function scanChar(m)
	if not CFG.PreciseMesh then return end
	for _, d in ipairs(m:GetDescendants()) do
		if not queued[d] then
			if d:IsA("MeshPart") and d.MeshId ~= "" then
				queued[d] = true
				pq[#pq + 1] = { part = d, id = d.MeshId }
			elseif d:IsA("SpecialMesh") and d.MeshType == Enum.MeshType.FileMesh and d.MeshId ~= "" and d.Parent and d.Parent:IsA("BasePart") then
				queued[d] = true
				pq[#pq + 1] = { part = d.Parent, id = d.MeshId, sm = d }
			end
		end
	end
end

local function makeProxy(job)
	local orig = job.part
	if not orig.Parent or not CFG.PreciseMesh then return end
	local mp = AssetService:CreateMeshPartAsync(Content.fromUri(job.id), { CollisionFidelity = Enum.CollisionFidelity.PreciseConvexDecomposition })
	if not alive or not orig:IsDescendantOf(Workspace) then mp:Destroy(); return end
	local off = CFrame.identity
	if job.sm then
		mp.Size = mp.Size * job.sm.Scale
		off = CFrame.new(job.sm.Offset)
	else
		mp.Size = orig.Size
	end
	mp.CFrame = orig.CFrame * off
	mp.Anchored = false; mp.CanCollide = false; mp.CanQuery = true; mp.CanTouch = false
	mp.Massless = true; mp.Transparency = 1; mp.CastShadow = false
	mp.Parent = proxyF
	local w = Instance.new("WeldConstraint"); w.Part0 = orig; w.Part1 = mp; w.Parent = mp
	proxyOf[mp] = orig
	excl[#excl + 1] = orig
	filtersDirty = true
	orig.Destroying:Connect(function()
		proxyOf[mp] = nil
		mp:Destroy()
		filtersDirty = true
	end)
end

task.spawn(function()
	while alive do
		local job = table.remove(pq, 1)
		if job then
			pcall(makeProxy, job)
			task.wait(0.12)
		else
			task.wait(0.4)
		end
	end
end)

local chars, nextChars, nextScan = {}, 0, 0
local function refreshChars()
	local list, ms = {}, {}
	for _, pl in ipairs(Players:GetPlayers()) do
		local c = pl.Character
		local r = c and c:FindFirstChild("HumanoidRootPart")
		if r then
			ms[#ms + 1] = c
			if pl == plr or (r.Position - camPos).Magnitude < 55 then
				list[#list + 1] = { m = c, r = r, loc = pl == plr, sh = false }
			end
		end
	end
	models = ms
	filtersDirty = true
	setFilters()
	for _, c in ipairs(list) do c.sh = sheltered(c.r.Position + V3(0, 3, 0)) end
	chars = list
	if now >= nextScan then
		nextScan = now + 2
		for i = 1, min(#list, 6) do scanChar(list[i].m) end
	end
end

local fallParts, fallFree, fallDrops = {}, {}, {}
local fallSpawnAccumulator = 0
local bodyDropAccumulator = 0
local bodyPartCache = setmetatable({}, { __mode = "k" })

function isBodyPart(instance)
	local cached = bodyPartCache[instance]
	if cached ~= nil then return cached end
	local model = instance:FindFirstAncestorOfClass("Model")
	local result = model ~= nil and model:FindFirstChildOfClass("Humanoid") ~= nil
	bodyPartCache[instance] = result
	return result
end

local function newFallDrop()
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Cylinder
	part.Anchored = true; part.CanCollide = false; part.CanTouch = false; part.CanQuery = false
	part.CastShadow = false; part.Material = MAT; part.Color = COL; part.Transparency = CFG.FallTrans
	part.Size = V3(1, 0.05, 0.05)
	fallParts[#fallParts + 1] = part
	return { part = part }
end

local function fallRaycast(origin, direction)
	local unit = direction.Unit
	for _ = 1, 3 do
		local result = Workspace:Raycast(origin, direction, rp)
		if not result then return nil end
		local base = proxyOf[result.Instance] or result.Instance
		if base.Transparency <= 0.9 and base.LocalTransparencyModifier <= 0.9 then return result end
		local advance = (result.Position - origin).Magnitude + 0.05
		if advance >= direction.Magnitude then return nil end
		origin = origin + unit * advance
		direction = unit * (direction.Magnitude - advance)
	end
	return nil
end

local function spawnFallDrop(aimPoint)
	local target = aimPoint
	if not target then
		local nearZone = rng:NextNumber() < CFG.FallNearShare
		local zoneRadius = nearZone and CFG.FallNearRadius or CFG.FallFarRadius
		local angle = rand(0, 2 * pi)
		local offsetDistance = zoneRadius * sqrt(rng:NextNumber())
		local center = camPos + flatLook * (zoneRadius * (nearZone and 0.35 or 0.5))
		target = V3(center.X + cos(angle) * offsetDistance, camPos.Y, center.Z + sin(angle) * offsetDistance)
	end

	local diameter = sampleVisible()
	local tb = CFG.Turbulence * VS
	local velocity = V3(W.X + gauss() * tb, -terminalSpeed(diameter) * VS * rand(0.97, 1.03), W.Z + gauss() * tb)
	local speed = velocity.Magnitude
	local direction = velocity / speed
	local startHeight = CFG.RoofHeight
	local origin = target - direction * startHeight
	local travelLimit = startHeight + 60
	local hit = fallRaycast(origin, direction * travelLimit)
	local travel = hit and (hit.Position - origin).Magnitude or travelLimit
	local cameraDistance = (target - camPos).Magnitude
	local length = speed * CFG.Shutter * (1 + cameraDistance / 60)
	local width = CFG.FallWidth * (diameter / 2) * (1 + cameraDistance / 35)
	local lifetime = (travel - length * 0.5) / speed
	if lifetime <= 0.02 then return false end

	local fallDrop = table.remove(fallFree) or newFallDrop()
	local part = fallDrop.part
	local rotation = CFrame.fromMatrix(ZERO, direction, direction:Cross(Vector3.xAxis).Unit)
	local birth = now - rand(0, dt)
	part.Size = V3(length, width, width)
	fallDrop.tr = 1 - (1 - CFG.FallTrans) * clamp(diameter / 2, 0.35, 2)
	fallDrop.full = false
	part.Transparency = 1
	part.CFrame = rotation + (origin + velocity * (now - birth))
	part.Parent = rainF
	fallDrop.origin = origin
	fallDrop.velocity = velocity
	fallDrop.rotation = rotation
	fallDrop.birth = birth
	fallDrop.lifetime = lifetime
	fallDrop.D = diameter
	local hitBase = hit and (proxyOf[hit.Instance] or hit.Instance)
	fallDrop.onBody = hitBase ~= nil and isBodyPart(hitBase)
	local hitWater = hit ~= nil and hit.Material == Enum.Material.Water
	fallDrop.landing = not fallDrop.onBody and hit and not hitWater and hit.Normal.Y > 0.3 and hit.Position or nil
	fallDrop.normal = fallDrop.landing and hit.Normal or nil
	fallDrop.water = hitWater and hit.Normal.Y > 0.5 and hit.Position or nil
	fallDrop.wn = fallDrop.water and hit.Normal or nil
	fallDrop.ns = fallDrop.landing and splashCount(diameter, math.abs(velocity:Dot(hit.Normal)) / VS) or 0
	fallDrops[#fallDrops + 1] = fallDrop
	return true
end

local function areaRay()
	local R = CFG.AreaRadius
	local a, r = rand(0, 2 * pi), R * sqrt(rng:NextNumber())
	local c = camPos + flatLook * (R * 0.4)
	local target = V3(c.X + cos(a) * r, camPos.Y, c.Z + sin(a) * r)
	local H = CFG.RoofHeight

	local Dmm = sampleDiameter()
	local tb = CFG.Turbulence * VS
	local vel = V3(W.X + gauss() * tb, -terminalSpeed(Dmm) * VS, W.Z + gauss() * tb)
	local dir = vel.Unit
	local res = ray(target - dir * H, dir * (H + 90))
	if not res then return false end
	if isBodyPart(proxyOf[res.Instance] or res.Instance) then return true end
	return newDrop(res, Dmm, math.abs(vel:Dot(res.Normal)) / VS)
end

local LN = { drops = {}, segs = {}, free = {}, all = {}, acc = 0, wipe = false, ok = true, mp = {}, mc = {}, tilt = CFrame.Angles(pi / 2, 0, 0) }
LN.folder = Instance.new("Folder"); LN.folder.Name = "RealRainLens"; LN.folder.Parent = cam

function LN.part()
	local p = Instance.new("Part")
	p.Anchored = true; p.CanCollide = false; p.CanTouch = false; p.CanQuery = false; p.CastShadow = false
	p.Material = MAT; p.Color = COL; p.Size = V3(0.01, 0.01, 0.01)
	local m = Instance.new("SpecialMesh"); m.MeshType = Enum.MeshType.Sphere; m.Parent = p
	LN.all[#LN.all + 1] = p
	return p
end
function LN.get()
	local p = table.remove(LN.free)
	if p then return p end
	if #LN.all >= CFG.LensMax * 3 + 40 then return nil end
	return LN.part()
end
function LN.put(p) p.Parent = nil; LN.free[#LN.free + 1] = p end

function LN.shape(d)
	local a, h = capGeom(d.V, d.ca)
	local kL = CFG.LensDist / CFG.LensEyeDist
	d.a, d.h = a, h
	d.ra = a * kL; d.sx = 2 * a * kL; d.sy = 2 * h * kL
end

function LN.merge(o, V, x, y, vx, vy)
	local V2 = o.V + V
	o.x = (o.x * o.V + x * V) / V2; o.y = (o.y * o.V + y * V) / V2
	o.vx = (o.vx * o.V + vx * V) / V2; o.vy = (o.vy * o.V + vy * V) / V2
	o.V = V2
	LN.shape(o)
	o.dirty = true
	o.exp = now + CFG.LensHold * rand(0.7, 1.4)
end

function LN.spawn(hW, hH)
	local Dmm = sampleDiameter()
	local V = pi * (Dmm * 0.001) ^ 3 / 6
	local ca = rad(CFG.LensContact)
	local a = capGeom(V, ca)
	local ra = a * CFG.LensDist / CFG.LensEyeDist
	local x, y = rand(-hW, hW), rand(-hH, hH)
	local drops = LN.drops
	if CFG.Coalesce then
		for i = 1, #drops do
			local o = drops[i]
			local dx, dy = o.x - x, o.y - y
			local reach = (o.ra + ra) * CFG.MergeReach
			if not o.dead and dx * dx + dy * dy < reach * reach then LN.merge(o, V, x, y, 0, 0); return end
		end
	end
	local p = LN.get()
	if not p then return end
	local d = {
		p = p, x = x, y = y, vx = 0, vy = 0, V = V, ca = ca, hyst = CFG.LensHyst * rand(0.75, 1.3), born = now,
		exp = now + CFG.LensHold * rand(0.7, 1.4), tr = rand(0.55, 0.8), ang = 0, st = 1, wf = rand(CFG.WidthMin, CFG.WidthMax),
		tx = x, ty = y, dirty = true,
	}
	LN.shape(d)
	p.Transparency = d.tr
	p.Size = V3(d.sx, d.sy, d.sx) * 0.3
	p.Parent = LN.folder
	d.off = CFrame.new(x, y, -CFG.LensDist) * LN.tilt
	drops[#drops + 1] = d
end

function LN.trail(d, final)
	local seg = d.seg
	if not seg then
		if not CFG.Trails or final then return end
		seg = LN.get()
		if not seg then return end
		seg.Transparency = min(1, d.tr + 0.12); seg.Parent = LN.folder
		d.seg = seg
	end
	local dx, dy = d.x - d.tx, d.y - d.ty
	local len = sqrt(dx * dx + dy * dy)
	if len < 1e-5 then
		if final then LN.put(seg); d.seg = nil; d.soff = nil end
		return
	end
	local w = 2 * d.ra * d.wf
	local th = max(d.sy * CFG.TrailThick, 0.0005)
	seg.Size = V3(len + w, th, w)
	local off = CFrame.new((d.tx + d.x) * 0.5, (d.ty + d.y) * 0.5, -CFG.LensDist) * CFrame.Angles(0, 0, math.atan2(dy, dx)) * LN.tilt
	if final or len >= max(d.ra * 6, 0.02) then
		LN.segs[#LN.segs + 1] = { p = seg, off = off, born = now, life = CFG.LensTrailLife * rand(0.7, 1.3), t0 = seg.Transparency }
		d.seg = nil; d.soff = nil
		d.tx, d.ty = d.x, d.y
	else
		d.soff = off
	end
end

function LN.clear()
	for i = #LN.drops, 1, -1 do
		local d = LN.drops[i]
		LN.put(d.p)
		if d.seg then LN.put(d.seg) end
		LN.drops[i] = nil
	end
	for i = #LN.segs, 1, -1 do LN.put(LN.segs[i].p); LN.segs[i] = nil end
	LN.acc = 0
end

function LN.step(cf)
	if LN.wipe or not CFG.Lens then
		LN.wipe = false
		if #LN.drops > 0 or #LN.segs > 0 then LN.clear() end
		if not CFG.Lens then return end
	end
	local drops = LN.drops
	local right, up, look = cf.RightVector, cf.UpVector, cf.LookVector
	local halfH = math.tan(rad(cam.FieldOfView) * 0.5) * CFG.LensDist
	local vp = cam.ViewportSize
	local halfW = halfH * (vp.X / max(vp.Y, 1))
	local kL = CFG.LensDist / CFG.LensEyeDist
	local dtR = dt * TS

	local gx, gy = -right.Y * G0, -up.Y * G0
	local rel = W - camVel
	local wx, wy = rel:Dot(right) / VS, rel:Dot(up) / VS
	local wm = sqrt(wx * wx + wy * wy)
	local u = wm * CFG.SlideInfluence

	if CFG.Enabled and not camSh and LN.ok then
		local rv = rainVelV - camVel
		local expo = clamp(-rv:Dot(look) / max(rainSpeed, 1), CFG.LensFloor, 1.5)
		LN.acc += CFG.LensRate * rateImp * expo * q * dt
		local n = floor(LN.acc)
		LN.acc -= n
		for _ = 1, min(n, 4) do
			if #drops < CFG.LensMax then LN.spawn(halfW, halfH) end
		end
	else
		LN.acc = 0
	end

	for i = #drops, 1, -1 do
		local d = drops[i]
		local dead = d.dead
		if not dead then
			if now > d.exp then
				dead = true
			else
				local V = d.V
				local ax, ay = gx, gy
				if wm > 1e-4 then
					local wk = WIND_K * d.a * d.h / V * u * u / wm
					ax = ax + wx * wk; ay = ay + wy * wk
				end
				local dm = sqrt(ax * ax + ay * ay)
				local pin = 2 * GAMMA * d.a * d.hyst / (RHO_W * V)
				local cE = 2 * CFG.ContactFriction * d.a / (RHO_W * V)
				local nx, ny = 0, 0
				if dm > pin then
					local f = 1 - pin / dm
					nx, ny = ax * f, ay * f
				end
				local vx = (d.vx + nx * dtR) / (1 + cE * dtR)
				local vy = (d.vy + ny * dtR) / (1 + cE * dtR)
				local spd = sqrt(vx * vx + vy * vy)
				if spd < 0.004 then vx, vy, spd = 0, 0, 0 end
				d.vx, d.vy = vx, vy
				if spd > 0 then
					local ds = spd * dtR
					d.x = d.x + vx / spd * ds * kL
					d.y = d.y + vy / spd * ds * kL

					local Ca = MU_W * spd / GAMMA
					local tf = clamp(1.34 * d.a * Ca ^ (2 / 3), 1e-6, 8e-5) * CFG.FilmScale
					d.V = V - tf * 2 * d.a * ds
					if d.V < VMIN then
						dead = true
					else
						LN.shape(d)
						d.ang = math.atan2(vy, vx)
						d.st = 1 + CFG.SlideStretch * clamp(spd / 0.15, 0, 1) * 2
						d.dirty = true

						if CFG.Coalesce then
							for j = 1, #drops do
								local o = drops[j]
								if o ~= d and not o.dead then
									local dx, dy = o.x - d.x, o.y - d.y
									local reach = (o.ra + d.ra) * CFG.MergeReach
									if dx * dx + dy * dy < reach * reach then
										LN.merge(d, o.V, o.x, o.y, o.vx, o.vy)
										o.dead = true; o.p.Transparency = 1
									end
								end
							end
						end
						LN.trail(d, false)
						if d.y < -halfH - d.ra or d.x < -halfW - d.ra or d.x > halfW + d.ra then dead = true end
					end
				elseif d.seg then
					LN.trail(d, true)
				end
				if not dead then
					local grow = (now - d.born) / ap
					if d.dirty or grow < 1 then
						d.dirty = false
						local k = grow < 1 and (0.3 + 0.7 * grow) or 1
						d.p.Size = V3(d.sx * d.st * k, d.sy * k, d.sx * k)
						d.off = CFrame.new(d.x, d.y, -CFG.LensDist) * CFrame.Angles(0, 0, d.ang) * LN.tilt
					end
				end
			end
		end
		if dead then
			if d.seg then LN.trail(d, true) end
			LN.put(d.p)
			rem(drops, i)
		end
	end

	local segs = LN.segs
	for i = #segs, 1, -1 do
		local s = segs[i]
		local f = (now - s.born) / s.life
		if f >= 1 then
			LN.put(s.p); rem(segs, i)
		else
			s.p.Transparency = s.t0 + (1 - s.t0) * f * f * f
		end
	end
end

function LN.place()
	local c = Workspace.CurrentCamera
	if not c then return end
	local cf = c.CFrame
	local mp, mc, n = LN.mp, LN.mc, 0
	for _, d in ipairs(LN.drops) do
		n += 1; mp[n] = d.p; mc[n] = cf * d.off
		if d.seg and d.soff then n += 1; mp[n] = d.seg; mc[n] = cf * d.soff end
	end
	for _, s in ipairs(LN.segs) do n += 1; mp[n] = s.p; mc[n] = cf * s.off end
	for i = #mp, n + 1, -1 do mp[i] = nil; mc[i] = nil end
	if n > 0 then Workspace:BulkMoveTo(mp, mc, Enum.BulkMoveMode.FireCFrameChanged) end
end

local STEP = {}
local errs = {}
local function guard(name, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok and not errs[name] then errs[name] = true; warn("RealRain [" .. name .. "]:", err) end
end

function STEP.statics()
	for i = #S, 1, -1 do
		local o = S[i]
		if o.dead then
			rem(S, i)
		elseif now >= o.exp then
			gridDel(o); vanish(o.p, V3(o.sx, o.sy, o.sx)); rem(S, i)
		else
			local age = now - o.born
			if age < ap then
				o.p.Size = V3(o.sx, o.sy, o.sx) * (0.25 + 0.75 * age / ap)
			elseif not o.full then
				o.p.Size = V3(o.sx, o.sy, o.sx); o.full = true
			end
			local gone = false
			local h = o.host
			if h then
				if h.Parent == nil then
					gone = true
				else
					local c = h.CFrame
					if c ~= o.hcf then
						local d = c * o.hcf:Inverse()
						o.hcf = c; o.cf = d * o.cf
						mv(o.p, o.cf)
					end
				end
			end
			if not gone and now >= o.cullT then
				o.cullT = now + 0.5
				if (o.cf.Position - camPos).Magnitude > CFG.CullDist then gone = true end
			end
			if gone then
				gridDel(o); drop(o.p); rem(S, i)
			elseif o.check then

				o.check = false
				if #L < CFG.MaxSliders * q and rng:NextNumber() < CFG.SlideChance and canRun(o.nrm, o.V, o.a, o.h, o.hyst, o.small, o.out) then
					gridDel(o)
					makeSlider(o.p, o.pos, o.nrm, o.V, o.ca, o.hyst, o.inst, o.host, o.vis, o.out, o.small, o.tr, o.mat, o.born)
					rem(S, i)
				end
			end
		end
	end
end

function STEP.sliders()
	for i = #L, 1, -1 do
		local s = L[i]
		local status = 0
		local h = s.host
		if h then
			if h.Parent == nil then
				status = 1
			else
				local c = h.CFrame
				if c ~= s.hcf then
					local d = c * s.hcf:Inverse()
					s.hcf = c
					s.pos = d * s.pos; s.tail = d * s.tail
					s.nrm = d:VectorToWorldSpace(s.nrm)
					s.vel = d:VectorToWorldSpace(s.vel)
					s.out = d:VectorToWorldSpace(s.out)
				end
			end
		end
		if status == 0 then
			if now > s.dieAt then
				status = 3
			elseif now >= s.cullT then
				s.cullT = now + 0.5
				if (s.pos - camPos).Magnitude > CFG.CullDist then status = 1 end
			end
		end
		if status == 0 then
			s.acc += dt
			if s.acc >= s.nxt and rays < rayCap then
				local hh = min(s.acc, 0.15)
				s.acc = 0; s.nxt = rand(CFG.StepMin, CFG.StepMax)
				status = stepSlider(s, hh)
			end
		end
		if status == 1 or status == 3 then finishSlider(s, status == 3); rem(L, i)
		elseif status == 2 then rem(L, i)
		else drawSlider(s) end
	end
end

function STEP.trails()
	for i = #T, 1, -1 do
		local t = T[i]
		local age = now - t.born
		if age >= t.life then
			drop(t.p); rem(T, i)
		else
			local h = t.host
			local gone = false
			if h then
				if h.Parent == nil then
					gone = true
				else
					local c = h.CFrame
					if c ~= t.hcf then
						local d = c * t.hcf:Inverse()
						t.hcf = c; t.cf = d * t.cf
						mv(t.p, t.cf)
					end
				end
			end
			if gone then
				drop(t.p); rem(T, i)
			elseif now >= t.nu then
				local f = age / t.life
				local k = 1 - CFG.AgeTaper * f
				t.p.Size = V3(t.len, t.th * k, t.sw * k)
				t.p.Transparency = t.t0 + (1 - t.t0) * f * f * f
				t.nu = now + t.life / 10
			end
		end
	end
end

function STEP.drips()
	for i = #D, 1, -1 do
		local d = D[i]
		local h = min(dt, 0.05)
		local vtE = d.vt * VS
		local c = GE * (d.vel - W).Magnitude / (vtE * vtE)
		local v = (d.vel + (V3(0, -GE, 0) + W * c) * h) / (1 + c * h)
		local rel = v - W
		local relMax = max(vtE * 1.1, (d.vel - W).Magnitude)
		local relMag = rel.Magnitude
		if relMag > relMax then v = W + rel * (relMax / relMag) end
		local spd = v.Magnitude
		local step = v * h
		local done = false
		if now - d.born > 3.5 or d.pos.Y < camPos.Y - 160 then
			done = true
		else
			local res = nil
			if rays < rayCap + 25 then res = ray(d.pos, step + v.Unit * d.sz) end
			if res then
				local vn = math.abs(v:Dot(res.Normal)) / VS
				if res.Material == Enum.Material.Water then
					ripple(res.Position, res.Normal, d.D)
				else
					local ns = splashCount(d.D, vn)
					if ns > 0 then splash(res.Position, res.Normal, ns) end
					if CFG.Relanding then newDrop(res, d.D, vn) end
				end
				done = true
			else
				d.pos = d.pos + step; d.vel = v
				local dirv = v / max(spd, 1e-3)
				d.p.Size = V3(d.sz + spd * CFG.Shutter, d.sz * 0.9, d.sz * 0.9)
				mv(d.p, frame(d.pos, perp(dirv), dirv))
			end
		end
		if done then drop(d.p); rem(D, i) end
	end
end

function STEP.vanish()
	for i = #V, 1, -1 do
		local v = V[i]
		local k = 1 - (now - v.t0) / 0.18
		if k <= 0 then drop(v.p); rem(V, i) else v.p.Size = v.sz * k end
	end
end

function STEP.ripples()
	local act = RIP.act
	for i = #act, 1, -1 do
		local r = act[i]
		local k = (now - r.t0) / CFG.RippleLife
		if k >= 1 then
			r.p.Parent = nil; RIP.free[#RIP.free + 1] = r; rem(act, i)
		else
			local dia = 2 * r.rm * (1 - (1 - k) * (1 - k)) + 0.05
			r.p.Size = V3(dia, 0.02, dia)
			r.st.Transparency = 0.3 + 0.7 * k * k
			r.st.Thickness = 3 * (1 - 0.5 * k)
		end
	end
end

function STEP.fall()
	if CFG.Enabled then

		local ratio = clamp(fallOpen, 0.02, 1)
		local sc = ratio < 0.06 and 0.15 or min(1 / ratio, 2.5)
		local wantedDrops = CFG.FallRate * q * dt * (fallSpeed / CFG.RefSpeed) * rateVis * sc + fallSpawnAccumulator
		local spawnCount = floor(wantedDrops)
		fallSpawnAccumulator = wantedDrops - spawnCount
		for _ = 1, min(spawnCount, 100) do
			if #fallDrops >= CFG.MaxFall then break end
			local ok = spawnFallDrop()
			fallOpen = fallOpen + ((ok and 1 or 0) - fallOpen) * 0.02
		end

		if #chars > 0 then
			local wantedBodyDrops = CFG.BodyRate * q * dt * min(#chars, 6) + bodyDropAccumulator
			local bodySpawnCount = floor(wantedBodyDrops)
			bodyDropAccumulator = wantedBodyDrops - bodySpawnCount
			for _ = 1, min(bodySpawnCount, 60) do
				if #fallDrops >= CFG.MaxFall then break end
				local character = chars[rng:NextInteger(1, #chars)]
				local cameraInsideLocal = character.loc and (camPos - character.r.Position).Magnitude < 2.2
				if not character.sh and not cameraInsideLocal then
					spawnFallDrop(character.r.Position + V3(rand(-1.7, 1.7), 0, rand(-1.7, 1.7)))
				end
			end
		end
	else
		fallSpawnAccumulator = 0
		bodyDropAccumulator = 0
	end

	for dropIndex = #fallDrops, 1, -1 do
		local fallDrop = fallDrops[dropIndex]
		local age = now - fallDrop.birth
		if age >= fallDrop.lifetime then
			if fallDrop.onBody then
				local fallDirection = fallDrop.velocity.Unit
				local currentPosition = fallDrop.origin + fallDrop.velocity * age
				local bodyHit = fallRaycast(currentPosition - fallDirection * 1.2, fallDirection * 4)
				if bodyHit and isBodyPart(proxyOf[bodyHit.Instance] or bodyHit.Instance)
					and (bodyHit.Position - camPos).Magnitude > 2.2 then
					newDrop(bodyHit, fallDrop.D, math.abs(fallDrop.velocity:Dot(bodyHit.Normal)) / VS)
				end
			end
			if fallDrop.landing and fallDrop.ns > 0 and rng:NextNumber() < CFG.FallSplash then
				splash(fallDrop.landing, fallDrop.normal, fallDrop.ns)
			end
			if fallDrop.water then ripple(fallDrop.water, fallDrop.wn, fallDrop.D) end
			fallDrop.part.Parent = nil
			fallFree[#fallFree + 1] = fallDrop
			rem(fallDrops, dropIndex)
		else
			if age < CFG.FallFadeIn then
				fallDrop.part.Transparency = 1 - (1 - fallDrop.tr) * (age / CFG.FallFadeIn)
			elseif not fallDrop.full then
				fallDrop.part.Transparency = fallDrop.tr; fallDrop.full = true
			end
			mv(fallDrop.part, fallDrop.rotation + (fallDrop.origin + fallDrop.velocity * age))
		end
	end
end

local spawnAcc, nextCam, nextQ = 0, 0, 0
local function update(delta)
	dt = clamp(delta, 1 / 240, 0.1)
	now = os.clock()
	rays, splashN = 0, 0
	cam = Workspace.CurrentCamera
	if not cam then return end
	if LN.folder.Parent ~= cam then LN.folder.Parent = cam end
	local cf = cam.CFrame
	camPos = cf.Position
	local lk = cf.LookVector
	flatLook = V3(lk.X, 0, lk.Z)
	flatLook = flatLook.Magnitude > 0.01 and flatLook.Unit or ZERO

	local moved = camPos - prevCamPos
	if moved.Magnitude > 40 then camVel = ZERO else camVel = camVel:Lerp(moved / dt, clamp(dt * 8, 0, 1)) end
	prevCamPos = camPos

	fpsAvg += (1 / dt - fpsAvg) * 0.04
	if CFG.AutoQuality then
		if fpsAvg < CFG.TargetFPS then q = max(0.3, q - dt * 0.15)
		elseif fpsAvg > CFG.TargetFPS + 8 then q = min(1, q + dt * 0.05) end
	else q = 1 end
	rayCap = floor(40 * q) + 10

	updatePhysics()
	if GE ~= pGE or LS ~= pLS then pGE, pLS = GE, LS; syncSplash() end

	if CFG.Wind then
		local g = CFG.Gustiness
		local a = rad(CFG.WindDir) + math.noise(now * 0.07, 3.3) * g * 0.6
		local gust = 1 + g * (math.noise(now * CFG.GustSpeed, 17.3) + 0.4 * math.noise(now * CFG.GustSpeed * 3.1, 41.7)) * 2
		W = V3(sin(a), 0, cos(a)) * (CFG.WindStrength * max(gust, 0) * VS)
	else W = ZERO end
	rainVelV = V3(W.X, -terminalSpeed(meanD) * VS, W.Z)
	rainDir = rainVelV.Unit
	rainSpeed = rainVelV.Magnitude
	local visD = clamp((floor(CFG.VisibleExp + 0.5) + 1) / lamV, CFG.DropMinMM, CFG.DropMaxMM)
	fallSpeed = V3(W.X, -terminalSpeed(visD) * VS, W.Z).Magnitude

	if filtersDirty then setFilters() end
	if now >= nextChars then nextChars = now + 0.5; refreshChars() end
	if now >= nextCam then nextCam = now + 0.25; camSh = sheltered(camPos) end
	if now >= nextQ then nextQ = now + 2; LN.ok = not CFG.LensRespectQuality or glassOk() end
	ap = max(CFG.AppearTime, 0.02)

	if CFG.Enabled then
		local ratio = clamp(areaOpen, 0.02, 1)
		local sc = ratio < 0.06 and 0.15 or min(1 / ratio, 2.5)
		local want = CFG.Rate * q * rateImp * sc * dt + spawnAcc
		local n = floor(want)
		spawnAcc = want - n
		for _ = 1, min(n, 8) do
			if rays >= rayCap then break end
			local ok = areaRay()
			areaOpen = areaOpen + ((ok and 1 or 0) - areaOpen) * 0.02
		end
	else spawnAcc = 0 end

	guard("statics", STEP.statics)
	guard("sliders", STEP.sliders)
	guard("trails", STEP.trails)
	guard("drips", STEP.drips)
	guard("vanish", STEP.vanish)
	guard("fall", STEP.fall)
	guard("ripples", STEP.ripples)
	guard("lens", LN.step, cf)

	if mvN > 0 then
		Workspace:BulkMoveTo(mvP, mvC, Enum.BulkMoveMode.FireCFrameChanged)
		table.clear(mvP); table.clear(mvC); mvN = 0
	end
end

local errd = false
conns[#conns + 1] = RunService.RenderStepped:Connect(function(delta)
	if not alive then return end
	local ok, err = pcall(update, delta)
	if not ok and not errd then errd = true; warn("RealRain:", err) end
end)
pcall(function() RunService:UnbindFromRenderStep("RealRainLens") end)
RunService:BindToRenderStep("RealRainLens", Enum.RenderPriority.Camera.Value + 1, function()
	if alive then pcall(LN.place) end
end)

local function applyLook()
	MAT = Enum.Material[CFG.Material]
	COL = COLORS[CFG.WaterColor] or COLORS[1]
	for _, p in ipairs(beads) do
		p.Material = MAT; p.Color = COL; p.CastShadow = CFG.CastShadow
	end
	for _, p in ipairs(LN.all) do
		p.Material = MAT; p.Color = COL
	end
	for _, part in ipairs(fallParts) do
		part.Material = MAT; part.Color = COL; part.Transparency = CFG.FallTrans
	end
end

local HOOKS = {
	Material = applyLook, WaterColor = applyLook, CastShadow = applyLook, FallTrans = applyLook,
	PreciseMesh = function(v)
		if v then nextScan = 0; for _, c in ipairs(chars) do scanChar(c.m) end end
	end,
	Lens = function(v) if not v then LN.wipe = true end end,
}
local function set(key, v)
	CFG[key] = v
	local h = HOOKS[key]
	if h then h(v) end
end
local function preset(name)
	local p = PRESETS[name]
	if not p then return end
	for k, v in pairs(p) do set(k, v) end
end

preset("HIGH")
applyLook()

local api = {}
api.Config = CFG
api.Set = set
api.Preset = preset
api.Enable = function() set("Enabled", true) end
api.Disable = function() set("Enabled", false) end
api.Toggle = function() set("Enabled", not CFG.Enabled) end
api.Wipe = function() LN.wipe = true end

api.Destroy = function()
	alive = false
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	pcall(function() RunService:UnbindFromRenderStep("RealRainLens") end)
	for _, s in ipairs(splashes) do pcall(function() s.a:Destroy() end) end
	for _, r in ipairs(RIP.free) do pcall(function() r.p:Destroy() end) end
	for _, p in ipairs(LN.all) do pcall(function() p:Destroy() end) end
	for _, p in ipairs(beads) do pcall(function() p:Destroy() end) end
	for _, p in ipairs(fallParts) do pcall(function() p:Destroy() end) end
	for _, d in pairs({ rainF, proxyF, LN.folder }) do pcall(function() d:Destroy() end) end
	env.RealRain = nil
end
env.RealRain = api
return api
