local panel, panelBtn, fpsLbl
local function buildPanel()
	local gui = Instance.new("ScreenGui")
	gui.Name = "RealRainUI"; gui.ResetOnSpawn = false; gui.IgnoreGuiInset = true; gui.DisplayOrder = 50
	parentGui(gui)
	panel = gui

	local function corner(o, r) local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r); c.Parent = o end
	local function label(parent, text, size, color, font)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1; l.Text = text; l.TextSize = size; l.TextColor3 = color
		l.Font = font or Enum.Font.Gotham; l.TextXAlignment = Enum.TextXAlignment.Left; l.Parent = parent
		return l
	end

	local root = Instance.new("Frame")
	root.AnchorPoint = Vector2.new(1, 0.5); root.Position = UDim2.new(1, -8, 0.5, 0); root.Size = UDim2.new(0, 300, 0.92, 0)
	root.BackgroundColor3 = Color3.fromRGB(16, 18, 24); root.BorderSizePixel = 0; root.Parent = gui
	corner(root, 8)
	local rs = Instance.new("UIStroke"); rs.Color = Color3.fromRGB(45, 50, 62); rs.Parent = root

	local title = label(root, "RAIN SETTINGS", 16, Color3.new(1, 1, 1), Enum.Font.GothamBold)
	title.Position = UDim2.fromOffset(12, 6); title.Size = UDim2.fromOffset(150, 24)
	fpsLbl = label(root, "60 FPS", 13, Color3.fromRGB(80, 220, 120), Enum.Font.GothamBold)
	fpsLbl.Position = UDim2.new(1, -112, 0, 6); fpsLbl.Size = UDim2.fromOffset(70, 24); fpsLbl.TextXAlignment = Enum.TextXAlignment.Right
	local x = Instance.new("TextButton")
	x.Text = "X"; x.Font = Enum.Font.GothamBold; x.TextSize = 14; x.TextColor3 = Color3.fromRGB(200, 205, 215)
	x.BackgroundColor3 = Color3.fromRGB(34, 38, 48); x.Size = UDim2.fromOffset(28, 24); x.Position = UDim2.new(1, -36, 0, 6)
	x.AutoButtonColor = true; x.Parent = root; corner(x, 6)

	local pr = Instance.new("Frame")
	pr.BackgroundTransparency = 1; pr.Position = UDim2.fromOffset(8, 36); pr.Size = UDim2.new(1, -16, 0, 28); pr.Parent = root
	local pl = Instance.new("UIListLayout"); pl.FillDirection = Enum.FillDirection.Horizontal; pl.Padding = UDim.new(0, 4); pl.Parent = pr
	for _, nme in ipairs({ "LOW", "MEDIUM", "HIGH", "ULTRA" }) do
		local b = Instance.new("TextButton")
		b.Text = nme; b.Font = Enum.Font.GothamBold; b.TextSize = 12; b.TextColor3 = Color3.fromRGB(200, 205, 215)
		b.BackgroundColor3 = Color3.fromRGB(34, 38, 48); b.Size = UDim2.new(0.25, -3, 1, 0); b.Parent = pr
		corner(b, 6)
		b.Activated:Connect(function() preset(nme) end)
	end

	local scroll = Instance.new("ScrollingFrame")
	scroll.BackgroundTransparency = 1; scroll.BorderSizePixel = 0
	scroll.Position = UDim2.fromOffset(8, 70); scroll.Size = UDim2.new(1, -16, 1, -76)
	scroll.ScrollBarThickness = 4; scroll.CanvasSize = UDim2.new(); scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.Parent = root
	local ll = Instance.new("UIListLayout"); ll.Padding = UDim.new(0, 3); ll.SortOrder = Enum.SortOrder.LayoutOrder; ll.Parent = scroll

	local activeSlider

	local order = 0
	for _, def in ipairs(UI) do
		order += 1
		if #def == 1 then
			local h = label(scroll, def[1], 11, Color3.fromRGB(80, 160, 255), Enum.Font.GothamBold)
			h.Size = UDim2.new(1, 0, 0, 20); h.LayoutOrder = order
			h.Text = "  " .. def[1]
		else
			local key, name, kind = def[1], def[2], def[3]
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, -6, 0, 26); row.BackgroundColor3 = Color3.fromRGB(28, 31, 40); row.BorderSizePixel = 0
			row.LayoutOrder = order; row.Parent = scroll; corner(row, 4)
			local lb = label(row, name, 12, Color3.fromRGB(205, 210, 220))
			lb.Position = UDim2.fromOffset(8, 0); lb.Size = UDim2.new(1, -160, 1, 0); lb.TextTruncate = Enum.TextTruncate.AtEnd

			if kind == "bool" then
				local b = Instance.new("TextButton")
				b.Text = ""; b.AutoButtonColor = false; b.Size = UDim2.fromOffset(36, 16); b.AnchorPoint = Vector2.new(1, 0.5)
				b.Position = UDim2.new(1, -8, 0.5, 0); b.Parent = row; corner(b, 8)
				local kn = Instance.new("Frame")
				kn.Size = UDim2.fromOffset(12, 12); kn.AnchorPoint = Vector2.new(0, 0.5); kn.BackgroundColor3 = Color3.new(1, 1, 1)
				kn.BorderSizePixel = 0; kn.Parent = b; corner(kn, 6)
				local function upd()
					local on = CFG[key]
					b.BackgroundColor3 = on and Color3.fromRGB(60, 200, 110) or Color3.fromRGB(60, 64, 76)
					kn.Position = UDim2.new(0, on and 22 or 2, 0.5, 0)
				end
				ctrls[key] = upd; upd()
				b.Activated:Connect(function() set(key, not CFG[key]) end)
			elseif kind == "choice" then
				local b = Instance.new("TextButton")
				b.Font = Enum.Font.GothamBold; b.TextSize = 12; b.TextColor3 = Color3.new(1, 1, 1)
				b.BackgroundColor3 = Color3.fromRGB(40, 44, 56); b.Size = UDim2.fromOffset(120, 20); b.AnchorPoint = Vector2.new(1, 0.5)
				b.Position = UDim2.new(1, -6, 0.5, 0); b.Parent = row; corner(b, 4)
				local opts = def[4]
				local function upd() b.Text = tostring(CFG[key]) end
				ctrls[key] = upd; upd()
				b.Activated:Connect(function()
					local idx = table.find(opts, CFG[key]) or 0
					set(key, opts[idx % #opts + 1])
				end)
			elseif kind == "color" then
				local btns = {}
				for i, c in ipairs(COLORS) do
					local b = Instance.new("TextButton")
					b.Text = ""; b.AutoButtonColor = false; b.BackgroundColor3 = c; b.Size = UDim2.fromOffset(16, 16)
					b.AnchorPoint = Vector2.new(1, 0.5); b.Position = UDim2.new(1, -8 - (#COLORS - i) * 21, 0.5, 0)
					b.Parent = row; corner(b, 8)
					local st = Instance.new("UIStroke"); st.Color = Color3.new(1, 1, 1); st.Thickness = 2; st.Parent = b
					btns[i] = st
					b.Activated:Connect(function() set(key, i) end)
				end
				local function upd() for i, st in ipairs(btns) do st.Enabled = (i == CFG[key]) end end
				ctrls[key] = upd; upd()
			else
				local mn, mx, step = def[3], def[4], def[5]
				local dec = step >= 1 and 0 or (step >= 0.1 and 1 or (step >= 0.01 and 2 or 3))
				local vl = label(row, "", 11, Color3.fromRGB(90, 170, 255), Enum.Font.GothamBold)
				vl.Size = UDim2.fromOffset(44, 26); vl.AnchorPoint = Vector2.new(1, 0); vl.Position = UDim2.new(1, -4, 0, 0)
				vl.TextXAlignment = Enum.TextXAlignment.Right
				local bar = Instance.new("TextButton")
				bar.Text = ""; bar.AutoButtonColor = false; bar.BackgroundColor3 = Color3.fromRGB(46, 50, 62); bar.BorderSizePixel = 0
				bar.Size = UDim2.fromOffset(96, 8); bar.AnchorPoint = Vector2.new(1, 0.5); bar.Position = UDim2.new(1, -52, 0.5, 0)
				bar.Parent = row; corner(bar, 4)
				local fill = Instance.new("Frame")
				fill.BackgroundColor3 = Color3.fromRGB(60, 150, 255); fill.BorderSizePixel = 0; fill.Size = UDim2.fromScale(0, 1)
				fill.Parent = bar; corner(fill, 4)
				local function upd()
					local v = CFG[key]
					fill.Size = UDim2.fromScale(clamp((v - mn) / (mx - mn), 0, 1), 1)
					vl.Text = string.format("%." .. dec .. "f", v)
				end
				ctrls[key] = upd; upd()
				local function fromX(px)
					local a = clamp((px - bar.AbsolutePosition.X) / max(bar.AbsoluteSize.X, 1), 0, 1)
					local v = mn + a * (mx - mn)
					v = floor(v / step + 0.5) * step
					set(key, clamp(tonumber(string.format("%.4f", v)), mn, mx))
				end
				bar.InputBegan:Connect(function(i)
					if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
						activeSlider = fromX
						scroll.ScrollingEnabled = false
						fromX(i.Position.X)
					end
				end)
			end
		end
	end

	conns[#conns + 1] = UIS.InputChanged:Connect(function(i)
		if activeSlider and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			activeSlider(i.Position.X)
		end
	end)
	conns[#conns + 1] = UIS.InputEnded:Connect(function(i)
		if activeSlider and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
			activeSlider = nil
			scroll.ScrollingEnabled = true
		end
	end)

	panelBtn = Instance.new("TextButton")
	panelBtn.Text = "RAIN"; panelBtn.Font = Enum.Font.GothamBold; panelBtn.TextSize = 11; panelBtn.TextColor3 = Color3.new(1, 1, 1)
	panelBtn.BackgroundColor3 = Color3.fromRGB(16, 18, 24); panelBtn.BackgroundTransparency = 0.15
	panelBtn.Size = UDim2.fromOffset(44, 30); panelBtn.Position = UDim2.new(0, 8, 0.5, -15); panelBtn.Visible = false
	panelBtn.Parent = gui; corner(panelBtn, 6)

	local function show(v) root.Visible = v; panelBtn.Visible = not v end
	x.Activated:Connect(function() show(false) end)
	panelBtn.Activated:Connect(function() show(true) end)
	return show
end
local showPanel = buildPanel()

task.spawn(function()
	while alive do
		task.wait(0.5)
		if fpsLbl then
			fpsLbl.Text = floor(fpsAvg + 0.5) .. " FPS"
			fpsLbl.TextColor3 = fpsAvg >= 45 and Color3.fromRGB(80, 220, 120) or (fpsAvg >= 30 and Color3.fromRGB(240, 200, 70) or Color3.fromRGB(240, 90, 80))
		end
	end
end)

