local grid = {}
local function cellKeyI(ix, iy, iz) return (ix + 16384) + (iy + 16384) * 32768 + (iz + 16384) * 1073741824 end
local function gridAdd(o)
	local cs = CFG.MergeCell
	local k = cellKeyI(floor(o.pos.X / cs), floor(o.pos.Y / cs), floor(o.pos.Z / cs))
	o.cell = k
	local c = grid[k]
	if c then c[#c + 1] = o else grid[k] = { o } end
end
local function gridDel(o)
	local k = o.cell
	if not k then return end
	local c = grid[k]
	if c then
		for i = 1, #c do
			if c[i] == o then c[i] = c[#c]; c[#c] = nil; break end
		end
		if #c == 0 then grid[k] = nil end
	end
	o.cell = nil
end

