local function getSharedEnvironment()
	local ok, environment = pcall(function()
		return getgenv()
	end)
	if ok and type(environment) == "table" then
		return environment
	end
	return _G
end

local sharedEnvironment = getSharedEnvironment()
if sharedEnvironment.GeorgiaSkyPort and type(sharedEnvironment.GeorgiaSkyPort.Destroy) == "function" then
	pcall(sharedEnvironment.GeorgiaSkyPort.Destroy)
	sharedEnvironment.GeorgiaSkyPort = nil
end

local Cleanup = { tasks = {} }

function Cleanup.add(callback)
	Cleanup.tasks[#Cleanup.tasks + 1] = callback
end

function Cleanup.run()
	for index = #Cleanup.tasks, 1, -1 do
		pcall(Cleanup.tasks[index])
	end
	table.clear(Cleanup.tasks)
end

local function track(instance)
	Cleanup.add(function()
		instance:Destroy()
	end)
	return instance
end

local function connect(signal, callback)
	local connection = signal:Connect(callback)
	Cleanup.add(function()
		connection:Disconnect()
	end)
	return connection
end

local function notify(message)
	warn("[GeorgiaSky] " .. message)
end

