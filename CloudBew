		for px = 0, size - 1 do
			local ax = ((px + 0.5) / size * 2 - 1) * tanHalf
			local dx, dy, dz = sx + rx * ax + ux * ay, sy + ry * ax + uy * ay, sz + rz * ax + uz * ay
			local inv = 1 / sqrt(dx * dx + dy * dy + dz * dz)
			dx, dy, dz = dx * inv, dy * inv, dz * inv
			if dy < 0 then
				writePixel(pixels, size, px, py, 0, 0, 0, 0)
				continue
			end
			local qx, qy, qz = dx - sx, dy - sy, dz - sz
			local chord = sqrt(qx * qx + qy * qy + qz * qz)
			local theta = 2 * asin(min(1, chord * 0.5))
			local verticalScaled = qy / squash
			local te = sqrt(qx * qx + qz * qz + verticalScaled * verticalScaled)
			local al = cloudData and ctx.opacityAt(dx, dy, dz) or 0
			local addR, addG, addB = 0, 0, 0
			if te < thetaSun then
				local m = sqrt(1 - (te / thetaSun) * (te / thetaSun))
				local clear = 12.8 * (1 - al)
				addR = clear * (1 - luR * (1 - m)) * invDenomR * transR
				addG = clear * (1 - luG * (1 - m)) * invDenomG * transG
				addB = clear * (1 - luB * (1 - m)) * invDenomB * transB
			end
			local glare = E0 * 1.2e-6 / (theta * theta + 6e-5) * (1 - 0.5 * al)
			addR, addG, addB = addR + glare * transR, addG + glare * transG, addB + glare * transB
			local d0r, d0g, d0b = Sprites.sampleDisplay(ctx.faceBuffers, ctx.faceSize, ctx.faces, dx, dy, dz)
			overlayPixel(pixels, size, px, py, d0r, d0g, d0b, addR, addG, addB, exposure, Core)
		end
	end
end

local MARIA = {
	{ -0.3, 0.45, 0.3 }, { 0.22, 0.5, 0.2 }, { 0.4, 0.12, 0.24 }, { 0.72, 0.3, 0.13 },
	{ 0.66, -0.1, 0.16 }, { -0.72, 0.05, 0.34 }, { -0.28, -0.4, 0.2 }, { -0.58, -0.45, 0.12 },
}

function Sprites.renderMoon(pixels, size, halfAngleDegrees, moon, sun, ctx, rowStart, rowEnd)
	local tanHalf = tan(math.rad(halfAngleDegrees))
	local mx, my, mz = moon.x, moon.y, moon.z
	local rx, ry, rz, ux, uy, uz = spriteBasis(mx, my, mz)
	local latitude = math.rad(ctx.latitudeDegrees)
	local pnx, pny, pnz = 0, sin(latitude), -cos(latitude)
	local pDot = pnx * mx + pny * my + pnz * mz
	local umx, umy, umz = pnx - mx * pDot, pny - my * pDot, pnz - mz * pDot
	local umLen = sqrt(umx * umx + umy * umy + umz * umz)
	umx, umy, umz = umx / umLen, umy / umLen, umz / umLen
	local rmx, rmy, rmz = my * umz - mz * umy, mz * umx - mx * umz, mx * umy - my * umx
	local exposure, Core, noise = ctx.exposure, ctx.Core, ctx.noise
	local limbLight = min(0.3, 0.6 / exposure)
	local glareGate = smoothstep(0.5, 30, exposure)
	local transR, transG, transB = ctx.transR, ctx.transG, ctx.transB
	local cloudData = ctx.cloudData
	for py = rowStart, rowEnd do
		local ay = (1 - (py + 0.5) / size * 2) * tanHalf
		for px = 0, size - 1 do
			local ax = ((px + 0.5) / size * 2 - 1) * tanHalf
			local dx, dy, dz = mx + rx * ax + ux * ay, my + ry * ax + uy * ay, mz + rz * ax + uz * ay
			local inv = 1 / sqrt(dx * dx + dy * dy + dz * dz)
			dx, dy, dz = dx * inv, dy * inv, dz * inv
			if dy < 0 then
				writePixel(pixels, size, px, py, 0, 0, 0, 0)
				continue
			end
			local ex, ey, ez = dx - mx, dy - my, dz - mz
			local qx = (ex * rmx + ey * rmy + ez * rmz) / 0.0046
			local qy = (ex * umx + ey * umy + ez * umz) / 0.0046
			local r2 = qx * qx + qy * qy
			local chord = sqrt(ex * ex + ey * ey + ez * ez)
			local thetaMoon = 2 * asin(min(1, chord * 0.5))
			local al = cloudData and ctx.opacityAt(dx, dy, dz) or 0
			local k = 0
			if r2 < 1.2 then
				local zz = sqrt(max(1 - r2, 0))
				local nnx = qx * rmx + qy * umx - mx * zz
				local nny = qx * rmy + qy * umy - my * zz
				local nnz = qx * rmz + qy * umz - mz * zz
				local nl = 1 / sqrt(nnx * nnx + nny * nny + nnz * nnz)
				nnx, nny, nnz = nnx * nl, nny * nl, nnz * nl
				local maria = 0
				for i = 1, 8 do
					local m = MARIA[i]
					local ddx, ddy = qx - m[1], qy - m[2]
					maria = maria + exp(-(ddx * ddx + ddy * ddy) / (m[3] * m[3]))
				end
				local lit = 0.02 + (1 - 0.02) * smoothstep(-0.03, 0.1, nnx * sun.x + nny * sun.y + nnz * sun.z)
				local mal = (0.95 + (0.5 - 0.95) * min(maria, 1)) * (0.9 + 0.2 * noise(qx * 9 + 3, qy * 9 + 3))
				local edge = (1 - sqrt(r2)) * 4
				if edge < 0 then edge = 0 elseif edge > 1 then edge = 1 end
				k = limbLight * mal * lit * edge * (1 - al)
			end
			local glare = limbLight * 2e-5 / (thetaMoon * thetaMoon + 6e-5) * (1 - 0.5 * al) * glareGate
			local total = k + glare
			if total * exposure < 4e-4 then
				writePixel(pixels, size, px, py, 0, 0, 0, 0)
				continue
			end
			local d0r, d0g, d0b = Sprites.sampleDisplay(ctx.faceBuffers, ctx.faceSize, ctx.faces, dx, dy, dz)
			overlayPixel(pixels, size, px, py, d0r, d0g, d0b, total * transR, total * transG, total * transB, exposure, Core)
		end
	end
end

function Sprites.renderHalo(pixels, size, halfAngleDegrees, sun, ctx, rowStart, rowEnd)
	local tanHalf = tan(math.rad(halfAngleDegrees))
	local sx, sy, sz = sun.x, sun.y, sun.z
	local rx, ry, rz, ux, uy, uz = spriteBasis(sx, sy, sz)
	local exposure, Core, E0 = ctx.exposure, ctx.Core, ctx.E0
	local R = ctx.R
	local height = ctx.cameraHeight
	local cirrusField = ctx.cirrusField
	local sunTransmittance, aerialTransmittance = ctx.sunTransmittance, ctx.aerialTransmittance
	local innerR, innerG, innerB = 0.372, 0.3825, 0.393
	for py = rowStart, rowEnd do
		local ay = (1 - (py + 0.5) / size * 2) * tanHalf
		for px = 0, size - 1 do
			local ax = ((px + 0.5) / size * 2 - 1) * tanHalf
			local theta = atan(sqrt(ax * ax + ay * ay))
			if abs(theta - 0.382) > 0.045 then
				writePixel(pixels, size, px, py, 0, 0, 0, 0)
				continue
			end
			local dx, dy, dz = sx + rx * ax + ux * ay, sy + ry * ax + uy * ay, sz + rz * ax + uz * ay
			local inv = 1 / sqrt(dx * dx + dy * dy + dz * dz)
			dx, dy, dz = dx * inv, dy * inv, dz * inv
			if dy <= 0.012 then
				writePixel(pixels, size, px, py, 0, 0, 0, 0)
				continue
			end
			local altitude = 9500
			local b = (R + height) * dy
			local t = -b + sqrt(b * b - (height - altitude) * (2 * R + height + altitude))
			local pcx, pcy, pcz = dx * t, R + height + dy * t, dz * t
			local n = cirrusField(ctx.cameraX + pcx, ctx.cameraZ + pcz)
			if n <= 0 then
				writePixel(pixels, size, px, py, 0, 0, 0, 0)
				continue
			end
			local hzR, hzG, hzB = (theta - innerR) / 0.0085, (theta - innerG) / 0.0085, (theta - innerB) / 0.0085
			local hlR, hlG, hlB = exp(-hzR * hzR), exp(-hzG * hzG), exp(-hzB * hzB)
			local A = n * 0.55
			local tapR, tapG, tapB = aerialTransmittance(altitude, dy)
			local stR, stG, stB = sunTransmittance(pcx, pcy, pcz)
			local addR = E0 * stR * hlR * 0.06 * A * tapR
			local addG = E0 * stG * hlG * 0.06 * A * tapG
			local addB = E0 * stB * hlB * 0.06 * A * tapB
			local d0r, d0g, d0b = Sprites.sampleDisplay(ctx.faceBuffers, ctx.faceSize, ctx.faces, dx, dy, dz)
			overlayPixel(pixels, size, px, py, d0r, d0g, d0b, addR, addG, addB, exposure, Core)
		end
	end
end

function Sprites.buildProceduralStars(hash2)
	local stars = {}
	local scale = 1 / 114.59
	for cx = -360, 359 do
		for cy = -180, 179 do
			local h = hash2(cx, cy)
			if h >= 0.992 then
				local fx = 0.2 + 0.6 * (h * 91.7 - floor(h * 91.7))
				local fy = 0.2 + 0.6 * (h * 277.3 - floor(h * 277.3))
				local lon = (cx + fx) * scale
				local lat = (cy + fy) * scale
				local tintMix = h * 733.7 - floor(h * 733.7)
				local brightness = h * 533.1 - floor(h * 533.1)
				local amplitude = brightness ^ 9 * 0.04 * 0.5
				local cl = cos(lat)
				stars[#stars + 1] = {
					qx = cl * cos(lon),
					qy = sin(lat),
					qz = cl * sin(lon),
					r = (1 + (0.72 - 1) * tintMix) * amplitude,
					g = (0.82 + (0.82 - 0.82) * tintMix) * amplitude,
					b = (0.66 + (1 - 0.66) * tintMix) * amplitude,
				}
			end
		end
	end
	return stars
end

local function splat(accumulator, touched, faces, size, dx, dy, dz, r, g, b)
	local ax, ay, az = abs(dx), abs(dy), abs(dz)
	local faceIndex
	if ax >= ay and ax >= az then
		faceIndex = dx > 0 and 1 or 2
	elseif az >= ay then
		faceIndex = dz > 0 and 3 or 4
	else
		faceIndex = dy > 0 and 5 or 6
	end
	local face = faces[faceIndex]
	local along = dx * face.nx + dy * face.ny + dz * face.nz
	local u = (dx * face.rx + dy * face.ry + dz * face.rz) / along
	local v = (dx * face.ux + dy * face.uy + dz * face.uz) / along
	local fx = (u + 1) * 0.5 * size - 0.5
	local fy = (1 - v) * 0.5 * size - 0.5
	local x0, y0 = floor(fx), floor(fy)
	local tx, ty = fx - x0, fy - y0
	local faceOffset = (faceIndex - 1) * size * size
	for oy = 0, 1 do
		local py = y0 + oy
		if py >= 0 and py < size then
			local wy = oy == 0 and (1 - ty) or ty
			for ox = 0, 1 do
				local px = x0 + ox
				if px >= 0 and px < size then
					local w = wy * (ox == 0 and (1 - tx) or tx)
					local key = faceOffset + py * size + px
					local accR = accumulator.r
					if accR[key] == nil then
						accR[key] = 0
						accumulator.g[key] = 0
						accumulator.b[key] = 0
						touched[#touched + 1] = key
					end
					accR[key] = accR[key] + r * w
					accumulator.g[key] = accumulator.g[key] + g * w
					accumulator.b[key] = accumulator.b[key] + b * w
				end
			end
		end
	end
end

function Sprites.bakeBegin(context)
	context.stage = "erase"
	context.cursor = 1
	context.accumulator = { r = {}, g = {}, b = {} }
	context.touched = {}
	context.written = {}
end

function Sprites.bakeStep(context, deadline)
	local clock = os.clock
	local faces = context.faces
	local size = context.size
	local buffers = context.buffers
	if context.stage == "erase" then
		local previous = context.previousKeys
		if previous then
			local count = #previous
			local cursor = context.cursor
			while cursor <= count do
				local key = previous[cursor]
				local faceIndex = floor(key / (size * size)) + 1
				local localIndex = key - (faceIndex - 1) * size * size
				buffer.writeu32(buffers[faceIndex], localIndex * 4, 0)
				cursor = cursor + 1
				if cursor % 128 == 0 and clock() >= deadline then
					context.cursor = cursor
					return false
				end
			end
		end
		context.stage = "procedural"
		context.cursor = 1
	end
	local accumulator, touched = context.accumulator, context.touched
	local siderealCos, siderealSin = context.siderealCos, context.siderealSin
	local cf, sf = context.latitudeCos, context.latitudeSin
	local transmittanceAt = context.transmittanceAt
	local opacityAt = context.opacityAt
	if context.stage == "procedural" then
		local procedural = context.procedural
		local count = #procedural
		local cursor = context.cursor
		while cursor <= count do
			local star = procedural[cursor]
			local qx, qy, qz = star.qx, star.qy, star.qz
			local dx = -siderealSin * qx + siderealCos * qz
			local dy = siderealCos * cf * qx + sf * qy + siderealSin * cf * qz
			local dz = siderealCos * sf * qx - cf * qy + siderealSin * sf * qz
			if dy > 0.004 then
				local tr, tg, tb = transmittanceAt(dy)
				local clear = 1 - opacityAt(dx, dy, dz)
				splat(accumulator, touched, faces, size, dx, dy, dz, star.r * tr * clear, star.g * tg * clear, star.b * tb * clear)
			end
			cursor = cursor + 1
			if cursor % 64 == 0 and clock() >= deadline then
				context.cursor = cursor
				return false
			end
		end
		context.stage = "catalog"
		context.cursor = 1
	end
	if context.stage == "catalog" then
		local catalog = context.catalog
		for i = 1, #catalog do
			local entry = catalog[i]
			if entry.dy > 0.004 then
				local tr, tg, tb = transmittanceAt(entry.dy)
				local clear = 1 - opacityAt(entry.dx, entry.dy, entry.dz)
				splat(accumulator, touched, faces, size, entry.dx, entry.dy, entry.dz, entry.star.colorR * tr * clear, entry.star.colorG * tg * clear, entry.star.colorB * tb * clear)
			end
		end
		context.stage = "convert"
		context.cursor = 1
		context.baseR, context.baseG, context.baseB = context.exposeToDisplay(context.skyR, context.skyG, context.skyB, context.exposure)
	end
	local exposeToDisplay = context.exposeToDisplay
	local exposure = context.exposure
	local skyR, skyG, skyB = context.skyR, context.skyG, context.skyB
	local baseR, baseG, baseB = context.baseR, context.baseG, context.baseB
	local written = context.written
	local count = #touched
	local cursor = context.cursor
	while cursor <= count do
		local key = touched[cursor]
		local d1R, d1G, d1B = exposeToDisplay(skyR + accumulator.r[key], skyG + accumulator.g[key], skyB + accumulator.b[key], exposure)
		local aR = (d1R - baseR) / max(1 - baseR, 0.02)
		local aG = (d1G - baseG) / max(1 - baseG, 0.02)
		local aB = (d1B - baseB) / max(1 - baseB, 0.02)
		local alpha = max(aR, aG, aB)
		if alpha > 0.004 then
			if alpha > 1 then alpha = 1 end
			local faceIndex = floor(key / (size * size)) + 1
			local localIndex = key - (faceIndex - 1) * size * size
			local index = localIndex * 4
			local pixels = buffers[faceIndex]
			buffer.writeu8(pixels, index, toByte((d1R - baseR * (1 - alpha)) / alpha))
			buffer.writeu8(pixels, index + 1, toByte((d1G - baseG * (1 - alpha)) / alpha))
			buffer.writeu8(pixels, index + 2, toByte((d1B - baseB * (1 - alpha)) / alpha))
			buffer.writeu8(pixels, index + 3, toByte(alpha))
			written[#written + 1] = key
		end
		cursor = cursor + 1
		if cursor % 64 == 0 and clock() >= deadline then
			context.cursor = cursor
			return false
		end
	end
	context.previousKeys = written
	context.stage = "done"
	return true
end

return Sprites
end)()

local ImageFactory = {}

function ImageFactory.create(width, height)
	local ok, image = pcall(function()
		return AssetService:CreateEditableImage({ Size = Vector2.new(width, height) })
	end)
	if not ok or not image then
		ok, image = pcall(function()
			local created = (Instance.new :: any)("EditableImage")
			created.Size = Vector2.new(width, height)
			return created
		end)
	end
	if ok and image then
		Cleanup.add(function()
			pcall(function()
				image:Destroy()
			end)
		end)
		return image
	end
	return nil
end

ImageFactory.warned = false

function ImageFactory.write(image, width, height, pixels)
	local ok, err = pcall(function()
		image:WritePixelsBuffer(Vector2.zero, Vector2.new(width, height), pixels)
	end)
	if not ok and not ImageFactory.warned then
		ImageFactory.warned = true
		notify("EditableImage write failed: " .. tostring(err))
	end
	return ok
end

function ImageFactory.content(image)
	return Content.fromObject(image)
end

local Dome = {}

local function createSurfaceGui(part, canvasPixels)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Canvas"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = Vector2.new(canvasPixels, canvasPixels)
	gui.LightInfluence = 0
	gui.Brightness = 1
	gui.AlwaysOnTop = false
	gui.ClipsDescendants = true
	gui.MaxDistance = 100000
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Adornee = part
	gui.Parent = part
	return gui
end

local function createImageLabel(parent, image, zIndex)
	local label = Instance.new("ImageLabel")
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Size = UDim2.fromScale(1, 1)
	label.ZIndex = zIndex
	label.ScaleType = Enum.ScaleType.Stretch
	label.ResampleMode = Enum.ResamplerMode.Default
	local assigned, assignError = pcall(function()
		label.ImageContent = ImageFactory.content(image)
	end)
	if not assigned then
		error("ImageContent is not supported on this client: " .. tostring(assignError))
	end
	label.Parent = parent
	return label
end

function Dome.build(faces, faceImageSets, faceSize, starImages, starSize)
	local half = Config.Sky.HalfSize
	local overlap = Config.Sky.TileOverlap
	local thickness = Config.Sky.CubeThickness
	local tilesPerSide = math.max(1, math.ceil(2 * half / (2048 - overlap)))
	local tileSpan = 2 * half / tilesPerSide
	local partWidth = tileSpan + overlap
	local folder = track(Instance.new("Folder"))
	folder.Name = "GeorgiaSky"
	folder.Parent = Workspace
	local model = Instance.new("Model")
	model.Name = "SkyDome"
	model.Parent = folder
	local dome = { folder = folder, model = model, starLabels = {}, skyLabels = { {}, {} }, tilesPerSide = tilesPerSide, tileSpan = tileSpan }
	local starTilePixels = starImages[1] and (starSize / tilesPerSide) or 0
	local skyTilePixels = faceSize / tilesPerSide
	local canvasPixels = math.max(64, math.ceil(math.max(starTilePixels, skyTilePixels)))
	for faceIndex, face in ipairs(faces) do
		local normal = Vector3.new(face.nx, face.ny, face.nz)
		local upVector = Vector3.new(face.ux, face.uy, face.uz)
		local rightVector = Vector3.new(face.rx, face.ry, face.rz)
		for ty = 0, tilesPerSide - 1 do
			for tx = 0, tilesPerSide - 1 do
				local center = normal * half + rightVector * (-half + (tx + 0.5) * tileSpan) + upVector * (half - (ty + 0.5) * tileSpan)
				local part = Instance.new("Part")
				part.Name = string.format("%s_%d_%d", face.name, tx, ty)
				part.Anchored = true
				part.CanCollide = false
				part.CanQuery = false
				part.CanTouch = false
				part.CastShadow = false
				part.Locked = true
				part.Material = Enum.Material.SmoothPlastic
				part.Color = Color3.new(0, 0, 0)
				part.Size = Vector3.new(partWidth, partWidth, thickness)
				part.CFrame = CFrame.fromMatrix(center, -rightVector, upVector)
				part.Parent = model
				local gui = createSurfaceGui(part, canvasPixels)
				for set = 1, 2 do
					local skyLabel = createImageLabel(gui, faceImageSets[set][faceIndex], set == 1 and 2 or 1)
					skyLabel.ImageRectOffset = Vector2.new(tx * skyTilePixels, ty * skyTilePixels)
					skyLabel.ImageRectSize = Vector2.new(skyTilePixels, skyTilePixels)
					dome.skyLabels[set][#dome.skyLabels[set] + 1] = skyLabel
				end
				if starImages[faceIndex] then
					local starLabel = createImageLabel(gui, starImages[faceIndex], 5)
					starLabel.ImageRectOffset = Vector2.new(tx * starTilePixels, ty * starTilePixels)
					starLabel.ImageRectSize = Vector2.new(starTilePixels, starTilePixels)
					starLabel.Visible = false
					dome.starLabels[#dome.starLabels + 1] = starLabel
				end
			end
		end
	end
	model.WorldPivot = CFrame.new()
	dome.starsVisible = false
	function dome.setStarsVisible(visible)
		if dome.starsVisible == visible then
			return
		end
		dome.starsVisible = visible
		for _, label in ipairs(dome.starLabels) do
			label.Visible = visible
		end
	end
	function dome.beginFade(set)
		for _, label in ipairs(dome.skyLabels[set]) do
			label.ImageTransparency = 1
			label.ZIndex = 3
		end
	end
	function dome.setFade(set, progress)
		local transparency = 1 - math.clamp(progress, 0, 1)
		for _, label in ipairs(dome.skyLabels[set]) do
			label.ImageTransparency = transparency
		end
	end
	function dome.finishFade(set)
		for _, label in ipairs(dome.skyLabels[set]) do
			label.ImageTransparency = 0
			label.ZIndex = 2
		end
		for _, label in ipairs(dome.skyLabels[3 - set]) do
			label.ZIndex = 1
		end
	end
	function dome.follow(cameraPosition)
		model:PivotTo(CFrame.new(cameraPosition))
	end
	return dome
end

function Dome.buildQuad(parent, name, widthStuds, image, canvasPixels)
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Locked = true
	part.Transparency = 1
	part.Size = Vector3.new(widthStuds, widthStuds, 0.2)
	part.Parent = parent
	local gui = createSurfaceGui(part, canvasPixels)
	local label = createImageLabel(gui, image, 1)
	label.Visible = false
	local quad = { part = part, label = label, gui = gui, visible = false }
	function quad.setVisible(visible)
		if quad.visible ~= visible then
			quad.visible = visible
			label.Visible = visible
		end
	end
	function quad.place(cameraPosition, direction, distance)
		local position = cameraPosition + direction * distance
		part.CFrame = CFrame.lookAt(position, cameraPosition)
	end
	return quad
end

local SkyController = {}
SkyController.__index = SkyController

local function angleBetween(ax, ay, az, bx, by, bz)
	local dot = ax * bx + ay * by + az * bz
	if dot > 1 then dot = 1 elseif dot < -1 then dot = -1 end
	return math.deg(math.acos(dot))
end

local function newSpriteState(imageFactory, size)
	return {
		size = size,
		pixels = buffer.create(size * size * 4),
		image = imageFactory.create(size, size),
		rowCursor = 0,
		active = false,
		params = nil,
		lastParams = nil,
		renderRows = nil,
		hasImage = false,
	}
end

function SkyController.new(imageFactory)
	local self = setmetatable({}, SkyController)
	local sky = Config.Sky
	self.imageFactory = imageFactory
	self.faceSize = sky.FaceResolution
	self.starSize = sky.StarResolution
	self.lut = Sky.newLut(sky.LutElevations, sky.LutAzimuths)
	self.lutVersion = 0
	self.faceBuffers = { {}, {} }
	self.faceImages = { {}, {} }
	for set = 1, 2 do
		for index = 1, 6 do
			self.faceBuffers[set][index] = buffer.create(self.faceSize * self.faceSize * 4)
			self.faceImages[set][index] = imageFactory.create(self.faceSize, self.faceSize)
		end
	end
	self.frontSet = 1
	self.faceVersion = 0
	self.fade = nil
	self.starBuffers = {}
	self.starImages = {}
	if sky.StarsEnabled then
		for index = 1, 6 do
			self.starBuffers[index] = buffer.create(self.starSize * self.starSize * 4)
			self.starImages[index] = imageFactory.create(self.starSize, self.starSize)
		end
		self.procedural = Sprites.buildProceduralStars(Core.hash2)
		self.catalog = {}
		for index, star in ipairs(Astro.Stars) do
			self.catalog[index] = { star = star, dx = 0, dy = 0, dz = 0 }
		end
	end
	self.cloudSize = Config.Clouds.Resolution
	self.cloudBuffers = { CloudPass.newBuffer(self.cloudSize), CloudPass.newBuffer(self.cloudSize), CloudPass.newBuffer(self.cloudSize), CloudPass.newBuffer(self.cloudSize) }
	self.faceCloudIndex = nil
	self.cloudFront = 1
	self.cloudVersion = 0
	self.cloudJob = { active = false }
	self.cloudSnapshot = nil
	self.facesCloudVersion = 0
	self.sunSprite = newSpriteState(imageFactory, sky.SunSpriteSize)
	self.moonSprite = newSpriteState(imageFactory, sky.MoonSpriteSize)
	self.haloSprite = newSpriteState(imageFactory, sky.HaloSpriteSize)
	self.stage = "idle"
	self.lastSnapshot = nil
	self.lastCompletedAt = -1e9
	self.starState = { lastExposure = 0, lastSidereal = -1e9, lastBakedAt = -1e9, uploadQueue = {}, baked = false, cloudVersion = -1 }
	self.dome = nil
	self.starJob = { active = false }
	self.starCloudIndex = nil
	return self
end

function SkyController:useAtmosphere(world)
	Atmos.configure(world.sunX, world.sunY, world.sunZ, world.aerosol, world.cameraHeight)
end

function SkyController:currentCloudData()
	if Config.Clouds.Enabled and self.cloudVersion > 0 then
		return self.cloudBuffers[self.cloudFront]
	end
	return nil
end

function SkyController:pickCloudTarget()
	for index = 1, #self.cloudBuffers do
		if index ~= self.cloudFront and index ~= self.faceCloudIndex and index ~= self.starCloudIndex and index ~= self.sunSprite.cloudIndex and index ~= self.moonSprite.cloudIndex and index ~= self.haloSprite.cloudIndex then
			return index
		end
	end
	return 1
end

function SkyController:opacityFunction()
	local data = self:currentCloudData()
	if not data then
		return function()
			return 0
		end
	end
	local size = self.cloudSize
	return function(dx, dy, dz)
		return CloudPass.opacityAt(data, size, Render.Faces, dx, dy, dz)
	end
end

function SkyController:skyRadiance(world, dx, dy, dz)
	local r, g, b = Sky.sample(self.lut, dx, dy, dz)
	if dy > 0 and world.moonIntensity > 0 then
		local mr, mg, mb = Atmos.moonSky(dx, dy, dz, world.moonX, world.moonY, world.moonZ, world.moonIntensity)
		r, g, b = r + mr, g + mg, b + mb
	end
	local glow = Atmos.GLOW
	return r + glow[1], g + glow[2], b + glow[3]
end

function SkyController:snapshotOf(world)
	return {
		sunX = world.sunX, sunY = world.sunY, sunZ = world.sunZ,
		aerosol = world.aerosol, cameraHeight = world.cameraHeight,
		moonX = world.moonX, moonY = world.moonY, moonZ = world.moonZ, moonIntensity = world.moonIntensity,
		exposure = world.exposure,
	}
end

function SkyController:planNext(world, now)
	local last = self.lastSnapshot
	if not last then
		return "lut"
	end
	if self.fade or now - self.lastCompletedAt < Config.Sky.MinRefreshInterval then
		return nil
	end
	if angleBetween(world.sunX, world.sunY, world.sunZ, last.sunX, last.sunY, last.sunZ) > 0.1
		or math.abs(world.aerosol - last.aerosol) > last.aerosol * 0.03
		or math.abs(world.cameraHeight - last.cameraHeight) > 40 then
		return "lut"
	end
	if self.cloudVersion ~= self.facesCloudVersion then
		return "faces"
	end
	if math.abs(world.exposure / last.exposure - 1) > 0.04 then
		return "faces"
	end
	if world.moonIntensity > 0 or last.moonIntensity > 0 then
		if angleBetween(world.moonX, world.moonY, world.moonZ, last.moonX, last.moonY, last.moonZ) > 0.4
			or math.abs(world.moonIntensity - last.moonIntensity) > 0.04 * math.max(last.moonIntensity, 1e-6) then
			return "faces"
		end
	end
	return nil
end

function SkyController:startLut(world)
	local snapshot = self:snapshotOf(world)
	self.pendingSnapshot = snapshot
	self.lutState = Sky.beginBuild(self.lut, snapshot.sunX, snapshot.sunY, snapshot.sunZ, snapshot.aerosol, snapshot.cameraHeight, snapshot.moonX, snapshot.moonY, snapshot.moonZ, snapshot.moonIntensity)
	self.stage = "lut"
end

function SkyController:startFaces(world)
	local snapshot = self.pendingSnapshot or self:snapshotOf(world)
	snapshot.exposure = world.exposure
	snapshot.moonX, snapshot.moonY, snapshot.moonZ, snapshot.moonIntensity = world.moonX, world.moonY, world.moonZ, world.moonIntensity
	self.pendingSnapshot = snapshot
	local glow = Atmos.GLOW
	self.renderSet = 3 - self.frontSet
	if not self.lastSnapshot then
		self.renderSet = self.frontSet
	end
	self.faceFrame = {
		lut = self.lut, Sky = Sky, Core = Core,
		exposure = snapshot.exposure,
		glowR = glow[1], glowG = glow[2], glowB = glow[3],
		moonX = snapshot.moonX, moonY = snapshot.moonY, moonZ = snapshot.moonZ, moonIntensity = snapshot.moonIntensity,
		moonSky = Atmos.moonSky,
		ditherSeedA = math.random() * 50, ditherSeedB = math.random() * 50,
		nightGrain = Config.Sky.NightGrain,
		cloudData = self:currentCloudData(),
		cloudSize = self.cloudSize,
		cloudFloats = CloudPass.FLOATS,
	}
	self.facesCloudVersion = self.cloudVersion
	self.faceCloudIndex = self.faceFrame.cloudData and self.cloudFront or nil
	self.faceIndex = 1
	self.faceRow = 0
	self.stage = "faces"
end

function SkyController:finishFaces(now)
	local set = self.renderSet
	for index = 1, 6 do
		self.imageFactory.write(self.faceImages[set][index], self.faceSize, self.faceSize, self.faceBuffers[set][index])
	end
	self.lastSnapshot = self.pendingSnapshot
	self.lastCompletedAt = os.clock()
	self.faceVersion = self.faceVersion + 1
	self.faceCloudIndex = nil
	self.stage = "idle"
	if set ~= self.frontSet then
		self.frontSet = set
		if self.dome then
			self.dome.beginFade(set)
			self.fade = { set = set, start = os.clock() }
		end
	elseif self.dome then
		self.dome.finishFade(set)
	end
end

function SkyController:stepLut(deadline)
	local finished = Sky.buildStep(self.lutState, Atmos, deadline)
	if finished then
		self.lutVersion = self.lutVersion + 1
		self.lutSnapshot = self.pendingSnapshot
		self.stage = "lutDone"
	end
end

function SkyController:stepFaces(deadline)
	local snapshot = self.pendingSnapshot
	Atmos.configure(snapshot.sunX, snapshot.sunY, snapshot.sunZ, snapshot.aerosol, snapshot.cameraHeight)
	local size = self.faceSize
	local buffers = self.faceBuffers[self.renderSet]
	local frame = self.faceFrame
	while self.stage == "faces" and os.clock() < deadline do
		local rowEnd = math.min(self.faceRow + 1, size - 1)
		frame.faceIndex = self.faceIndex
		Render.renderFaceRows(Render.Faces[self.faceIndex], size, buffers[self.faceIndex], self.faceRow, rowEnd, frame)
		self.faceRow = rowEnd + 1
		if self.faceRow >= size then
			self.faceRow = 0
			self.faceIndex = self.faceIndex + 1
			if self.faceIndex > 6 then
				self:finishFaces()
			end
		end
	end
end

function SkyController:stepSkyPipeline(world, deadline, now)
	if self.stage == "idle" then
		local plan = self:planNext(world, now)
		if plan == "lut" then
			self:startLut(world)
		elseif plan == "faces" then
			self.pendingSnapshot = self:snapshotOf(world)
			self:startFaces(world)
		end
	end
	if self.stage == "lut" then
		self:stepLut(deadline)
	end
	if self.stage == "lutDone" then
		self:startFaces(world)
	end
	if self.stage == "faces" then
		self:stepFaces(deadline)
	end
end

function SkyController:cloudsNeedPass(world)
	local last = self.cloudSnapshot
	if not last then
		return true
	end
	if math.abs(world.windTime - last.windTime) * 6.94 >= Config.Clouds.RefreshDriftMeters then
		return true
	end
	if math.abs(world.convection - last.convection) > 0.04 or math.abs(world.cloudBase - last.cloudBase) > 30 then
		return true
	end
	if angleBetween(world.sunX, world.sunY, world.sunZ, last.sunX, last.sunY, last.sunZ) > 0.3 then
		return true
	end
	if math.abs(world.cameraX - last.cameraX) + math.abs(world.cameraZ - last.cameraZ) > 80 then
		return true
	end
	return false
end

function SkyController:startCloudPass(world)
	local windX, windZ = Astro.windOffset(world.windTime)
	local steps = Config.Clouds.Steps
	if world.timeSpeedEffective >= 300 then
		steps = math.min(steps, 6)
	elseif world.timeSpeedEffective >= 30 then
		steps = math.min(steps, 11)
	end
	local lutSnapshot = self.lutSnapshot
	local params = {
		size = self.cloudSize,
		targetIndex = self:pickCloudTarget(),
		sunX = lutSnapshot.sunX, sunY = lutSnapshot.sunY, sunZ = lutSnapshot.sunZ,
		aerosol = lutSnapshot.aerosol, cameraHeight = lutSnapshot.cameraHeight,
		windX = windX, windZ = windZ, convection = world.convection, cloudBase = world.cloudBase,
		cameraX = world.cameraX, cameraZ = world.cameraZ,
		moonX = world.moonX, moonY = world.moonY, moonZ = world.moonZ, moonIntensity = world.moonIntensity,
		steps = steps, earlyOut = Config.Clouds.EarlyOut,
		windTime = world.windTime,
		lutVersion = self.lutVersion,
	}
	params.target = self.cloudBuffers[params.targetIndex]
	self.cloudParams = params
	CloudPass.begin(self.cloudJob, params)
end

function SkyController:finishCloudPass()
	local params = self.cloudParams
	if params.lutVersion ~= self.lutVersion then
		self.cloudSnapshot = nil
		return
	end
	self.cloudFront = params.targetIndex
	self.cloudVersion = self.cloudVersion + 1
	self.cloudSnapshot = {
		windTime = params.windTime, convection = params.convection, cloudBase = params.cloudBase,
		sunX = params.sunX, sunY = params.sunY, sunZ = params.sunZ,
		cameraX = params.cameraX, cameraZ = params.cameraZ,
	}
end

function SkyController:updateClouds(world, deadline)
	if not Config.Clouds.Enabled or not self.lut.ready or not self.lastSnapshot or not self.lutSnapshot then
		return
	end
	local job = self.cloudJob
	if job.active then
		if CloudPass.step(job, deadline, Render.Faces, self.lut) then
			self:finishCloudPass()
		end
	elseif self:cloudsNeedPass(world) then
		self:startCloudPass(world)
		if CloudPass.step(job, deadline, Render.Faces, self.lut) then
			self:finishCloudPass()
		end
	end
end

function SkyController:updateFade(now)
	local fade = self.fade
	if not fade or not self.dome then
		return
	end
	local progress = (os.clock() - fade.start) / Config.Clouds.FadeSeconds
	if progress >= 1 then
		self.dome.finishFade(fade.set)
		self.fade = nil
	else
		self.dome.setFade(fade.set, progress)
	end
end

function SkyController:spriteContext(world)
	local cloudData = self:currentCloudData()
	return {
		faces = Render.Faces,
		faceBuffers = self.faceBuffers[self.frontSet],
		faceSize = self.faceSize,
		cloudData = cloudData,
		opacityAt = self:opacityFunction(),
		exposure = world.exposure,
		E0 = Atmos.E0,
		Core = Core,
	}
end

function SkyController:spriteNeedsRefresh(state, world, bodyX, bodyY, bodyZ)
	if state.active or not self.lut.ready then
		return false
	end
	local last = state.lastParams
	if not last then
		return true
	end
	return last.lutVersion ~= self.lutVersion
		or last.faceVersion ~= self.faceVersion
		or math.abs(world.exposure / last.exposure - 1) > 0.03
		or angleBetween(bodyX, bodyY, bodyZ, last.bodyX, last.bodyY, last.bodyZ) > 0.12
end

function SkyController:startSunSprite(world)
	local state = self.sunSprite
	self:useAtmosphere(world)
	local sunDirection = { x = world.sunX, y = world.sunY, z = world.sunZ }
	local half = Config.Sky.SunSpriteHalfAngle
	local _, _, _, tr, tg, tb = Atmos.scatter(world.sunX, math.max(world.sunY, 0), world.sunZ, 1e7, 24)
	local context = self:spriteContext(world)
	context.transR, context.transG, context.transB = tr, tg, tb
	state.params = { lutVersion = self.lutVersion, faceVersion = self.faceVersion, exposure = world.exposure, bodyX = world.sunX, bodyY = world.sunY, bodyZ = world.sunZ }
	state.renderRows = function(rowStart, rowEnd)
		Sprites.renderSun(state.pixels, state.size, half, sunDirection, context, rowStart, rowEnd)
	end
	state.rowCursor = 0
	state.active = true
	state.cloudIndex = self.cloudVersion > 0 and self.cloudFront or nil
end

function SkyController:startMoonSprite(world)
	local state = self.moonSprite
	self:useAtmosphere(world)
	local half = Config.Sky.MoonSpriteHalfAngle
	local moonDirection = { x = world.moonX, y = world.moonY, z = world.moonZ }
	local sunDirection = { x = world.sunX, y = world.sunY, z = world.sunZ }
	local tr, tg, tb = Atmos.aerialTransmittance(1e5, world.moonY)
	local context = self:spriteContext(world)
	context.transR, context.transG, context.transB = tr, tg, tb
	context.latitudeDegrees = Astro.Latitude
	context.noise = Core.valueNoise
	state.params = { lutVersion = self.lutVersion, faceVersion = self.faceVersion, exposure = world.exposure, bodyX = world.moonX, bodyY = world.moonY, bodyZ = world.moonZ }
	state.renderRows = function(rowStart, rowEnd)
		Sprites.renderMoon(state.pixels, state.size, half, moonDirection, sunDirection, context, rowStart, rowEnd)
	end
	state.rowCursor = 0
	state.active = true
	state.cloudIndex = self.cloudVersion > 0 and self.cloudFront or nil
end

function SkyController:startHaloSprite(world)
	local state = self.haloSprite
	local half = Config.Sky.HaloSpriteHalfAngle
	local sunDirection = { x = world.sunX, y = world.sunY, z = world.sunZ }
	local context = self:spriteContext(world)
	context.R = Atmos.R
	context.cameraHeight = world.cameraHeight
	context.cameraX, context.cameraZ = world.cameraX, world.cameraZ
	context.cirrusField = CloudField.cirrus
	context.sunTransmittance = Atmos.sunTransmittance
	context.aerialTransmittance = Atmos.aerialTransmittance
	local windX, windZ = Astro.windOffset(world.windTime)
	local convection, cloudBase = world.convection, world.cloudBase
	local aerosol = world.aerosol
	local sunX, sunY, sunZ, height = world.sunX, world.sunY, world.sunZ, world.cameraHeight
	local cameraX, cameraZ = world.cameraX, world.cameraZ
	state.params = { lutVersion = self.lutVersion, faceVersion = self.faceVersion, exposure = world.exposure, bodyX = world.sunX, bodyY = world.sunY, bodyZ = world.sunZ }
	state.renderRows = function(rowStart, rowEnd)
		Atmos.configure(sunX, sunY, sunZ, aerosol, height)
		CloudField.configure(windX, windZ, convection, cloudBase, cameraX, cameraZ, height, sunX, sunY, sunZ)
		Sprites.renderHalo(state.pixels, state.size, half, sunDirection, context, rowStart, rowEnd)
	end
	state.rowCursor = 0
	state.active = true
	state.cloudIndex = self.cloudVersion > 0 and self.cloudFront or nil
end

function SkyController:stepSprite(state, deadline)
	while state.active and os.clock() < deadline do
		local rowEnd = state.rowCursor
		state.renderRows(state.rowCursor, rowEnd)
		state.rowCursor = rowEnd + 1
		if state.rowCursor >= state.size then
			state.active = false
			state.cloudIndex = nil
			self.imageFactory.write(state.image, state.size, state.size, state.pixels)
			state.lastParams = state.params
			state.hasImage = true
		end
	end
end

function SkyController:starsNeedBake(world, now)
	if not Config.Sky.StarsEnabled or not self.lut.ready or self.starJob.active then
		return false
	end
	if world.sunEl > 6 then
		return false
	end
	local state = self.starState
	if #state.uploadQueue > 0 then
		return false
	end
	if not state.baked then
		return true
	end
	local speedFactor = math.min(world.timeSpeed, 600)
	local minimumInterval = speedFactor > 30 and 0.75 or 4
	if now - state.lastBakedAt < minimumInterval then
		return false
	end
	return math.abs(world.exposure / state.lastExposure - 1) > 0.1
		or math.abs(world.siderealDegrees - state.lastSidereal) > 0.05
		or state.cloudVersion ~= self.cloudVersion
end

function SkyController:startStarBake(world, now)
	self:useAtmosphere(world)
	local siderealRadians = math.rad(world.siderealDegrees)
	for _, entry in ipairs(self.catalog) do
		entry.dx, entry.dy, entry.dz = Astro.starDirection(entry.star, world.siderealDegrees)
	end
	local referenceDirectionY = math.sin(math.rad(50))
	local horizontalScale = math.cos(math.rad(50))
	local hx, hz = -world.sunX, -world.sunZ
	local horizontal = math.sqrt(hx * hx + hz * hz)
	if horizontal < 1e-4 then hx, hz, horizontal = 1, 0, 1 end
	local skyR, skyG, skyB = self:skyRadiance(world, hx / horizontal * horizontalScale, referenceDirectionY, hz / horizontal * horizontalScale)
	local context = self.starContext
	if not context then
		context = {
			faces = Render.Faces,
			size = self.starSize,
			buffers = self.starBuffers,
			procedural = self.procedural,
			catalog = self.catalog,
			latitudeCos = math.cos(math.rad(Astro.Latitude)),
			latitudeSin = math.sin(math.rad(Astro.Latitude)),
			exposeToDisplay = Core.exposeToDisplay,
		}
		self.starContext = context
	end
	local lut = self.lut
	context.transmittanceAt = function(dy)
		return Sky.transmittanceAt(lut, dy)
	end
	context.opacityAt = self:opacityFunction()
	self.starCloudIndex = self.cloudVersion > 0 and self.cloudFront or nil
	context.siderealCos, context.siderealSin = math.cos(siderealRadians), math.sin(siderealRadians)
	context.exposure = world.exposure
	context.skyR, context.skyG, context.skyB = skyR, skyG, skyB
	Sprites.bakeBegin(context)
	self.starJob.active = true
	self.starJob.exposure = world.exposure
	self.starJob.sidereal = world.siderealDegrees
	self.starJob.startedAt = now
end

function SkyController:stepStarBake(deadline)
	if Sprites.bakeStep(self.starContext, deadline) then
		local state = self.starState
		self.starJob.active = false
		self.starCloudIndex = nil
		state.baked = true
		state.lastExposure = self.starJob.exposure
		state.lastSidereal = self.starJob.sidereal
		state.lastBakedAt = self.starJob.startedAt
		state.cloudVersion = self.cloudVersion
		state.uploadQueue = { 1, 2, 3, 4, 5, 6 }
	end
end

function SkyController:stepStarUpload()
	local queue = self.starState.uploadQueue
	if #queue > 0 then
		local index = table.remove(queue, 1)
		self.imageFactory.write(self.starImages[index], self.starSize, self.starSize, self.starBuffers[index])
	end
end

function SkyController:update(world, now)
	local deadline = os.clock() + Config.Sky.SliceBudgetSeconds
	self:stepSkyPipeline(world, deadline, now)
	if self.lut.ready and self.lastSnapshot then
		if self.sunSprite.active then
			self:stepSprite(self.sunSprite, deadline)
		elseif self:spriteNeedsRefresh(self.sunSprite, world, world.sunX, world.sunY, world.sunZ) then
			self:startSunSprite(world)
			self:stepSprite(self.sunSprite, deadline)
		end
		if self.moonSprite.active then
			self:stepSprite(self.moonSprite, deadline)
		elseif world.moonIntensity > 0 and self:spriteNeedsRefresh(self.moonSprite, world, world.moonX, world.moonY, world.moonZ) then
			self:startMoonSprite(world)
			self:stepSprite(self.moonSprite, deadline)
		end
		if self.haloSprite.active then
			self:stepSprite(self.haloSprite, deadline)
		elseif world.sunEl > -1 and self:spriteNeedsRefresh(self.haloSprite, world, world.sunX, world.sunY, world.sunZ) then
			self:startHaloSprite(world)
			self:stepSprite(self.haloSprite, deadline)
		end
		if self.starJob.active then
			self:stepStarBake(deadline)
		elseif self:starsNeedBake(world, now) then
			self:startStarBake(world, now)
			self:stepStarBake(deadline)
		end
	end
	self:stepStarUpload()
	self:updateFade(now)
	local cloudBudget = self.cloudVersion == 0 and Config.Clouds.InitialBudgetSeconds or Config.Clouds.BudgetSeconds
	self:updateClouds(world, os.clock() + cloudBudget)
end

function SkyController:renderNow(world, now)
	local everything = os.clock() + 120
	self:startLut(world)
	while self.stage == "lut" do
		self:stepLut(everything)
	end
	self:startFaces(world)
	while self.stage == "faces" do
		self:stepFaces(everything)
	end
	self:startSunSprite(world)
	self:stepSprite(self.sunSprite, everything)
	if world.moonIntensity > 0 then
		self:startMoonSprite(world)
		self:stepSprite(self.moonSprite, everything)
	end
	if world.sunEl > -1 then
		self:startHaloSprite(world)
		self:stepSprite(self.haloSprite, everything)
	end
	if self:starsNeedBake(world, now) then
		self:startStarBake(world, now)
		while self.starJob.active do
			self:stepStarBake(everything)
		end
		while #self.starState.uploadQueue > 0 do
			self:stepStarUpload()
		end
	end
end

local LightingDriver = {}
LightingDriver.__index = LightingDriver

local function clamp(x, lo, hi)
	if x < lo then return lo elseif x > hi then return hi end
	return x
end

local function color(r, g, b)
	return Color3.new(clamp(r, 0, 1), clamp(g, 0, 1), clamp(b, 0, 1))
end

local function luminance(r, g, b)
	return r * 0.2126 + g * 0.7152 + b * 0.0722
end

local SAVED_LIGHTING_PROPERTIES = {
	"ClockTime", "GeographicLatitude", "Ambient", "OutdoorAmbient", "Brightness",
	"ColorShift_Top", "ColorShift_Bottom", "ExposureCompensation",
	"EnvironmentDiffuseScale", "EnvironmentSpecularScale",
}

local SAVED_ATMOSPHERE_PROPERTIES = { "Density", "Offset", "Color", "Decay", "Glare", "Haze" }

function LightingDriver.new()
	local self = setmetatable({}, LightingDriver)
	self.original = {}
	for _, name in ipairs(SAVED_LIGHTING_PROPERTIES) do
		local ok, value = pcall(function()
			return (Lighting :: any)[name]
		end)
		if ok then
			self.original[name] = value
		end
	end
	Cleanup.add(function()
		for name, value in pairs(self.original) do
			pcall(function()
				(Lighting :: any)[name] = value
			end)
		end
	end)
	self.engineClock = Lighting.ClockTime
	self.engineLatitude = Lighting.GeographicLatitude
	self.engineAligned = false
	self.lastEngineTarget = nil
	self.engineUsesMoon = false
	self.lastUpdate = -1e9
	if Config.Lighting.ManageAtmosphere then
		local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
		if atmosphere then
			local saved = {}
			for _, name in ipairs(SAVED_ATMOSPHERE_PROPERTIES) do
				saved[name] = (atmosphere :: any)[name]
			end
			Cleanup.add(function()
				for name, value in pairs(saved) do
					pcall(function()
						(atmosphere :: any)[name] = value
					end)
				end
			end)
		else
			atmosphere = track(Instance.new("Atmosphere"))
			atmosphere.Parent = Lighting
		end
		self.atmosphere = atmosphere
	end
	if Config.Lighting.ManageEffects then
		self.colorCorrection = track(Instance.new("ColorCorrectionEffect"))
		self.colorCorrection.Name = "GeorgiaSkyColor"
		self.colorCorrection.Parent = Lighting
		self.bloom = track(Instance.new("BloomEffect"))
		self.bloom.Name = "GeorgiaSkyBloom"
		self.bloom.Parent = Lighting
		self.sunRays = track(Instance.new("SunRaysEffect"))
		self.sunRays.Name = "GeorgiaSkySunRays"
		self.sunRays.Parent = Lighting
	end
	return self
end

function LightingDriver:directionOf(clockTime, latitude, useMoon)
	Lighting.ClockTime = clockTime
	Lighting.GeographicLatitude = latitude
	if useMoon then
		return Lighting:GetMoonDirection()
	end
	return Lighting:GetSunDirection()
end

function LightingDriver:alignCoarse(target, useMoon)
	local bestError, bestClock, bestLatitude = math.huge, 12, 0
	for latitude = -90, 90, 15 do
		for clockTime = 0, 23.5, 0.5 do
			local direction = self:directionOf(clockTime, latitude, useMoon)
			local err = 1 - direction:Dot(target)
			if err < bestError then
				bestError, bestClock, bestLatitude = err, clockTime, latitude
			end
		end
	end
	self.engineClock, self.engineLatitude = bestClock, bestLatitude
	return bestError
end

function LightingDriver:alignNewton(target, useMoon)
	local clockTime, latitude = self.engineClock, self.engineLatitude
	local stepClock, stepLatitude = 0.05, 1
	for _ = 1, 3 do
		local d0 = self:directionOf(clockTime, latitude, useMoon)
		local dT = (self:directionOf(clockTime + stepClock, latitude, useMoon) - d0) / stepClock
		local dL = (self:directionOf(clockTime, latitude + stepLatitude, useMoon) - d0) / stepLatitude
		local residual = target - d0
		local a11, a12, a22 = dT:Dot(dT), dT:Dot(dL), dL:Dot(dL)
		local b1, b2 = dT:Dot(residual), dL:Dot(residual)
		local determinant = a11 * a22 - a12 * a12 + 1e-9
		local deltaClock = (b1 * a22 - b2 * a12) / determinant
		local deltaLatitude = (a11 * b2 - a12 * b1) / determinant
		clockTime = (clockTime + clamp(deltaClock, -1.5, 1.5)) % 24
		latitude = clamp(latitude + clamp(deltaLatitude, -15, 15), -90, 90)
	end
	self.engineClock, self.engineLatitude = clockTime, latitude
	local final = self:directionOf(clockTime, latitude, useMoon)
	return 1 - final:Dot(target)
end

function LightingDriver:alignEngine(world)
	local useMoon = world.sunY < -0.03 and world.moonY > 0
	local target = useMoon and Vector3.new(world.moonX, world.moonY, world.moonZ) or Vector3.new(world.sunX, world.sunY, world.sunZ)
	local last = self.lastEngineTarget
	if last and not (self.engineUsesMoon ~= useMoon) and (last - target).Magnitude < 0.0008 then
		return
	end
	local err
	if not self.engineAligned or self.engineUsesMoon ~= useMoon then
		self:alignCoarse(target, useMoon)
		err = self:alignNewton(target, useMoon)
		self.engineAligned = true
	else
		err = self:alignNewton(target, useMoon)
		if err > 2e-4 then
			err = self:alignNewton(target, useMoon)
		end
		if err > 5e-3 then
			self:alignCoarse(target, useMoon)
			err = self:alignNewton(target, useMoon)
		end
	end
	self.engineUsesMoon = useMoon
	self.lastEngineTarget = target
	self.engineError = err
	Lighting.ClockTime = self.engineClock
	Lighting.GeographicLatitude = self.engineLatitude
end

function LightingDriver:update(world, skyController, now)
	if now - self.lastUpdate < Config.Lighting.UpdateInterval then
		return
	end
	self.lastUpdate = now
	local lut = skyController.lut
	if not lut.ready then
		return
	end
	local context = lut.groundContext
	local sunGround = lut.sunAtGround
	local E0 = Atmos.E0
	local exposure = world.exposure
	local ambientR = context.ambientR + context.moonR
	local ambientG = context.ambientG + context.moonG
	local ambientB = context.ambientB + context.moonB
	local cloudShadow = 1
	if Config.Clouds.Enabled then
		local windX, windZ = Astro.windOffset(world.windTime)
		CloudField.configure(windX, windZ, world.convection, world.cloudBase, world.cameraX, world.cameraZ, world.cameraHeight, world.sunX, world.sunY, world.sunZ)
		cloudShadow = CloudField.groundShadow()
	end
	local sunVisibility = clamp((world.sunY + 0.02) / 0.05, 0, 1) * cloudShadow
	local sunTermR = E0 * sunGround[1] * sunVisibility / math.pi
	local sunTermG = E0 * sunGround[2] * sunVisibility / math.pi
	local sunTermB = E0 * sunGround[3] * sunVisibility / math.pi
	local shadedR, shadedG, shadedB = Core.exposeToDisplay(ambientR, ambientG, ambientB, exposure)
	local litR, litG, litB = Core.exposeToDisplay(ambientR + sunTermR, ambientG + sunTermG, ambientB + sunTermB, exposure)
	local ambientScale = Config.Lighting.AmbientScale
	local ambientColor = color(shadedR * ambientScale, shadedG * ambientScale, shadedB * ambientScale)
	Lighting.OutdoorAmbient = ambientColor
	Lighting.Ambient = ambientColor
	local sunContribution = math.max(luminance(litR, litG, litB) - luminance(shadedR, shadedG, shadedB), 0)
	local brightness = sunContribution * 5 * Config.Lighting.BrightnessScale
	local useMoon = world.sunY < -0.03 and world.moonY > 0
	if useMoon then
		brightness = clamp(world.moonIntensity / 3e-3, 0, 1) * 0.35 * Config.Lighting.BrightnessScale
	end
	Lighting.Brightness = clamp(brightness, 0, 8)
	local maxChannel = math.max(sunGround[1], sunGround[2], sunGround[3], 1e-6)
	local tintStrength = clamp(1 - world.sunY * 2.5, 0, 1) * clamp((world.sunY + 0.06) / 0.1, 0, 1) * 0.5
	Lighting.ColorShift_Top = color(sunGround[1] / maxChannel * tintStrength, sunGround[2] / maxChannel * tintStrength, sunGround[3] / maxChannel * tintStrength)
	Lighting.ColorShift_Bottom = color(shadedR * 0.08, shadedG * 0.1, shadedB * 0.14)
	Lighting.EnvironmentDiffuseScale = 0
	Lighting.EnvironmentSpecularScale = 0.2
	Lighting.ExposureCompensation = 0
	if Config.Lighting.AlignEngineSun then
		self:alignEngine(world)
	end
	local aerosolRatio = world.aerosol / 4e-5
	local warm = clamp(1 - world.sunY * 4, 0, 1) * clamp((world.sunY + 0.1) / 0.15, 0, 1)
	if self.atmosphere then
		local horizonDirectionX, horizonDirectionZ = -world.sunX, -world.sunZ
		local horizontal = math.sqrt(horizonDirectionX * horizonDirectionX + horizonDirectionZ * horizonDirectionZ)
		if horizontal < 1e-4 then
			horizonDirectionX, horizonDirectionZ, horizontal = 1, 0, 1
		end
		local elevation = math.rad(4)
		local hx, hy, hz = horizonDirectionX / horizontal * math.cos(elevation), math.sin(elevation), horizonDirectionZ / horizontal * math.cos(elevation)
		local hr, hg, hb = skyController:skyRadiance(world, hx, hy, hz)
		local cr, cg, cb = Core.exposeToDisplay(hr, hg, hb, exposure)
		self.atmosphere.Color = color(cr, cg, cb)
		local nr, ng, nb = skyController:skyRadiance(world, world.sunX * 0.98, math.max(world.sunY, 0.05) * 0.98 + 0.02, world.sunZ * 0.98)
		local dr, dg, db = Core.exposeToDisplay(nr, ng, nb, exposure)
		self.atmosphere.Decay = color(dr, dg, db)
		self.atmosphere.Density = clamp(0.06 * aerosolRatio ^ 0.7 * Config.Lighting.AtmosphereDensityScale, 0, 0.5)
		self.atmosphere.Haze = clamp(0.6 * aerosolRatio, 0, 4)
		self.atmosphere.Glare = clamp(0.2 + 0.8 * warm, 0, 1)
		self.atmosphere.Offset = 0.25
	end
	if self.colorCorrection then
		local night = clamp(-world.sunEl / 12, 0, 1)
		self.colorCorrection.Saturation = 0.05 - 0.5 * night
		self.colorCorrection.Contrast = 0.08
		self.colorCorrection.Brightness = 0
		self.colorCorrection.TintColor = color(1 - 0.23 * night * 0.8, 1 - 0.1 * night * 0.8, 1)
		self.bloom.Intensity = 0.25 + 0.3 * warm
		self.bloom.Size = 26
		self.bloom.Threshold = 0.92
		self.sunRays.Intensity = clamp(0.03 + 0.12 * warm, 0, 1) * clamp((world.sunY + 0.05) / 0.1, 0, 1)
		self.sunRays.Spread = 0.8
	end
end

