function Hud:update(world, now)
	local state = self.state
	self.playButton.Text = state.playing and "II" or ">"
	self.speedButton.Text = Config.SpeedLabels[state.speedIndex] or tostring(Config.Speeds[state.speedIndex])
	self.knob.Position = UDim2.new(state.hour / 24, 0, 0.5, 0)
	if now - self.lastText < 0.25 then
		return
	end
	self.lastText = now
	self.clock.Text = Astro.formatClock(state.hour)
	local illumination = math.floor((1 + math.cos(math.rad(world.moonPhase))) * 50 + 0.5)
	self.sun.Text = string.format("Sun %.1f\u{00B0} above horizon \u{00B7} azimuth %.0f\u{00B0} \u{00B7} Moon %d%% lit, %.0f\u{00B0}", world.sunEl, world.sunAz, illumination, world.moonEl)
	self.location.Text = "Atlanta, Georgia \u{00B7} 33.749\u{00B0} N, 84.388\u{00B0} W"
end

local function resolveStartTime()
	local civil = os.date("*t")
	local startHour = Config.StartHour
	if startHour == "Now" then
		local utcSeconds = os.time()
		local utc = os.date("!*t", utcSeconds)
		local offset = Astro.easternOffsetHours(utc.year, utc.month, utc.day)
		local atlanta = os.date("!*t", utcSeconds + offset * 3600)
		Astro.setDate(atlanta.year, atlanta.month, atlanta.day)
		return atlanta.hour + atlanta.min / 60 + atlanta.sec / 3600
	end
	Astro.setDate(civil.year, civil.month, civil.day)
	if type(startHour) == "number" then
		return startHour % 24
	end
	local hour = 17
	local t = 12
	while t < 24 do
		if Astro.sunAt(t) < 1.2 then
			hour = t
			break
		end
		t = t + 1 / 60
	end
	return hour
end

local function computeWorld(state, cameraPosition, deltaTime)
	local world = {}
	local hour = state.hour
	world.hour = hour
	world.sunX, world.sunY, world.sunZ, world.sunEl, world.sunAz = Astro.sunDirection(hour)
	world.humidity, world.aerosol, world.cloudBase, world.convection = Astro.humidityState(hour)
	world.siderealDegrees = Astro.siderealAngle(hour)
	world.moonX, world.moonY, world.moonZ, world.moonEl, world.moonPhase = Astro.moonAt(hour, world.siderealDegrees)
	world.moonIntensity = Astro.moonIntensity(world.moonPhase, world.moonEl)
	local target = Astro.exposureTarget(world.sunEl)
	if state.exposureLog == nil then
		state.exposureLog = target
	else
		local rate = target > state.exposureLog and 3.5 or 0.6
		state.exposureLog = state.exposureLog + (target - state.exposureLog) * (1 - math.exp(-deltaTime / rate))
	end
	world.exposure = 2 ^ state.exposureLog
	world.cameraHeight = math.max(1.7, cameraPosition.Y / STUDS_PER_METER)
	world.cameraX = cameraPosition.X / STUDS_PER_METER
	world.cameraZ = cameraPosition.Z / STUDS_PER_METER
	local speed = Config.Speeds[state.speedIndex]
	world.timeSpeedEffective = speed
	world.timeSpeed = state.playing and speed or 1
	world.windTime = state.windTime
	return world
end

local function start()
	local camera = Workspace.CurrentCamera
	if not camera then
		notify("No CurrentCamera; aborting")
		return
	end
	local state = {
		hour = resolveStartTime(),
		playing = Config.StartPlaying,
		speedIndex = Config.StartSpeedIndex,
		windTime = 0,
		exposureLog = nil,
	}
	Astro.buildStars()
	local cameraPosition = camera.CFrame.Position
	local world = computeWorld(state, cameraPosition, 0)
	local skyController = SkyController.new(ImageFactory)
	local skyReady = skyController.faceImages[1][1] ~= nil
	local dome, sunQuad, moonQuad, haloQuad
	if skyReady then
		local sky = Config.Sky
		local built, failure = pcall(function()
			dome = Dome.build(Render.Faces, skyController.faceImages, skyController.faceSize, skyController.starImages, skyController.starSize)
			local celestialDistance = sky.HalfSize * sky.CelestialDistanceFraction
			sunQuad = Dome.buildQuad(dome.folder, "SunQuad", 2 * celestialDistance * math.tan(math.rad(sky.SunSpriteHalfAngle)), skyController.sunSprite.image, sky.SunSpriteSize)
			moonQuad = Dome.buildQuad(dome.folder, "MoonQuad", 2 * celestialDistance * math.tan(math.rad(sky.MoonSpriteHalfAngle)), skyController.moonSprite.image, sky.MoonSpriteSize)
			haloQuad = Dome.buildQuad(dome.folder, "HaloQuad", 2 * sky.HaloDistance * math.tan(math.rad(sky.HaloSpriteHalfAngle)), skyController.haloSprite.image, sky.HaloSpriteSize)
		end)
		if built then
			skyController.dome = dome
			skyController:renderNow(world, os.clock())
		else
			notify("Could not build the physical sky: " .. tostring(failure))
			skyReady = false
		end
	else
		notify("EditableImage is unavailable here, so the physical sky texture is disabled")
	end
	local lightingDriver
	if Config.Lighting.Enabled then
		lightingDriver = LightingDriver.new()
	end
	local hud
	if Config.Hud.Enabled then
		task.spawn(function()
			hud = Hud.new(state)
		end)
	end
	local previousClock = os.clock()
	local function step()
		local now = os.clock()
		local deltaTime = math.min(now - previousClock, 0.1)
		previousClock = now
		local currentCamera = Workspace.CurrentCamera
		if not currentCamera then
			return
		end
		local speed = Config.Speeds[state.speedIndex]
		if state.playing then
			state.hour = (state.hour + deltaTime * speed / 3600) % 24
		end
		state.windTime = state.windTime + deltaTime * speed
		local position = currentCamera.CFrame.Position
		local currentWorld = computeWorld(state, position, deltaTime)
		if skyReady then
			dome.follow(position)
			local sunDirection = Vector3.new(currentWorld.sunX, currentWorld.sunY, currentWorld.sunZ)
			local moonDirection = Vector3.new(currentWorld.moonX, currentWorld.moonY, currentWorld.moonZ)
			local celestialDistance = Config.Sky.HalfSize * Config.Sky.CelestialDistanceFraction
			sunQuad.place(position, sunDirection, celestialDistance)
			moonQuad.place(position, moonDirection, celestialDistance)
			haloQuad.place(position, sunDirection, Config.Sky.HaloDistance)
			skyController:update(currentWorld, now)
			sunQuad.setVisible(skyController.sunSprite.hasImage == true and currentWorld.sunEl > -2.5)
			moonQuad.setVisible(skyController.moonSprite.hasImage == true and currentWorld.moonIntensity > 0)
			haloQuad.setVisible(skyController.haloSprite.hasImage == true and currentWorld.sunEl > -1)
			dome.setStarsVisible(Config.Sky.StarsEnabled and skyController.starState.baked and currentWorld.sunEl < 7)
		end
		if lightingDriver and skyReady then
			lightingDriver:update(currentWorld, skyController, now)
		end
		if hud then
			hud:update(currentWorld, now)
		end
		local port = sharedEnvironment.GeorgiaSkyPort
		if port then
			port.World = currentWorld
			port.Sky = skyController
			port.Lighting = lightingDriver
		end
	end
	RunService:BindToRenderStep("GeorgiaSkyStep", Enum.RenderPriority.Camera.Value + 1, step)
	Cleanup.add(function()
		RunService:UnbindFromRenderStep("GeorgiaSkyStep")
	end)
	sharedEnvironment.GeorgiaSkyPort = {
		Destroy = function()
			Cleanup.run()
			sharedEnvironment.GeorgiaSkyPort = nil
		end,
		State = state,
		Config = Config,
	}
end

start()
