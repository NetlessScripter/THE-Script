local function lerpNumber(a, b, t)
	return a + (b - a) * t
end

local function smoothstep(t)
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

local function lerpValue(a, b, t)
	if typeof(a) == "Color3" and typeof(b) == "Color3" then
		return a:Lerp(b, t)
	elseif typeof(a) == "number" and typeof(b) == "number" then
		return lerpNumber(a, b, t)
	elseif typeof(a) == "table" and typeof(b) == "table" then
		local out = {}
		for k, v in pairs(a) do
			out[k] = lerpValue(v, b[k], t)
		end
		return out
	else
		return a
	end
end

local function interpolateWeather(weatherTable, hour)
	local count = #weatherTable
	local lo, hi = weatherTable[count], weatherTable[1]
	local loTime, hiTime = lo.time - 24, hi.time

	for i = 1, count do
		local a = weatherTable[i]
		local b = weatherTable[i + 1] or weatherTable[1]
		local aTime = a.time
		local bTime = (b.time <= aTime) and (b.time + 24) or b.time
		if hour >= aTime and hour <= bTime then
			lo, hi = a, b
			loTime, hiTime = aTime, bTime
			break
		end
	end

	local span = hiTime - loTime
	local t = span > 0 and smoothstep((hour - loTime) / span) or 0
	return lerpValue(lo, hi, t)
end

