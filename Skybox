local function getSunPosition(distance)
	distance = distance or 4500
	local direction = Lighting:GetSunDirection()
	local camera = workspace.CurrentCamera
	local origin = camera and camera.CFrame.Position or Vector3.new(0, 0, 0)
	return origin + direction * distance
end

local function setWeather(name, blendSeconds)
	if not Data[name] then
		warn("[RageSkybox] Unknown weather preset: " .. tostring(name))
		return
	end
	if name == targetWeatherName and blendAlpha >= 1 then
		return
	end

	if blendAlpha < 1 then
		weatherName = targetWeatherName
	end

	targetWeatherName = name
	blendDuration = math.max(blendSeconds or 8, 0.01)
	blendTime = 0
	blendAlpha = 0
end

local function update(dt)
	if not paused then
		hour = (hour + (dt / secondsPerGameDay) * 24) % 24
	end

	if blendAlpha < 1 then
		blendTime += dt
		blendAlpha = math.clamp(blendTime / blendDuration, 0, 1)
		if blendAlpha >= 1 then
			weatherName = targetWeatherName
		end
	end

	resolve()
	apply()
end

resolve()
apply()

_G.RageSkybox = {
	SetWeather = setWeather,
	SetTime = function(h)
		hour = h % 24
	end,
	SetPaused = function(p)
		paused = p
	end,
	SetDayLength = function(realMinutesPerDay)
		secondsPerGameDay = math.max(realMinutesPerDay, 0.001) * 60
	end,
	GetHour = function()
		return hour
	end,
	GetWeather = function()
		return targetWeatherName
	end,
	GetState = function()
		return state
	end,
	GetSunDirection = getSunDirection,
	GetMoonDirection = getMoonDirection,
	GetSunPosition = getSunPosition,
}

RunService.Heartbeat:Connect(update)
