local function applySkyFill(s)
	local sunElevation = Lighting:GetSunDirection():Dot(UP)
	twilightAmount = 1 - math.clamp((sunElevation + 0.05) / 0.25, 0, 1)

	local minBrightness = 1.3 + 0.35 * twilightAmount
	if (1 + s.zenith.intensity) < minBrightness then
		s.zenith.intensity = minBrightness - 1
	end

	local skyFill = C3(70, 82, 108)
	s.ambientColor = s.ambientColor:Lerp(skyFill, 0.55 * twilightAmount)

	s.hdrExposure = math.max(s.hdrExposure, -0.1)
	return s
end

local function resolve()
	Lighting.ClockTime = hour

	local fromState = interpolateWeather(Data[weatherName], hour)
	if blendAlpha < 1 then
		local toState = interpolateWeather(Data[targetWeatherName], hour)
		state = lerpValue(fromState, toState, smoothstep(blendAlpha))
	else
		state = fromState
	end
	state = applySkyFill(state)
end

local function apply()
	local s = state
	if not s then
		return
	end

	Lighting.ClockTime = hour
	Lighting.Brightness = 1 + s.zenith.intensity
	Lighting.ExposureCompensation = s.hdrExposure
	Lighting.OutdoorAmbient = s.ambientColor
	Lighting.Ambient = s.ambientColor
	Lighting.ColorShift_Top = s.zenith.color
	Lighting.ColorShift_Bottom = s.horizon.color

	Lighting.FogColor = s.fog.color
	local farClip = math.clamp(6000 * (1 - s.fog.density), 250, 6000)
	Lighting.FogStart = farClip * 0.05
	Lighting.FogEnd = farClip

	sky.SunAngularSize = 15 * math.clamp(s.sun.size, 0.1, 2)
	sky.MoonAngularSize = 15 * math.clamp(s.moon.size, 0.1, 2)
	sky.StarCount = math.floor(3000 * s.starIntensity)

	atmosphere.Color = s.fog.color
	atmosphere.Decay = s.horizon.color
	atmosphere.Density = math.clamp(s.fog.density * 0.4, 0, 1)
	atmosphere.Haze = math.clamp(s.fog.haze * 7, 0, 10)
	atmosphere.Glare = math.clamp(s.sun.glare, 0, 1)

	colorCorrection.Contrast = 0.15 * (1 - twilightAmount)
	colorCorrection.Brightness = 0.12 * twilightAmount
end

