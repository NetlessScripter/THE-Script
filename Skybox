local function kf(t)
	return {
		time = t.time,
		zenith = { color = t.zenith[1], intensity = t.zenith[2] },
		horizon = { color = t.horizon[1], intensity = t.horizon[2] },
		sun = { color = t.sun[1], intensity = t.sun[2], size = t.sun[3], glare = t.sun[4] },
		moon = { color = t.moon[1], size = t.moon[2] },
		starIntensity = t.starIntensity,
		cloud = { lit = t.cloud[1], shadow = t.cloud[2], density = t.cloud[3] },
		fog = { color = t.fog[1], density = t.fog[2], haze = t.fog[3] },
		lightRay = { intensity = t.lightRay[1], falloff = t.lightRay[2] },
		dirLightColor = t.dirLightColor,
		ambientColor = t.ambientColor,
		hdrExposure = t.hdrExposure,
	}
end

