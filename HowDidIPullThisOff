local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local ok, objs = pcall(function()
	return game:GetObjects("rbxassetid://6812562887")
end)

if not ok or not objs then
	warn("Could not load asset")
	return
end

for _, obj in ipairs(objs) do
	obj.Parent = ReplicatedStorage
end

local CloudsFolder = ReplicatedStorage:WaitForChild("CloudsModule")

local CloudsModule = {}
local CloudClass = {}
CloudClass.__index = CloudClass
CloudsModule.Clouds = CloudClass

local DefaultValues = {
	Tallness = 40,
	Offset = 0,
	Density = 0.2,
	Speed = 5,
	Height = 1500,
	Size = 3.572,
	ShadowCast = true,
	CloudType = "Cumulus",
}

-- Blends around the hue wheel (shortest arc) instead of straight-line RGB.
-- RGB lerping between two saturated colors (e.g. gold -> blue) cuts through
-- muddy grey/brown in the middle; walking the wheel by hue keeps every step
-- of the gradient looking like an actual color instead of a desaturated mix.
local function WheelLerp(colorA, colorB, alpha)
	local h1, s1, v1 = colorA:ToHSV()
	local h2, s2, v2 = colorB:ToHSV()

	local diff = h2 - h1
	if diff > 0.5 then
		diff -= 1
	elseif diff < -0.5 then
		diff += 1
	end

	local h = (h1 + diff * alpha) % 1
	local s = s1 + (s2 - s1) * alpha
	local v = v1 + (v2 - v1) * alpha

	return Color3.fromHSV(h, s, v)
end

-- Darkens a color for the silhouette band without hue-shifting it toward red
-- the way lerping straight to Color3.new(0, 0, 0) would (black's hue is 0).
-- Real shadow just loses brightness/chroma, it doesn't change color.
local function Shadow(color, amount)
	local h, s, v = color:ToHSV()
	return Color3.fromHSV(h, s * (1 - amount * 0.4), v * (1 - amount))
end

-- Approximates blackbody/daylight color temperature (Kelvin) as RGB.
-- Real sunlight runs ~2000K hugging the horizon (Rayleigh scattering strips
-- out blue) up to ~6500K near zenith (all wavelengths intact, reads white).
local function KelvinToColor3(kelvin)
	local temp = kelvin / 100
	local r, g, b

	if temp <= 66 then
		r = 255
	else
		r = 329.698727446 * ((temp - 60) ^ -0.1332047592)
	end

	if temp <= 66 then
		g = 99.4708025861 * math.log(temp) - 161.1195681661
	else
		g = 288.1221695283 * ((temp - 60) ^ -0.0755148492)
	end

	if temp >= 66 then
		b = 255
	elseif temp <= 19 then
		b = 0
	else
		b = 138.5177312231 * math.log(temp - 10) - 305.0447927307
	end

	return Color3.fromRGB(
		math.clamp(r, 0, 255),
		math.clamp(g, 0, 255),
		math.clamp(b, 0, 255)
	)
end

-- Real Mie scattering (what light does hitting droplets much bigger than its
-- wavelength) is heavily forward-peaked - most photons keep going roughly the
-- direction they were already headed, just deflected slightly. The Henyey-
-- Greenstein phase function is the standard cheap approximation of that: a
-- single "asymmetry" parameter g controls how tightly the glow hugs the exact
-- sun direction. g=0 would be flat/uniform in every direction (wrong - real
-- clouds aren't); g near 1 is a tight, fast-falloff spike right at the sun -
-- cloud droplets sit around g=0.85-0.90, which is why the silver-lining halo
-- in real photos is a narrow bright rim, not a broad soft glow.
local function HenyeyGreenstein(cosTheta, g)
	local g2 = g * g
	local denom = (1 + g2 - 2 * g * cosTheta) ^ 1.5
	local hg = (1 - g2) / math.max(denom, 1e-4)
	-- hg's own peak value at cosTheta=1 depends on g, so divide it out to
	-- land the curve in a clean 0..1 range regardless of which g we pick.
	local hgPeak = (1 + g) / ((1 - g) ^ 2)
	return math.clamp(hg / hgPeak, 0, 1)
end

-- Blends a cloud's tint by t=0..1, where 1 is "fully catching direct forward-
-- scattered sunlight" and 0 is "fully shadowed." t itself already folds in
-- both the phase function above and the self-shadow term below - this just
-- turns that single number into a color.
local function SunTint(t, base, nearColor)
	local dark = Shadow(base, 0.7)

	if t > 0.75 then
		return WheelLerp(dark, nearColor, (t - 0.75) / 0.25)
	elseif t > 0.4 then
		return WheelLerp(base, dark, (t - 0.4) / 0.35)
	else
		return base
	end
end

-- Fractal Brownian motion: sums several octaves of noise at increasing
-- frequency/decreasing amplitude. A single math.noise call gives one clean
-- wavelength of variation, which looks like a sine wave once you see it move
-- - real cloud structure is turbulent and self-similar at multiple scales
-- (big lumps built out of medium lumps built out of small ones), so layering
-- octaves is what actually gets rid of the "obviously one wave" look.
local function FBM(x, seed, octaves)
	local total, amplitude, frequency, maxValue = 0, 1, 1, 0
	for i = 1, octaves do
		total += math.noise(x * frequency, seed + i * 37.219) * amplitude
		maxValue += amplitude
		amplitude *= 0.5
		frequency *= 2.17 -- non-integer lacunarity avoids octaves lining up and repeating
	end
	return total / maxValue -- ~ -1..1
end

-- Tries to read the actual pixels of the skybox's top face and figure out
-- what color is mainly showing up there. Weighted circular mean of hue,
-- weighted by saturation*value so washed-out white/grey sky doesn't drown
-- out the color actually doing the work - that's "the color that's mainly
-- showing" rather than a flat average that trends toward grey.
--
-- Roblox only allows CreateEditableImageAsync on images you/the experience
-- own, so this will fail on most third-party skyboxes - that's expected,
-- not a bug. Returns nil on any failure so the caller can fall back.
local function GetDominantSkyColor()
	local sky = Lighting:FindFirstChildOfClass("Sky")
	if not sky or sky.SkyboxUp == "" then
		return nil
	end

	local ok, result = pcall(function()
		local AssetService = game:GetService("AssetService")
		local editableImage = AssetService:CreateEditableImageAsync(sky.SkyboxUp)
		if not editableImage then
			return nil
		end

		local size = editableImage.Size
		local pixels = editableImage:ReadPixelsBuffer(Vector2.zero, size)
		editableImage:Destroy()

		local step = math.max(1, math.floor(math.min(size.X, size.Y) / 24))
		local sinSum, cosSum, satSum, valSum, weightSum = 0, 0, 0, 0, 0

		for y = 0, size.Y - 1, step do
			for x = 0, size.X - 1, step do
				local index = (y * size.X + x) * 4
				local h, s, v = Color3.fromRGB(
					buffer.readu8(pixels, index),
					buffer.readu8(pixels, index + 1),
					buffer.readu8(pixels, index + 2)
				):ToHSV()

				local weight = s * v
				sinSum += math.sin(h * math.pi * 2) * weight
				cosSum += math.cos(h * math.pi * 2) * weight
				satSum += s * weight
				valSum += v * weight
				weightSum += weight
			end
		end

		if weightSum < 0.001 then
			return nil
		end

		local hue = (math.atan2(sinSum, cosSum) / (math.pi * 2)) % 1
		return Color3.fromHSV(hue, satSum / weightSum, valSum / weightSum)
	end)

	if ok then
		return result
	end

	return nil
end

-- Same idea as Shadow, but brightens/dims toward a per-layer shade value
-- (used for the original vertical banding effect) without desaturating the
-- color the way lerping toward flat grey would.
local function Tone(color, shade)
	local h, s, v = color:ToHSV()
	return Color3.fromHSV(h, s, math.clamp(v * (0.6 + shade * 0.8), 0, 1))
end

function CloudClass:new(attributes)
	local self = setmetatable({}, CloudClass)
	attributes = attributes or {}

	self.Tallness = attributes.Tallness or DefaultValues.Tallness
	self.Offset = attributes.Offset or DefaultValues.Offset
	self.Density = attributes.Density or DefaultValues.Density
	self.Speed = attributes.Speed or DefaultValues.Speed
	self.Height = attributes.Height or DefaultValues.Height
	self.Size = attributes.Size or DefaultValues.Size
	self.ShadowCast = attributes.ShadowCast ~= nil and attributes.ShadowCast or DefaultValues.ShadowCast
	self.CloudType = attributes.CloudType or DefaultValues.CloudType

	return self
end

function CloudClass:SpawnClouds()
	task.spawn(function()
		local templateName = self.CloudType == "Stratus" and "StratusCloud" or "CumulusCloud"
		local template = CloudsFolder:WaitForChild(templateName)
		local lastCloud = template
		local darkness = 100
		local rng = Random.new()

		local camera = workspace.CurrentCamera
		local sunDir = Lighting:GetSunDirection()
		local sunElevation = math.clamp(sunDir.Y, 0, 1) -- 0 = on the horizon, 1 = zenith

		-- Prefer the actual skybox's dominant color over an authored mood
		-- color, and prefer that over a generic physics guess - each is a
		-- fallback for when the one before it isn't available.
		--
		-- ColorShift_Top/ColorShift_Bottom are Roblox's own built-in properties
		-- for tinting geometry based on whether it faces up or down relative to
		-- the world - exactly the "sunlit top / shadowed underside" split real
		-- clouds need, and they're already hand-tuned to this rig's golden/khaki
		-- palette rather than us guessing at a generic sunset color. Atmosphere.
		-- Decay is deliberately NOT used here: its Roblox engine default is an
		-- unrelated dark brown, and it only reads correctly once Haze/Glare have
		-- actually been authored for it - the exact trap that turned the clouds
		-- brown before.
		local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
		local nearSunColor = GetDominantSkyColor()
			or (atmosphere and atmosphere.Color and atmosphere.Color:Lerp(Lighting.ColorShift_Top, 0.6))
			or KelvinToColor3(2000 + sunElevation * 4500)
		local awaySunColor = Lighting.ColorShift_Bottom

		lastCloud.Position = Vector3.new(392.629, self.Height, -405.891)

		local spawned = {}

		for _ = 1, self.Tallness do
			local cl = lastCloud:Clone()
			local ran1 = math.random(-self.Offset, self.Offset)
			local ran2 = math.random(-self.Offset, self.Offset)

			cl.Parent = workspace
			cl.Position = cl.Position + Vector3.new(ran1, 5, ran2)
			cl.CastShadow = self.ShadowCast

			if self.Size == 3.572 then
				cl.Size = Vector3.new(
					rng:NextNumber(2.9, 3),
					0.143,
					rng:NextNumber(2.9, 3)
				)
			else
				cl.Size = Vector3.new(
					rng:NextNumber(2.9, self.Size),
					0.143,
					rng:NextNumber(2.9, self.Size)
				)
			end

			local alignment = (cl.Position - camera.CFrame.Position).Unit:Dot(sunDir)
			table.insert(spawned, { instance = cl, shade = darkness / 255, alignment = alignment })

			darkness += 10
			lastCloud = cl
		end

		-- Clouds spawned this close together barely differ in raw sun
		-- alignment (the whole cluster is small relative to how far away the
		-- sun effectively is), so stretch whatever spread actually exists
		-- across the full -1..1 range HenyeyGreenstein expects, rather than
		-- relying on fixed thresholds that assume a wide-open sky.
		local minAlign, maxAlign = math.huge, -math.huge
		for _, data in ipairs(spawned) do
			minAlign = math.min(minAlign, data.alignment)
			maxAlign = math.max(maxAlign, data.alignment)
		end
		local alignRange = math.max(maxAlign - minAlign, 0.0001)

		local g = 0.87 -- forward-scattering asymmetry for cloud-droplet-sized Mie scattering
		local shadowNoiseScale = 12 -- lower = tighter self-shadow bands, higher = broader ones
		local shadowSeed = rng:NextNumber(0, 1000)

		for _, data in ipairs(spawned) do
			local cl = data.instance

			-- Forward scattering (Mie): stretch this cloud's alignment into
			-- the batch's available -1..1 range, then run it through the
			-- phase function so brightness peaks sharply the closer a cloud
			-- sits to the sun's exact forward direction.
			local cosTheta = ((data.alignment - minAlign) / alignRange) * 2 - 1
			local glow = HenyeyGreenstein(cosTheta, g)

			-- Self-shadowing: a cloud closer to the sun blocks light from
			-- ever reaching clouds behind it, regardless of how well-aligned
			-- those clouds are - real cloud banks are optically thick, so
			-- this is the actual mechanism behind the streaky look, not
			-- randomness for its own sake. We can't raytrace through the
			-- neighboring cloud geometry cheaply, so fBm noise (sampled
			-- along Position.Y, since that's what actually varies when
			-- Offset is 0 and the stack runs straight up) stands in for
			-- "how much intervening cloud mass happened to be in the way,"
			-- with several octaves so the bands look like turbulent cloud
			-- structure rather than one clean sine wave. This is scaled
			-- into a Beer-Lambert-style transmittance term (0 = fully
			-- blocked, 1 = fully open) rather than left as raw noise.
			local shadowNoise = FBM(cl.Position.Y / shadowNoiseScale, shadowSeed, 3)
			local transmittance = math.clamp(0.35 + 0.65 * ((shadowNoise + 1) / 2), 0, 1)

			-- Real clouds are colorless water droplets - their "true color"
			-- is just whatever light is actually hitting a given face. The
			-- top faces the open sky, catching direct forward-scattered
			-- sunlight almost unobstructed, so it should read close to the
			-- warm near-sun color with the self-shadow term barely touching
			-- it. The underside only ever gets weak ambient bounce light
			-- filtered through the cloud's own mass above it, so it should
			-- skew toward the cooler ColorShift_Bottom tone and take the
			-- self-shadow term at full strength, same reason real cumulus
			-- clouds have bright tops and flat grey-khaki bottoms.
			local topBase = Tone(nearSunColor:Lerp(awaySunColor, 0.35), data.shade)
			local topT = math.clamp(glow * (0.6 + 0.4 * transmittance), 0, 1)
			local topColor = SunTint(topT, topBase, nearSunColor)

			local bottomBase = Tone(awaySunColor, data.shade)
			local bottomT = math.clamp(glow * transmittance * 0.5, 0, 1)
			local bottomColor = SunTint(bottomT, bottomBase, nearSunColor)

			if cl:FindFirstChild("Texture1") then
				cl.Texture1.Transparency = 1 - self.Density
				cl.Texture1.Color3 = topColor
			end

			if cl:FindFirstChild("Texture2") then
				cl.Texture2.Transparency = 1 - self.Density
				cl.Texture2.Color3 = bottomColor
			end
		end
	end)
end

local Clouds = CloudsModule.Clouds:new({
	Tallness = 40,
	Offset = 0, -- a zero offset stacks every cloud on the same X/Z,
	-- collapsing the sun-alignment dot product to nearly identical values
	-- for every cloud (SunTint never leaves the "base" branch). Give the
	-- formation real horizontal width so there's an actual near-sun/
	-- off-axis side for it to shade between.
	Density = 0.2,
	Speed = 5,
	Height = 1500,
	Size = 3.572,
	ShadowCast = true,
	CloudType = "Cumulus"
})

Clouds:SpawnClouds()
