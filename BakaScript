local rng = Random.new()

local function rand(a, b)
    return rng:NextNumber(a, b)
end

local function lerp(a, b, t)
    return a + (b - a) * t
end

-- Maid: collects instances / connections / functions and cleans them all in one call
local Maid = {}
Maid.__index = Maid

function Maid.new()
    return setmetatable({tasks = {}}, Maid)
end

function Maid:Add(item)
    table.insert(self.tasks, item)
    return item
end

function Maid:Clean()
    local list = self.tasks
    self.tasks = {}
    for i = #list, 1, -1 do
        local item = list[i]
        pcall(function()
            local kind = typeof(item)
            if kind == "RBXScriptConnection" then
                item:Disconnect()
            elseif kind == "Instance" then
                item:Destroy()
            elseif kind == "function" then
                item()
            end
        end)
    end
end

-- Easing: every function takes 0..1 and returns 0..1
local Ease = {}
Ease.linear = function(a) return a end
Ease.sine = function(a) return -(math.cos(math.pi * a) - 1) / 2 end
Ease.quadIn = function(a) return a * a end
Ease.quadOut = function(a) return 1 - (1 - a) * (1 - a) end
Ease.cubicOut = function(a) return 1 - (1 - a) ^ 3 end
Ease.quartIn = function(a) return a ^ 4 end
Ease.quartOut = function(a) return 1 - (1 - a) ^ 4 end
Ease.quartInOut = function(a)
    if a < 0.5 then return 8 * a ^ 4 end
    return 1 - ((-2 * a + 2) ^ 4) / 2
end
Ease.expoIn = function(a) return a <= 0 and 0 or 2 ^ (10 * a - 10) end
Ease.expoOut = function(a) return a >= 1 and 1 or 1 - 2 ^ (-10 * a) end
Ease.backOut = function(a)
    local c1 = 1.70158
    local c3 = c1 + 1
    return 1 + c3 * (a - 1) ^ 3 + c1 * (a - 1) ^ 2
end
Ease.smoother = function(a) return a * a * a * (a * (a * 6 - 15) + 10) end

-- Camera path builders: each returns f(e) -> Vector3 for e in 0..1
local Path = {}

function Path.line(a, b)
    return function(e) return a:Lerp(b, e) end
end

function Path.bezier(a, c, b)
    return function(e)
        local u = 1 - e
        return a * (u * u) + c * (2 * u * e) + b * (e * e)
    end
end

function Path.cubic(a, c1, c2, b)
    return function(e)
        local u = 1 - e
        return a * (u * u * u) + c1 * (3 * u * u * e) + c2 * (3 * u * e * e) + b * (e * e * e)
    end
end

-- a position or a path function -> a position
local function evalP(p, e)
    if type(p) == "function" then
        return p(e)
    end
    return p
end

-- One-shot sound. Falls back to a pitched teleport whoosh when no id is configured.
local FALLBACK_SPEED = {boom = 0.45, impact = 0.7, thunder = 0.6, rumble = 0.3, charge = 1.5, whoosh = 1}
local WET = {boom = true, thunder = true, rumble = true}

local function playSfx(kind, volume, speed)
    pcall(function()
        local id = CFG.SFX[kind]
        local pitch = speed or 1
        if not id or id == "" then
            id = TELEPORT_SFX_ID
            pitch = pitch * (FALLBACK_SPEED[kind] or 1)
        end
        local s = Instance.new("Sound")
        s.SoundId = id
        s.Volume = volume or 1
        s.PlaybackSpeed = pitch
        if WET[kind] then
            local verb = Instance.new("ReverbSoundEffect")
            verb.DecayTime = 2.6
            verb.Wetness = 0.35
            verb.Parent = s
        end
        s.Parent = SoundService
        s:Play()
        Debris:AddItem(s, 10)
    end)
end

