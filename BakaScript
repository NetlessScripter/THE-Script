    ---------------------------------------------------------------------
    -- 6.6 WORLD FX  (all parented to one folder that is destroyed at the end)
    ---------------------------------------------------------------------
    local groundY = CFG.ARENA_GROUND_Y
    if not groundY then
        local sum = 0
        for _, p in ipairs(TELEPORT_POSITIONS) do
            sum = sum + p.Y
        end
        groundY = sum / #TELEPORT_POSITIONS - 3 -- standing height minus the HipHeight + half a root part
    end
    local CX, CZ = RING_CENTER.X, RING_CENTER.Z

    local ring, dome, strike, strikeRandom, storm, debris, debrisBlast, gather, orb, growOrb, pillar, setMotes, aura
    do
        local fxFolder = Instance.new("Folder")
        fxFolder.Name = "ToP_Cutscene_FX"
        fxFolder.Parent = workspace
        maid:Add(fxFolder)

        local function fxPart(shape, size, cf, color, transparency, neon)
            local p = Instance.new("Part")
            p.Anchored = true
            p.CanCollide = false
            p.CanQuery = false
            p.CanTouch = false
            p.CastShadow = false
            p.Shape = shape or Enum.PartType.Block
            p.Material = (neon == false) and Enum.Material.SmoothPlastic or Enum.Material.Neon
            p.Color = color or COL.gold
            p.Transparency = transparency or 0
            p.Size = size
            p.CFrame = cf
            p.Parent = fxFolder
            return p
        end

        -- Ki shockwave ring v2. A layered, ragged-crested shockwave instead of one flat wall of blocks:
        --   core   thin white-hot leading edge that cools to `color`
        --   glow   fatter, wobbling, translucent band trailing behind the edge
        --   disc   (opts.disc)  flat flash on the ground inside the ring that dies fast
        --   dust   (opts.dust)  smoke puffs + sparks thrown off the front
        --   echo   (opts.echo)  a second, fainter wave chasing the first
        -- The radius blasts out fast and decelerates (expoOut) while the band thins and fades.
        function ring(cx, cz, y, r0, r1, dur, color, opts)
            opts = opts or {}
            color = color or COL.goldHot
            local n = math.clamp(math.floor((opts.segments or 48) * 1.5), 24, 108)
            local thickK, heightK = opts.thick or 0.04, opts.height or 0.05

            if not opts.silent then
                playShockwaveSfx()
            end

            local core, glow = {}, {}
            for i = 1, n do
                core[i] = fxPart(Enum.PartType.Block, Vector3.new(1, 1, 1), CFrame.new(cx, y, cz), COL.white, 1)
                glow[i] = fxPart(Enum.PartType.Block, Vector3.new(1, 1, 1), CFrame.new(cx, y, cz), color, 1)
            end

            local disc
            if opts.disc then
                disc = fxPart(Enum.PartType.Cylinder, Vector3.new(0.2, 1, 1), CFrame.new(cx, y + 0.15, cz) * CFrame.Angles(0, 0, math.pi / 2), color:Lerp(COL.white, 0.5), 1)
            end

            -- emitters ride on a handful of the core segments; they outlive the ring so the puffs drift away
            local hosts, puffs, sparks = {}, {}, {}
            if opts.dust then
                local puffSize = math.clamp(r1 * 0.025, 4, 30)
                local sparkSize = math.clamp(r1 * 0.004, 1, 5)
                local every = math.max(1, n // 24)
                for i = 1, n, every do
                    local host = core[i]
                    hosts[host] = true

                    local puff = Instance.new("ParticleEmitter")
                    puff.Texture = "rbxasset://textures/particles/smoke_main.dds"
                    puff.Rate = 0
                    puff.Lifetime = NumberRange.new(0.8, 1.5)
                    puff.Speed = NumberRange.new(4, 14)
                    puff.Drag = 2
                    puff.SpreadAngle = Vector2.new(30, 30)
                    puff.EmissionDirection = Enum.NormalId.Right -- the segment's local +X points away from the ring centre
                    puff.Rotation = NumberRange.new(0, 360)
                    puff.RotSpeed = NumberRange.new(-50, 50)
                    puff.LightEmission = 0.55
                    puff.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, color:Lerp(COL.white, 0.55)),
                        ColorSequenceKeypoint.new(1, color:Lerp(COL.ember, 0.35)),
                    })
                    puff.Size = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, puffSize * 0.6),
                        NumberSequenceKeypoint.new(1, puffSize * 1.9),
                    })
                    puff.Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 0.5),
                        NumberSequenceKeypoint.new(0.3, 0.68),
                        NumberSequenceKeypoint.new(1, 1),
                    })
                    puff.Parent = host
                    puffs[#puffs + 1] = puff

                    if (i // every) % 2 == 0 then
                        local spark = Instance.new("ParticleEmitter")
                        spark.Texture = "rbxasset://textures/particles/sparkles_main.dds"
                        spark.Rate = 0
                        spark.Lifetime = NumberRange.new(0.6, 1.1)
                        spark.Speed = NumberRange.new(30, 90)
                        spark.SpreadAngle = Vector2.new(45, 45)
                        spark.EmissionDirection = Enum.NormalId.Top
                        spark.Acceleration = Vector3.new(0, -70, 0)
                        spark.LightEmission = 1
                        spark.Color = ColorSequence.new(COL.white, color)
                        spark.Size = NumberSequence.new({
                            NumberSequenceKeypoint.new(0, sparkSize),
                            NumberSequenceKeypoint.new(1, 0),
                        })
                        spark.Transparency = NumberSequence.new({
                            NumberSequenceKeypoint.new(0, 0),
                            NumberSequenceKeypoint.new(1, 1),
                        })
                        spark.Parent = host
                        sparks[#sparks + 1] = spark
                    end
                end
            end

            if opts.echo then
                task.delay(dur * 0.09, function()
                    ring(cx, cz, y, r0 * 0.9, r1 * 0.9, dur * 1.15, COL.cream, {
                        thick = thickK * 0.6, height = heightK * 0.55, segments = opts.segments,
                        t0 = 0.4, ease = opts.ease, silent = true, -- the echo wave doesn't re-trigger the sounds
                    })
                end)
            end

            local frame = 0
            anim(dur, function(e, k)
                frame = frame + 1
                local r = lerp(r0, r1, e)
                local age = k ^ 1.25 -- fade follows real time, so the ring stays visible while it is still travelling
                local thick = (r * thickK + 1.5) * (1.15 - 0.6 * age)
                local height = (r * heightK + 2) * (1.2 - 0.8 * age)
                local chord = 2 * r * math.sin(math.pi / n) * 1.1 + 0.5
                local coreCol = COL.white:Lerp(color, math.min(1, k * 1.8))
                local coreT = lerp(opts.t0 or 0.04, 1, age)
                local glowT = lerp(0.42, 1, k ^ 1.05)

                for i = 1, n do
                    local ang = (i - 1) / n * math.pi * 2
                    local cs, sn = math.cos(ang), math.sin(ang)
                    local rot = CFrame.Angles(0, -ang, 0)

                    local c = core[i]
                    local ch = height * 0.8
                    c.Size = Vector3.new(thick * 0.42, ch, chord)
                    c.CFrame = CFrame.new(cx + cs * r, y + ch / 2, cz + sn * r) * rot
                    c.Color = coreCol
                    c.Transparency = coreT

                    -- ragged crest: each glow segment rises and sinks, and the pattern drifts as the wave travels
                    local g = glow[i]
                    local wob = 1 + 0.24 * math.sin(ang * 9 + k * 11) + 0.12 * math.sin(ang * 23 - k * 17)
                    local gh = height * wob
                    local rg = r - thick * 0.3
                    g.Size = Vector3.new(thick, gh, chord)
                    g.CFrame = CFrame.new(cx + cs * rg, y + gh / 2, cz + sn * rg) * rot
                    g.Transparency = glowT
                end

                if disc then
                    disc.Size = Vector3.new(0.2, r * 2, r * 2)
                    disc.Transparency = lerp(0.86, 1, math.min(1, k ^ 0.45))
                end

                if frame % 2 == 0 and k < 0.92 then
                    for _, p in ipairs(puffs) do p:Emit(1) end
                    for _, s in ipairs(sparks) do s:Emit(1) end
                end
            end, opts.ease or Ease.expoOut, function()
                for i = 1, n do
                    if hosts[core[i]] then
                        core[i].Transparency = 1 -- keeps its emitters alive while the last puffs drift off
                        local host = core[i]
                        task.delay(2, function() host:Destroy() end)
                    else
                        core[i]:Destroy()
                    end
                    glow[i]:Destroy()
                end
                if disc then disc:Destroy() end
            end)
        end

        -- Expanding energy dome (a translucent glowing sphere)
        function dome(cx, cz, y, r0, r1, dur, color, startT)
            local p = fxPart(Enum.PartType.Ball, Vector3.new(1, 1, 1), CFrame.new(cx, y, cz), color or COL.goldHot, 1)
            anim(dur, function(e)
                local d = lerp(r0, r1, e) * 2
                p.Size = Vector3.new(d, d, d)
                p.Transparency = lerp(startT or 0.5, 1, e ^ 1.4)
            end, Ease.quartOut, function()
                p:Destroy()
            end)
        end

        -- Procedural lightning bolt (glow layer + white-hot core), flickers out. Returns its points.
        local function bolt(a, b, thick, life, color)
            local segs = CFG.BOLT_SEGMENTS
            local dir = b - a
            local len = dir.Magnitude
            if len < 1 then return nil end
            local unit = dir / len
            local helper = math.abs(unit.Y) > 0.9 and Vector3.xAxis or Vector3.yAxis
            local s1 = unit:Cross(helper).Unit
            local s2 = unit:Cross(s1).Unit
            local jag = len * 0.055

            local pts = {a}
            for i = 1, segs - 1 do
                local base = a + dir * (i / segs)
                pts[#pts + 1] = base + s1 * rand(-jag, jag) + s2 * rand(-jag, jag)
            end
            pts[#pts + 1] = b

            local cores, glows = {}, {}
            for i = 1, #pts - 1 do
                local p0, p1 = pts[i], pts[i + 1]
                local d = (p1 - p0).Magnitude
                if d > 0.01 then
                    local cf = CFrame.lookAt(p0, p1) * CFrame.new(0, 0, -d / 2)
                    cores[#cores + 1] = fxPart(Enum.PartType.Block, Vector3.new(thick, thick, d), cf, color or COL.white, 0)
                    glows[#glows + 1] = fxPart(Enum.PartType.Block, Vector3.new(thick * 3.4, thick * 3.4, d), cf, COL.gold, 0.6)
                end
            end

            anim(life, function(e)
                local flicker = (math.floor(e * 14) % 2 == 0) and 0 or 0.4
                local trCore = math.clamp(e ^ 2 + flicker * (1 - e), 0, 1)
                local trGlow = math.clamp(0.55 + e * 0.45 + flicker * 0.2, 0, 1)
                for _, p in ipairs(cores) do p.Transparency = trCore end
                for _, p in ipairs(glows) do p.Transparency = trGlow end
            end, Ease.linear, function()
                for _, p in ipairs(cores) do p:Destroy() end
                for _, p in ipairs(glows) do p:Destroy() end
            end)
            return pts
        end

        local lastThunder = 0
        -- A bolt from the sky to the ground (with side branches when `big`), plus a ground flash
        function strike(x, z, big)
            local top = Vector3.new(x + rand(-80, 80), groundY + rand(520, 820), z + rand(-80, 80))
            local bottom = Vector3.new(x, groundY + 1, z)
            local th = big and 6.5 or 3.4
            local pts = bolt(top, bottom, th, big and 0.6 or 0.34, COL.white)
            if pts then
                for _ = 1, big and 3 or 1 do
                    local from = pts[rng:NextInteger(3, #pts - 2)]
                    local to = from + Vector3.new(rand(-1, 1), rand(-0.7, -0.1), rand(-1, 1)).Unit * rand(120, 280)
                    bolt(from, to, th * 0.55, 0.28, COL.goldHot)
                end
            end
            expoSpike(big and 1.4 or 0.5, 0.22)
            if os.clock() - lastThunder > 0.35 then
                lastThunder = os.clock()
                playSfx("thunder", big and 1 or 0.55, rand(0.9, 1.15))
            end
        end

        function strikeRandom(big)
            local a = rand(0, math.pi * 2)
            local r = math.sqrt(rng:NextNumber()) * (CFG.ARENA_RADIUS + 120)
            strike(CX + math.cos(a) * r, CZ + math.sin(a) * r, big)
        end

        -- Random strikes across the arena for `duration` seconds
        function storm(duration, perSecond)
            anim(duration, function(_, _, dt)
                if rng:NextNumber() < perSecond * dt then
                    strikeRandom(false)
                end
            end)
        end

        -- Levitating rocks: they start on the ground, fade in as they lift, tumble slowly
        debris = {on = false, mult = 1, heightMult = 1, list = {}}
        for i = 1, CFG.DEBRIS_COUNT do
            local ang = rand(0, math.pi * 2)
            local rad = math.sqrt(rng:NextNumber()) * CFG.ARENA_RADIUS + 40
            local sz = rand(3, 11)
            local part = fxPart(
                Enum.PartType.Block,
                Vector3.new(sz * rand(0.8, 1.4), sz * rand(0.6, 1), sz * rand(0.8, 1.4)),
                CFrame.new(CX + math.cos(ang) * rad, groundY + sz / 2, CZ + math.sin(ang) * rad),
                Color3.fromRGB(rng:NextInteger(70, 110), rng:NextInteger(62, 92), rng:NextInteger(55, 80)),
                1,
                false
            )
            part.Material = Enum.Material.Slate
            debris.list[i] = {
                part = part, x = CX + math.cos(ang) * rad, z = CZ + math.sin(ang) * rad, size = sz,
                h = 0, v = 0, acc = rand(1.5, 4), maxH = rand(40, 140), delay = rand(0, 3), age = 0,
                rot = CFrame.Angles(rand(0, 6.28), rand(0, 6.28), rand(0, 6.28)),
                rx = rand(-0.8, 0.8), ry = rand(-0.8, 0.8), rz = rand(-0.8, 0.8), phase = rand(0, 6.28),
            }
        end

        step(function(dt)
            if not debris.on then return end
            local t = os.clock()
            for _, r in ipairs(debris.list) do
                r.age = r.age + dt
                if r.age >= r.delay then
                    local cap = r.maxH * debris.heightMult
                    r.v = r.v + r.acc * debris.mult * dt
                    r.h = math.min(r.h + r.v * dt, cap)
                    if r.h >= cap then r.v = 0 end
                    r.rot = r.rot * CFrame.Angles(r.rx * dt, r.ry * dt, r.rz * dt)
                    local bob = math.sin(t * 1.3 + r.phase) * 1.2 * math.min(r.h / 20, 1)
                    r.part.Transparency = 1 - math.clamp(r.h / 12, 0, 1)
                    r.part.CFrame = CFrame.new(r.x, groundY + r.size / 2 + r.h + bob, r.z) * r.rot
                end
            end
        end)

        function debrisBlast()
            debris.on = true
            debris.mult = 3.5
