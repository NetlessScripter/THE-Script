    -- Comic title "stamp": outlined gold lettering with a glow layer and an optional rotating sunburst.
    -- opts = { lines = { {text, h, font?, top?, mid?, bottom?, glow?, stroke?} }, pos, size, rot, burst }
    local function buildStamp(opts)
        local heightPx = vp().Y
        local holder = Instance.new("Frame")
        holder.Name = "Stamp"
        holder.BackgroundTransparency = 1
        holder.AnchorPoint = Vector2.new(0.5, 0.5)
        holder.Position = opts.pos or UDim2.fromScale(0.5, 0.4)
        holder.Size = opts.size or UDim2.fromScale(0.8, 0.3)
        holder.Rotation = opts.rot or -3
        holder.Visible = false
        holder.Parent = L.stamps

        local scale = Instance.new("UIScale")
        scale.Parent = holder

        local list = Instance.new("UIListLayout")
        list.FillDirection = Enum.FillDirection.Vertical
        list.HorizontalAlignment = Enum.HorizontalAlignment.Center
        list.VerticalAlignment = Enum.VerticalAlignment.Center
        list.SortOrder = Enum.SortOrder.LayoutOrder
        list.Parent = holder

        local items = {} -- { instance, property, baseTransparency }
        local rowLabels = {} -- rowLabels[i] = {glowLabel, mainLabel}

        for i, ln in ipairs(opts.lines) do
            local row = Instance.new("Frame")
            row.Name = "Row" .. i
            row.BackgroundTransparency = 1
            row.LayoutOrder = i
            row.Size = UDim2.fromScale(1, ln.h)
            row.Parent = holder

            local thick = math.max(3, heightPx * (ln.stroke or 0.010))

            -- glow layer: transparent text whose fat coloured outline is the glow
            local glow = Instance.new("TextLabel")
            glow.BackgroundTransparency = 1
            glow.Size = UDim2.fromScale(1, 1)
            glow.FontFace = EVENT_FONT
            glow.Text = ln.text
            glow.TextScaled = true
            glow.TextColor3 = COL.white
            glow.TextTransparency = 1
            glow.ZIndex = 1
            glow.Parent = row
            local gStroke = Instance.new("UIStroke")
            gStroke.Color = ln.glow or COL.orange
            gStroke.Thickness = thick * 2.4
            gStroke.Transparency = 0.5
            gStroke.LineJoinMode = Enum.LineJoinMode.Round
            gStroke.Parent = glow
            table.insert(items, {gStroke, "Transparency", 0.5})

            -- main layer: vertical gold gradient fill + hard black outline
            local main = Instance.new("TextLabel")
            main.BackgroundTransparency = 1
            main.Size = UDim2.fromScale(1, 1)
            main.FontFace = EVENT_FONT
            main.Text = ln.text
            main.TextScaled = true
            main.TextColor3 = COL.white
            main.ZIndex = 2
            main.Parent = row
            local mStroke = Instance.new("UIStroke")
            mStroke.Color = COL.black
            mStroke.Thickness = thick
            mStroke.LineJoinMode = Enum.LineJoinMode.Round
            mStroke.Parent = main
            local grad = Instance.new("UIGradient")
            grad.Rotation = 90
            grad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, ln.top or COL.cream),
                ColorSequenceKeypoint.new(0.5, ln.mid or COL.goldHot),
                ColorSequenceKeypoint.new(1, ln.bottom or COL.orange),
            })
            grad.Parent = main
            table.insert(items, {main, "TextTransparency", 0})
            table.insert(items, {mStroke, "Transparency", 0})
            rowLabels[i] = {glow, main}
        end

        local burst
        if opts.burst then
            local bh = Instance.new("Frame")
            bh.BackgroundTransparency = 1
            bh.AnchorPoint = Vector2.new(0.5, 0.5)
            bh.Position = opts.pos or UDim2.fromScale(0.5, 0.4)
            bh.Size = UDim2.fromOffset(0, 0)
            bh.Visible = false
            bh.Parent = L.burst
            local bScale = Instance.new("UIScale")
            bScale.Parent = bh
            local radial = makeRadial(bh, 44, opts.burstColor or COL.gold, {
                ColorSequenceKeypoint.new(0, COL.white),
                ColorSequenceKeypoint.new(0.3, COL.goldHot),
                ColorSequenceKeypoint.new(0.65, COL.orange),
                ColorSequenceKeypoint.new(1, COL.ember),
            }, 2.75) -- rays are ~2.75x longer than the original (capped at MAX_RAY_PX), gradient squeezed to match
            radial.jitter(0.02, 2.2, 3, 0.004, 0.016, 0.05, 0.4)
            burst = {holder = bh, radial = radial, scale = bScale}
            step(function(dt)
                if bh.Visible then
                    bh.Rotation = bh.Rotation + dt * 9
                end
            end)
        end

        local stamp = {holder = holder}

        -- Change the text of one row (1 = first line) after the stamp was built
        function stamp.setLine(i, text)
            local pair = rowLabels[i]
            if pair then
                pair[1].Text = text
                pair[2].Text = text
            end
        end

        function stamp.setAlpha(a)
            for _, it in ipairs(items) do
                it[1][it[2]] = 1 - (1 - it[3]) * a
            end
            if burst then burst.radial.setAlpha(a * 0.9) end
        end

        function stamp.slam(fromScale, dur)
            holder.Visible = true
            if burst then burst.holder.Visible = true end
            stamp.setAlpha(1)
            anim(dur or 0.4, function(e)
                scale.Scale = lerp(fromScale or 2.8, 1, e)
                if burst then burst.scale.Scale = lerp(0.2, 1, math.min(e, 1)) end
            end, Ease.backOut)
        end

        function stamp.release(dur)
            anim(dur or 0.7, function(e)
                stamp.setAlpha(1 - e)
                scale.Scale = 1 + 0.16 * e
            end, Ease.quadIn, function()
                holder.Visible = false
                if burst then burst.holder.Visible = false end
            end)
        end

        return stamp
    end

    -- Anime lens glint: a four-point star that blooms and spins at a screen position
