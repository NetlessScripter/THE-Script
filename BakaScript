    local letterSizes = {}
    local function measureLetter(ch)
        local cached = letterSizes[ch]
        if cached then return cached end
        local size
        local ok = pcall(function()
            boundsParams.Text = ch
            size = TextService:GetTextBoundsAsync(boundsParams)
        end)
        if not ok or not size then
            size = Vector2.new(14, 25)
