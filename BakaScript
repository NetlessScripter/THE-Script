    local function setShot(s)
        rig.cf = CFrame.lookAt(evalP(s.pos, 0), evalP(s.look, 0))
        rig.fov = s.fov[1]
        rig.roll = s.roll and s.roll[1] or 0
        rig.handheld = s.handheld or 0.3
        rig.shake = s.shake and s.shake[1] or 0
        rig.active = true
    end

    -- Plays one shot: evaluates the path every frame and fires each cue once when its time comes
    local function runShot(s)
        local cues = {}
        for _, c in ipairs(s.cues or {}) do
            table.insert(cues, c)
        end
        table.sort(cues, function(a, b)
            return a[1] < b[1]
        end)
        local ci, elapsed = 1, 0
        local ease = s.ease or Ease.sine
        while true do
            while cues[ci] and elapsed >= cues[ci][1] do
                local fn = cues[ci][2]
                ci = ci + 1
                spawnSafe(fn)
            end
            local a = math.min(elapsed / s.time, 1)
            local e = ease(a)
            rig.cf = CFrame.lookAt(evalP(s.pos, e), evalP(s.look, e))
            rig.fov = lerp(s.fov[1], s.fov[2], e)
            if s.roll then
                rig.roll = lerp(s.roll[1], s.roll[2], e)
            end
            if s.shake then
                rig.shake = lerp(s.shake[1], s.shake[2], (s.shakeEase or Ease.linear)(a))
            end
            if a >= 1 then break end
            elapsed = elapsed + nextFrame()
        end
    end

    -- WHIP PAN: the camera yaws away faster and faster behind heavy blur (whipOut, fired by a cue
    -- just before the shot ends); the next shot starts yawed the other way and snaps into place.
    function whipOut(dir)
        playSfx("whoosh", 0.8, 1.15)
        anim(0.26, function(e)
            rig.whip = dir * 75 * e
            blur.Size = 22 * e
        end, Ease.expoIn)
    end

    local function whipIn(nextSetup, dir)
        nextSetup()
        rig.whip = -dir * 75
        anim(0.5, function(e)
            rig.whip = -dir * 75 * (1 - e)
            blur.Size = 22 * (1 - e)
        end, Ease.expoOut, function()
            rig.whip = 0
            blur.Size = 0
        end)
    end

    -- MANGA IMPACT CUT: a frozen black/white starburst frame (alternating dark / inverted),
    -- then a white flash that the new angle fades in from
    local flip = false
    local function impactCut(nextSetup)
        flip = not flip
        showImpact(flip)
        kick(9, 0.5)
        playSfx("impact", 0.9)
        hitStop(0.1)
        rwait(0.1)
        impactFrame.Visible = false
        flash.BackgroundColor3 = COL.white
        flash.BackgroundTransparency = 0
        nextSetup()
        wait(0.05)
        tween(flash, 0.55, {BackgroundTransparency = 1})
    end

    ---------------------------------------------------------------------
    -- 6.11 HAND-BACK, FINALE, CLEANUP
    ---------------------------------------------------------------------
    local function handBackCamera()
        if camHandedBack then return end
        camHandedBack = true
        rig.active = false
        cam.CameraType = saved.camType
        if saved.camSubject then
            cam.CameraSubject = saved.camSubject
        end
        -- BURST: start wide and snap back to normal
        cam.FieldOfView = FOV_BURST_START
        TweenService:Create(cam, TweenInfo.new(FOV_BURST_TIME, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            FieldOfView = FOV_BURST_END,
        }):Play()
    end

    -- The ki orb detonates: pillar of light, one shockwave (plus its echo), a dome, rocks blasted skyward, lightning
    local function erupt()
        local from = orb.d
        anim(0.18, function(e)
            orb.d = lerp(from, 0, e)
        end, Ease.quadIn)
        gather.Rate = 0

        pillar.a = 1
        anim(0.5, function(e)
            pillar.h = lerp(0, 1900, e)
            pillar.w = lerp(0.25, 1, e)
        end, Ease.expoOut)
        anim(5.0, function(_, k)
            if k > 0.45 then
                local f = (k - 0.45) / 0.55
                pillar.a = 1 - f
                pillar.w = lerp(1, 0.45, f)
            end
        end)

        ring(CX, CZ, groundY + 1, 10, 1300, 2.2, COL.white, {thick = 0.03, height = 0.05, segments = 72, disc = true, dust = true, echo = true})
        dome(CX, CZ, groundY, 20, 800, 1.3, COL.goldHot, 0.35)
        debrisBlast()
        strike(CX, CZ, true)
        storm(2.4, 5)
        setMotes(150)
    end

    local function beginBeat()
        stamps.begin.slam(3.2, 0.45)
        kick(10, 0.6)
        flashScreen(0.35, 0.4, COL.cream)
        pulseVignette(0.8, 1.2, COL.goldHot)
        playSfx("impact", 1, 0.8)
    end

    local finaleStarted = false
    local function finale()
        finaleStarted = true

        -- white-out, camera goes back to the player (with the FOV burst)
        flash.BackgroundColor3 = COL.white
        flash.BackgroundTransparency = 0
        setSpeedLines(false)
        blur.Size = 0
        rig.shake = 0
        table.clear(kicks)
        playSfx("boom", 1.2, 0.85)
        handBackCamera()

        tween(barTop, 1.0, {Size = UDim2.fromScale(1, 0)})
        tween(barBottom, 1.0, {Size = UDim2.fromScale(1, 0)})
        tween(cc, 1.4, NEUTRAL)
        tween(bloom, 1.4, {Intensity = 0.7, Size = 28, Threshold = 0.9})
        tween(rays, 1.4, {Intensity = 0.05})
        tween(dof, 0.5, {FarIntensity = 0})
        setExpo(0, 1.4)
        setMood("blast", 0.5)

        erupt()
        anim(1.8, function(e)
            rig.shake = 5 * (1 - e)
        end, Ease.quadOut, function()
            rig.shake = 0
        end)

        wait(0.25)
        tween(flash, 1.2, {BackgroundTransparency = 1})
        wait(0.2)
        beginBeat()
        wait(1.9)
        stamps.begin.release(0.7)
        aura.fadeOut(1.2)
        setMood("calm", 2.2)
        wait(0.9)
    end

    local music
    local function destroyWorld()
        if worldDead then return end
        worldDead = true
        pcall(function()
            RunService:UnbindFromRenderStep("ToPCutscene")
        end)
        pcall(function()
            Lighting.ExposureCompensation = saved.exposure
        end)
        pcall(function()
            if not atmoCreated then
                atmo.Color = atmoSaved.Color
                atmo.Decay = atmoSaved.Decay
                atmo.Density = atmoSaved.Density
                atmo.Haze = atmoSaved.Haze
                atmo.Glare = atmoSaved.Glare
            end
        end)
        maid:Clean()
        pcall(function() gui:Destroy() end)
        cutsceneRunning = false
    end

    local function cleanup()
        if cleaned then return end
        cleaned = true

        handBackCamera()
        setSpeedLines(false)
        pcall(function() impactFrame.Visible = false end)

        -- If the cutscene got cut short (error / failsafe) the finale never ran: put the scene back
        -- to normal behind a white flash so it still ends cleanly
        if not finaleStarted then
            pcall(function()
                barTop.Size = UDim2.fromScale(1, 0)
                barBottom.Size = UDim2.fromScale(1, 0)
                fade.BackgroundTransparency = 1
                blur.Size = 0
                stamps.title.holder.Visible = false
                stamps.n8.holder.Visible = false
                stamps.n80.holder.Visible = false
                stamps.n1.holder.Visible = false
                tween(cc, 0.6, NEUTRAL)
                tween(bloom, 0.6, {Intensity = 0.3, Size = 24, Threshold = 1})
                tween(rays, 0.6, {Intensity = 0.05})
                tween(dof, 0.3, {FarIntensity = 0})
                setMood("calm", 1.5)
                flashScreen(1, 1.2)
            end)
        end

        -- the glow and aura ease out while the world FX play their tail
        pcall(function()
            aura.fadeOut(1.0)
            tween(bloom, CFG.FX_TAIL, {Intensity = 0})
            setMood("calm", 1.5)
            setExpo(0, 1.0)
        end)

        -- Player side: everything is put back
        pcall(clearDialogue)
        for t, enabled in pairs(saved.coreGui) do
            pcall(StarterGui.SetCoreGuiEnabled, StarterGui, t, enabled)
        end
        if chatWindow and saved.chatWindowOn then chatWindow.Enabled = true end
        if chatBar and saved.chatBarOn then chatBar.Enabled = true end
        for g in pairs(saved.playerGuis) do
            pcall(function() g.Enabled = true end)
        end
        if controls then
            pcall(function() controls:Enable() end)
        end
        if hrp then
            pcall(function() hrp.Anchored = hrpWasAnchored end)
        end
        -- If the face shot never ran (or errored), make sure the player isn't left invisible
        showCharacterNow()
        if music then
            pcall(function()
                TweenService:Create(music, TweenInfo.new(1.5), {Volume = 0}):Play()
                task.delay(1.6, function() music:Destroy() end)
            end)
        end

        -- World FX keep playing for a moment (pillar fading, rings finishing), then everything goes
        task.delay(CFG.FX_TAIL, destroyWorld)
    end

    -- Failsafe: if anything ever hangs, force the cutscene to end instead of locking the player in
    local function abort()
        if aborted then return end
        aborted = true
        for i = #waiters, 1, -1 do
            local w = waiters[i]
            table.remove(waiters, i)
            task.spawn(w.co)
        end
    end
    task.delay(CFG.FAILSAFE_SECONDS, function()
        if not cleaned then
            warn("[Event] Cutscene failsafe triggered")
            abort()
            cleanup()
        end
    end)

    ---------------------------------------------------------------------
    -- 6.12 THE SEQUENCE
    ---------------------------------------------------------------------
    local function sequence()
        if CUTSCENE_MUSIC_ID ~= "" then
            music = Instance.new("Sound")
            music.SoundId = CUTSCENE_MUSIC_ID
            music.Volume = 1
            music.Parent = SoundService
            music:Play()
        end

        -- PRE-ROLL: real game fades to black, bars close in, a lens glint, then the world is revealed
        tween(fade, 0.55, {BackgroundTransparency = 0}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        playSfx("rumble", 0.9)
        wait(0.6)

        setShot(S1)
        rig.shake = 0.3
        tween(barTop, 1.2, {Size = UDim2.fromScale(1, CFG.BAR_HEIGHT)})
        tween(barBottom, 1.2, {Size = UDim2.fromScale(1, CFG.BAR_HEIGHT)})
        tween(cc, 1.5, GRADE)
        tween(bloom, 1.5, {Intensity = 0.9, Size = 28, Threshold = 0.85})
        tween(rays, 1.5, {Intensity = 0.14})
        wait(0.55)
        glint(vp().X / 2, vp().Y / 2, vp().Y * 0.45, 0.7)
        playSfx("whoosh", 0.5, 1.6)
        wait(0.45)

        -- SHOT 1: arcing crane push-in + title slam
        tween(fade, 1.5, {BackgroundTransparency = 1})
        runShot(S1)

        -- SHOT 2: low truck, the numbers
        whipIn(function() setShot(S2) end, 1)
        runShot(S2)

        -- SHOT 3A: high angle, the storm builds
        impactCut(function() setShot(S3A) end)
        runShot(S3A)

        -- FACE SHOT: the arrival close-up (skipped if the character can't be found)
        local face = buildFaceShot()
        if face then
            impactCut(function() setShot(face) end)
            runShot(face)
        end

        -- RUSH: accelerating dive at the ring
        impactCut(function() setShot(RUSH) end)
        runShot(RUSH)

        -- FINALE
        finale()
    end

    local ok, err = pcall(sequence)
    cleanup()
    if not ok and not aborted then
        warn("[Event] Cutscene error: " .. tostring(err))
    end
end

