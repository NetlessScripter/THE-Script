-- Used when the game's own teleport particles can't be found, so the arrival never goes silent
local function fallbackBurst(root)
    local e = Instance.new("ParticleEmitter")
    e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    e.Rate = 0
    e.Lifetime = NumberRange.new(0.4, 0.9)
    e.Speed = NumberRange.new(14, 34)
    e.SpreadAngle = Vector2.new(180, 180)
    e.LightEmission = 1
    e.Color = ColorSequence.new(COL.white, COL.gold)
    e.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 2.5),
        NumberSequenceKeypoint.new(1, 0),
    })
    e.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(1, 1),
    })
    e.Parent = root
    e:Emit(36)
    Debris:AddItem(e, 2)
end

-- Particle puffs from ReplicatedStorage.Resources.NinjaUlt.Start_Effects.Particles, emitted on the root part
local function emitTeleportVFX(root)
    local ok, particles = pcall(function()
        return ReplicatedStorage.Resources.NinjaUlt.Start_Effects.Particles
    end)
    if not ok or not particles then
        fallbackBurst(root)
        return
    end
    for _, name in ipairs({"Low", "Center_Tilted", "Ground"}) do
        local template = particles:FindFirstChild(name)
        if template then
            local fx = template:Clone()
            fx.Parent = root
            for _, v in ipairs(fx:GetChildren()) do
                if v:IsA("ParticleEmitter") then
                    v:Emit(15)
                    v.Enabled = false
                end
            end
            Debris:AddItem(fx, 4)
        end
    end
end

local function playTeleportSound(root)
    local sfx = Instance.new("Sound")
    sfx.SoundId = TELEPORT_SFX_ID
    sfx.Volume = 1
    sfx.Parent = root
    sfx:Play()
    sfx.Ended:Connect(function()
        sfx:Destroy()
    end)
    Debris:AddItem(sfx, 10)
end

-- Remembers each part's real transparency while the character is hidden (nil = not hidden)
local hiddenOriginals = nil

-- Makes the character fully invisible and keeps it that way until blinkCharacter / showCharacterNow
local function hideCharacter(char)
    if hiddenOriginals then return end
    hiddenOriginals = {}
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("Texture") then
            if obj.Transparency < 1 then
                hiddenOriginals[obj] = obj.Transparency
                obj.Transparency = 1
            end
        end
    end
end

-- Instantly brings the character back (safety net for cleanup / errors)
local function showCharacterNow()
    if not hiddenOriginals then return end
    local original = hiddenOriginals
    hiddenOriginals = nil
    for obj, trans in pairs(original) do
        if obj.Parent then
            obj.Transparency = trans
        end
    end
end

-- The quick hide / show / hide / show flicker of the character.
-- Ends VISIBLE by default; with endHidden = true it ends INVISIBLE and stays that way until the
-- next blinkCharacter call (without endHidden) or showCharacterNow reveals it.
local function blinkCharacter(char, endHidden)
    local original = hiddenOriginals
    hiddenOriginals = nil
    if not original then
        original = {}
        for _, obj in ipairs(char:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("Texture") then
                original[obj] = obj.Transparency
            end
        end
    end
    local function setHidden(hide)
        for obj, trans in pairs(original) do
            if trans < 1 and obj.Parent then
                obj.Transparency = hide and 1 or trans
            end
        end
    end
    pcall(function()
        setHidden(true) task.wait(0.01)
        setHidden(false) task.wait(0.01)
        setHidden(true) task.wait(0.01)
    end)
    if endHidden then
        setHidden(true)
        hiddenOriginals = original -- remembered so the reveal can restore the real transparencies
    else
        setHidden(false) -- end up visible again
    end
end

-- Every client sorts the players the same way (by UserId) and takes the spot matching its own
-- place in that list, so no two players get the same spot. Once every spot is taken, the next
-- players reuse the spots but are placed EXTRA_SPOT_DISTANCE studs away from them, each lap
-- in a different direction, so they still don't stack on top of anyone.
local function pickSpotFor(plr)
    local list = Players:GetPlayers()
    table.sort(list, function(a, b)
        return a.UserId < b.UserId
    end)
    local index = table.find(list, plr) or 1
    local count = #TELEPORT_POSITIONS
    local base = TELEPORT_POSITIONS[(index - 1) % count + 1]
    local lap = (index - 1) // count
    if lap == 0 then
        return base
    end
    local angle = math.rad(lap * 137.5)
    return base + Vector3.new(math.cos(angle), 0, math.sin(angle)) * EXTRA_SPOT_DISTANCE
end

-- Moves the local character to its own spot from TELEPORT_POSITIONS, facing the ring
local function teleportToRandomSpot()
    local plr = Players.LocalPlayer
    local char = plr.Character or plr.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart", 5)
    if not root then return end

    local pos = pickSpotFor(plr)

    -- Make sure the destination is streamed in before we arrive
    if workspace.StreamingEnabled then
        pcall(function()
            plr:RequestStreamAroundAsync(pos, 5)
        end)
    end

    -- Teleport visuals + sound where we leave from
    emitTeleportVFX(root)
    playTeleportSound(root)

    -- Anchor right away so nothing can move the player until the cutscene is over
    -- (the cutscene's cleanup puts the original anchored state back)
    hrpAnchoredBeforeEvent = root.Anchored
    root.Anchored = true
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    char:PivotTo(CFrame.lookAt(pos, Vector3.new(RING_CENTER.X, pos.Y, RING_CENTER.Z)))

    -- ...and again where we arrive, plus the quick flicker like normal, but the flicker ends
    -- INVISIBLE: the player stays hidden until the face close-up shot, where playArrivalFx
    -- replays the teleport visuals and reveals them
    emitTeleportVFX(root)
    blinkCharacter(char, true)
end

local Event = {}

function Event:Start()
    local thread = coroutine.running()
    local conns = {}
    local finished = false

    local function finish()
        if finished then return end
        finished = true
        for _, c in ipairs(conns) do
            c:Disconnect()
        end
        task.spawn(thread)
    end

    local function check(userId, message)
        if userId ~= TARGET_USERID then return end
        if message:match("^%s*(.-)%s*$") == TARGET_PHRASE then
            finish()
        end
    end

    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        -- New chat
        table.insert(conns, TextChatService.MessageReceived:Connect(function(msg)
            if msg.TextSource then
                check(msg.TextSource.UserId, msg.Text)
            end
        end))
    else
        -- Legacy chat
        local function hook(p)
            if p.UserId == TARGET_USERID then
                table.insert(conns, p.Chatted:Connect(function(msg)
                    check(p.UserId, msg)
                end))
            end
        end
        for _, p in ipairs(Players:GetPlayers()) do
            hook(p)
        end
        table.insert(conns, Players.PlayerAdded:Connect(hook))
    end

    coroutine.yield()

    -- He said the line: the event begins, so teleport the player first
    teleportToRandomSpot()

    -- Model is already in workspace, roll the cutscene
    self:Cutscene()
end

---------------------------------------------------------------------
-- 6. CUTSCENE  (can't be skipped)
--
--   Pre-roll   black, bars in, lens glint
--   Shot 1     "World of Void"  - arcing crane push-in, TITLE SLAM, lightning wakes up
--   (whip pan)
--   Shot 2     low truck        - 8 / 80 / 1 number slams, ki gathers
--   (impact frame)
--   Shot 3A    high orbit       - storm, rocks lift, the ki orb swells
--   (impact frame)
--   Face shot  arrival close-up - teleport flash, aura ignites, eye glint
--   (impact frame)
--   Rush       accelerating dive at the ring - speed lines, blur, shake
--   Finale     white-out, camera handed back, orb detonates, BEGIN!
---------------------------------------------------------------------
local cutsceneRunning = false

function Event:Cutscene()
    if cutsceneRunning then return end
    cutsceneRunning = true

    local plr = Players.LocalPlayer
    local cam = workspace.CurrentCamera
    local maid = Maid.new() -- world side: fx folder, post fx, emitters
    local aborted, cleaned, worldDead, camHandedBack = false, false, false, false

    ---------------------------------------------------------------------
    -- 6.1 Saved state (everything is put back when the cutscene ends)
    ---------------------------------------------------------------------
    local saved = {
        camType = cam.CameraType,
        camSubject = cam.CameraSubject,
        fov = cam.FieldOfView,
        exposure = Lighting.ExposureCompensation,
        coreGui = {},
        playerGuis = {},
    }
    if saved.camType == Enum.CameraType.Scriptable then
        saved.camType = Enum.CameraType.Custom
    end

    ---------------------------------------------------------------------
    -- 6.2 Overlay gui, hide the HUD / chat / the game's own guis, freeze the player
    ---------------------------------------------------------------------
    local gui = Instance.new("ScreenGui")
    gui.Name = "TournamentOfPowerCutscene"
    gui.IgnoreGuiInset = true
    gui.ScreenInsets = Enum.ScreenInsets.None -- also ignore the device safe area so bars reach the real screen edges
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 1000
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    do
        local okParent = pcall(function()
            gui.Parent = (gethui and gethui()) or game:GetService("CoreGui")
        end)
        if not okParent or not gui.Parent then
            gui.Parent = plr:WaitForChild("PlayerGui")
        end
    end

    for _, t in ipairs(Enum.CoreGuiType:GetEnumItems()) do
        if t ~= Enum.CoreGuiType.All then
            local okGet, on = pcall(StarterGui.GetCoreGuiEnabled, StarterGui, t)
            if okGet then saved.coreGui[t] = on end
            pcall(StarterGui.SetCoreGuiEnabled, StarterGui, t, false)
        end
    end

    local chatWindow = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration")
    local chatBar = TextChatService:FindFirstChildOfClass("ChatInputBarConfiguration")
    saved.chatWindowOn = chatWindow ~= nil and chatWindow.Enabled
    saved.chatBarOn = chatBar ~= nil and chatBar.Enabled
    if chatWindow then chatWindow.Enabled = false end
    if chatBar then chatBar.Enabled = false end

    for _, g in ipairs(plr:WaitForChild("PlayerGui"):GetChildren()) do
        if g:IsA("ScreenGui") and g ~= gui and g.Enabled then
            saved.playerGuis[g] = true
            g.Enabled = false
        end
    end

    local controls
    pcall(function()
        controls = require(plr.PlayerScripts:WaitForChild("PlayerModule", 2)):GetControls()
        controls:Disable()
    end)
    local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    local hrpWasAnchored = hrp and hrp.Anchored
    if hrp and hrpAnchoredBeforeEvent ~= nil then
        hrpWasAnchored = hrpAnchoredBeforeEvent
    end
    hrpAnchoredBeforeEvent = nil
    if hrp then hrp.Anchored = true end

    ---------------------------------------------------------------------
    -- 6.3 THE CLOCK. One render step drives everything:
    --     steppers -> animations -> kicks -> waiting threads -> camera write.
    --     Because it is one clock, hit-stop freezes the *whole* scene at once.
    ---------------------------------------------------------------------
    local clock = {t = 0, scale = 1, holdUntil = 0}
    local anims, steppers, waiters, kicks = {}, {}, {}, {}
    local rig = {
        cf = cam.CFrame, fov = cam.FieldOfView,
        roll = 0, shake = 0, kick = 0, whip = 0, fovKick = 0, handheld = 0,
        active = false, -- true while the script owns the camera
    }

    -- Non-blocking animation. fn(easedValue, rawAlpha, dt) is called every frame for `duration` seconds.
    local function anim(duration, fn, easeFn, onDone)
        local a = {t = 0, d = math.max(duration, 0.001), fn = fn, ease = easeFn or Ease.linear, done = onDone}
        table.insert(anims, a)
        return a
    end

    -- Persistent per-frame callback fn(dt, clockTime). Returns a handle (set .dead = true to stop).
    local function step(fn)
        local h = {fn = fn}
        table.insert(steppers, h)
        return h
    end

    -- Blocking wait on the cutscene clock (so it respects hit-stop / slow-mo)
    local function wait(d)
        if aborted then error("cutscene aborted", 0) end
        if d and d > 0 then
            table.insert(waiters, {left = d, co = coroutine.running()})
            coroutine.yield()
            if aborted then error("cutscene aborted", 0) end
        end
    end

    -- Blocks until the next clock frame, returns that frame's scaled dt
    local function nextFrame()
        if aborted then error("cutscene aborted", 0) end
        table.insert(waiters, {left = 0, co = coroutine.running()})
        local dt = coroutine.yield()
        if aborted then error("cutscene aborted", 0) end
        return dt or 0
    end

    -- Real-time wait (used while the clock is frozen on an impact frame)
    local function rwait(d)
        task.wait(d)
        if aborted then error("cutscene aborted", 0) end
    end

    local function spawnSafe(fn)
        task.spawn(function()
            local ok, err = pcall(fn)
            if not ok and not aborted then
                warn("[Event] cue failed: " .. tostring(err))
            end
        end)
    end

    local function hitStop(d)
        clock.holdUntil = os.clock() + d
    end

    local function kick(strength, duration)
        table.insert(kicks, {s = strength, d = duration, t = 0})
    end

    local function fovPunch(amount, duration)
        anim(duration, function(e)
            rig.fovKick = amount * (1 - e) ^ 2
        end, Ease.linear, function()
            rig.fovKick = 0
        end)
    end

    local function tween(inst, time, props, style, dir)
        local tw = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
        tw:Play()
        return tw
    end

    do
        local function runFrame(rdt)
            local dt = 0
            if os.clock() >= clock.holdUntil then
                dt = math.min(rdt, 0.1) * clock.scale
            end
            clock.t = clock.t + dt

            for i = #steppers, 1, -1 do
                local h = steppers[i]
                if h.dead then
                    table.remove(steppers, i)
                else
                    local ok, err = pcall(h.fn, dt, clock.t)
                    if not ok then
                        h.dead = true
                        warn("[Event] stepper failed: " .. tostring(err))
                    end
                end
            end

            for i = #anims, 1, -1 do
                local a = anims[i]
                a.t = a.t + dt
                local k = math.min(a.t / a.d, 1)
                local ok, err = pcall(a.fn, a.ease(k), k, dt)
                if not ok then
                    warn("[Event] anim failed: " .. tostring(err))
                    a.t = a.d
                    k = 1
                end
                if k >= 1 then
                    table.remove(anims, i)
                    if a.done then pcall(a.done) end
                end
            end

            local ks = 0
            for i = #kicks, 1, -1 do
                local k = kicks[i]
                k.t = k.t + dt
                if k.t >= k.d then
                    table.remove(kicks, i)
                else
                    ks = ks + k.s * (1 - k.t / k.d) ^ 2
                end
            end
            rig.kick = ks

            for i = #waiters, 1, -1 do
                local w = waiters[i]
                w.left = w.left - dt
                if w.left <= 0 then
                    table.remove(waiters, i)
                    task.spawn(w.co, dt)
                end
            end
        end

        -- The only place the camera is written. Layers: path -> roll -> whip -> handheld sway -> shake
        local function writeCamera()
            local tr = os.clock()
            local s = (rig.shake + rig.kick) * 0.01
            local jitter = CFrame.new()
            if s > 0 then
                jitter = CFrame.new(math.noise(tr * 37, 1.3, 0.5) * s * 6, math.noise(tr * 41, 5.1, 0.5) * s * 6, 0)
                    * CFrame.Angles(
                        math.noise(tr * 31, 0.21, 0.5) * s,
                        math.noise(tr * 29, 4.37, 0.5) * s,
                        math.noise(tr * 23, 9.13, 0.5) * s * 0.6
                    )
            end
            if rig.active then
                local h = rig.handheld * 0.0035
                local sway = CFrame.Angles(
                    math.noise(tr * 0.6, 2.2, 0.1) * h,
                    math.noise(tr * 0.5, 7.7, 0.3) * h,
                    math.noise(tr * 0.4, 3.3, 0.9) * h * 0.7
                )
                cam.CameraType = Enum.CameraType.Scriptable
                cam.CFrame = rig.cf * CFrame.Angles(0, 0, math.rad(rig.roll)) * CFrame.Angles(0, math.rad(rig.whip), 0) * sway * jitter
                cam.FieldOfView = math.clamp(rig.fov + rig.fovKick, 1, 120)
            elseif s > 0 then
                -- camera already handed back: a little rumble on top of the player's own camera
                cam.CFrame = cam.CFrame * jitter
            end
        end

        RunService:BindToRenderStep("ToPCutscene", Enum.RenderPriority.Camera.Value + 1, function(rdt)
            if worldDead then return end
            runFrame(rdt)
            writeCamera()
        end)
    end

    ---------------------------------------------------------------------
    -- 6.4 SCREEN SPACE: layers, letterbox, speed lines, impact frames, stamps, vignette, glint
    ---------------------------------------------------------------------
    local function vp()
        return cam.ViewportSize
    end

    local L, barTop, barBottom, fade, flash
    do
        local function layer(name, z)
            local f = Instance.new("Frame")
            f.Name = name
            f.BackgroundTransparency = 1
            f.BorderSizePixel = 0
            f.Size = UDim2.fromScale(1, 1)
            f.ZIndex = z
            f.Parent = gui
            return f
        end

        L = {
            vignette = layer("Vignette", 5),
            lines = layer("SpeedLines", 10),
            burst = layer("Sunburst", 15),
            stamps = layer("Stamps", 20),
            glints = layer("Glints", 25),
        }

        local function solid(color, z)
            local f = Instance.new("Frame")
            f.BackgroundColor3 = color
            f.BorderSizePixel = 0
            f.ZIndex = z
            f.Size = UDim2.fromScale(1, 1)
            f.Parent = gui
            return f
        end

        -- letterbox bars
        barTop = solid(COL.black, 40)
        barTop.AnchorPoint = Vector2.new(0, 0)
        barTop.Position = UDim2.fromScale(0, 0)
        barTop.Size = UDim2.fromScale(1, 0)

        barBottom = solid(COL.black, 40)
        barBottom.AnchorPoint = Vector2.new(0, 1)
        barBottom.Position = UDim2.fromScale(0, 1)
        barBottom.Size = UDim2.fromScale(1, 0)

        fade = solid(COL.black, 50)
        fade.BackgroundTransparency = 1

        flash = solid(COL.white, 60)
        flash.BackgroundTransparency = 1
    end

    local function flashScreen(alpha, dur, color)
        flash.BackgroundColor3 = color or COL.white
        flash.BackgroundTransparency = 1 - alpha
        tween(flash, dur, {BackgroundTransparency = 1})
    end

    -- Radial line field (speed lines / manga starburst). Lines are sized as a fraction of the
    -- screen diagonal so they look the same on a phone and on a 4K monitor.
    -- Rays are never drawn longer than this many pixels. Giant GUI frames (tens of thousands of px) get
    -- dropped by the renderer, which made a chunk of the 10x-long rays vanish. ~5000px still reaches the
    -- far corner of even a 4K screen from the title's position.
    local MAX_RAY_PX = 5000

    local function makeRadial(parent, count, color, gradient, stretch)
        stretch = stretch or 1 -- >1 = rays are that many times longer; squeezes the gradients so the look stays the same
        local holder = Instance.new("Frame")
        holder.Name = "Radial"
        holder.BackgroundTransparency = 1
        holder.Size = UDim2.fromScale(1, 1)
        holder.Parent = parent

        local streaks, bases = {}, {}
        for i = 1, count do
            local pivot = Instance.new("Frame")
            pivot.BackgroundTransparency = 1
            pivot.AnchorPoint = Vector2.new(0.5, 0.5)
            pivot.Position = UDim2.fromScale(0.5, 0.5)
            pivot.Size = UDim2.fromOffset(0, 0)
            pivot.Rotation = (i - 1) / count * 360 + rand(-2, 2)
            pivot.Parent = holder

            local streak = Instance.new("Frame")
            streak.BorderSizePixel = 0
            streak.BackgroundColor3 = gradient and COL.white or color -- the gradient supplies the colour
            streak.AnchorPoint = Vector2.new(0, 0.5)
            streak.Parent = pivot

            -- fades in from the inner end so the centre stays clean and each line tapers
            local g = Instance.new("UIGradient")
            g.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(0.35 / stretch, 0.1),
                NumberSequenceKeypoint.new(1, 0),
            })
            if gradient then
                if stretch ~= 1 then
                    local squeezed = {}
                    for _, k in ipairs(gradient) do
                        table.insert(squeezed, ColorSequenceKeypoint.new(k.Time / stretch, k.Value))
                    end
                    table.insert(squeezed, ColorSequenceKeypoint.new(1, gradient[#gradient].Value))
                    g.Color = ColorSequence.new(squeezed)
                else
                    g.Color = ColorSequence.new(gradient) -- runs inner end -> outer end of the ray
                end
            end
            g.Parent = streak
            streaks[i] = streak
        end

        local radial = {holder = holder, streaks = streaks}

        function radial.jitter(inner, lenMin, lenMax, thickMin, thickMax, tMin, tMax)
            local d = vp().Magnitude
            for i, s in ipairs(streaks) do
                s.Position = UDim2.fromOffset(rand(inner * 0.85, inner * 1.15) * d, 0)
                s.Size = UDim2.fromOffset(math.min(rand(lenMin, lenMax) * d, MAX_RAY_PX), math.max(1, rand(thickMin, thickMax) * d))
                bases[i] = rand(tMin, tMax)
                s.BackgroundTransparency = bases[i]
            end
        end

        function radial.setAlpha(a)
            for i, s in ipairs(streaks) do
                s.BackgroundTransparency = 1 - (1 - bases[i]) * a
            end
        end

        radial.jitter(0.2, 0.3, 0.6, 0.002, 0.005, 0.3, 0.7)
        return radial
    end

    -- Anime speed lines: re-randomised ~14 times a second (the "on twos/threes" flicker)
    local lineState, setSpeedLines
    do
        local speedLines = makeRadial(L.lines, CFG.SPEED_LINES, COL.white, {
            ColorSequenceKeypoint.new(0, COL.white),
            ColorSequenceKeypoint.new(0.5, COL.cream),
            ColorSequenceKeypoint.new(1, COL.goldHot),
        }, 6) -- lines are ~6x longer than the original (capped at MAX_RAY_PX), gradient squeezed to match
        speedLines.holder.Visible = false
        lineState = {on = false, acc = 0, power = 1}

        step(function(dt)
            if not lineState.on then return end
            lineState.acc = lineState.acc + dt
            if lineState.acc < 0.07 then return end
            lineState.acc = 0
            local p = lineState.power
            speedLines.jitter(lerp(0.30, 0.12, p), 2.2, 3, 0.0015, 0.006 + 0.004 * p, 0.25, 0.8 - 0.35 * p)
        end)

        function setSpeedLines(on, power)
