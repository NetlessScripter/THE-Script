    local function say(text, shake, delay, style)
        if aborted then return end
        speakLine(text, shake, delay, style)
    end

    -- The signature Dragon Ball hit: camera punch + zoom-in + light flash + gold edge glow + a frozen beat
    local function impactBeat(strength)
        kick(strength, 0.55)
        fovPunch(-strength * 0.9, 0.35)
        expoSpike(0.45, 0.25)
        pulseVignette(0.9, 0.7)
        flashScreen(0.28, 0.25, COL.cream)
        hitStop(0.05)
    end

    local function arenaRing(r1, dur, color)
        ring(CX, CZ, groundY + 1, 20, r1, dur, color, {thick = 0.03, height = 0.035, segments = 64, disc = r1 >= 600, dust = r1 >= 600, echo = r1 >= 600})
    end

    -- One number slam: 8 / 80 / 1
    local function numBeat(stamp, strength, final)
        stamp.slam(2.6, 0.38)
        impactBeat(strength)
        playSfx("boom", 0.7, final and 0.9 or 1.1)
        if final then
            arenaRing(900, 1.2, COL.white)
        end
        strike(CX + rand(-200, 200), CZ + rand(-200, 200), final == true)
        setSpeedLines(true, 0.5)
        wait(0.35)
        setSpeedLines(false)
        wait(final and 1.4 or 1.1)
        stamp.release(0.6)
    end

    -- When the face shot cuts in, replay the teleport visuals + sound and the flicker on the
    -- player so it looks like they arrive right there, then ignite the aura
    local function playArrivalFx()
        local char = plr.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        emitTeleportVFX(root)
        playTeleportSound(root)
        task.spawn(blinkCharacter, char)
        aura.ignite(char)
    end

    local function eyeGlint()
        local char = plr.Character
        local head = char and char:FindFirstChild("Head")
        local size = vp().Y * 0.5
        if head then
            local v, onScreen = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.1, 0))
            if onScreen then
                glint(v.X + size * 0.06, v.Y - size * 0.04, size, 0.75)
                return
            end
        end
        glint(vp().X / 2, vp().Y / 2, size, 0.75)
    end

