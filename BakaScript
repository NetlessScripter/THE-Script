-- 12 -> "TWELVE", 21 -> "TWENTY-ONE", 105 -> "ONE HUNDRED FIVE" (falls back to digits past 999)
local function numberToWords(n)
    n = math.floor(n)
    if n < 0 or n > 999 then return tostring(n) end
    if n == 0 then return "ZERO" end
    local ones = {"ONE", "TWO", "THREE", "FOUR", "FIVE", "SIX", "SEVEN", "EIGHT", "NINE", "TEN", "ELEVEN", "TWELVE",
        "THIRTEEN", "FOURTEEN", "FIFTEEN", "SIXTEEN", "SEVENTEEN", "EIGHTEEN", "NINETEEN"}
    local tens = {"", "TWENTY", "THIRTY", "FORTY", "FIFTY", "SIXTY", "SEVENTY", "EIGHTY", "NINETY"}
    local parts = {}
    if n >= 100 then
        parts[#parts + 1] = ones[n // 100] .. " HUNDRED"
        n = n % 100
    end
    if n >= 20 then
        local t = tens[n // 10]
        if n % 10 > 0 then t = t .. "-" .. ones[n % 10] end
        parts[#parts + 1] = t
    elseif n > 0 then
        parts[#parts + 1] = ones[n]
    end
    return table.concat(parts, " ")
end

