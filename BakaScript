        -- Close-up of the player's face, built at runtime because it depends on where they were
        -- teleported. The camera dollies in along a small arc, then settles with handheld life.
        function buildFaceShot()
            local char = plr.Character
            local head = char and char:FindFirstChild("Head")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not head or not root then return nil end
            local facePos = head.Position
            -- the character's forward direction (the way the player faces), not the head part's own
            -- orientation, which can point the other way on some rigs
            local fwd = root.CFrame.LookVector
            local right = root.CFrame.RightVector
            local function camAt(dist, ang, lift)
                return facePos + (fwd * math.cos(ang) + right * math.sin(ang)) * dist + Vector3.new(0, lift, 0)
            end
            return {
                time = FACE_TIME,
                pos = function(e)
                    return camAt(
                        lerp(FACE_SHOT_DISTANCE * 1.6, FACE_SHOT_DISTANCE * 0.8, e),
                        lerp(math.rad(-26), math.rad(10), e),
                        lerp(0.8, 0, e)
                    )
                end,
                look = function(e)
                    return facePos + Vector3.new(0, lerp(0, 0.15, e), 0)
                end,
                fov = {52, 30}, roll = {-4, 2}, handheld = 0.6, shake = {0.4, 1.2},
