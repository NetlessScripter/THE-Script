local function cameraFacing(position)
	local camera = Workspace.CurrentCamera
	local offset = camera and (camera.CFrame.Position - position) or Vector3.yAxis
	if offset.Magnitude < 0.01 then return Vector3.yAxis end
	return offset.Unit
end

local function tiltedNormal(normal, angle, seed)
	local axis = normal:Cross(seed == 2 and Vector3.xAxis or Vector3.yAxis)
	if axis.Magnitude < 0.1 then axis = Vector3.zAxis end
	return CFrame.fromAxisAngle(axis.Unit, angle):VectorToWorldSpace(normal)
end

local function randomDirectionInCone(random, axis, coneHalfAngle)
	local helperAxis = math.abs(axis.Y) > 0.95 and vec3(1, 0, 0) or vec3(0, 1, 0)
	local axisRight = axis:Cross(helperAxis).Unit
	local axisUp = axis:Cross(axisRight).Unit
	local polarAngle = coneHalfAngle * math.sqrt(random:NextNumber())
	local azimuthAngle = random:NextNumber(0, TAU)
	local sideways = (axisRight * math.cos(azimuthAngle) + axisUp * math.sin(azimuthAngle)) * math.sin(polarAngle)
	return (axis * math.cos(polarAngle) + sideways).Unit
end

