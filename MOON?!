-- ================================================================ lens layer: radial haze + anamorphic flare (ported from the planet script)
local function newLens(gui, root, camera, baseFov)
	local L = {}
	local haze = Instance.new("CanvasGroup")
	haze.Size = UDim2.fromScale(1, 1)
	haze.BackgroundTransparency = 1
	haze.BorderSizePixel = 0
	haze.ZIndex = 2
	haze.Parent = gui
	local circles = {}
	for i = 1, 24 do
		local c = Instance.new("Frame")
		c.AnchorPoint = Vector2.new(0.5, 0.5)
		c.BackgroundColor3 = WHITE
		c.BorderSizePixel = 0
		c.BackgroundTransparency = 1
		local u = Instance.new("UICorner")
		u.CornerRadius = UDim.new(1, 0)
		u.Parent = c
		c.Parent = haze
		circles[i] = c
	end

	local rig = Instance.new("Part")
	rig.Anchored = true
	rig.CanCollide, rig.CanQuery, rig.CanTouch, rig.CastShadow = false, false, false, false
	rig.Transparency = 1
	rig.Size = Vector3.one * 0.05
	rig.Parent = root
	local defs = {
		{ pos = Vector2.new(1, 1), mult = 1, blend = 0.5, role = 1, squash = -1,
			size = NumberSequence.new({ NSK(0, 9), NSK(0.5, 4.5), NSK(1, 0) }),
			alpha = NumberSequence.new({ NSK(0, 0.1), NSK(0.6, 0.55), NSK(1, 1) }) },
		{ pos = Vector2.new(1, 1), mult = 1, blend = 0.15, role = 1, squash = -1.2,
			size = NumberSequence.new({ NSK(0, 4.5), NSK(1, 0) }),
			alpha = NumberSequence.new({ NSK(0, 0), NSK(1, 1) }) },
		{ pos = Vector2.new(1, 1), mult = 1, blend = 0.8, role = 2, squash = -4,
			size = NumberSequence.new({ NSK(0, 6), NSK(1, 0) }),
			alpha = NumberSequence.new({ NSK(0, 0.25), NSK(0.6, 0.65), NSK(1, 1) }) },
		{ pos = Vector2.new(-0.6, -0.6), mult = 1, blend = 0.75, role = 3, squash = -1.5,
			size = NumberSequence.new({ NSK(0, 2.2), NSK(1, 0) }),
			alpha = NumberSequence.new({ NSK(0, 0.65), NSK(1, 1) }) },
		{ pos = Vector2.new(1, 1), mult = 1, blend = 0.85, role = 2,
			size = NumberSequence.new({ NSK(0, 3.5), NSK(1, 0) }),
			alpha = NumberSequence.new({ NSK(0, 0.1), NSK(1, 1) }),
			squash = NumberSequence.new({ NSK(0, -9), NSK(1, -3) }) },
		{ pos = Vector2.new(1, 1), mult = 1, blend = 0.15, role = 1,
			size = NumberSequence.new({ NSK(0, 2.2), NSK(1, 0) }),
			alpha = NumberSequence.new({ NSK(0, 0), NSK(1, 1) }),
			squash = NumberSequence.new({ NSK(0, -14), NSK(1, -5) }) },
	}
	for _, d in ipairs(defs) do
		d.att = Instance.new("Attachment")
		d.att.Parent = rig
		local e = Instance.new("ParticleEmitter")
		e.Enabled, e.Rate = false, 0
		e.Speed, e.RotSpeed = NumberRange.new(0), NumberRange.new(0)
		e.Lifetime = NumberRange.new(0.05)
		e.Rotation = NumberRange.new(UPPERCUT_FLARE_TILT)
		e.LightEmission, e.LightInfluence, e.ZOffset = 1, 0, -5
		e.Orientation = Enum.ParticleOrientation.FacingCamera
		e.Parent = d.att
		d.e = e
	end
	local function evalSeq(v, a)
		if typeof(v) == "number" then return v end
		a = math.clamp(a, 0, 1)
		local k = v.Keypoints
		for i = 2, #k do
			if a <= k[i].Time then
				local p0, p1 = k[i - 1], k[i]
				return p0.Value + (p1.Value - p0.Value) * (a - p0.Time) / (p1.Time - p0.Time)
			end
		end
		return k[#k].Value
	end

	-- p = { src = world pos, tint, glowSize, glowAlpha, flare, cols = {main, accent, ghost}, t, visible }
	function L.update(p)
		local V = camera.ViewportSize
		local cx, cy = V.X / 2, V.Y / 2
		local srcX, srcY, onScreen = cx, cy, false
		if p.src then
			local P = camera:WorldToViewportPoint(p.src)
			srcX, srcY, onScreen = P.X, P.Y, P.Z > 0
		end
		haze.Visible = p.visible ~= false
		local ga = onScreen and p.glowAlpha or 0
		for i, c in ipairs(circles) do
			local sz = V.Y * 0.05 * 1.22 ^ (i - 1) * p.glowSize
			c.Size = UDim2.fromOffset(sz, sz)
			c.Position = UDim2.fromOffset(srcX, srcY)
			c.BackgroundColor3 = p.tint:Lerp(WHITE, math.clamp(1 - (i - 1) / 8, 0, 1))
			-- discs wider than the screen only tint the whole frame, so they fade out
			local reach = 1 - math.clamp((sz - V.Y * 1.1) / (V.Y * 0.9), 0, 1)
			c.BackgroundTransparency = 1 - math.clamp(0.025 * ga * reach, 0, 1)
		end

		local fl = onScreen and (p.flare or 0) * UPPERCUT_FLARE or 0
		if fl <= 0.001 or not p.src then return end
		local cf = camera.CFrame
		local toSrc = p.src - cf.Position
		if toSrc.Magnitude < 0.01 then return end
		local viewAngle = math.acos(math.clamp(cf.LookVector:Dot(toSrc.Unit), -1, 1))
		local vFov = math.rad(camera.FieldOfView)
		local ar = V.X / V.Y
		local dFov = 2 * math.atan(math.tan(vFov / 2) * math.sqrt(1 + ar * ar))
		local angleAlpha = 1 - math.clamp(viewAngle / (dFov / 2), 0, 1)
		local strength = math.clamp(angleAlpha * fl, 0, 1)
		if strength > 0.001 then
			local t = p.t or os.clock()
			local src2 = Vector2.new(srcX, srcY)
			-- drift bias so the ghosts still spread out while the source sits dead centre
			local b = Vector2.new(cx, cy) - src2 + Vector2.new(math.cos(t * 0.7) * V.Y * 0.16, math.sin(t * 0.5) * V.Y * 0.1)
			local fovK = math.tan(vFov / 2) / math.tan(math.rad(baseFov) / 2)
			for _, d in ipairs(defs) do
				local k = Vector2.one - d.pos * d.mult
				local pt = src2 + Vector2.new(b.X * k.X, b.Y * k.Y)
				local ray = camera:ViewportPointToRay(pt.X, pt.Y)
				d.att.WorldPosition = ray.Origin + ray.Direction.Unit * 13
				local fade = 1 - angleAlpha
				d.e.Size = NumberSequence.new(evalSeq(d.size, fade) * fovK)
				d.e.Squash = NumberSequence.new(evalSeq(d.squash, fade))
				d.e.Transparency = NumberSequence.new(math.clamp(1 - (1 - evalSeq(d.alpha, fade)) * strength, 0, 1))
				d.e.Color = ColorSequence.new(WHITE:Lerp(p.cols[d.role], d.blend))
				d.e:Emit(1)
			end
		end
	end
	function L.destroy()
		haze:Destroy()
		rig:Destroy()
	end
	return L
end

-- ================================================================ camera shake (same as the planet script)
local function explosionShake(shakes)
	local now = os.clock()
	local yaw, pitch, roll = 0, 0, 0
	for _, sh in ipairs(shakes) do
		local rt = now - sh.start
		if rt >= 0 then
			local atk = math.clamp(rt / 0.06, 0, 1)
			atk = atk * atk * (3 - 2 * atk)
			local env = atk * (0.55 * math.exp(-rt * 4.5) + 0.45 * math.exp(-rt * 1.3))
			if env >= 0.0005 then
				local k, ph = env * sh.strength * UPPERCUT_SHAKE, sh.phase
				yaw = yaw + (0.6 * math.sin(rt * TAU * 6.1 + 0.3 + ph) + 0.4 * math.sin(rt * TAU * 10.7 + 1.7 + ph)) * 0.11 * k
				pitch = pitch + (0.6 * math.sin(rt * TAU * 7.3 + 2.1 + ph) + 0.4 * math.sin(rt * TAU * 12.9 + 0.4 + ph)) * 0.09 * k
				roll = roll + (0.7 * math.sin(rt * TAU * 5.2 + 4.0 + ph) + 0.3 * math.sin(rt * TAU * 9.1 + 1.0 + ph)) * 0.07 * k
			end
		end
	end
	return yaw, pitch, roll
end

-- ================================================================ planets + space backdrop
local TEMPLATES = {}
local function loadTemplate(kind, assetId)
	if TEMPLATES[kind] then return TEMPLATES[kind] end
	local okL, objs = pcall(function() return game:GetObjects("rbxassetid://" .. tostring(assetId)) end)
	if not okL or type(objs) ~= "table" or #objs == 0 then
		warn("[Uppercut] could not load asset " .. tostring(assetId) .. " (" .. tostring(objs) .. ") - using a plain sphere instead")
		return nil
	end
	local m = Instance.new("Model")
	m.Name = "UF_" .. kind
	for _, o in ipairs(objs) do o.Parent = m end
	local hasPart = false
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("LuaSourceContainer") then
			pcall(function() d:Destroy() end)
		elseif d:IsA("BasePart") then
			hasPart = true
			d.Anchored = true
			d.CanCollide, d.CanTouch, d.CanQuery, d.CastShadow = false, false, false, false
		end
	end
	if not hasPart then
		warn("[Uppercut] asset " .. tostring(assetId) .. " has no parts - using a plain sphere instead")
		return nil
	end
	TEMPLATES[kind] = m
	return m
end
