	for _ = 1, cnt(10) do
		fx.bolt({ t0 = t0 + rr(0, 0.35) * tm, life = rr(0.4, 0.8) * tm, ang = rr(0, TAU), r0 = 0.1 * S, len = rr(0.5, 1.1) * S,
			w = 0.006 * S * th, color = BLUE[2], jitter = 0.08 })
	end
	fx.core({ t0 = t0, life = 1.7 * tm, size = function(t)
		local u = t / tm
		return S * kf(u, { { 0, 0.01 }, { 0.15, 0.22 }, { 0.9, 0.24 }, { 1.4, 0.1 }, { 1.7, 0 } })
	end })
	if o.second then
		local t2 = t0 + o.second
		fx.once(t2, function() fx.burst(BLUE[2], BLUE[3], cnt(12), 1.2, 0.007 * th, tm) end)
		for _, a in ipairs({ 0.15, PI + 0.15, -0.12, PI - 0.12, 1.2, PI + 1.2 }) do
			fx.ray({ t0 = t2 + 0.03 * tm, life = 2.6 * tm, ang = a, r0 = 0.1 * S, len = 1.7 * S, w = 0.03 * S * th,
				color = BLUE[2], grow = 0.12, hold = 0.6, tailMove = 0.35 })
		end
		for _ = 1, cnt(90) do
			fx.comet({ t0 = t2 + rr(0, 0.25) * tm, life = rr(1.0, 1.8) * tm, mode = "out", ang = rr(0, TAU), r0 = 0.06 * S, r1 = rr(1, 2.6) * S,
				swirl = rr(0.8, 2.0) * sgn(), z = rr(-0.25, 0.25), w = rr(0.01, 0.025) * S * th, trail = rr(0.45, 0.9) * tm,
				color = pick(BLUE), color2 = BLUE[3], minHead = mh })
		end
		for _ = 1, cnt(8) do
			fx.bolt({ t0 = t2 + rr(0, 0.4) * tm, life = rr(0.4, 0.8) * tm, ang = rr(0, TAU), r0 = 0.12 * S, len = rr(0.7, 1.4) * S,
