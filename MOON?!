	end
	return effectsFolder
end

local function expandingSphere(parent, position, startDiameter, endDiameter, life, color, startTransparency, fadePower, delay)
	local ball = makeBall(parent, position, startDiameter, color, 1)
	local elapsed = -(delay or 0)
	addEffect(function(deltaTime)
		elapsed += deltaTime
		if elapsed < 0 then return false end
		local alpha = math.min(elapsed / life, 1)
		ball.Size = Vector3.one * math.clamp(lerp(startDiameter, endDiameter, easeOutCubic(alpha)), 0.05, MAX_PART_SIZE)
		ball.Transparency = startTransparency + (1 - startTransparency) * alpha ^ (fadePower or 1.4)
		if alpha >= 1 then
			ball:Destroy()
			return true
		end
		return false
	end)
	return ball
end

local function addRing(parent, center, normal, startRadius, endRadius, life, color, width, delay, coreColor)
	local segmentCount = math.clamp(math.floor(endRadius / 10), 56, 140)
	local helperAxis = math.abs(normal.Y) > 0.95 and vec3(1, 0, 0) or vec3(0, 1, 0)
	local axisX = normal:Cross(helperAxis).Unit
	local axisY = normal:Cross(axisX).Unit
	local holder = makePart(parent, Enum.PartType.Ball, Enum.Material.SmoothPlastic, WHITE, vec3(0.5, 0.5, 0.5), CFrame.new(center), 1)
	local attachments = {}
	for index = 1, segmentCount do
		local attachment = Instance.new("Attachment")
		attachment.Parent = holder
		attachments[index] = attachment
	end
	local function makeBeamLayer(beamColor, widthScale)
		local beamList = {}
		for index = 1, segmentCount do
			local beam = Instance.new("Beam")
			beam.Attachment0 = attachments[index]
			beam.Attachment1 = attachments[index % segmentCount + 1]
			beam.FaceCamera = true
			beam.LightEmission = 1
			beam.LightInfluence = 0
			beam.Segments = 1
			beam.Color = ColorSequence.new(beamColor)
			beam.Transparency = NumberSequence.new(1)
			beam.Parent = holder
			beamList[index] = beam
		end
		return { beams = beamList, widthScale = widthScale }
	end
	local layers = { makeBeamLayer(color, 1) }
	if coreColor then
		layers[2] = makeBeamLayer(coreColor, 0.4)
	end
	local elapsed = -(delay or 0)
	addEffect(function(deltaTime)
		elapsed += deltaTime
		if elapsed < 0 then return false end
		local alpha = math.min(elapsed / life, 1)
		if alpha >= 1 then
			holder:Destroy()
			return true
		end
		local radius = lerp(startRadius, endRadius, easeOutCubic(alpha))
		for index = 1, segmentCount do
			local angle = (index - 1) / segmentCount * TAU
			attachments[index].WorldPosition = center + axisX * (math.cos(angle) * radius) + axisY * (math.sin(angle) * radius)
		end
		local currentWidth = width * (1 - alpha * 0.65)
		local transparency = NumberSequence.new(math.clamp(alpha ^ 1.6, 0, 1))
		for _, layer in ipairs(layers) do
			local layerWidth = currentWidth * layer.widthScale
			for _, beam in ipairs(layer.beams) do
				beam.Width0, beam.Width1 = layerWidth, layerWidth
				beam.Transparency = transparency
			end
		end
		return false
	end)
end

local function rayBurst(parent, position, options)
	local random = Random.new()
	local rays = {}
	for index = 1, options.count do
		local direction = random:NextUnitVector()
		local part = makePart(parent, Enum.PartType.Block, Enum.Material.Neon, options.colors[random:NextInteger(1, #options.colors)], vec3(options.width, options.width, 1), CFrame.new(position), 1)
		rays[index] = {
			part = part,
			direction = direction,
			length = options.length * random:NextNumber(0.55, 1.2),
			startRadius = options.startRadius * random:NextNumber(0.6, 1.4),
		}
	end
	local elapsed = -(options.delay or 0)
	addEffect(function(deltaTime)
		elapsed += deltaTime
		if elapsed < 0 then return false end
		local alpha = elapsed / options.life
		if alpha >= 1 then
			for _, ray in ipairs(rays) do ray.part:Destroy() end
			return true
		end
		for _, ray in ipairs(rays) do
			local headDistance = ray.startRadius + ray.length * easeOutExpo(alpha / 0.3)
			local tailDistance = ray.startRadius + ray.length * 0.85 * smoothstep((alpha - 0.12) / 0.88)
			local rayLength = math.max(headDistance - tailDistance, 0.05)
			local middleDistance = (headDistance + tailDistance) / 2
			local rayWidth = options.width * (1 - alpha * 0.8)
			ray.part.Size = vec3(rayWidth, rayWidth, rayLength)
			ray.part.CFrame = CFrame.lookAt(position + ray.direction * middleDistance, position + ray.direction * (middleDistance + 1))
			ray.part.Transparency = math.clamp(alpha ^ 1.6, 0, 1)
		end
		return false
	end)
end

