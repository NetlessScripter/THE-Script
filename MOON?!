local function smoothstep(value)
	value = math.clamp(value, 0, 1)
	return value * value * (3 - 2 * value)
end

local function easeOutCubic(value)
	value = math.clamp(value, 0, 1)
	return 1 - (1 - value) ^ 3
end

local function easeInCubic(value)
	value = math.clamp(value, 0, 1)
	return value ^ 3
end

local function easeOutExpo(value)
	value = math.clamp(value, 0, 1)
	return value >= 1 and 1 or 1 - 2 ^ (-10 * value)
end

local function lerp(fromValue, toValue, alpha)
	return fromValue + (toValue - fromValue) * alpha
end

local function playSound(soundKey, volume)
	local soundId = UPPERCUT_SFX[soundKey]
	if not soundId or soundId == "" then return end
	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Volume = volume or 2
	sound.Parent = Workspace
	sound:Play()
	Debris:AddItem(sound, 15)
end

local effectList = {}
local effectConnection = nil
local effectClock = 1

local function addEffect(effectFunction)
	effectList[#effectList + 1] = effectFunction
	if not effectConnection then
		effectConnection = RunService.RenderStepped:Connect(function(deltaTime)
			deltaTime = math.min(deltaTime, 0.1) * effectClock
			local index = 1
			while index <= #effectList do
				local succeeded, finished = pcall(effectList[index], deltaTime)
				if not succeeded or finished then
					table.remove(effectList, index)
				else
					index += 1
				end
			end
			if #effectList == 0 and effectConnection then
				effectConnection:Disconnect()
				effectConnection = nil
			end
		end)
	end
end

local function clearEffects()
	effectList = {}
	if effectConnection then
		effectConnection:Disconnect()
		effectConnection = nil
	end
end

local function makePart(parent, shape, material, color, size, cframe, transparency)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide, part.CanQuery, part.CanTouch, part.CastShadow = false, false, false, false
	part.Shape = shape
	part.Material = material
	part.Color = color
	part.Transparency = transparency or 0
	part.Size = size
	part.CFrame = cframe
	part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function makeBall(parent, position, diameter, color, transparency)
	return makePart(parent, Enum.PartType.Ball, Enum.Material.Neon, color, Vector3.one * math.clamp(diameter, 0.05, MAX_PART_SIZE), CFrame.new(position), transparency)
end

