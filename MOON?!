-- ================================================================ hitbox (copy of the attack 4 one, own threshold)
function StartAttack3Hitbox(duration, onTrigger)
	local state = { triggered = false, target = nil }
	local char = LocalPlayer.Character or Character
	local root = (char and char:FindFirstChild("HumanoidRootPart")) or HumanoidRootPart

	local hitbox = Instance.new("Part")
	hitbox.Name = "Attack3Hitbox"
	hitbox.Size = ATTACK3_HITBOX_SIZE
	hitbox.Anchored = true
	hitbox.CanCollide, hitbox.CanQuery, hitbox.CanTouch, hitbox.CastShadow = false, false, false, false
	hitbox.Transparency = ATTACK3_HITBOX_DEBUG and 0.7 or 1
	hitbox.Color = Color3.new(0, 0.6, 1)
	hitbox.Material = Enum.Material.SmoothPlastic
	hitbox.CFrame = root.CFrame * CFrame.new(0, 0, -ATTACK3_HITBOX_OFFSET)
	hitbox.Parent = workspace

	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char, hitbox }

	local conn
	local function stop()
		if conn then
			conn:Disconnect()
			conn = nil
		end
		if hitbox then
			hitbox:Destroy()
			hitbox = nil
		end
	end
	state.stop = stop

	local startTime = os.clock()
	conn = RunService.Heartbeat:Connect(function()
		if not hitbox then return end
		if os.clock() - startTime >= duration then
			stop()
			return
		end
		if root and root.Parent then
			hitbox.CFrame = root.CFrame * CFrame.new(0, 0, -ATTACK3_HITBOX_OFFSET)
		end
		local live = workspace:FindFirstChild("Live")
		for _, part in ipairs(workspace:GetPartBoundsInBox(hitbox.CFrame, hitbox.Size, params)) do
			local model = part:FindFirstAncestorOfClass("Model")
			if model then
				local hum = model:FindFirstChildOfClass("Humanoid")
				local plr = Players:GetPlayerFromCharacter(model)
				local isTarget = (plr ~= nil and plr ~= LocalPlayer)
					or (model.Name == "Weakest Dummy" and (live == nil or model:IsDescendantOf(live)))
				if hum and isTarget and hum.Health > 0 and hum.Health <= ATTACK3_FINISHER_HEALTH then
					state.triggered = true
					state.target = model
					stop()
					if onTrigger then task.spawn(onTrigger, model) end
					return
				end
			end
		end
	end)
	return state
end

-- ================================================================ clone the enemy (must happen while he is alive)
local function cloneTarget(char)
	if not char then return nil end
	pcall(function() char.Archivable = true end)
	for _, d in ipairs(char:GetDescendants()) do
		pcall(function() d.Archivable = true end)
	end
	local okC, clone = pcall(function() return char:Clone() end)
	if not okC or not clone then return nil end
	clone.Name = "UppercutFinisherClone"
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("LuaSourceContainer") or d:IsA("Sound") or d:IsA("BodyMover") or d:IsA("Constraint")
			or d:IsA("ForceField") or d:IsA("Highlight") or d:IsA("BillboardGui") or d:IsA("Tool") then
			pcall(function() d:Destroy() end)
		end
	end
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = (d.Name == "HumanoidRootPart")  -- only the root is anchored, the limbs follow the joints so animations still play
			d.CanCollide, d.CanTouch, d.CanQuery = false, false, false
		end
	end
	local hum = clone:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		hum.BreakJointsOnDeath = false
		hum.RequiresNeck = false
		hum.AutoRotate = false
		hum.PlatformStand = true
		pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false) end)
		hum.MaxHealth = math.max(hum.MaxHealth, 100)
		hum.Health = hum.MaxHealth
	end
	return clone
end

-- ================================================================ the cutscene
local cutsceneActive = false

function PlayUppercutCutscene(f)
	if cutsceneActive then return end
	cutsceneActive = true

	local cleanups, finished = {}, false
	local ST = { done = false, staged = false, shakes = {}, flashUntil = 0, clock = 0 }
	local function addCleanup(fn) cleanups[#cleanups + 1] = fn end
	local function runCleanups()
		if finished then return end
		finished = true
		if ST.staged then  -- black overlay that fades out, so coming back to the real world isn't a hard cut
			pcall(function()
				local eg = newScreenGui("UppercutEndFade", 2000)
				local ef = Instance.new("Frame")
				ef.Size = UDim2.fromScale(1, 1)
				ef.BackgroundColor3 = Color3.new(0, 0, 0)
				ef.BorderSizePixel = 0
				ef.Parent = eg
				local tw = TweenService:Create(ef, TweenInfo.new(1.5, Enum.EasingStyle.Linear), { BackgroundTransparency = 1 })
				tw.Completed:Connect(function() eg:Destroy() end)
				tw:Play()
			end)
		end
		for i = #cleanups, 1, -1 do pcall(cleanups[i]) end
		cutsceneActive = false
	end

	local ok, err = pcall(function()
		local camera = workspace.CurrentCamera
		local O = UPPERCUT_STAGE_ORIGIN
		local FOV = 60
		local D = 3000
		local UI, W, TL, K = {}, {}, {}, {}

		-- ===== screen overlays =====
		local gui = newScreenGui("UppercutCutsceneGui", 1000)
		addCleanup(function() gui:Destroy() end)
		local function fullFrame(color, z)
			local fr = Instance.new("Frame")
			fr.Size = UDim2.fromScale(1, 1)
			fr.BackgroundColor3 = color
			fr.BorderSizePixel = 0
			fr.BackgroundTransparency = 1
			fr.ZIndex = z
			fr.Parent = gui
			return fr
		end
		UI.white = fullFrame(WHITE, 5)
		UI.black = fullFrame(Color3.new(0, 0, 0), 6)

		-- white flash hides the hard cut to the stage (and the heavy setup below)
		TweenService:Create(UI.white, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 0 }):Play()
		task.wait(0.14)
		ST.staged = true
		addCleanup(hideUI(gui))

		-- ===== world setup (same as the planet finisher: no sky, no atmosphere, bloom + colour) =====
		local removed = {}
		for _, c in ipairs(Lighting:GetChildren()) do
			if c:IsA("Sky") or c:IsA("Atmosphere") then
				removed[#removed + 1] = c
				c.Parent = nil
			end
		end
		local sky = Instance.new("Sky")
		for _, nme in ipairs({ "SkyboxBk", "SkyboxDn", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxUp" }) do
			sky[nme] = ""
		end
		sky.StarCount = 0
		sky.CelestialBodiesShown = false
		sky.Parent = Lighting
		UI.bloom = Instance.new("BloomEffect")
		UI.bloom.Size = 56
		UI.bloom.Threshold = 0.8
		UI.bloom.Parent = Lighting
		UI.cc = Instance.new("ColorCorrectionEffect")
		UI.cc.Saturation = 0.25
		UI.cc.Parent = Lighting
		UI.blur = Instance.new("BlurEffect")
		UI.blur.Size = 0
		UI.blur.Parent = Lighting
		addCleanup(function()
			sky:Destroy()
			UI.bloom:Destroy()
			UI.cc:Destroy()
			UI.blur:Destroy()
			for _, c in ipairs(removed) do c.Parent = Lighting end
		end)

		W.stageRoot = Instance.new("Folder")
		W.stageRoot.Name = "UppercutStage"
		W.stageRoot.Parent = workspace
		addCleanup(function() W.stageRoot:Destroy() end)

		camera.CameraType = Enum.CameraType.Scriptable
		camera.FieldOfView = FOV
		camera.CFrame = CFrame.new(O)
		local savedFov = 70
		addCleanup(function()
			camera.CameraType = Enum.CameraType.Custom
			camera.FieldOfView = savedFov
			local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if h then camera.CameraSubject = h end
		end)

		-- ===== geometry: exactly the Attack 4 earth composition =====
		local V = camera.ViewportSize
		local aspect = math.max(V.X / math.max(V.Y, 1), 1.6)
		local halfH = D * math.tan(math.rad(FOV) / 2)
		local S = halfH * aspect                         -- half the visible width at the explosion plane
		local earthRadiusScr = 0.55 * halfH
		local backOff = 1.06 * D * earthRadiusScr / (D - earthRadiusScr)
		local distScale = (D + backOff) / D
		local Re = earthRadiusScr * distScale            -- real radius of the (visible) earth
		local EC = O + Vector3.new(0, 0, -(D + backOff)) -- earth centre
		local Ce = CFrame.new(O + Vector3.new(0, 0, -D)) -- explosion plane centre, axes = camera axes
		local startupScale = 1 + earthRadiusScr / (0.2 * S)
		local EARTH_RATIO = 2.1                          -- the earth asset's visible sphere is 2.1x its bounding box

		W.earth = getEarthModel(W.stageRoot)
		if W.earth then
			fitBounds(W.earth, math.min(2 * Re / EARTH_RATIO, 2000))
			centerModel(W.earth, EC)
		else
			W.earth = fallbackSphere(rgb(50, 120, 210), 2 * Re, EC, W.stageRoot)
		end

		-- moon behind the camera: we whip round to it
		local Dm = 3800
		local MC = O + Vector3.new(0, 0, Dm)
		local Rm = 1000
		W.moon = getMoonModel(W.stageRoot)
		if W.moon then
			fitBounds(W.moon, math.min(2 * Rm, 2000))
			centerModel(W.moon, MC)
			local _, msz = W.moon:GetBoundingBox()
			Rm = math.max(msz.X, msz.Y, msz.Z) / 2
		else
			W.moon = fallbackSphere(rgb(170, 170, 175), 2 * Rm, MC, W.stageRoot)
		end
		W.moonBase = W.moon:GetPivot()
		local dirM = ((O + Vector3.new(60, 40, 0)) - MC).Unit
		local PM = MC + dirM * Rm                        -- where the enemy hits the moon
		local rotBack = CFrame.Angles(0, -PI, 0)         -- the camera's rotation once it has whipped round
		local Cm = CFrame.new(PM) * rotBack
		local Cd = CFrame.new(MC) * rotBack

		-- space backdrop: black wall + twinkling stars behind earth and behind the moon (like the planet script), plus side walls
		local pxE = 2 * halfH * aspect * ((D + backOff + Re + 300) / D) / math.max(V.X, 1)
		local earthWall = buildWall(W.stageRoot, O, "Z", -1, D + backOff + Re + 300,
			math.tan(math.rad(62)) * (D + backOff + Re + 300), math.tan(math.rad(46)) * (D + backOff + Re + 300), math.floor(430 * UPPERCUT_QUALITY), pxE)
		local moonWall = buildWall(W.stageRoot, O, "Z", 1, Dm + Rm + 300,
			math.tan(math.rad(62)) * (Dm + Rm + 300), math.tan(math.rad(46)) * (Dm + Rm + 300), math.floor(430 * UPPERCUT_QUALITY), pxE * 0.82)
		buildWall(W.stageRoot, O, "X", 1, 2600, 4500, 2600, 0, 0)
		buildWall(W.stageRoot, O, "X", -1, 2600, 4500, 2600, 0, 0)

		-- ===== enemy path =====
		local surfDist = D + backOff - Re
		W.PS = O + Vector3.new(0, 0, -(surfDist + 420))          -- starts inside the earth
		W.PC = O + Vector3.new(380, 120, -60)                    -- whooshes past just right of the camera
		local V0, TA = 1500, 1.4
		local LA = (W.PC - W.PS).Magnitude
		local LB = (PM - W.PC).Magnitude
		local ACC = math.max(2 * (LA - V0 * TA) / (TA * TA), 0)
		local VB = (V0 + ACC * TA) * 0.8
		local function enemyPosAt(tt)
			local s
			if tt <= 0 then
				s = 0
			elseif tt <= TA then
				s = V0 * tt + 0.5 * ACC * tt * tt
			else
				s = LA + VB * (tt - TA)
			end
			if s <= LA then return W.PS:Lerp(W.PC, s / LA) end
			return W.PC:Lerp(PM, math.min((s - LA) / LB, 1))
		end
		local tExit = TA
		do
			local tt = 0
			while tt < TA do
				if (enemyPosAt(tt) - EC).Magnitude >= Re * 0.985 then
					tExit = tt
					break
				end
				tt = tt + 0.01
			end
		end

		-- ===== timeline (clock seconds) =====
		local T1 = 1.0                                   -- BREACH: the enemy bursts out of the earth
		TL.launch = T1 - tExit
		TL.pass = TL.launch + TA                         -- he whooshes past the camera
		TL.impact = TL.pass + LB / VB                    -- he hits the moon
		local TI = TL.impact
		local TB = TI + 0.9                              -- the moon detonates
		local TF = TB + 3.6                              -- end
		TL.whipStart = TL.pass - 0.07
		TL.whipDur = 0.34
		TL.exit = tExit

		K.black = { { 0, 1 }, { TF - 0.5, 1 }, { TF, 0 } }
		K.dim = { { 0, 1 }, { T1 - 0.35, 1 }, { T1 - 0.04, 0.5 }, { T1 + 0.01, 0.5 }, { T1 + 0.06, 1 },
			{ TI - 0.3, 1 }, { TI - 0.02, 0.5 }, { TI + 0.01, 0.5 }, { TI + 0.06, 1 } }
		K.white = { { 0, 0 }, { 0.4, 1 }, { T1 - 0.06, 1 }, { T1, 0.15 }, { T1 + 0.06, 0.7 }, { T1 + 0.5, 1 },
			{ TI - 0.06, 1 }, { TI, 0.15 }, { TI + 0.06, 0.7 }, { TI + 0.5, 1 },
			{ TB - 0.02, 1 }, { TB + 0.03, 0 }, { TB + 0.18, 0.4 }, { TB + 0.8, 0.93 }, { TF, 0.93 } }
		K.rumble = { { 0, 0 }, { 0.2, 0.03 }, { T1 - 0.35, 0.3 }, { T1 - 0.04, 0.55 }, { T1, 0 }, { TI + 0.05, 0 }, { TB - 0.04, 0.5 }, { TB, 0 } }
		K.fov = { { 0, 3 }, { T1 - 0.35, -6 }, { T1 - 0.04, -17 }, { T1 + 0.04, -17 }, { T1 + 0.12, 14 }, { T1 + 0.7, 5 },
			{ TI - 0.5, 2 }, { TI - 0.04, -14 }, { TI + 0.04, -14 }, { TI + 0.12, 10 }, { TB - 0.2, 4 }, { TB - 0.05, -9 },
			{ TB + 0.02, -9 }, { TB + 0.18, 24 }, { TF - 1.8, 9 }, { TF, 0 } }
		K.bloom = { { 0, 0.5 }, { T1 - 0.1, 1.0 }, { T1 + 0.02, 2.0 }, { T1 + 0.7, 1.2 }, { TI - 0.1, 1.0 }, { TI + 0.02, 2.0 },
			{ TI + 0.7, 1.2 }, { TB, 1.4 }, { TB + 0.05, 2.6 }, { TB + 1.8, 1.8 }, { TF, 3 } }
		K.contrast = { { 0, 0.12 }, { TB - 0.04, 0.12 }, { TB, 1.0 }, { TB + 0.14, 0.12 } }
		K.bright = { { 0, 0 }, { T1 - 0.32, 0 }, { T1 - 0.04, -0.12 }, { T1 + 0.04, 0.15 }, { T1 + 0.5, 0 },
			{ TI - 0.04, -0.12 }, { TI + 0.04, 0.15 }, { TI + 0.5, 0 } }
		K.vig = { { 0, 0.4 }, { T1 - 0.35, 0.2 }, { T1 - 0.04, 0 }, { T1 + 0.08, 0.4 }, { TI - 0.04, 0.3 }, { TI, 0 },
			{ TI + 0.1, 0.4 }, { TB, 0.3 }, { TB + 0.1, 0.45 }, { TF, 0.6 } }
		K.ts = { { 0, 1 }, { T1 - 0.06, 1 }, { T1, 0.35 }, { T1 + 0.12, 0.35 }, { T1 + 0.25, 1 },
			{ TI - 0.06, 1 }, { TI, 0.2 }, { TI + 0.05, 0.2 }, { TI + 0.2, 1 },
			{ TB - 0.07, 1 }, { TB, 0.2 }, { TB + 0.22, 0.2 }, { TB + 0.42, 1 } }
		K.flare = { { 0, 0 }, { 0.15, 0 }, { T1 - 0.4, 0.3 }, { T1 - 0.04, 0.1 }, { T1 + 0.02, 1.0 }, { T1 + 0.7, 0.5 },
			{ TI - 0.1, 0.2 }, { TI + 0.02, 1.0 }, { TI + 0.7, 0.5 }, { TB - 0.04, 0.6 }, { TB + 0.02, 1.0 }, { TF - 1.5, 0.85 }, { TF, 0.6 } }
		K.glowS = { { 0, 0 }, { 0.1, 0.05 }, { 0.5, 0.5 }, { T1 - 0.28, 0.9 }, { T1 - 0.04, 0.12 }, { T1 + 0.08, 2.0 }, { T1 + 0.9, 1.2 },
			{ T1 + 1.0, 0.2 }, { TI - 0.1, 0.2 }, { TI + 0.1, 2.0 }, { TB - 0.05, 2.2 }, { TB + 0.1, 4 }, { TB + 1.8, 5 }, { TF, 7 } }
		K.glowA = { { 0, 0 }, { 0.1, 0.2 }, { 0.5, 0.7 }, { T1 - 0.04, 0.9 }, { T1 + 0.08, 1.4 }, { T1 + 0.9, 0.6 }, { T1 + 1.0, 0 },
			{ TI - 0.1, 0 }, { TI + 0.1, 1.4 }, { TB - 0.05, 1.2 }, { TB + 0.1, 2.0 }, { TB + 1.8, 1.6 }, { TF - 0.3, 2.5 }, { TF, 0 } }
		K.hot = { { 0, 0 }, { TB, 0 }, { TB + 0.3, 1 } }
		K.bgE = { { 0, Color3.new(0, 0, 0) }, { T1 - 0.01, Color3.new(0, 0, 0) }, { T1 + 0.1, rgb(6, 28, 150) },
			{ T1 + 0.5, rgb(0, 60, 235) }, { T1 + 1.1, Color3.new(0, 0, 0) } }
		K.bgM = { { 0, Color3.new(0, 0, 0) }, { TI - 0.01, Color3.new(0, 0, 0) }, { TI + 0.1, rgb(6, 28, 150) },
			{ TI + 0.45, rgb(0, 60, 235) }, { TB - 0.02, rgb(10, 50, 230) }, { TB + 0.3, rgb(62, 12, 150) },
			{ TB + 1.5, rgb(38, 10, 100) }, { TB + 3.0, rgb(105, 34, 110) } }
		K.starE = { { 0, 1 }, { T1 - 0.06, 1 }, { T1 + 0.1, 0 } }
		K.starM = { { 0, 1 }, { TI - 0.06, 1 }, { TI + 0.1, 0 } }
		local flarePhases = {
			{ 0, T1 - 0.02, BLUE[2], BLUE[1], BLUE[3] },
			{ T1 + 0.04, TI - 0.12, BLUE[4], BLUE[2], BLUE[1] },
			{ TI - 0.05, TB - 0.05, BLUE[1], BLUE[3], BLUE[2] },
			{ TB + 0.02, TB + 1.2, rgb(255, 220, 120), HOT[1], HOT[3] },
			{ TB + 1.6, TB + 2.6, rgb(255, 80, 140), HOT[5], HOT[3] },
			{ TB + 2.9, TF, WHITE, rgb(255, 150, 200), HOT[5] },
		}
		K.flareCols = { {}, {}, {} }
		for _, ph in ipairs(flarePhases) do
			for i = 1, 3 do
				table.insert(K.flareCols[i], { ph[1], ph[2 + i] })
				table.insert(K.flareCols[i], { ph[2], ph[2 + i] })
			end
		end

		-- ===== vignette + lens layer =====
		local vigC = Instance.new("CanvasGroup")
		vigC.Size = UDim2.fromScale(1, 1)
		vigC.BackgroundTransparency = 1
		vigC.BorderSizePixel = 0
		vigC.ZIndex = 1
		vigC.Parent = gui
		local function edge(anchorP, pos, size, rot)
			local fr = Instance.new("Frame")
			fr.AnchorPoint = anchorP
			fr.Position = pos
			fr.Size = size
			fr.BackgroundColor3 = Color3.new(0, 0, 0)
			fr.BorderSizePixel = 0
			local g = Instance.new("UIGradient")
			g.Rotation = rot
			g.Transparency = NumberSequence.new({ NSK(0, 0.35), NSK(1, 1) })
			g.Parent = fr
			fr.Parent = vigC
		end
		edge(Vector2.new(0, 0), UDim2.fromScale(0, 0), UDim2.fromScale(0.28, 1), 0)
		edge(Vector2.new(1, 0), UDim2.fromScale(1, 0), UDim2.fromScale(0.28, 1), 180)
		edge(Vector2.new(0, 0), UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.28), 90)
		edge(Vector2.new(0, 1), UDim2.fromScale(0, 1), UDim2.fromScale(1, 0.28), 270)

		local lensRoot = Instance.new("Folder")
		lensRoot.Name = "UppercutLens"
		lensRoot.Parent = W.stageRoot
		local lens = newLens(gui, lensRoot, camera, FOV)

		-- ===== the enemy clone (or a glowing orb if the clone failed) =====
		W.enemyModel = f and f.clone or nil
		local ENEMY = UPPERCUT_ENEMY_SCALE
		if W.enemyModel then
			pcall(function() W.enemyModel:ScaleTo(ENEMY) end)
			W.enemyModel.Parent = W.stageRoot
			W.enemyRoot = W.enemyModel:FindFirstChild("HumanoidRootPart") or W.enemyModel.PrimaryPart
			if W.enemyRoot then
				W.enemyModel:PivotTo(CFrame.new(O + Vector3.new(0, -30000, 0)))  -- parked out of sight until the breach
				local hum = W.enemyModel:FindFirstChildOfClass("Humanoid")
				if hum then
					local animator = hum:FindFirstChildOfClass("Animator")
					if not animator then
						animator = Instance.new("Animator")
						animator.Parent = hum
					end
					local an = Instance.new("Animation")
					an.AnimationId = UPPERCUT_FALL_ANIM_ID
					local okA, tr = pcall(function() return animator:LoadAnimation(an) end)
					if okA and tr then
						tr.Priority = Enum.AnimationPriority.Action4
						tr.Looped = true
						tr:Play(0)
					end
				end
			end
		end
		if not W.enemyRoot then
			W.enemyModel = nil
			local orb = Instance.new("Part")
			orb.Shape = Enum.PartType.Ball
			orb.Material = Enum.Material.Neon
			orb.Color = BLUE[2]
			orb.Size = Vector3.one * 200
			orb.Anchored = true
			orb.CanCollide, orb.CanQuery, orb.CanTouch, orb.CastShadow = false, false, false, false
			orb.CFrame = CFrame.new(O + Vector3.new(0, -30000, 0))
			orb.Parent = W.stageRoot
			W.enemyRoot = orb
		end
		do  -- speed trail
			local h = W.enemyModel and (2.6 * ENEMY) or 100
			local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
			a0.Position = Vector3.new(0, h, 0)
			a1.Position = Vector3.new(0, -h, 0)
			a0.Parent, a1.Parent = W.enemyRoot, W.enemyRoot
			W.trail = Instance.new("Trail")
			W.trail.Attachment0, W.trail.Attachment1 = a0, a1
			W.trail.Lifetime = 0.45
			W.trail.LightEmission = 1
			W.trail.LightInfluence = 0
			W.trail.FaceCamera = true
			W.trail.Color = ColorSequence.new({ CSK(0, WHITE), CSK(0.25, BLUE[2]), CSK(1, BLUE[3]) })
			W.trail.Transparency = NumberSequence.new({ NSK(0, 0.1), NSK(0.6, 0.5), NSK(1, 1) })
			W.trail.WidthScale = NumberSequence.new({ NSK(0, 1), NSK(1, 0) })
			W.trail.Enabled = false
			W.trail.Parent = W.enemyRoot
		end

		-- ===== park our own character =====
		local char = LocalPlayer.Character or Character
		local myRoot = char and char:FindFirstChild("HumanoidRootPart")
		if myRoot then
			local savedCF = myRoot.CFrame
			local pinCF = savedCF
			if UPPERCUT_TELEPORT then
				pinCF = CFrame.new(CUTSCENE_TELEPORT_POS)
				myRoot.CFrame = pinCF
			end
			local pinConn = RunService.Heartbeat:Connect(function()
				local r = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if r then
					r.CFrame = pinCF
					r.AssemblyLinearVelocity = Vector3.zero
					r.AssemblyAngularVelocity = Vector3.zero
				end
			end)
			addCleanup(function()
				pinConn:Disconnect()
				local r = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if r then
					if UPPERCUT_TELEPORT then r.CFrame = savedCF end
					r.AssemblyLinearVelocity = Vector3.zero
					r.AssemblyAngularVelocity = Vector3.zero
				end
			end)
		end

		-- ===== effects: three engines (earth plane, moon impact, moon detonation); all scheduled on the cutscene clock =====
		local fxE = newFX(Ce, S, W.stageRoot)
		local fxM = newFX(Cm, 0.85 * S, W.stageRoot)
		local fxD = newFX(Cd, S, W.stageRoot)
		local function addShake(strength, phase)
			table.insert(ST.shakes, { start = os.clock(), strength = strength, phase = phase })
		end

		-- earth: night-to-day reveal shadow, warning glow, STARTUP (Attack 4 charge), BREACH, second burst
		do
			local holder = Instance.new("Frame")
			holder.Size = UDim2.fromScale(1, 1)
			holder.BackgroundTransparency = 1
			holder.BorderSizePixel = 0
			holder.ZIndex = 4
			holder.Parent = gui
			local tail = Instance.new("Frame")
			tail.BackgroundColor3 = Color3.new(0, 0, 0)
			tail.BorderSizePixel = 0
			tail.ZIndex = 4
			tail.Parent = holder
			local fade = Instance.new("Frame")
			fade.BackgroundColor3 = Color3.new(0, 0, 0)
			fade.BorderSizePixel = 0
			fade.ZIndex = 4
			fade.Parent = holder
			local fg = Instance.new("UIGradient")
			fg.Rotation = 0
			fg.Transparency = NumberSequence.new({ NSK(0, 0), NSK(0.45, 0.45), NSK(1, 1) })
			fg.Parent = fade
			local function placeShadow(a)
				local Vp = camera.ViewportSize
				local pxPerStud = (Vp.Y / 2) / (D * math.tan(math.rad(camera.FieldOfView) / 2))
				local dPx = 2 * earthRadiusScr * pxPerStud * 1.03
				local P = camera:WorldToViewportPoint(EC)
				local planetLeft = P.X - dPx / 2
				local F = dPx * 1.4
				local e = a * a * (3 - 2 * a)
				local x0 = planetLeft + dPx * 1.03
				local x1 = planetLeft - F - dPx * 0.03
				local x = x0 + (x1 - x0) * e
				local tailW = Vp.X * 3 + dPx * 4
				tail.Size = UDim2.new(0, tailW, 1, 0)
				tail.Position = UDim2.new(0, x - tailW, 0, 0)
				fade.Size = UDim2.new(0, F, 1, 0)
				fade.Position = UDim2.new(0, x, 0, 0)
			end
			placeShadow(0)
			fxE.at(0, T1 - 0.05, placeShadow, function() holder:Destroy() end)

			local glow
			fxE.at(T1 - 0.45, 0.45, function(a)
				if not glow then
					glow = Instance.new("Highlight")
					glow.Adornee = W.earth
					glow.DepthMode = Enum.HighlightDepthMode.Occluded
					glow.FillColor = BLUE[2]
					glow.OutlineColor = BLUE[2]
					glow.FillTransparency, glow.OutlineTransparency = 1, 1
					glow.Parent = W.stageRoot
				end
				local e = a ^ 2.5
				glow.FillTransparency = 1 - 0.85 * e
				glow.OutlineTransparency = 1 - e
			end, function() if glow then glow:Destroy() end end)

			startupFX(fxE, { t0 = 0.05, d = T1 - 0.05, scale = startupScale, streakLen = earthRadiusScr + 0.62 * S,
				dustWidth = 2 * (earthRadiusScr + 0.3 * S), comets = 80 })
			breachFX(fxE, { t0 = T1, tm = 1, th = 1, second = 0.55 })
			fxE.once(T1, function()
				ST.flashUntil = impactFrame(0.035)
				addShake(1, 0)
				sfx("rbxassetid://13297025560", 1.5)
				sfx("rbxassetid://12509593160", 1.5)
			end)
			fxE.once(T1 + 0.55, function() addShake(0.85, 2.3) end)
		end

		-- moon: BREACH on impact, cracks + glow building in the wound, rumble, then the DETONATION
		breachFX(fxM, { t0 = TI, tm = 0.9, th = 1, second = 0.4 })
		for i = 1, fxM.cnt(14) do
			fxM.bolt({ t0 = TI + 0.1 + i * 0.05, life = fxM.rr(0.4, 0.7), ang = fxM.rr(0, TAU), r0 = 0, len = fxM.rr(0.5, 1.1) * 0.85 * S,
				w = 0.006 * 0.85 * S, color = (i % 2 == 0) and BLUE[2] or HOTBOLT[2], jitter = 0.1, N = 9 })
		end
		fxM.core({ t0 = TI + 0.1, life = TB - TI + 0.1,
			size = function(t) return 0.85 * S * (0.12 + 0.2 * (t / (TB - TI))) end,
			hot = function(t) return math.clamp(t / (TB - TI), 0, 1) end })
		fxM.once(TI, function()
			if W.enemyModel then
				W.enemyModel:Destroy()
			elseif W.enemyRoot then
				W.enemyRoot:Destroy()
			end
			W.enemyRoot, W.enemyModel = nil, nil
			ST.impacted = true
			ST.flashUntil = impactFrame(0.035)
			addShake(1, 0.7)
			sfx("rbxassetid://14064865799", 1.5)
			sfx("rbxassetid://12534794717", 1.5)
		end)
		fxM.once(TI + 0.4, function() addShake(0.85, 3.1) end)

		detonationFX(fxD, { t0 = TB, emberH = 2 * halfH })
		fxD.once(TB, function()
			ST.broke = true
			pcall(function() W.moon:Destroy() end)
			addShake(1.5, 2.3)
			sfx("rbxassetid://9117969687", 2)
			sfx("rbxassetid://10495327847", 2)
			sfx("rbxassetid://11365099784", 1.5)
			sfx("rbxassetid://14796422256", 1.5)
		end)
		fxD.once(TB + 0.9, function() addShake(0.8, 4.2) end)

		-- ===== per-frame =====
		local function stepFn(t)
			-- enemy flight (parked out of sight until the breach)
			local tt = t - TL.launch
			if W.enemyRoot and not ST.impacted and tt >= TL.exit then
				local pos = enemyPosAt(tt)
				W.enemyRoot.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, tt * 1.2)  -- facing the earth, never the camera
				if not ST.enemyShown then
					ST.enemyShown = true
					if W.trail then W.trail.Enabled = true end
				end
			end
			if ST.impacted and not ST.broke then
				local u = math.clamp((t - TI) / (TB - TI), 0, 1)
				local amp = 1 + 14 * u  -- the moon rumbles between the hit and the blast
				W.moon:PivotTo(W.moonBase * CFrame.new((math.random() - 0.5) * amp, (math.random() - 0.5) * amp, 0))
			end

			-- camera (same sway / noise / impulse shake as the planet script) + the whip round to the moon
			local u = math.clamp((t - TL.whipStart) / TL.whipDur, 0, 1)
			local e = outBack(u)
			local amp = kf(t, K.rumble) * UPPERCUT_SHAKE
			local shYaw, shPitch, shRoll = explosionShake(ST.shakes)
			local yaw = 0.045 * math.sin(t * 0.45)
			local pitch = 0.028 * math.sin(t * 0.37 + 1)
			camera.CFrame = CFrame.new(O) * CFrame.Angles(0, -PI * e, 0) * CFrame.Angles(
				pitch + math.noise(t * 31, 0.3) * amp * 0.035 + shPitch,
				yaw + math.noise(t * 31, 10.3) * amp * 0.035 + shYaw,
				math.noise(t * 27, 20.3) * amp * 0.025 + shRoll - 0.3 * math.sin(PI * u))
			camera.FieldOfView = FOV + kf(t, K.fov) + 26 * math.sin(PI * u)
			camera.Focus = Ce

			-- world
			local flashing = os.clock() < ST.flashUntil
			UI.bloom.Intensity = flashing and 0 or kf(t, K.bloom)
			UI.cc.Contrast = kf(t, K.contrast)
			UI.cc.Brightness = kf(t, K.bright)
			UI.blur.Size = 26 * math.sin(PI * u)

			local bcE, bcM = kf(t, K.bgE), kf(t, K.bgM)
			for _, tile in ipairs(earthWall.tiles) do tile.Color = bcE end
			for _, tile in ipairs(moonWall.tiles) do tile.Color = bcM end
			local sfE, sfM = kf(t, K.starE), kf(t, K.starM)
			for _, st in ipairs(earthWall.stars) do
				local tw = 0.7 + 0.3 * math.sin(t * st.speed + st.phase)
				st.part.Transparency = 1 - math.clamp(st.base * tw * sfE, 0, 1)
			end
			for _, st in ipairs(moonWall.stars) do
				local tw = 0.7 + 0.3 * math.sin(t * st.speed + st.phase)
				st.part.Transparency = 1 - math.clamp(st.base * tw * sfM, 0, 1)
			end

			fxE.update(t)
			fxM.update(t)
			fxD.update(t)

			-- screen layer
			vigC.GroupTransparency = kf(t, K.vig)
			vigC.Visible = not flashing
			local hot = kf(t, K.hot)
			local focus = Ce.Position
			if t >= TB then
				focus = MC
			elseif t >= TI then
				focus = PM
			end
			lens.update({
				src = focus, t = t, visible = not flashing,
				tint = rgb(70, 150, 255):Lerp(rgb(255, 120, 60), hot),
				glowSize = kf(t, K.glowS), glowAlpha = kf(t, K.glowA), flare = kf(t, K.flare),
				cols = { kf(t, K.flareCols[1]), kf(t, K.flareCols[2]), kf(t, K.flareCols[3]) },
			})
			UI.black.BackgroundTransparency = math.min(kf(t, K.black), kf(t, K.dim))
			UI.white.BackgroundTransparency = kf(t, K.white)
		end

		local conn
		conn = RunService.RenderStepped:Connect(function(dt)
			dt = math.min(dt, 0.1)
			local okS, errS = pcall(function()
				local ts = kf(ST.clock, K.ts)
				ST.clock = ST.clock + dt * ts
				stepFn(ST.clock)
			end)
			if not okS then
				warn("[Uppercut] cutscene error: " .. tostring(errS))
				ST.done = true
			end
			if ST.clock >= TF then ST.done = true end
		end)
		addCleanup(function() conn:Disconnect() end)

		while not ST.done do task.wait() end
	end)

	if not ok then warn("[Uppercut] cutscene failed: " .. tostring(err)) end
	runCleanups()
end

-- ================================================================ finisher entry points (called from the attack 3 trigger)
-- Called the moment the hitbox catches a low-health target.
function UppercutFinisherBegin(targetChar)
	local f = { clone = nil, hitPos = nil }

	-- 1) clone the enemy NOW while he is alive (a corpse can't be reused)
	f.clone = cloneTarget(targetChar)
	local trp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
	f.hitPos = trp and trp.Position

	-- 2) mini Attack 4 startup effect on our LEFT hand for UPPERCUT_ORB_TIME
	local char = LocalPlayer.Character or Character
	local leftArm = char and char:FindFirstChild("Left Arm")
	task.spawn(function()
		local okA, errA = pcall(armStartup, leftArm, UPPERCUT_ORB_TIME)
		if not okA then warn("[Uppercut] startup effect failed: " .. tostring(errA)) end
	end)

	-- 3) at the mark: mini Attack 4 breach where the enemy is
	task.delay(UPPERCUT_ORB_TIME, function()
		local p = (trp and trp.Parent) and trp.Position or f.hitPos
		if not p then
			local r = char and char:FindFirstChild("HumanoidRootPart")
			if r then p = (r.CFrame * CFrame.new(0, 0, -4)).Position end
		end
		if p then
			local okB, errB = pcall(UppercutBlueImpact, p)
			if not okB then warn("[Uppercut] impact effect failed: " .. tostring(errB)) end
		end
	end)
	return f
end

-- Called when the uppercut animation has ended: second animation + the cutscene (blocks until done).
function UppercutFinisherRun(f)
	local a2 = Instance.new("Animation")
	a2.AnimationId = UPPERCUT_ANIM2_ID
	local okA, a2Track = pcall(function() return Animator:LoadAnimation(a2) end)
	if okA and a2Track then
		a2Track:Play(0)
		a2Track.TimePosition = UPPERCUT_ANIM2_START
		task.delay(UPPERCUT_ANIM2_LENGTH, function()
			pcall(function() a2Track:Stop(0.2) end)
		end)
	end
	PlayUppercutCutscene(f)
end
end -- do (uppercut finisher)
