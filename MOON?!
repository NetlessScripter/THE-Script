	local T0 = o.t0
	fx.once(T0, function() fx.burst(WHITE, HOT[2], cnt(16), 1.3, 0.008, 1) end)
	fx.once(T0 + 0.5, function() fx.burst(HOT[2], HOT[3], cnt(14), 1.5, 0.007, 1) end)
