local function fallbackBall(name, color, material)
	local model = Instance.new("Model")
	model.Name = name
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.one * 1000
	part.Color = color
	part.Material = material
	part.Anchored = true
	part.CanCollide, part.CanTouch, part.CanQuery, part.CastShadow = false, false, false, false
	part.Parent = model
	return model
end

local function fitDiameter(model, targetDiameter)
	local _, boundingSize = model:GetBoundingBox()
	local currentDiameter = math.max(boundingSize.X, boundingSize.Y, boundingSize.Z)
	if currentDiameter <= 0 then return end
	pcall(function() model:ScaleTo(model:GetScale() * targetDiameter / currentDiameter) end)
end

local function centerModelAt(model, position)
	local boundingCFrame = model:GetBoundingBox()
	model:PivotTo(model:GetPivot() + (position - boundingCFrame.Position))
end

local function createPlanet(templateKey, fallbackName, fallbackColor, fallbackMaterial, visualDiameter, visualToBoundsRatio, centerPosition, parent)
	local planetModel
	local usedFallback = false
	local template = planetTemplates[templateKey]
	if template then
		planetModel = template:Clone()
	else
		planetModel = fallbackBall(fallbackName, fallbackColor, fallbackMaterial)
		usedFallback = true
	end
	planetModel.Parent = parent
	local boundsDiameter = usedFallback and visualDiameter or math.min(visualDiameter / visualToBoundsRatio, 2000)
	fitDiameter(planetModel, boundsDiameter)
	centerModelAt(planetModel, centerPosition)
	return planetModel, usedFallback
end

local playing = false

local function play(enemyClone, onDone)
	if playing then
		if enemyClone then enemyClone:Destroy() end
		if onDone then onDone() end
		return
	end
	playing = true

	local waitStart = os.clock()
	while pendingPlanetLoads > 0 and os.clock() - waitStart < 8 do
		task.wait()
	end

	local camera = Workspace.CurrentCamera
	local random = Random.new(2718)
	local stage = Instance.new("Folder")
	stage.Name = "UppercutFinisherStage"
	stage.Parent = Workspace

	local ORIGIN = UPPERCUT_STAGE_ORIGIN
	local EARTH_DISTANCE, EARTH_RADIUS = 1300, 470
	local MOON_RADIUS, MOON_DISTANCE = 480, 1900
	local PASS_OFFSET = vec3(70, 28, 0)
	local ENEMY_SCALE = 26

	local earthCenter = ORIGIN + vec3(0, 0, -EARTH_DISTANCE)
	local earthNormal = vec3(0.12, 0.065, 0.99).Unit
	local launchPoint = earthCenter + earthNormal * (EARTH_RADIUS - 24)
	local earthSurfacePoint = earthCenter + earthNormal * EARTH_RADIUS
	local passPoint = ORIGIN + PASS_OFFSET
	local launchVector = passPoint - launchPoint
	local launchDistance = launchVector.Magnitude
	local flightDirection = launchVector.Unit
	local towardCamera = -flightDirection
	local moonCenter = passPoint + flightDirection * MOON_DISTANCE
	local impactPoint = moonCenter - flightDirection * (MOON_RADIUS * 0.97)
	local impactDistance = (impactPoint - passPoint).Magnitude

	local LAUNCH_SPEED, LAUNCH_ACCELERATION, IMPACT_SPEED = 320, 2100, 1500
	local accelerationTime = (-LAUNCH_SPEED + math.sqrt(LAUNCH_SPEED * LAUNCH_SPEED + 2 * LAUNCH_ACCELERATION * launchDistance)) / LAUNCH_ACCELERATION
	local passSpeed = LAUNCH_SPEED + LAUNCH_ACCELERATION * accelerationTime
	local decelerationTime = 2 * impactDistance / (passSpeed + IMPACT_SPEED)
	local deceleration = (passSpeed - IMPACT_SPEED) / decelerationTime

	local T_CHARGE = 0.2
	local T_LAUNCH = 1.25
	local T_PASS = T_LAUNCH + accelerationTime
	local T_WHIP = T_PASS + 0.03
	local WHIP_DURATION = 0.28
	local T_CHASE_START = T_WHIP + WHIP_DURATION
	local T_HIT = T_PASS + decelerationTime
	local T_BOOM = T_HIT + 1.05
	local T_END = T_BOOM + 4.4

	local function enemyDistance(time)
		if time <= T_LAUNCH then return 0 end
		local sinceLaunch = time - T_LAUNCH
		if time <= T_PASS then
			return LAUNCH_SPEED * sinceLaunch + 0.5 * LAUNCH_ACCELERATION * sinceLaunch * sinceLaunch
		end
		local sincePass = math.min(time - T_PASS, decelerationTime)
		return launchDistance + passSpeed * sincePass - 0.5 * deceleration * sincePass * sincePass
	end

	local sceneBuilt, sceneResult = pcall(function()
		local builtScene = {}
		builtScene.starfield = buildStarfield(stage, ORIGIN, camera.ViewportSize.Y)
		builtScene.earthModel = createPlanet("earth", "UppercutEarth", rgb(40, 100, 200), Enum.Material.SmoothPlastic, 2 * EARTH_RADIUS, UPPERCUT_EARTH_VISUAL_TO_BOUNDS_RATIO, earthCenter, stage)
		builtScene.moonModel = createPlanet("moon", "UppercutMoon", rgb(170, 168, 160), Enum.Material.Slate, 2 * MOON_RADIUS, UPPERCUT_MOON_VISUAL_TO_BOUNDS_RATIO, moonCenter, stage)
		local rimHighlight = Instance.new("Highlight")
		rimHighlight.Adornee = builtScene.earthModel
		rimHighlight.DepthMode = Enum.HighlightDepthMode.Occluded
		rimHighlight.FillColor = BLUE[2]
		rimHighlight.OutlineColor = BLUE[2]
		rimHighlight.FillTransparency = 1
		rimHighlight.OutlineTransparency = 1
		rimHighlight.Parent = stage
		builtScene.earthRim = rimHighlight
		builtScene.screenLayer = buildScreenLayer(localPlayer:WaitForChild("PlayerGui"))
		if enemyClone then
			pcall(function() enemyClone:ScaleTo(ENEMY_SCALE) end)
		end
		return builtScene
	end)
	if not sceneBuilt then
		warn("[UppercutFinisher] could not build the scene:", sceneResult)
		pcall(function() stage:Destroy() end)
		if enemyClone then pcall(function() enemyClone:Destroy() end) end
		playing = false
		if onDone then pcall(onDone) end
		return
	end
	local starfield = sceneResult.starfield
	local earthModel = sceneResult.earthModel
	local moonModel = sceneResult.moonModel
	local earthRim = sceneResult.earthRim
	local screenLayer = sceneResult.screenLayer
	local earthBasePivot = earthModel:GetPivot()
	local moonBasePivot = moonModel:GetPivot()

	local previousCameraType, previousFieldOfView = camera.CameraType, camera.FieldOfView
	local lightingPropertyNames = { "ClockTime", "Brightness", "Ambient", "OutdoorAmbient", "FogEnd", "FogStart", "ExposureCompensation", "EnvironmentDiffuseScale", "EnvironmentSpecularScale" }
	local savedLighting = {}
	for _, propertyName in ipairs(lightingPropertyNames) do
		local readSucceeded, value = pcall(function() return Lighting[propertyName] end)
		if readSucceeded then savedLighting[propertyName] = value end
	end

	local removedLightingChildren, disabledPostEffects = {}, {}
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("Sky") or child:IsA("Atmosphere") then
			removedLightingChildren[#removedLightingChildren + 1] = child
			child.Parent = nil
		elseif child:IsA("PostEffect") and child.Enabled then
			disabledPostEffects[#disabledPostEffects + 1] = child
			child.Enabled = false
		end
