-- a COPY of the Attack 4 earth (the model Attack 4 uses is never touched)
local function getEarthModel(parent)
	local src = workspace:FindFirstChild("PlanetExplosionEarth") or TEMPLATES.earth or loadTemplate("earth", UPPERCUT_EARTH_ASSET_ID)
	if not src then return nil end
	local m = src:Clone()
	m.Name = "UppercutEarth"
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide, d.CanTouch, d.CanQuery, d.CastShadow = false, false, false, false
		end
	end
	m.Parent = parent
	return m
end

local function getMoonModel(parent)
	local src = TEMPLATES.moon or loadTemplate("moon", UPPERCUT_MOON_ASSET_ID)
	if not src then return nil end
	local m = src:Clone()
	m.Name = "UppercutMoon"
	m.Parent = parent
	return m
end

local function fitBounds(model, targetBounds)  -- scales so the model's bounding box is targetBounds studs (same as the planet script)
	local _, size = model:GetBoundingBox()
	local cur = math.max(size.X, size.Y, size.Z)
	if cur <= 0 then return end
	pcall(function() model:ScaleTo(model:GetScale() * targetBounds / cur) end)
end

local function centerModel(model, pos)
	local bb = model:GetBoundingBox()
	model:PivotTo(model:GetPivot() + (pos - bb.Position))
end

local function fallbackSphere(color, diameter, pos, parent)
	local model = Instance.new("Model")
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Anchored = true
	p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = false, false, false, false
	p.Material = Enum.Material.SmoothPlastic
	p.Color = color
	p.Size = Vector3.one * math.min(diameter, 2040)
	p.CFrame = CFrame.new(pos)
	p.Parent = model
	model.PrimaryPart = p
	model.Parent = parent
	return model
end

-- black wall of 2048 tiles (recolourable, like the planet script's backdrop) + tiny twinkling stars in front of it
local function buildWall(parent, O, axis, sign, dist, halfW, halfHt, starCount, pxStud)
	local T = 2048
	local cols = math.max(1, math.ceil(2 * halfW / T))
	local rows = math.max(1, math.ceil(2 * halfHt / T))
	local wall = { tiles = {}, stars = {} }
	local function put(p, a, b, depth)
		if axis == "Z" then
			p.Position = O + Vector3.new(a, b, sign * depth)
		else
			p.Position = O + Vector3.new(sign * depth, b, a)
		end
	end
	local function part(shape)
		local p = Instance.new("Part")
		p.Shape = shape or Enum.PartType.Block
		p.Material = Enum.Material.Neon
		p.Anchored = true
		p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = false, false, false, false
		p.Parent = parent
		return p
	end
	for i = 1, cols do
		for j = 1, rows do
			local p = part()
			p.Size = (axis == "Z") and Vector3.new(T, T, 2) or Vector3.new(2, T, T)
			p.Color = Color3.new(0, 0, 0)
			put(p, (i - (cols + 1) / 2) * T, (j - (rows + 1) / 2) * T, dist)
			wall.tiles[#wall.tiles + 1] = p
		end
	end
	if starCount and starCount > 0 then
		local starColors = { rgb(255, 255, 255), rgb(255, 255, 255), rgb(200, 225, 255), rgb(160, 200, 255), rgb(255, 238, 215) }
		local sr = Random.new(2024)
		for _ = 1, starCount do
			local p = part(Enum.PartType.Ball)
			p.Size = Vector3.one * pxStud * sr:NextNumber(1, 2.6)
			p.Color = starColors[sr:NextInteger(1, #starColors)]
			p.Transparency = 1
			put(p, (sr:NextNumber() - 0.5) * cols * T, (sr:NextNumber() - 0.5) * rows * T, dist - 3)
			wall.stars[#wall.stars + 1] = { part = p, base = sr:NextNumber(0.45, 1), speed = sr:NextNumber(0.8, 3), phase = sr:NextNumber(0, TAU) }
		end
	end
	return wall
end

-- ================================================================ hide the HUD / controls for the cutscene
local function hideUI(myGui)
	local st = { hidden = {}, chat = {}, core = {}, conn = nil, controls = nil }
	local KEEP = { UppercutCutsceneGui = true, UppercutEndFade = true, UppercutImpactGui = true }
	for _, t in ipairs(Enum.CoreGuiType:GetEnumItems()) do
		if t ~= Enum.CoreGuiType.All then
			local okS, on = pcall(function() return StarterGui:GetCoreGuiEnabled(t) end)
			if okS then st.core[t] = on end
		end
	end
	local containers = { LocalPlayer:WaitForChild("PlayerGui") }
	pcall(function() table.insert(containers, game:GetService("CoreGui")) end)
	pcall(function()
		if gethui then
			local h = gethui()
			if h and not table.find(containers, h) then table.insert(containers, h) end
		end
	end)
	local function sweep()
		for _, c in ipairs(containers) do
			for _, g in ipairs(c:GetChildren()) do
				if g:IsA("ScreenGui") and g ~= myGui and not KEEP[g.Name] and g.Enabled then
					st.hidden[#st.hidden + 1] = g
					g.Enabled = false
				end
			end
		end
	end
	local function chatSweep()
		pcall(function()
			for _, cls in ipairs({ "ChatWindowConfiguration", "ChatInputBarConfiguration" }) do
				local cfg = game:GetService("TextChatService"):FindFirstChildOfClass(cls)
				if cfg then
					if st.chat[cfg] == nil then st.chat[cfg] = cfg.Enabled end
					cfg.Enabled = false
				end
			end
		end)
	end
	pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false) end)
	pcall(function() StarterGui:SetCore("TopbarEnabled", false) end)
	sweep()
	chatSweep()
	local last = os.clock()
	st.conn = RunService.RenderStepped:Connect(function()
		sweep()
		if os.clock() - last > 0.25 then
			last = os.clock()
			pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false) end)
			pcall(function() StarterGui:SetCore("TopbarEnabled", false) end)
			chatSweep()
		end
	end)
	pcall(function()
		st.controls = require(LocalPlayer.PlayerScripts:WaitForChild("PlayerModule", 2)):GetControls()
		st.controls:Disable()
	end)
	return function()
		if st.conn then st.conn:Disconnect() end
		for _, g in ipairs(st.hidden) do
			if g.Parent then pcall(function() g.Enabled = true end) end
		end
		for cfg, was in pairs(st.chat) do
			if cfg.Parent then pcall(function() cfg.Enabled = was end) end
		end
		pcall(function() StarterGui:SetCore("TopbarEnabled", true) end)
		if st.controls then pcall(function() st.controls:Enable() end) end
		for t, was in pairs(st.core) do
			pcall(function() StarterGui:SetCoreGuiEnabled(t, was) end)
		end
	end
end

