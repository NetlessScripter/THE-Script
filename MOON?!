local function cloneEnemy(target)
	if not target then return nil end
	local restoreList = {}
	local function makeArchivable(object)
		if not object.Archivable then
			restoreList[#restoreList + 1] = object
			object.Archivable = true
		end
	end
	makeArchivable(target)
	for _, descendant in ipairs(target:GetDescendants()) do
		makeArchivable(descendant)
	end
	local cloneSucceeded, clone = pcall(function() return target:Clone() end)
	for _, object in ipairs(restoreList) do
		pcall(function() object.Archivable = false end)
	end
	if not cloneSucceeded or not clone then return nil end
	clone.Name = "UppercutFinisherEnemy"
	for _, descendant in ipairs(clone:GetDescendants()) do
		if descendant:IsA("BaseScript") or descendant:IsA("Sound") or descendant:IsA("BillboardGui") or descendant:IsA("ForceField") or descendant:IsA("Highlight") then
			descendant:Destroy()
		elseif descendant:IsA("BasePart") then
			descendant.CanCollide, descendant.CanTouch, descendant.CanQuery = false, false, false
			descendant.Anchored = false
		end
	end
	local humanoid = clone:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		humanoid.BreakJointsOnDeath = false
		humanoid.RequiresNeck = false
		humanoid.MaxHealth = 100
		humanoid.Health = 100
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
		humanoid.PlatformStand = true
	end
	local rootPart = clone:FindFirstChild("HumanoidRootPart")
	if rootPart then rootPart.Anchored = true end
	return clone
end

local planetTemplates = { earth = nil, moon = nil }
local pendingPlanetLoads = 2

local function buildTemplateModel(loadedObjects, modelName)
	local model = Instance.new("Model")
	model.Name = modelName
	for _, loadedObject in ipairs(loadedObjects) do
		loadedObject.Parent = model
	end
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BaseScript") or descendant:IsA("Sound") or descendant:IsA("PointLight") or descendant:IsA("SpotLight") or descendant:IsA("SurfaceLight") then
			descendant:Destroy()
		end
	end
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide, descendant.CanTouch, descendant.CanQuery, descendant.CastShadow = false, false, false, false
		end
	end
	return model
end

local function loadModelAsset(assetId, modelName)
	for attempt = 1, 4 do
		local loadSucceeded, loadedObjects = pcall(function()
			return game:GetObjects("rbxassetid://" .. tostring(assetId))
		end)
		if loadSucceeded and type(loadedObjects) == "table" and #loadedObjects > 0 then
			return buildTemplateModel(loadedObjects, modelName)
		end
		warn("[UppercutFinisher] attempt " .. attempt .. " could not load " .. modelName .. " (" .. tostring(assetId) .. "): " .. tostring(loadedObjects))
		task.wait(0.5 * attempt)
	end
	return nil
end

local function preloadPlanet(templateKey, assetId, modelName)
	task.spawn(function()
		planetTemplates[templateKey] = loadModelAsset(assetId, modelName)
		pendingPlanetLoads -= 1
	end)
end

