local function convergingEnergy(parent, targetPosition, options)
	local random = Random.new(options.seed or 5)
	local bits = {}
	for index = 1, options.count do
		local direction = random:NextUnitVector()
		if direction:Dot(options.hemisphere) < 0 then direction = -direction end
		local bitSize = random:NextNumber(3, 7)
		local bit = makePart(parent, Enum.PartType.Ball, Enum.Material.Neon, options.colors[random:NextInteger(1, #options.colors)], Vector3.one * bitSize, CFrame.new(targetPosition + direction * options.radius), 1)
		local attachmentA, attachmentB = Instance.new("Attachment"), Instance.new("Attachment")
		attachmentA.Position, attachmentB.Position = vec3(bitSize * 0.9, 0, 0), vec3(-bitSize * 0.9, 0, 0)
		attachmentA.Parent, attachmentB.Parent = bit, bit
		local trail = Instance.new("Trail")
		trail.Attachment0, trail.Attachment1 = attachmentA, attachmentB
		trail.Lifetime = 0.35
		trail.MinLength = 0.1
		trail.FaceCamera = true
		trail.LightEmission = 1
		trail.LightInfluence = 0
		trail.Enabled = false
		trail.Color = ColorSequence.new({ colorKeypoint(0, WHITE), colorKeypoint(0.4, BLUE[2]), colorKeypoint(1, BLUE[3]) })
		trail.Transparency = NumberSequence.new({ numberKeypoint(0, 0.05), numberKeypoint(1, 1) })
		trail.WidthScale = NumberSequence.new({ numberKeypoint(0, 1), numberKeypoint(1, 0) })
		trail.Parent = bit
		bits[index] = {
			part = bit,
			trail = trail,
			direction = direction,
			startRadius = options.radius * random:NextNumber(0.55, 1.1),
			bornTime = random:NextNumber(0, options.window),
			life = random:NextNumber(0.45, 0.8),
			swirl = random:NextNumber(1.2, 2.6) * (random:NextNumber() < 0.5 and 1 or -1),
		}
	end
	local elapsed = 0
	addEffect(function(deltaTime)
		elapsed += deltaTime
		local allDone = true
		for _, bitState in ipairs(bits) do
			if bitState.part.Parent then
				local progress = (elapsed - bitState.bornTime) / bitState.life
				if progress < 1 then
					allDone = false
				end
				if progress >= 0 and progress < 1 then
					bitState.trail.Enabled = true
					bitState.part.Transparency = 0
					local swirledDirection = CFrame.fromAxisAngle(options.axis, bitState.swirl * progress):VectorToWorldSpace(bitState.direction)
					local distance = math.max(bitState.startRadius * (1 - progress) ^ 1.8, 0.5)
					bitState.part.CFrame = CFrame.lookAt(targetPosition + swirledDirection * distance, targetPosition)
				elseif progress >= 1 then
					bitState.part:Destroy()
				end
			end
		end
		return allDone
	end)
end

local function buildCrackNetwork(parent, center, radius, originDirection, settings)
	local random = Random.new(settings.seed or 11)
	local crackFolder = Instance.new("Folder")
	crackFolder.Name = "SurfaceCracks"
	crackFolder.Parent = parent
	local segments = {}
	local surfaceRadius = radius * (settings.surfaceOffset or 1.006)
	local segmentLimit = settings.segmentLimit or 420
	local stepAngle = settings.stepAngle or 0.05

	local helperAxis = math.abs(originDirection.Y) > 0.95 and vec3(1, 0, 0) or vec3(0, 1, 0)
	local tangentA = originDirection:Cross(helperAxis).Unit
	local tangentB = originDirection:Cross(tangentA).Unit

	local function spawnSegment(fromDirection, toDirection, travelledAngle, width, depth)
		if #segments >= segmentLimit then return end
		local fromPosition = center + fromDirection * surfaceRadius
		local toPosition = center + toDirection * surfaceRadius
		local segmentLength = (toPosition - fromPosition).Magnitude
		if segmentLength < 0.01 then return end
		local middlePosition = (fromPosition + toPosition) / 2
		local orientation = CFrame.lookAt(middlePosition, toPosition)
		local travelFraction = math.clamp(travelledAngle / settings.maxAngle, 0, 1)
		local segmentColor = settings.hotColor:Lerp(settings.coolColor, travelFraction ^ 0.8)
		local corePart = makePart(crackFolder, Enum.PartType.Block, Enum.Material.Neon, segmentColor, vec3(width, width, segmentLength * 1.18), orientation, 1)
		local haloPart = nil
		if depth == 0 then
			haloPart = makePart(crackFolder, Enum.PartType.Block, Enum.Material.Neon, settings.haloColor, vec3(width * 2.8, width * 2.8, segmentLength * 1.2), orientation, 1)
		end
		segments[#segments + 1] = {
			core = corePart,
			halo = haloPart,
			bornTime = settings.delay + travelledAngle / settings.spreadSpeed,
			phase = random:NextNumber(0, TAU),
		}
	end

	local function growCrack(startDirection, startHeading, stepCount, width, startAngle, depth)
		local direction, heading = startDirection, startHeading
		local travelled = startAngle
		for stepIndex = 1, stepCount do
			local cosine, sine = math.cos(stepAngle), math.sin(stepAngle)
			local nextDirection = (direction * cosine + heading * sine).Unit
			local nextHeading = -direction * sine + heading * cosine
			nextHeading = (nextHeading - nextDirection * nextHeading:Dot(nextDirection)).Unit
			nextHeading = CFrame.fromAxisAngle(nextDirection, random:NextNumber(-settings.jitter, settings.jitter)):VectorToWorldSpace(nextHeading)
			local taper = 1 - 0.55 * (stepIndex / stepCount)
			spawnSegment(direction, nextDirection, travelled, width * taper, depth)
			travelled += stepAngle
			if depth < 2 and stepIndex > 2 and stepIndex < stepCount - 2 and random:NextNumber() < settings.branchChance then
				local branchSide = random:NextNumber() < 0.5 and -1 or 1
				local branchHeading = CFrame.fromAxisAngle(nextDirection, branchSide * random:NextNumber(0.5, 1.1)):VectorToWorldSpace(nextHeading)
				growCrack(nextDirection, branchHeading, math.floor(stepCount * random:NextNumber(0.3, 0.55)), width * 0.6, travelled, depth + 1)
			end
			direction, heading = nextDirection, nextHeading
		end
	end

	for crackIndex = 1, settings.mainCount do
		local angle = (crackIndex - 1) / settings.mainCount * TAU + random:NextNumber(-0.3, 0.3)
		local heading = tangentA * math.cos(angle) + tangentB * math.sin(angle)
		growCrack(originDirection, heading, math.floor(settings.maxAngle / stepAngle * random:NextNumber(0.7, 1)), settings.width, 0, 0)
	end

	local elapsed = 0
	local destroyed = false
	addEffect(function(deltaTime)
		if destroyed then return true end
		elapsed += deltaTime
		local fadeProgress = math.clamp((elapsed - settings.fadeStart) / settings.fadeTime, 0, 1)
		for _, segment in ipairs(segments) do
			local age = elapsed - segment.bornTime
			if age >= 0 then
				local popIn = math.clamp(age / 0.05, 0, 1)
				local flicker = 0.82 + 0.18 * math.sin(elapsed * 38 + segment.phase)
				local brightness = popIn * flicker * (1 - fadeProgress)
				segment.core.Transparency = 1 - brightness
				if segment.halo then
					segment.halo.Transparency = 1 - brightness * 0.55
				end
			end
		end
		if fadeProgress >= 1 then
			crackFolder:Destroy()
			destroyed = true
			return true
		end
		return false
	end)

	return function()
		if not destroyed then
			destroyed = true
			crackFolder:Destroy()
		end
	end
end

local function spawnRockChunks(parent, random, origin, count, options)
	local smokeBudget = options.smokeBudget or 0
	for chunkIndex = 1, count do
		local direction
		if options.axis then
			direction = randomDirectionInCone(random, options.axis, options.coneAngle)
		else
			direction = random:NextUnitVector()
		end
		local bigness = random:NextNumber() ^ options.bigPower
		local chunkSize = lerp(options.sizeMin, options.sizeMax, bigness)
		local startPosition = origin + direction * (options.scatterRadius * random:NextNumber(0.05, 1))
		local chunk = makePart(parent, Enum.PartType.Block, Enum.Material.Neon, FIRE[random:NextInteger(1, 3)],
			vec3(chunkSize * random:NextNumber(0.6, 1.4), chunkSize * random:NextNumber(0.6, 1.2), chunkSize * random:NextNumber(0.6, 1.4)),
			CFrame.new(startPosition) * CFrame.Angles(random:NextNumber(0, TAU), random:NextNumber(0, TAU), random:NextNumber(0, TAU)), 0)

		local trailAttachmentA, trailAttachmentB = Instance.new("Attachment"), Instance.new("Attachment")
		trailAttachmentA.Position, trailAttachmentB.Position = vec3(0, chunkSize * 0.5, 0), vec3(0, -chunkSize * 0.5, 0)
		trailAttachmentA.Parent, trailAttachmentB.Parent = chunk, chunk
		local trail = Instance.new("Trail")
		trail.Attachment0, trail.Attachment1 = trailAttachmentA, trailAttachmentB
		trail.Lifetime = random:NextNumber(0.5, 1.0)
		trail.LightEmission = 1
		trail.LightInfluence = 0
		trail.FaceCamera = true
		trail.Color = ColorSequence.new({ colorKeypoint(0, FIRE[2]), colorKeypoint(0.4, FIRE[3]), colorKeypoint(1, FIRE[5]) })
		trail.Transparency = NumberSequence.new({ numberKeypoint(0, 0.2), numberKeypoint(1, 1) })
		trail.WidthScale = NumberSequence.new({ numberKeypoint(0, 1), numberKeypoint(1, 0) })
		trail.Parent = chunk

		if bigness > 0.65 and smokeBudget > 0 then
			smokeBudget -= 1
			local smoke = Instance.new("ParticleEmitter")
			smoke.Texture = SOFT_GLOW
			smoke.Color = ColorSequence.new({ colorKeypoint(0, rgb(120, 85, 60)), colorKeypoint(1, rgb(30, 28, 28)) })
			smoke.Size = NumberSequence.new({ numberKeypoint(0, chunkSize * 0.8), numberKeypoint(1, chunkSize * 2.4) })
			smoke.Transparency = NumberSequence.new({ numberKeypoint(0, 0.45), numberKeypoint(1, 1) })
			smoke.Lifetime = NumberRange.new(1.0, 1.8)
			smoke.Rate = 22
			smoke.Speed = NumberRange.new(0, 12)
			smoke.LightEmission = 0.2
			smoke.LightInfluence = 0
			smoke.LockedToPart = false
			smoke.Parent = chunk
		end

		local speed = lerp(options.speedMax, options.speedMin, bigness) * random:NextNumber(0.55, 1.1)
		local velocity = direction * speed
		local spin = vec3(random:NextNumber(-3, 3), random:NextNumber(-3, 3), random:NextNumber(-3, 3))
		local life = random:NextNumber(options.lifeMin, options.lifeMax)
		local hotColor = chunk.Color
		local coolColor = rgb(random:NextInteger(70, 105), random:NextInteger(62, 92), random:NextInteger(55, 80))
		local elapsed = 0
		local cooled = false
		addEffect(function(deltaTime)
			elapsed += deltaTime
			velocity = velocity * (1 - 0.32 * deltaTime)
			chunk.CFrame = (chunk.CFrame + velocity * deltaTime) * CFrame.Angles(spin.X * deltaTime, spin.Y * deltaTime, spin.Z * deltaTime)
			local coolAmount = smoothstep((elapsed - 0.1) / 0.8)
			chunk.Color = hotColor:Lerp(rgb(255, 120, 40), math.min(coolAmount * 2, 1)):Lerp(coolColor, math.max(coolAmount * 2 - 1, 0))
			if coolAmount > 0.6 and not cooled then
				cooled = true
				chunk.Material = Enum.Material.Slate
			end
			chunk.Transparency = math.clamp((elapsed - (life - 0.8)) / 0.8, 0, 1)
			if elapsed >= life then
				chunk:Destroy()
				return true
			end
			return false
		end)
	end
end

local function buildStarfield(parent, origin, viewportHeight)
	local starRandom = Random.new(2024)
	local starRadius = 9000
	local studsPerPixel = 2 * starRadius * math.tan(math.rad(35)) / math.max(viewportHeight, 1)
	local stars = {}
	for index = 1, 760 do
		local direction = starRandom:NextUnitVector()
		local starPart = makePart(parent, Enum.PartType.Ball, Enum.Material.Neon, STAR_COLORS[starRandom:NextInteger(1, #STAR_COLORS)],
			Vector3.one * studsPerPixel * starRandom:NextNumber(1, 2.6), CFrame.new(origin + direction * starRadius), 1)
		stars[index] = {
			part = starPart,
			base = starRandom:NextNumber(0.45, 1),
			speed = starRandom:NextNumber(0.8, 3),
			phase = starRandom:NextNumber(0, TAU),
		}
	end
	return stars
end

local function buildScreenLayer(playerGui)
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "UppercutFinisherFade"
	screenGui.IgnoreGuiInset = true
	screenGui.ScreenInsets = Enum.ScreenInsets.None
	screenGui.ResetOnSpawn = false
	screenGui.DisplayOrder = 5000

	local layer = { gui = screenGui }

	local function solidFrame(color, zIndex)
		local frame = Instance.new("Frame")
		frame.Size = UDim2.fromScale(1, 1)
		frame.BackgroundColor3 = color
		frame.BackgroundTransparency = 1
		frame.BorderSizePixel = 0
		frame.ZIndex = zIndex
		frame.Parent = screenGui
		return frame
	end

	local function vignetteEdge(position, size, rotation, reversed)
		local frame = Instance.new("Frame")
		frame.Position = position
		frame.Size = size
		frame.BackgroundColor3 = BLACK
		frame.BackgroundTransparency = 1
		frame.BorderSizePixel = 0
		frame.ZIndex = 1
		local gradient = Instance.new("UIGradient")
		gradient.Rotation = rotation
		if reversed then
			gradient.Transparency = NumberSequence.new({ numberKeypoint(0, 1), numberKeypoint(1, 0) })
		else
			gradient.Transparency = NumberSequence.new({ numberKeypoint(0, 0), numberKeypoint(1, 1) })
		end
		gradient.Parent = frame
		frame.Parent = screenGui
		return frame
	end

	local vignetteEdges = {
		vignetteEdge(UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.3), 90, false),
		vignetteEdge(UDim2.fromScale(0, 0.7), UDim2.fromScale(1, 0.3), 90, true),
		vignetteEdge(UDim2.fromScale(0, 0), UDim2.fromScale(0.22, 1), 0, false),
		vignetteEdge(UDim2.fromScale(0.78, 0), UDim2.fromScale(0.22, 1), 0, true),
	}

	function layer.setVignette(amount)
		local transparency = 1 - math.clamp(amount, 0, 1)
		for _, edge in ipairs(vignetteEdges) do
			edge.BackgroundTransparency = transparency
		end
	end

	local lineRandom = Random.new(404)
	local speedLines = {}
	local speedLineCount = 60
	for index = 1, speedLineCount do
		local frame = Instance.new("Frame")
		frame.AnchorPoint = Vector2.new(0, 0.5)
		frame.Position = UDim2.fromScale(0.5, 0.5)
		frame.BackgroundColor3 = WHITE
		frame.BackgroundTransparency = 1
		frame.BorderSizePixel = 0
		frame.Rotation = (index - 1) / speedLineCount * 360 + lineRandom:NextNumber(-2.5, 2.5)
		frame.ZIndex = 2
		local gradient = Instance.new("UIGradient")
		gradient.Transparency = NumberSequence.new({ numberKeypoint(0, 1), numberKeypoint(1, 0) })
		gradient.Parent = frame
		frame.Parent = screenGui
		speedLines[index] = {
			frame = frame,
			innerFactor = lineRandom:NextNumber(0.7, 1.5),
			lengthFactor = lineRandom:NextNumber(0.5, 1.1),
			thicknessFactor = lineRandom:NextNumber(0.6, 1.6),
			noiseSeed = lineRandom:NextNumber(0, 100),
			noiseSpeed = lineRandom:NextNumber(6, 14),
		}
	end

	function layer.setSpeedLines(amount, clockTime, viewportSize, color)
		if amount <= 0.01 then
			for _, line in ipairs(speedLines) do
				line.frame.BackgroundTransparency = 1
			end
			return
		end
		local shortestSide = math.min(viewportSize.X, viewportSize.Y)
		local diagonal = viewportSize.Magnitude
		for _, line in ipairs(speedLines) do
			local flicker = math.clamp(0.55 + 0.9 * math.noise(clockTime * line.noiseSpeed, line.noiseSeed), 0.1, 1)
			local innerPixels = shortestSide * 0.2 * line.innerFactor
			local lengthPixels = math.max(diagonal * 0.5 * line.lengthFactor * amount * flicker, 2)
			line.frame.AnchorPoint = Vector2.new(-innerPixels / lengthPixels, 0.5)
			line.frame.Size = UDim2.fromOffset(lengthPixels, 1 + 3 * line.thicknessFactor * amount)
			line.frame.BackgroundColor3 = color
			line.frame.BackgroundTransparency = 1 - math.clamp(amount * flicker * 1.1, 0, 0.95)
		end
	end

	local flareGlow = Instance.new("ImageLabel")
	flareGlow.AnchorPoint = Vector2.new(0.5, 0.5)
	flareGlow.BackgroundTransparency = 1
	flareGlow.BorderSizePixel = 0
	flareGlow.Image = SOFT_GLOW
	flareGlow.ImageTransparency = 1
	flareGlow.ZIndex = 3
	flareGlow.Parent = screenGui

	local function flareStreakFrame(isVertical)
		local frame = Instance.new("Frame")
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.BorderSizePixel = 0
		frame.BackgroundColor3 = WHITE
		frame.BackgroundTransparency = 1
		frame.ZIndex = 3
		local gradient = Instance.new("UIGradient")
		gradient.Rotation = isVertical and 90 or 0
		gradient.Transparency = NumberSequence.new({ numberKeypoint(0, 1), numberKeypoint(0.5, 0), numberKeypoint(1, 1) })
		gradient.Parent = frame
		frame.Parent = screenGui
		return frame
	end
	local flareStreakHorizontal = flareStreakFrame(false)
	local flareStreakVertical = flareStreakFrame(true)

	function layer.setFlare(screenPoint, strength, color, viewportSize)
		if not screenPoint or strength <= 0.01 then
			flareGlow.ImageTransparency = 1
			flareStreakHorizontal.BackgroundTransparency = 1
			flareStreakVertical.BackgroundTransparency = 1
			return
		end
		local clampedStrength = math.clamp(strength, 0, 1)
		local position = UDim2.fromOffset(screenPoint.X, screenPoint.Y)
		local glowSize = viewportSize.Y * (0.3 + 1.3 * strength)
		flareGlow.Position = position
		flareGlow.Size = UDim2.fromOffset(glowSize, glowSize)
		flareGlow.ImageColor3 = color
		flareGlow.ImageTransparency = 1 - clampedStrength * 0.85
		local streakColor = color:Lerp(WHITE, 0.5)
		flareStreakHorizontal.Position = position
		flareStreakHorizontal.Size = UDim2.fromOffset(viewportSize.X * (0.25 + 1.5 * strength), 2 + 14 * strength)
		flareStreakHorizontal.BackgroundColor3 = streakColor
		flareStreakHorizontal.BackgroundTransparency = 1 - clampedStrength * 0.9
		flareStreakVertical.Position = position
		flareStreakVertical.Size = UDim2.fromOffset(2 + 8 * strength, viewportSize.Y * (0.1 + 0.5 * strength))
		flareStreakVertical.BackgroundColor3 = streakColor
		flareStreakVertical.BackgroundTransparency = 1 - clampedStrength * 0.7
	end

	function layer.addShockRing(getCenter, startDiameter, endDiameter, life, color, thickness, delay)
		local ring = Instance.new("Frame")
		ring.AnchorPoint = Vector2.new(0.5, 0.5)
		ring.BackgroundTransparency = 1
		ring.BorderSizePixel = 0
		ring.ZIndex = 4
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = ring
		local stroke = Instance.new("UIStroke")
		stroke.Color = color
		stroke.Thickness = thickness
		stroke.Transparency = 1
		stroke.Parent = ring
		ring.Parent = screenGui
		local elapsed = -(delay or 0)
		addEffect(function(deltaTime)
			elapsed += deltaTime
			if elapsed < 0 then return false end
			local alpha = math.min(elapsed / life, 1)
			if alpha >= 1 then
				ring:Destroy()
				return true
			end
			local center = getCenter()
			if center then
				local diameter = lerp(startDiameter, endDiameter, easeOutCubic(alpha))
				ring.Position = UDim2.fromOffset(center.X, center.Y)
				ring.Size = UDim2.fromOffset(diameter, diameter)
				stroke.Transparency = math.clamp(alpha ^ 1.3, 0, 1)
				stroke.Thickness = thickness * (1 - alpha * 0.7)
			else
				stroke.Transparency = 1
			end
			return false
		end)
	end

	layer.white = solidFrame(WHITE, 8)
	layer.black = solidFrame(BLACK, 9)
	screenGui.Parent = playerGui
	return layer
end

