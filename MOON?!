-- =====================================================================================================
--  ATTACK 3 (UPPERCUT) FINISHER   -   built from the same code / look as the Attack 4 planet finisher
--  When the uppercut (anim 12510170988) catches a player / dummy at or below ATTACK3_FINISHER_HEALTH:
--    0.0s  the enemy is CLONED (while still alive) + a mini version of the Attack 4 STARTUP effect on the LEFT hand
--    0.3s  mini version of the Attack 4 BREACH (blue starburst / comets / bolts / flare / impact frame), small
--    end   of the uppercut: anim 13927612951 (from 2.3, for 2.7s) + the cutscene:
--          the Attack 4 earth + space backdrop -> enemy bursts out of the earth -> camera whips round ->
--          he crashes into the moon (422840159) -> the moon detonates
-- =====================================================================================================
ATTACK3_FINISHER_HEALTH = 15
ATTACK3_HITBOX_SIZE     = Vector3.new(8, 7, 8)
ATTACK3_HITBOX_OFFSET   = 3      -- studs in front of us
ATTACK3_HITBOX_DURATION = 0.35   -- seconds (from the start of the move) the hitbox looks for a target
ATTACK3_HITBOX_DEBUG    = false

UPPERCUT_ORB_TIME       = 0.3    -- length of the mini startup effect on the left hand; the mini breach fires when it ends
UPPERCUT_ANIM2_ID       = "rbxassetid://13927612951"
UPPERCUT_ANIM2_START    = 2.3    -- TimePosition it starts at
UPPERCUT_ANIM2_LENGTH   = 2.7    -- seconds it plays before being stopped
UPPERCUT_FALL_ANIM_ID   = "rbxassetid://15280575192"  -- same fall anim the flying system uses
UPPERCUT_EARTH_ASSET_ID = 750680926   -- the Attack 4 earth
UPPERCUT_MOON_ASSET_ID  = 422840159
UPPERCUT_STAGE_ORIGIN   = Vector3.new(-30000, 25000, 30000)  -- empty void, away from the Attack 4 stage
UPPERCUT_ENEMY_SCALE    = 45     -- how big the enemy clone is in the space shot (the planet is huge, he has to be too)
UPPERCUT_TELEPORT       = false  -- true = park us at CUTSCENE_TELEPORT_POS during the cutscene (like the planet finisher)
UPPERCUT_QUALITY        = 1      -- lower (0.5) = fewer trails / beams / particles for weak devices
UPPERCUT_SHAKE          = 1
UPPERCUT_FLARE          = 1      -- lens flare strength (0 = off)
UPPERCUT_FLARE_TILT     = 10

do
local RunService   = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting     = game:GetService("Lighting")
local StarterGui   = game:GetService("StarterGui")

local WHITE = Color3.new(1, 1, 1)
local rgb = Color3.fromRGB
local NSK, CSK = NumberSequenceKeypoint.new, ColorSequenceKeypoint.new
local PI = math.pi
local TAU = PI * 2
local BLUE    = { rgb(70, 150, 255), rgb(90, 230, 255), rgb(30, 80, 255), rgb(180, 205, 255) }
local HOT     = { rgb(255, 120, 30), rgb(255, 220, 60), rgb(255, 60, 150), rgb(255, 255, 255), rgb(190, 70, 255), rgb(255, 150, 40) }
local HOTBOLT = { rgb(255, 230, 120), rgb(255, 140, 50), rgb(255, 255, 255), rgb(255, 90, 140) }
local FIRE    = { rgb(255, 90, 20), rgb(255, 150, 40), rgb(255, 230, 140), rgb(200, 40, 20), rgb(90, 25, 20) }
local ROCK    = { rgb(120, 118, 125), rgb(90, 88, 95), rgb(150, 145, 140), rgb(60, 58, 65) }
local TILT = -0.2

-- ================================================================ helpers (same as the planet script)
local function kf(t, pts)
	if t <= pts[1][1] then return pts[1][2] end
	for i = 2, #pts do
		local p0, p1 = pts[i - 1], pts[i]
		if t <= p1[1] then
			local s = (t - p0[1]) / (p1[1] - p0[1])
			s = s * s * (3 - 2 * s)
			local v0, v1 = p0[2], p1[2]
			if typeof(v0) == "Color3" then return v0:Lerp(v1, s) end
			return v0 + (v1 - v0) * s
		end
	end
	return pts[#pts][2]
end

local function outExpo(a)
	if a >= 1 then return 1 end
	return 1 - 2 ^ (-10 * a)
end

local function outBack(u)  -- fast turn with a small overshoot (action-style whip)
	local c1 = 1.2
	local c3 = c1 + 1
	return 1 + c3 * (u - 1) ^ 3 + c1 * (u - 1) ^ 2
end

local function softCap(x)  -- parts max out at 2048 studs: ease big sizes into the cap
	local knee, cap = 1000, 2040
	if x <= knee then return x end
	return knee + (cap - knee) * (1 - math.exp(-(x - knee) / (cap - knee)))
end

local function guiParent()
	return (gethui and gethui()) or LocalPlayer:WaitForChild("PlayerGui")
end

local function sfx(id, vol, speed)  -- non-positional sound (parented to workspace)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = vol or 1
	if speed then s.PlaybackSpeed = speed end
	s.Parent = workspace
	s:Play()
	game:GetService("Debris"):AddItem(s, 10)
	return s
end

local function newScreenGui(name, order)
	local g = Instance.new("ScreenGui")
	g.Name = name
	g.IgnoreGuiInset = true
	g.ScreenInsets = Enum.ScreenInsets.None
	g.ResetOnSpawn = false
	g.DisplayOrder = order
	g.Parent = guiParent()
	return g
end

-- pure black & white impact frame: a stack of max-contrast desaturated colour corrections (same trick as the planet script)
local function impactFrame(seconds)
	local ccs = {}
	for i = 1, 6 do
		local c = Instance.new("ColorCorrectionEffect")
		c.Saturation = -1
		c.Contrast = 1
		c.Brightness = 0
		c.TintColor = WHITE
		c.Parent = Lighting
		ccs[i] = c
	end
	task.delay(seconds, function()
		for _, c in ipairs(ccs) do c:Destroy() end
	end)
	return os.clock() + seconds
end

-- ================================================================ FX engine (ported 1:1 from PlanetExplosion V3)
-- Effects live in the local XY plane of fx.C (axes = camera axes). Every size is a fraction of S.
local function newFX(C, S, parent)
	local fx = { C = C, S = S, dead = false }
	local rng = Random.new()
	local function rr(a, b) return rng:NextNumber(a, b) end
	local function pick(t) return t[rng:NextInteger(1, #t)] end
	local function cnt(n) return math.max(1, math.floor(n * UPPERCUT_QUALITY)) end
	local function sgn() return (rng:NextNumber() < 0.5) and 1 or -1 end
	fx.rr, fx.pick, fx.cnt, fx.sgn = rr, pick, cnt, sgn

	local root = Instance.new("Folder")
	root.Name = "UppercutFX"
	root.Parent = parent or workspace
	fx.root = root

	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide, anchor.CanQuery, anchor.CanTouch = false, false, false
	anchor.Transparency = 1
	anchor.Size = Vector3.one
	anchor.CFrame = CFrame.new(C.Position)
	anchor.Parent = root

	local tasks = {}
	function fx.at(t0, dur, fn, done)
		tasks[#tasks + 1] = { t0 = t0, dur = dur, fn = fn, done = done }
	end
	function fx.once(t0, fn)
		tasks[#tasks + 1] = { t0 = t0, once = true, fn = fn }
	end
	function fx.update(t)
		if fx.dead then return end
		for i = #tasks, 1, -1 do
			local k = tasks[i]
			if k and t >= k.t0 then
				if k.once then
					table.remove(tasks, i)
					k.fn()
				else
					local a = (t - k.t0) / k.dur
					if a >= 1 then
						table.remove(tasks, i)
						k.fn(1)
						if k.done then k.done() end
					else
						k.fn(a)
					end
				end
			end
		end
	end
	function fx.destroy()
		if fx.dead then return end
		fx.dead = true
		if fx.conn then fx.conn:Disconnect() end
		root:Destroy()
	end

	local function newAtt()
		local a = Instance.new("Attachment")
		a.Parent = anchor
		return a
	end
	local function makeBeam(a0, a1, colorSeq)
		local b = Instance.new("Beam")
		b.Attachment0, b.Attachment1 = a0, a1
		b.FaceCamera = true
		b.LightEmission = 1
		b.LightInfluence = 0
		b.Segments = 1
		b.Color = colorSeq
		b.Width0, b.Width1 = 0, 0
		b.Parent = root
		return b
	end
	local function neonPart(shape)
		local p = Instance.new("Part")
		p.Shape = shape or Enum.PartType.Block
		p.Material = Enum.Material.Neon
		p.Anchored = true
		p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = false, false, false, false
		p.Parent = root
		return p
	end
	local function seqFor(base, tr)
		local t = base + (1 - base) * tr
		return NumberSequence.new({ NSK(0, t), NSK(0.55, t + (1 - t) * 0.4), NSK(1, 1) })
	end

	-- tapered beam streak: white-hot tail -> coloured body -> soft tip (halo layer on thick rays)
	function fx.ray(s)
		local dir = Vector3.new(math.cos(s.ang), math.sin(s.ang), s.z or 0).Unit
		local grow, hold, tm = s.grow or 0.25, s.hold or 0.5, s.tailMove or 0.7
		local useHalo = s.w > 0.009 * S
		local a0, a1, halo, body, core
		fx.at(s.t0, s.life, function(a)
			if not a0 then
				a0, a1 = newAtt(), newAtt()
				if useHalo then halo = makeBeam(a0, a1, ColorSequence.new(s.color)) end
				body = makeBeam(a0, a1, ColorSequence.new({ CSK(0, WHITE), CSK(0.3, s.color), CSK(1, s.color) }))
				core = makeBeam(a0, a1, ColorSequence.new(WHITE))
			end
			local g = outExpo(math.min(a / grow, 1))
			local head = s.r0 + s.len * g
			local tail = s.r0 + s.len * tm * (math.clamp((a - grow) / (1 - grow), 0, 1) ^ 1.5)
			local C0 = fx.C
			a0.WorldPosition = C0 * (dir * tail)
			a1.WorldPosition = C0 * (dir * head)
			local tr = math.max(1 - math.min(a / 0.05, 1), math.clamp((a - hold) / (1 - hold), 0, 1) ^ 1.3)
			local w = s.w * (1 - 0.5 * a)
			if halo then
				halo.Width0, halo.Width1 = w * 5, 0
				halo.Transparency = seqFor(0.82, tr)
			end
			body.Width0, body.Width1 = w * 2, 0
			body.Transparency = seqFor(0.3, tr)
			core.Width0, core.Width1 = w * 0.7, 0
			core.Transparency = seqFor(0, tr)
		end, function()
			if a0 then
				a0:Destroy()
				a1:Destroy()
				body:Destroy()
				core:Destroy()
				if halo then halo:Destroy() end
			end
		end)
	end

	-- tilted ellipse shockwave ring (beam segments)
	function fx.ring(s)
		local N = s.N or cnt(72)
		local cr, sr = math.cos(s.rot or 0), math.sin(s.rot or 0)
		local atts, beams
		fx.at(s.t0, s.life, function(a)
			if not atts then
				atts, beams = {}, {}
				for i = 0, N do atts[i] = newAtt() end
				for i = 1, N do beams[i] = makeBeam(atts[i - 1], atts[i], ColorSequence.new(s.color)) end
			end
			local sc = s.s0 + (s.s1 - s.s0) * outExpo(a)
			local C0 = fx.C
			for i = 0, N do
				local th = TAU * (i / N)
				local x, y = s.rx * sc * math.cos(th), s.ry * sc * math.sin(th)
				atts[i].WorldPosition = C0 * Vector3.new(x * cr - y * sr, x * sr + y * cr, 0)
			end
			local tseq = NumberSequence.new(math.max(1 - math.min(a / 0.05, 1), a ^ 1.4))
			local w = s.w * (1 - 0.75 * a)
			for i = 1, N do
				beams[i].Width0, beams[i].Width1 = w, w
				beams[i].Transparency = tseq
			end
		end, function()
			if atts then
				for i = 1, N do beams[i]:Destroy() end
				for i = 0, N do atts[i]:Destroy() end
			end
		end)
	end

	-- smooth curved streak: a glowing head dragging a Trail along a spiral path
	function fx.comet(s)
		local part, tr
		local inward = s.mode == "in"
		fx.at(s.t0, s.life, function(a)
			if not part then
				part = neonPart(Enum.PartType.Ball)
				part.Size = Vector3.one * math.max(s.w * 1.3, s.minHead or 1)
				part.Color = s.color:Lerp(WHITE, 0.65)
				local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
				a0.Position, a1.Position = Vector3.new(0, s.w / 2, 0), Vector3.new(0, -s.w / 2, 0)
				a0.Parent, a1.Parent = part, part
				tr = Instance.new("Trail")
				tr.Attachment0, tr.Attachment1 = a0, a1
				tr.Lifetime = math.max(s.trail, 0.03)
				tr.LightEmission = 1
				tr.LightInfluence = 0
				tr.FaceCamera = true
				tr.Color = ColorSequence.new({ CSK(0, WHITE), CSK(0.18, s.color), CSK(1, s.color2 or s.color) })
				tr.Transparency = NumberSequence.new({ NSK(0, 0), NSK(0.45, 0.3), NSK(1, 1) })
				tr.WidthScale = NumberSequence.new({ NSK(0, 1), NSK(1, 0) })
				tr.Parent = part
			end
			local e = inward and (a ^ 2.2) or (outExpo(a) ^ 0.9)
			local r = s.r0 + (s.r1 - s.r0) * e
			local th = s.ang + s.swirl * e
			part.CFrame = fx.C * CFrame.new(math.cos(th) * r, math.sin(th) * r, (s.z or 0) * r)
			part.Transparency = math.clamp((a - 0.8) / 0.2, 0, 1)
		end, function()
			if part then
				tr.Enabled = false
				part.Transparency = 1
				task.delay(s.trail + 0.4, function() part:Destroy() end)
			end
		end)
	end

	-- jagged flickering lightning
	function fx.bolt(s)
		local N = s.N or 9
		local dir = Vector3.new(math.cos(s.ang), math.sin(s.ang), 0)
		local nrm = Vector3.new(-math.sin(s.ang), math.cos(s.ang), 0)
		local atts, halos, cores
		local lastTick, jit = -1, {}
		fx.at(s.t0, s.life, function(a)
			if not atts then
				atts, halos, cores = {}, {}, {}
				for i = 0, N do atts[i] = newAtt() end
				for i = 1, N do
					halos[i] = makeBeam(atts[i - 1], atts[i], ColorSequence.new(s.color))
					cores[i] = makeBeam(atts[i - 1], atts[i], ColorSequence.new(WHITE))
				end
			end
			local tk = math.floor(a * s.life * 24)
			if tk ~= lastTick then
				lastTick = tk
				for i = 0, N do jit[i] = rr(-1, 1) end
			end
			local g = outExpo(math.min(a / 0.18, 1))
			local C0 = fx.C
			for i = 0, N do
				local u = i / N
				local off = jit[i] * s.len * (s.jitter or 0.07) * math.sin(PI * u) * g
				atts[i].WorldPosition = C0 * (dir * (s.r0 + s.len * g * u) + nrm * off)
			end
			local fade = math.max(1 - math.min(a / 0.04, 1), math.clamp((a - 0.45) / 0.55, 0, 1))
			if rr(0, 1) < 0.18 then fade = math.min(1, fade + 0.55) end  -- flicker
			local tsq = NumberSequence.new(fade)
			local hsq = NumberSequence.new(0.5 + 0.5 * fade)
			for i = 1, N do
				local wa, wb = s.w * (1 - (i - 1) / N) ^ 0.7, s.w * (1 - i / N) ^ 0.7
				halos[i].Width0, halos[i].Width1 = wa * 3.2, wb * 3.2
				cores[i].Width0, cores[i].Width1 = wa, wb
				halos[i].Transparency = hsq
				cores[i].Transparency = tsq
			end
		end, function()
			if atts then
				for i = 1, N do
					halos[i]:Destroy()
					cores[i]:Destroy()
				end
				for i = 0, N do atts[i]:Destroy() end
			end
		end)
	end

	-- glowing / rocky debris flying out in 3D
	function fx.debris(t0, dir, spd, size, life, spin, color, rock)
		local p
		fx.at(t0, life, function(a)
			if not p then
				p = neonPart()
				p.Color = color
				if rock then p.Material = Enum.Material.Slate end
			end
			local dist = spd * 2.2 * (1 - (1 - a) ^ 2.2)
			local sz = math.max(size * (1 - a ^ 2), 0.06)
			p.Size = Vector3.new(sz, sz * 0.7, sz * 1.2)
			p.CFrame = fx.C * CFrame.new(dir * dist) * CFrame.Angles(spin.X * a, spin.Y * a, spin.Z * a)
			p.Transparency = math.clamp((a - 0.6) / 0.4, 0, 1)
		end, function()
			if p then p:Destroy() end
		end)
	end

	-- core: 12 stacked neon spheres = smooth radial glow. size(t) in studs, alpha(t) 0..1, hot(t) 0 = blue, 1 = fire (t = seconds since t0)
	local NL = 12
	local mult = { 1, 1.2, 1.45, 1.75, 2.1, 2.6, 3.2, 4, 5, 6.3, 8, 10 }
	local ctr  = { 0, 0.18, 0.36, 0.5, 0.62, 0.72, 0.8, 0.86, 0.91, 0.945, 0.97, 0.985 }
	local blueL, hotL = {}, {}
	for i = 1, NL do
		local u = (i - 1) / (NL - 1)
		blueL[i] = WHITE:Lerp(rgb(25, 70, 255), u ^ 0.7)
		if u < 0.35 then
			hotL[i] = WHITE:Lerp(rgb(255, 220, 120), u / 0.35)
		elseif u < 0.7 then
			hotL[i] = rgb(255, 220, 120):Lerp(rgb(255, 80, 140), (u - 0.35) / 0.35)
		else
			hotL[i] = rgb(255, 80, 140):Lerp(rgb(130, 60, 255), (u - 0.7) / 0.3)
		end
	end
	function fx.core(s)
		local layers
		fx.at(s.t0, s.life, function(a)
			if not layers then
				layers = {}
				for i = 1, NL do
					local p = neonPart(Enum.PartType.Ball)
					p.Transparency = 1
					layers[i] = p
				end
			end
			local t = a * s.life
			local d = s.size(t)
			local al = s.alpha and s.alpha(t) or 1
			local hot = s.hot and s.hot(t) or 0
			local pos = CFrame.new(fx.C.Position)
			for i = 1, NL do
				local l = layers[i]
				if d > 0.05 and al > 0.001 then
					l.Size = Vector3.one * softCap(d * mult[i])
					l.CFrame = pos
					l.Transparency = 1 - (1 - ctr[i]) * al
					l.Color = blueL[i]:Lerp(hotL[i], hot)
				else
					l.Transparency = 1
				end
			end
		end, function()
			if layers then
				for i = 1, NL do layers[i]:Destroy() end
			end
		end)
	end

	-- ring of 16 particle emitters that spit sparks outward
	local sparkers
	function fx.burst(c0, c1, count, speed, size, lifeScale)
		if not sparkers then
			sparkers = {}
			for i = 1, 16 do
				local ang = (i / 16) * TAU
				local p = Instance.new("Part")
				p.Anchored = true
				p.CanCollide, p.CanQuery, p.CanTouch = false, false, false
				p.Transparency = 1
				p.Size = Vector3.one
				p.CFrame = fx.C * CFrame.lookAt(Vector3.zero, Vector3.new(math.cos(ang), math.sin(ang), 0))
				p.Parent = root
				local e = Instance.new("ParticleEmitter")
				e.Rate = 0
				e.LightEmission = 1
				e.EmissionDirection = Enum.NormalId.Front
				e.SpreadAngle = Vector2.new(22, 22)
				e.Drag = 0.8
				e.Transparency = NumberSequence.new({ NSK(0, 0), NSK(0.7, 0.2), NSK(1, 1) })
				e.Parent = p
				sparkers[i] = e
			end
		end
		local ls = lifeScale or 1
		for _, e in ipairs(sparkers) do
			e.Lifetime = NumberRange.new(1.4 * ls, 3 * ls)
			e.Color = ColorSequence.new(c0, c1)
			e.Speed = NumberRange.new(S * speed * 0.3, S * speed)
			e.Size = NumberSequence.new({ NSK(0, S * size), NSK(1, 0) })
			e:Emit(count)
		end
	end

	-- cyan dust band (rate driven by the caller)
	function fx.addDust(width)
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide, p.CanQuery, p.CanTouch = false, false, false
		p.Transparency = 1
		p.Size = Vector3.new(math.min(width, 2048), 0.05 * S, 40)
		p.CFrame = fx.C * CFrame.Angles(0, 0, TILT)
		p.Parent = root
		local d = Instance.new("ParticleEmitter")
		d.Shape = Enum.ParticleEmitterShape.Box
		d.Rate = 0
		d.LightEmission = 1
		d.Lifetime = NumberRange.new(2, 3)
		d.Speed = NumberRange.new(0, S * 0.005)
		d.Color = ColorSequence.new(rgb(140, 255, 255), rgb(30, 150, 255))
		d.Size = NumberSequence.new({ NSK(0, 0), NSK(0.2, S * 0.0045), NSK(0.8, S * 0.0035), NSK(1, 0) })
		d.Transparency = NumberSequence.new(0.1)
		d.Parent = p
		return d
	end

	-- drifting embers (rate driven by the caller)
	function fx.addEmbers(w, h)
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide, p.CanQuery, p.CanTouch = false, false, false
		p.Transparency = 1
		p.Size = Vector3.new(math.min(w, 2048), math.min(h, 2048), 40)
		p.CFrame = fx.C
		p.Parent = root
		local e = Instance.new("ParticleEmitter")
		e.Shape = Enum.ParticleEmitterShape.Box
		e.Rate = 0
		e.LightEmission = 1
		e.Lifetime = NumberRange.new(3, 5)
		e.Speed = NumberRange.new(0, S * 0.05)
		e.Acceleration = Vector3.new(0, S * 0.02, 0)
		e.Drag = 0.5
		e.Color = ColorSequence.new(rgb(255, 220, 120), rgb(255, 80, 30))
		e.Size = NumberSequence.new({ NSK(0, 0), NSK(0.15, S * 0.005), NSK(1, 0) })
		e.Transparency = NumberSequence.new({ NSK(0, 0.1), NSK(0.8, 0.3), NSK(1, 1) })
		e.Parent = p
		return e
	end

	return fx
end

-- ================================================================ the Attack 4 effect recipes
-- STARTUP: two lens streaks through the core, tiny rays, energy comets spiralling INTO the core, charge arcs, pulsing core.
-- Same timing fractions as the planet script (which runs 4.7s); d = how long this one runs.
local function startupFX(fx, o)
	local S, rr, pick, cnt, sgn = fx.S, fx.rr, fx.pick, fx.cnt, fx.sgn
	local d, t0, sc = o.d, o.t0 or 0, o.scale or 1
	local mh = o.minHead
	for _, off in ipairs({ 0, PI }) do
		fx.ray({ t0 = t0 + 0.106 * d, life = 0.894 * d, ang = TILT + off, r0 = 0, len = o.streakLen, w = 0.007 * S * sc,
			color = BLUE[2], grow = 0.3, hold = 0.85, tailMove = 0 })
	end
	for i = 1, cnt(12) do
		fx.ray({ t0 = t0 + (0.19 + i * 0.004) * d, life = 0.81 * d, ang = TILT + PI * i / 6 + rr(-0.1, 0.1), z = rr(-0.2, 0.2),
			r0 = 0.01 * S, len = rr(0.07, 0.22) * S * sc, w = 0.0035 * S * sc, color = pick(BLUE), grow = 0.3, hold = 0.85, tailMove = 0 })
	end
	for _ = 1, cnt(o.comets or 110) do
		local u = rr(0, 1)
		local life = rr(0.23, 0.36) * d
		fx.comet({ t0 = t0 + (0.255 + 0.723 * u ^ 0.6) * d, life = life, mode = "in", ang = rr(0, TAU), r0 = rr(0.3, 0.95) * S, r1 = 0.015 * S,
			swirl = rr(2.2, 3.6) * sgn(), z = rr(-0.2, 0.2), w = rr(0.003, 0.008) * S * sc, trail = rr(0.35, 0.6) * life / 1.4,
			color = pick(BLUE), color2 = BLUE[3], minHead = mh })
	end
	for i = 1, cnt(6) do
		fx.bolt({ t0 = t0 + (0.745 + i * 0.038) * d, life = math.max(0.106 * d, 0.06), ang = rr(0, TAU), r0 = 0.03 * S,
			len = rr(0.1, 0.22) * S * sc, w = 0.003 * S * sc, color = BLUE[2], jitter = 0.14, N = 7 })
	end
	local cm = o.coreMul or 1
	fx.core({ t0 = t0, life = d * 1.02, size = function(t)
		local u = math.clamp(t / d, 0, 1)
		local u4 = u * 4.74
		local base = kf(u, { { 0, 0 }, { 0.127, 0.004 }, { 0.338, 0.02 }, { 0.633, 0.034 }, { 0.886, 0.06 }, { 0.96, 0.03 }, { 1, 0.004 } })
		local pulse = kf(u, { { 0.1, 0 }, { 0.32, 1 }, { 0.85, 1 }, { 0.97, 0 } })
		return base * S * cm * (1 + 0.12 * math.sin(u4 * (6 + 3 * u4)) * pulse)
	end })
	if o.dustWidth then
		local dust = fx.addDust(o.dustWidth)
		fx.at(t0, d, function(a)
			dust.Rate = kf(a, { { 0.1, 0 }, { 0.21, 70 }, { 0.98, 70 }, { 1, 0 } }) * UPPERCUT_QUALITY
		end, function() dust.Rate = 0 end)
	end
end

-- BREACH (+ optional second burst): blue starburst, rays, spiralling comets, lightning, sparks, core flash.
-- tm = time multiplier (1 = planet speed), th = beam thickness multiplier
