-- drives an fx + lens in real time for `duration` seconds in the real world, then cleans everything up
local function runWorldFX(fx, lensCfg, duration, followFn)
	local cam = workspace.CurrentCamera
	local gui = newScreenGui("UppercutImpactGui", 1400)
	local lensRoot = Instance.new("Folder")
	lensRoot.Name = "UppercutLens"
	lensRoot.Parent = workspace
	local lens = newLens(gui, lensRoot, cam, cam.FieldOfView)
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		if t >= duration then
			conn:Disconnect()
			fx.destroy()
			gui:Destroy()
			lensRoot:Destroy()
			return
		end
		local pos = fx.C.Position
		if followFn then
			local rot = cam.CFrame - cam.CFrame.Position
			pos = followFn()
			fx.C = CFrame.new(pos) * rot
		end
		fx.update(t)
		lens.update({
			src = pos, t = t, tint = BLUE[1], cols = { BLUE[4], BLUE[2], BLUE[1] },
			glowSize = lensCfg.glowSize(t), glowAlpha = lensCfg.glowAlpha(t), flare = lensCfg.flare(t),
		})
	end)
end

