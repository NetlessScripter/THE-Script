		local viewportDiagonal = camera.ViewportSize.Magnitude
		local function moonScreenPoint() return projectToScreen(moonCenter) end
		screenLayer.addShockRing(moonScreenPoint, 60, viewportDiagonal * 1.1, 1.0, FIRE[1], 12, 0)
		screenLayer.addShockRing(moonScreenPoint, 40, viewportDiagonal * 0.8, 1.3, FIRE[2], 7, 0.12)
	end

	local function secondPulse()
		local R = MOON_RADIUS
		addShake(0.6, 3.1)
		whiteAlpha = math.max(whiteAlpha, 0.45)
		expandingSphere(stage, moonCenter, 0.6 * R, 4.0 * R, 0.7, FIRE[1], 0.2, 1.4)
		addRing(stage, moonCenter, flightDirection, 0.5 * R, 5.4 * R, 1.4, FIRE[1], 22, 0, FIRE[2])
		burstParticles(stage, moonCenter, 1.2 * R, {
			texture = SPARK_TEXTURE,
			color = ColorSequence.new({ colorKeypoint(0, FIRE[1]), colorKeypoint(1, FIRE[3]) }),
			size = NumberSequence.new({ numberKeypoint(0, 20), numberKeypoint(1, 0) }),
			transparency = NumberSequence.new({ numberKeypoint(0, 0), numberKeypoint(1, 1) }),
			lifetime = NumberRange.new(1.0, 2.0),
			speed = NumberRange.new(700, 2600),
			drag = 1.3,
			brightness = 3,
		}, 160)
	end

	local events = {
		{ time = T_CHARGE, run = beginCharge },
		{ time = 0.45, run = startEarthCracks },
		{ time = T_LAUNCH, run = launch },
		{ time = T_PASS, run = passLens },
		{ time = T_HIT, run = hitMoon },
		{ time = T_BOOM, run = boom },
		{ time = T_BOOM + 0.3, run = secondPulse },
	}

	local function cleanup()
		if finished then return end
		finished = true
		if mainLoopConnection then
			mainLoopConnection:Disconnect()
			mainLoopConnection = nil
		end
		if fallTrack then pcall(function() fallTrack:Stop(0) end) end
		effectClock = 1
		clearEffects()
		screenLayer.black.BackgroundTransparency = 0
		screenLayer.white.BackgroundTransparency = 1
		pcall(function() if onDone then onDone() end end)
		local character = localPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		camera.CameraType = Enum.CameraType.Custom
		camera.FieldOfView = previousFieldOfView
		if humanoid then camera.CameraSubject = humanoid end
		for propertyName, value in pairs(savedLighting) do
			pcall(function() Lighting[propertyName] = value end)
		end
		for _, effect in ipairs({ bloom, colorCorrection, blur, blankSky }) do
			pcall(function() effect:Destroy() end)
		end
		for _, flashEffect in ipairs(flashCorrections) do
			pcall(function() flashEffect:Destroy() end)
		end
		for _, child in ipairs(removedLightingChildren) do
			pcall(function() child.Parent = Lighting end)
		end
		for _, postEffect in ipairs(disabledPostEffects) do
			pcall(function() postEffect.Enabled = true end)
		end
		for _, gui in ipairs(hiddenGuis) do
			pcall(function() gui.Enabled = true end)
		end
		for coreGuiType, enabled in pairs(coreGuiStates) do
			pcall(function() StarterGui:SetCoreGuiEnabled(coreGuiType, enabled) end)
		end
		if controls then pcall(function() controls:Enable() end) end
		pcall(function() StarterGui:SetCore("TopbarEnabled", true) end)
		pcall(function() stage:Destroy() end)
		if enemyClone then pcall(function() enemyClone:Destroy() end) end
		playing = false
		local fadeElapsed = 0
		local fadeConnection
		fadeConnection = RunService.RenderStepped:Connect(function(deltaTime)
			fadeElapsed += deltaTime
			screenLayer.black.BackgroundTransparency = smoothstep(fadeElapsed / 0.45)
			if fadeElapsed >= 0.45 then
				fadeConnection:Disconnect()
				screenLayer.gui:Destroy()
			end
		end)
	end

	local speedLineColor = WHITE:Lerp(BLUE[4], 0.4)
	local lastRealTime = os.clock()
	mainLoopConnection = RunService.RenderStepped:Connect(function()
		local now = os.clock()
		local deltaTime = math.min(now - lastRealTime, 0.1)
		lastRealTime = now
		local loopSucceeded, loopError = pcall(function()
			if now < holdUntil then
				timeScale = 0.03
			elseif slowMotionStart then
				local sinceSlow = now - slowMotionStart
				timeScale = sinceSlow < 0.3 and 0.2 or (sinceSlow < 1.0 and lerp(0.2, 1, smoothstep((sinceSlow - 0.3) / 0.7)) or 1)
			else
				timeScale = 1
			end
			storyTime += deltaTime * timeScale
			effectClock = timeScale
			hideGuis()

			for _, event in ipairs(events) do
				if not event.done and storyTime >= event.time then
					event.done = true
					event.run()
				end
			end

			for _, star in ipairs(starfield) do
				local twinkle = 0.7 + 0.3 * math.sin(storyTime * star.speed + star.phase)
				star.part.Transparency = 1 - math.clamp(star.base * twinkle, 0, 1)
			end

			local earthShakeAmount
			if storyTime < T_LAUNCH then
				earthShakeAmount = 2.5 * smoothstep((storyTime - 0.4) / (T_LAUNCH - 0.4))
			else
				earthShakeAmount = 9 * math.exp(-(storyTime - T_LAUNCH) * 2.2)
			end
			earthModel:PivotTo(
				CFrame.new(random:NextNumber(-1, 1) * earthShakeAmount, random:NextNumber(-1, 1) * earthShakeAmount, 0)
				* CFrame.new(earthCenter) * CFrame.Angles(0, storyTime * 0.03, 0) * CFrame.new(-earthCenter) * earthBasePivot)

			local rimStrength
			if storyTime < T_LAUNCH then
				rimStrength = smoothstep((storyTime - 0.3) / (T_LAUNCH - 0.3))
			else
				rimStrength = 1 - smoothstep((storyTime - T_LAUNCH) / 1.6)
			end
			earthRim.OutlineTransparency = 1 - 0.9 * rimStrength
			earthRim.FillTransparency = 1 - 0.2 * rimStrength

			if chargeCore and chargeHalo then
				local chargeProgress = smoothstep((storyTime - T_CHARGE) / (T_LAUNCH - T_CHARGE))
				local flicker = 1 + 0.18 * math.sin(storyTime * 55) + 0.1 * math.sin(storyTime * 23)
				local coreDiameter = (10 + 160 * chargeProgress ^ 1.5) * flicker
				chargeCore.Size = Vector3.one * coreDiameter
				chargeHalo.Size = Vector3.one * coreDiameter * 2.4
				chargeHalo.Transparency = 0.8 - 0.25 * chargeProgress
			end

			if enemyActive and enemyCarrier then
				local enemyPosition = launchPoint + flightDirection * enemyDistance(storyTime)
				local rollAngle = (storyTime - T_LAUNCH) * 2.4
				local enemyOrientation = CFrame.lookAt(enemyPosition, enemyPosition - flightDirection) * CFrame.Angles(0, 0, rollAngle)
				if enemyClone then
					enemyClone:PivotTo(enemyOrientation)
				else
					enemyCarrier.CFrame = enemyOrientation
				end
				if enemyShell then
					local pulse = 1 + 0.08 * math.sin(storyTime * 40)
					enemyShell.Size = Vector3.one * 190 * pulse
					enemyShell.CFrame = CFrame.new(enemyPosition)
				end
				local rushStrength = math.clamp((storyTime - T_LAUNCH) / accelerationTime, 0, 1)
				for _, tail in ipairs(enemyTails) do
					local tailLength = tail.length * (0.35 + 0.65 * rushStrength)
					tail.part.CFrame = CFrame.new(enemyPosition - flightDirection * tailLength)
				end
			end

			if moonShaking and moonGlowInner and moonGlowOuter then
				local heatProgress = math.clamp((storyTime - T_HIT) / (T_BOOM - T_HIT), 0, 1)
				moonGlowInner.Transparency = lerp(1, 0.45, heatProgress ^ 1.6)
				moonGlowInner.Color = FIRE[4]:Lerp(FIRE[2], heatProgress)
				moonGlowOuter.Transparency = lerp(1, 0.82, heatProgress ^ 1.3)
				local jitterAmount = 2 + 9 * heatProgress
				local jitterVector = vec3(random:NextNumber(-jitterAmount, jitterAmount), random:NextNumber(-jitterAmount, jitterAmount), random:NextNumber(-jitterAmount, jitterAmount))
				moonModel:PivotTo(moonBasePivot * CFrame.new(jitterVector))
				moonGlowInner.CFrame = CFrame.new(moonCenter + jitterVector)
				moonGlowOuter.CFrame = CFrame.new(moonCenter + jitterVector)
			end

			local forwardToEarth = (earthCenter - ORIGIN).Unit
			local driftPosition = ORIGIN + forwardToEarth * (26 * math.min(storyTime, T_LAUNCH))
			local cameraPosition = driftPosition
			local cameraRotation = cameraStartRotation
			local fieldOfView = lerp(70, 63, smoothstep(storyTime / T_LAUNCH))
			local rumble = 0.05 + 0.25 * smoothstep((storyTime - 0.4) / (T_LAUNCH - 0.4))
			local blurSize = 0
			local speedAmount = 0
			local vignetteAmount = 0.38
			local crackPhase = 0
			local cameraRollExtra = 0

			if storyTime >= T_LAUNCH and storyTime < T_WHIP then
				local rushProgress = math.clamp((storyTime - T_LAUNCH) / accelerationTime, 0, 1)
				fieldOfView = lerp(63, 94, rushProgress ^ 2)
				rumble = 0.2 + 0.8 * rushProgress
				blurSize = 10 * rushProgress ^ 2
				speedAmount = smoothstep(rushProgress) ^ 1.3
				vignetteAmount = 0.38 + 0.4 * rushProgress
			elseif storyTime >= T_WHIP then
				local whipProgress = math.clamp((storyTime - T_WHIP) / WHIP_DURATION, 0, 1)
				local whipEase = 1 - (1 - whipProgress) ^ 3.5
				local whipSwing = math.sin(PI * whipEase)
				cameraPosition = driftPosition:Lerp(ORIGIN, whipEase)
				cameraRotation = cameraStartRotation * CFrame.Angles(-0.1 * whipSwing, -PI * whipEase, 0.22 * whipSwing)
				if whipProgress >= 1 then
					cameraRotation = cameraEndRotation
				else
					cameraRotation = cameraRotation:Lerp(cameraEndRotation, whipEase ^ 4)
				end
				fieldOfView = lerp(94, 64, whipEase) + 20 * whipSwing
				blurSize = 38 * whipSwing ^ 0.8
				rumble = 0.3 * (1 - whipProgress)
				speedAmount = (1 - whipEase) * 0.8
				vignetteAmount = 0.7
				if whipProgress >= 1 then
					local chaseDuration = math.max(T_HIT - T_CHASE_START, 0.01)
					local chaseProgress = math.clamp((storyTime - T_CHASE_START) / chaseDuration, 0, 1)
					cameraPosition = ORIGIN + flightDirection * (300 * chaseProgress ^ 2)
					fieldOfView = lerp(64, 56, smoothstep(chaseProgress))
					speedAmount = 0.35 * smoothstep(chaseProgress)
					rumble = 0.12 + 0.2 * chaseProgress
					vignetteAmount = 0.55
				end
			end

			if storyTime >= T_HIT then
				local sinceHit = storyTime - T_HIT
				crackPhase = math.clamp(sinceHit / (T_BOOM - T_HIT), 0, 1)
				cameraPosition = ORIGIN + flightDirection * (300 + 90 * crackPhase)
				fieldOfView = lerp(56, 44, smoothstep(crackPhase)) - 6 * math.exp(-sinceHit * 10)
				rumble = 0.2 + 0.7 * crackPhase
				speedAmount = 0
				vignetteAmount = 0.45 + 0.25 * crackPhase
				if storyTime >= T_BOOM then
					local sinceBoom = storyTime - T_BOOM
					cameraPosition = ORIGIN + flightDirection * (390 - 260 * easeOutCubic(sinceBoom / 1.6))
					fieldOfView = 44 + 44 * smoothstep(sinceBoom / 0.4)
					if sinceBoom > 0.4 then
						fieldOfView = lerp(88, 72, smoothstep((sinceBoom - 0.4) / 1.8))
					end
					rumble = 0.2 + 0.6 * math.exp(-sinceBoom * 1.2)
					vignetteAmount = 0.3
					cameraRollExtra = 0.08 * math.sin(sinceBoom * 2.5) * math.exp(-sinceBoom * 0.8)
				end
			end

			local shakeYaw, shakePitch, shakeRoll = explosionShake()
			camera.CFrame = CFrame.new(cameraPosition) * cameraRotation.Rotation * CFrame.Angles(
				math.noise(storyTime * 31, 0.3) * rumble * 0.035 + shakePitch,
				math.noise(storyTime * 31, 10.3) * rumble * 0.035 + shakeYaw,
				math.noise(storyTime * 27, 20.3) * rumble * 0.025 + shakeRoll + cameraRollExtra)
			camera.FieldOfView = math.clamp(fieldOfView, 20, 115)
			blur.Size = blurSize

			local flashing = now < flashUntil
			if flashing ~= flashOn then
				flashOn = flashing
				for _, flashEffect in ipairs(flashCorrections) do
					flashEffect.Enabled = flashing
				end
			end

			local bloomIntensity = 0.6
			if storyTime >= T_HIT then bloomIntensity = 1.0 end
			if storyTime >= T_LAUNCH and storyTime < T_PASS then bloomIntensity = 0.9 end
			if lightKickStart then
				local sinceKick = now - lightKickStart
				bloomIntensity = 1.2 + 1.8 * math.exp(-sinceKick * 1.6)
				Lighting.Brightness = BASE_BRIGHTNESS + 2.2 + 3 * math.exp(-sinceKick * 1.4)
				colorCorrection.TintColor = WHITE:Lerp(rgb(255, 205, 160), math.exp(-sinceKick * 0.9))
				colorCorrection.Contrast = 0.08 + 0.2 * math.exp(-sinceKick * 2)
			end
			bloom.Intensity = flashing and 0 or bloomIntensity

			local viewportSize = camera.ViewportSize
			screenLayer.setVignette(vignetteAmount)
			screenLayer.setSpeedLines(speedAmount, storyTime, viewportSize, speedLineColor)

			local flareWorldPosition, flareStrength, flareColor = nil, 0, WHITE
			if storyTime < T_LAUNCH then
				flareWorldPosition = earthSurfacePoint
				flareStrength = 0.9 * smoothstep((storyTime - T_CHARGE) / (T_LAUNCH - T_CHARGE)) ^ 2
				flareColor = BLUE[2]
			elseif storyTime < T_PASS then
				flareWorldPosition = earthSurfacePoint
				flareStrength = math.exp(-(storyTime - T_LAUNCH) * 4)
				flareColor = BLUE[2]
			elseif storyTime >= T_BOOM then
				flareWorldPosition = moonCenter
				flareStrength = 1.1 * math.exp(-(storyTime - T_BOOM) * 0.9)
				flareColor = FIRE[2]
			elseif storyTime >= T_HIT then
				flareWorldPosition = impactPoint
				flareStrength = 0.3 + 0.6 * crackPhase
				flareColor = FIRE[3]
			end
			local flareScreenPoint = nil
			if flareWorldPosition and flareStrength > 0.01 then
				flareScreenPoint = projectToScreen(flareWorldPosition)
			end
			screenLayer.setFlare(flareScreenPoint, flareStrength, flareColor, viewportSize)

			whiteAlpha = math.max(0, whiteAlpha - deltaTime * whiteDecay)
			screenLayer.white.BackgroundTransparency = 1 - whiteAlpha
			blackAlpha = smoothstep((storyTime - (T_END - 0.5)) / 0.5)
			screenLayer.black.BackgroundTransparency = 1 - blackAlpha

			if storyTime >= T_END then cleanup() end
		end)
		if not loopSucceeded then
			warn("[UppercutFinisher] cutscene error:", loopError)
			cleanup()
		end
	end)
end

return {
	BlueImpact = blueImpact,
	CloneEnemy = cloneEnemy,
	Cutscene = play,
}
end)()
