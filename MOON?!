	for _ = 1, cnt(40) do
		fx.ray({ t0 = T0 + rr(0, 0.2), life = rr(0.9, 1.5), ang = rr(0, TAU), z = rr(-0.3, 0.3), r0 = rr(0.02, 0.1) * S,
