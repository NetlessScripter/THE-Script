	fx.ring({ t0 = T0, life = 1.8, rx = 1, ry = 0.3, rot = 0.2, s0 = 0.05 * S, s1 = 1.8 * S, w = 0.012 * S, color = HOT[2] })
	fx.ring({ t0 = T0 + 0.1, life = 2.2, rx = 1, ry = 0.55, rot = -0.35, s0 = 0.05 * S, s1 = 2.4 * S, w = 0.009 * S, color = WHITE })
