	local function explosionShake()
		if #shakes == 0 then return 0, 0, 0 end
		local now = os.clock()
		local yaw, pitch, roll = 0, 0, 0
		for _, shake in ipairs(shakes) do
			local realTime = now - shake.start
			local attack = smoothstep(realTime / 0.06)
			local envelope = attack * (0.55 * math.exp(-realTime * 4.5) + 0.45 * math.exp(-realTime * 1.3))
			if envelope >= 0.0005 then
				local strength, phase = envelope * shake.strength, shake.phase
				yaw += (0.6 * math.sin(realTime * TAU * 6.1 + 0.3 + phase) + 0.4 * math.sin(realTime * TAU * 10.7 + 1.7 + phase)) * 0.11 * strength
				pitch += (0.6 * math.sin(realTime * TAU * 7.3 + 2.1 + phase) + 0.4 * math.sin(realTime * TAU * 12.9 + 0.4 + phase)) * 0.09 * strength
				roll += (0.7 * math.sin(realTime * TAU * 5.2 + 4.0 + phase) + 0.3 * math.sin(realTime * TAU * 9.1 + 1.0 + phase)) * 0.07 * strength
			end
		end
		return yaw, pitch, roll
	end

