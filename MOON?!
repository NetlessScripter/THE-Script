	local t0, tm, th, mh = o.t0 or 0, o.tm or 1, o.th or 1, o.minHead
	fx.once(t0, function() fx.burst(WHITE, BLUE[2], cnt(10), 1.0, 0.006 * th, tm) end)
	local n = 16
	for i = 1, n do
		local big = (i % 4 == 0)
		fx.ray({ t0 = t0 + rr(0, 0.04) * tm, life = 2.2 * tm, ang = TILT + (i / n) * TAU, z = rr(-0.08, 0.08), r0 = 0.03 * S,
			len = 1.5 * S * ((i % 2 == 0) and 1 or 0.55) * (big and 1.25 or 1) * rr(0.9, 1.1), w = 0.007 * S * th * (big and 1.4 or 1),
			color = pick(BLUE), grow = 0.12, hold = 0.5, tailMove = 0.45 })
	end
	for _ = 1, cnt(40) do
		fx.ray({ t0 = t0 + rr(0, 0.1) * tm, life = rr(0.8, 1.3) * tm, ang = rr(0, TAU), z = rr(-0.3, 0.3), r0 = rr(0.02, 0.1) * S,
			len = rr(0.12, 0.5) * S, w = rr(0.008, 0.016) * S * th, color = pick(BLUE), grow = 0.16, hold = 0.35, tailMove = 0.6 })
	end
	for _ = 1, cnt(90) do
		fx.comet({ t0 = t0 + rr(0, 0.2) * tm, life = rr(1.0, 1.7) * tm, mode = "out", ang = rr(0, TAU), r0 = 0.04 * S, r1 = rr(0.8, 2.3) * S,
			swirl = rr(0.7, 1.7) * sgn(), z = rr(-0.25, 0.25), w = rr(0.008, 0.02) * S * th, trail = rr(0.4, 0.8) * tm,
			color = pick(BLUE), color2 = BLUE[3], minHead = mh })
