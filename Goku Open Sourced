    local Spring = {}
    Spring.__index = Spring

    function Spring.new(initial, speed, damper)
        return setmetatable({
            pos = initial,
            vel = 0,
            target = initial,
            speed = speed,
            damper = damper,
        }, Spring)
    end

    function Spring:step(dt)
        local w, z = self.speed, self.damper
        local x0 = self.pos - self.target
        local v0 = self.vel
        local x, v

        if math.abs(z - 1) < 1e-4 then
            local e = math.exp(-w * dt)
            local c = v0 + w * x0
            x = (x0 + c * dt) * e
            v = (v0 - c * w * dt) * e
        elseif z < 1 then
            local wd = w * math.sqrt(1 - z * z)
            local e = math.exp(-z * w * dt)
            local cs, sn = math.cos(wd * dt), math.sin(wd * dt)
            local b = (v0 + z * w * x0) / wd
            x = e * (x0 * cs + b * sn)
            v = e * (v0 * cs - (x0 * wd + z * w * b) * sn)
        else
            local s = math.sqrt(z * z - 1)
            local r1 = -w * (z + s)
            local r2 = -w * (z - s)
            local c2 = (v0 - r1 * x0) / (r2 - r1)
            local c1 = x0 - c2
            local e1, e2 = math.exp(r1 * dt), math.exp(r2 * dt)
            x = c1 * e1 + c2 * e2
            v = c1 * r1 * e1 + c2 * r2 * e2
        end

        self.pos = self.target + x
        self.vel = v
        return self.pos
    end

