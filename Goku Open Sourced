    -- Tab spacer. Only one tab's rows show at a time, and a tab with fewer rows
    -- than the tallest one (Settings) gets this invisible block to fill the height
    -- its missing rows leave behind, so the panel (and the Close button) doesn't
    -- jump around when switching tabs.
    local tabRowCounts = {}
    for _, tabName in ipairs(tabNames) do
        tabRowCounts[tabName] = 0
    end
    for _, rowDefinition in ipairs(settingRowDefinitions) do
        local rowTabName = rowDefinition.tab or "Settings"
        tabRowCounts[rowTabName] = tabRowCounts[rowTabName] + 1
    end
    local tallestTabRowCount = 0
    for _, rowCount in pairs(tabRowCounts) do
        tallestTabRowCount = math.max(tallestTabRowCount, rowCount)
    end

    local function GetSpacerScaleForTab(tabName)
        local missingRowCount = tallestTabRowCount - tabRowCounts[tabName]
        if missingRowCount <= 0 then
            return 0
        end
        return missingRowCount * panelRowScale + (missingRowCount - 1) * panelPaddingScale
    end

    local tabSpacer = Instance.new("Frame")
    tabSpacer.Name = "TabSpacer"
    tabSpacer.LayoutOrder = #settingRowDefinitions + 1
    tabSpacer.BackgroundTransparency = 1
    tabSpacer.BorderSizePixel = 0
    tabSpacer.Size = UDim2.new(1, 0, 0, 0)
    tabSpacer.Visible = false
    tabSpacer.Parent = settingsPanel

    SetActiveTab = function(tabName)
        activeTabName = tabName
        CloseAllDropdowns()

        local isSettingsTab = tabName == "Settings"
        for _, rowEntry in ipairs(settingRowButtons) do
            rowEntry.button.Visible = rowEntry.tab == tabName
        end
        local spacerScale = GetSpacerScaleForTab(tabName)
        tabSpacer.Size = UDim2.new(1, 0, spacerScale, 0)
        tabSpacer.Visible = spacerScale > 0
        applyButton.Visible = isSettingsTab

        -- Keep the yellow row highlight on a row that is actually showing.
        local selectedEntry = settingRowButtons[selectedRowIndex]
        if not selectedEntry or selectedEntry.tab ~= tabName then
            for rowIndex, rowEntry in ipairs(settingRowButtons) do
                if rowEntry.tab == tabName then
                    selectedRowIndex = rowIndex
                    break
                end
            end
            refreshRowVisuals()
        end

        for name, tabButton in pairs(tabButtons) do
            local isActive = name == tabName
            tabButton.BackgroundColor3 = isActive and highlightColor or headerColor
            tabButton.TextColor3 = isActive and selectedTextColor or normalTextColor
        end
    end
