local SPIRIT_BOMB_ANIM_ID   = "rbxassetid://11365563255"
local SPIRIT_BOMB_GROW_DONE = 5.2   -- 3.1s wait + 2.1s orb grow
local SPIRIT_BOMB_FALL      = 9.4   -- 5.2 + 0.8s drop + 3.4s explosion
