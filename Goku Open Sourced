    local function SetMusicVolume(newVolume)
        musicVolume = newVolume
        if currentFadeInTween then
            currentFadeInTween:Cancel()
            currentFadeInTween = nil
        end

        local activeSound = currentMusicSound
        if activeSound and activeSound.Parent then
            local inLucyFadeOut = activeSound.Name:lower():find("lucy~", 1, true) ~= nil and activeSound.TimePosition >= LucyFadeOutStart
            if not inLucyFadeOut then
                activeSound.Volume = newVolume
            end
        end
    end

    local function SetMusicEnabled(enabled)
        if enabled then
            _G.Music = true
            musicActive = true
            if not currentMusicSound or not currentMusicSound.Parent then
                task.spawn(PlaySoundCycle)
            end
        else
            _G.Music = false
            musicActive = false
            if currentMusicSound then
                currentMusicSound:Stop()
                currentMusicSound:Destroy()
                currentMusicSound = nil
            end
        end
    end

    -- Picks one of the Music Volume options (Max / Medium / None).
