                local barWidth = sliderBar.AbsoluteSize.X
                if barWidth <= 0 then return end
                local fraction = math.clamp((pointerX - sliderBar.AbsolutePosition.X) / barWidth, 0, 1)
                local shownFraction = rowDefinition.onSliderChanged(fraction)
