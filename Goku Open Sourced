    local function buildViewport()
        local sourceCharacter = localPlayer.Character or localPlayer.CharacterAdded:Wait()

        local wasArchivable = sourceCharacter.Archivable
        sourceCharacter.Archivable = true
        local cloneOk, previewClone = pcall(function()
            return sourceCharacter:Clone()
        end)
        sourceCharacter.Archivable = wasArchivable

        local characterHeight = 5.5
        if cloneOk and previewClone then
            for _, descendant in ipairs(previewClone:GetDescendants()) do
                if descendant:IsA("LuaSourceContainer") or descendant:IsA("Sound")
                    or descendant:IsA("ParticleEmitter") or descendant:IsA("Trail")
                    or descendant:IsA("Beam") or descendant:IsA("Light")
                    or descendant:IsA("Highlight") or descendant:IsA("BillboardGui")
                    or descendant:IsA("ForceField") or descendant:IsA("Fire")
                    or descendant:IsA("Smoke") or descendant:IsA("Sparkles") then
                    descendant:Destroy()
                elseif descendant:IsA("BasePart") then

                    descendant.Anchored = (descendant.Name == "HumanoidRootPart")
                end
            end

            local previewHumanoid = previewClone:FindFirstChildOfClass("Humanoid")
            if previewHumanoid then
                previewHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
                previewHumanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
            end

            local yaw = math.rad(CHARACTER_YAW_DEGREES)
            previewClone:PivotTo(CFrame.Angles(0, yaw, 0))
            local boundsCFrame, boundsSize = previewClone:GetBoundingBox()
            characterHeight = boundsSize.Y
            local feetY = boundsCFrame.Position.Y - boundsSize.Y / 2
            previewClone:PivotTo(CFrame.new(0, -feetY + 0.06, 0) * CFrame.Angles(0, yaw, 0))

            local worldModel = Instance.new("WorldModel")
            worldModel.Name = "PreviewWorld"
            worldModel.Parent = viewport
            previewClone.Parent = worldModel
            previewModel = previewClone
        else
            warn("[CharacterSelect] Couldn't copy the character for the viewport")
        end

        local diameter = math.max(characterHeight, 5)
        makeDisc("PlatformBase", 0.4, diameter, -0.2, Color3.fromRGB(58, 64, 76), Enum.Material.SmoothPlastic)
        makeDisc("PlatformTop", 0.06, diameter * 0.93, 0.03, Color3.fromRGB(78, 85, 100), Enum.Material.SmoothPlastic)

        local bottomY = -0.4
        local topY = characterHeight + 0.06
        local centerY = (bottomY + topY) / 2
        local halfSpan = (topY - bottomY) / 2 * 1.4

        local screenSize = workspace.CurrentCamera.ViewportSize
        local aspect = (screenSize.X * VIEWPORT_SIZE.X.Scale) / (screenSize.Y * VIEWPORT_SIZE.Y.Scale)
        local halfTan = math.tan(math.rad(CAMERA_FOV / 2))
        local distanceForHeight = halfSpan / halfTan
        local distanceForWidth = (diameter / 2 * 1.15) / (halfTan * aspect)
        local distance = math.max(distanceForHeight, distanceForWidth)

        viewportFocus = Vector3.new(0, centerY, 0)
        viewportDistance = distance
        viewportHeight = distance * 0.18
        viewportCamera.CFrame = CFrame.lookAt(
            viewportFocus + Vector3.new(0, viewportHeight, -viewportDistance),
            viewportFocus
        )
    end

