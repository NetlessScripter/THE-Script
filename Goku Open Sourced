    local function readSeen()
        local okRead, decoded = pcall(function()
            if isfile and readfile and isfile(SEEN_FILE) then
                return HttpService:JSONDecode(readfile(SEEN_FILE))
            end
            return nil
        end)
        if okRead and type(decoded) == "table" then
            return decoded
        end
        return {}
    end

    local function writeSeen(seenDates)
        local okWrite, writeError = pcall(function()
            writefile(SEEN_FILE, HttpService:JSONEncode(seenDates))
