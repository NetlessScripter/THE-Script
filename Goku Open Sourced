local MenuHud = { hidden = true, saved = {}, conns = {} }

function MenuHud.hideObject(obj)
    if not MenuHud.hidden or not obj or MenuHud.saved[obj] ~= nil then return end
    local property = obj:IsA("ScreenGui") and "Enabled" or "Visible"
    local readOk, current = pcall(function() return obj[property] end)
    if not readOk then return end

    MenuHud.saved[obj] = { property = property, value = current }
    pcall(function() obj[property] = false end)

    table.insert(MenuHud.conns, obj:GetPropertyChangedSignal(property):Connect(function()
        if MenuHud.hidden and obj[property] then

            MenuHud.saved[obj].value = true
            obj[property] = false
        end
    end))
end

function MenuHud.release()
    if not MenuHud.hidden then return end
    MenuHud.hidden = false
    for _, conn in ipairs(MenuHud.conns) do conn:Disconnect() end
    MenuHud.conns = {}
    for obj, info in pairs(MenuHud.saved) do
        if obj.Parent then
            pcall(function() obj[info.property] = info.value end)
        end
    end
    MenuHud.saved = {}
end

