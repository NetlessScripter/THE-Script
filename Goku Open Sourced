        local vfx = option.vfx
        option.aura      = option.aura or { vfx:Lerp(black, 0.3), vfx, vfx:Lerp(white, 0.3), vfx:Lerp(white, 0.65) }
        option.auraLight = option.auraLight or vfx:Lerp(white, 0.1)
