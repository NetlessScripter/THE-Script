                    element.Position = RISE_POSITION
                    element.Size = UDim2.new(1, 0, 1, 0)
                    element.Parent = holder

                    return { element = element, fade = makeFadeGroup(element) }
                end

                local pieces = {
                    makePiece(header, 0, HEADER_H),
                    makePiece(body, 1, BODY_H),
                    makePiece(buttonRow, 2, BUTTON_H),
                }
                for _, piece in ipairs(pieces) do
                    piece.fade.apply(0)
                end

                local hovered = false
                local sweeping = false

                local function playSheen()
                    if sweeping then return end
                    sweeping = true
                    sheen.Visible = true
                    sheenGradient.Offset = Vector2.new(-1, 0)
                    local sweep = TweenService:Create(sheenGradient, info(0.8, Style.Quint, Dir.InOut), {
                        Offset = Vector2.new(1, 0),
                    })
                    sweep.Completed:Connect(function()
                        sweeping = false
                        sheen.Visible = false
                    end)
                    sweep:Play()
                end

                okButton.MouseEnter:Connect(function()
                    hovered = true
                    TweenService:Create(pressScale, info(0.2, Style.Back, Dir.Out), { Scale = 1.07 }):Play()
                    TweenService:Create(lift, info(0.3, Style.Quad, Dir.Out), { BackgroundTransparency = 0.9 }):Play()
                    TweenService:Create(okStroke, info(0.3, Style.Quint, Dir.Out), { Thickness = 3 }):Play()
