        table.insert(spiritBombAura, clone)
        if clone:IsA("Attachment") or clone:IsA("PointLight") then
            clone.Parent = character.PrimaryPart
        else
            clone.Parent = character
            local weld = Instance.new("Weld")
            weld.Part0  = character.PrimaryPart
            weld.Part1  = clone
            weld.Parent = clone
        end

