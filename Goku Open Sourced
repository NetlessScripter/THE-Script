                local NAME_GRADIENT   = verticalGradient(WHITE, Color3.fromRGB(255, 214, 64), Color3.fromRGB(255, 150, 40))
                local INFO_GRADIENT   = verticalGradient(WHITE, Color3.fromRGB(255, 226, 150))
