                    local moveY = math.noise(seed, s, 3.1) * 2
                    local pan   = math.noise(s * 0.9, seed, 7.7) * 2
                    local tilt  = math.noise(seed, s * 0.9, 9.3) * 2
                    local roll  = math.noise(s * 0.7, 4.4, seed) * 2
