    local function playViewportAnimations()
        if not previewModel then return end

        BackNav.stopAnimations()
        local animGeneration = BackNav.animGeneration

        local rigController = previewModel:FindFirstChildOfClass("Humanoid")
            or previewModel:FindFirstChildOfClass("AnimationController")
        if not rigController then
            warn("[CharacterSelect] No Humanoid/AnimationController in the viewport clone")
            return
        end

        local animator = rigController:FindFirstChildOfClass("Animator")
        if not animator then
            animator = Instance.new("Animator")
            animator.Parent = rigController
        end

        local function loadTrack(animationId)
            local animation = Instance.new("Animation")
            animation.AnimationId = animationId
            local ok, track = pcall(function()
                return animator:LoadAnimation(animation)
            end)
            if ok and track then
                track.Priority = Enum.AnimationPriority.Action4
                table.insert(BackNav.tracks, track)
                return track
            end
            warn("[CharacterSelect] Couldn't load animation " .. animationId .. " : " .. tostring(track))
            return nil
        end

        local function ensureAnimatorIsStepping(track)
            task.wait(0.35)
            if manualStepConnection or not track.IsPlaying then return end
            if track.TimePosition > 0.05 then return end

            manualStepConnection = RunService.RenderStepped:Connect(function(deltaTime)
                pcall(function()
                    animator:StepAnimations(deltaTime)
                end)
            end)
        end

        overlayGui.Destroying:Connect(function()
            if manualStepConnection then
                manualStepConnection:Disconnect()
                manualStepConnection = nil
            end
        end)

        task.spawn(function()
            local startupTrack = loadTrack(STARTUP_ANIMATION_ID)
            local loopTrack = loadTrack(LOOP_ANIMATION_ID)

            if loopTrack then
                loopTrack.Looped = true
            end

            if startupTrack then
                startupTrack.Looped = false
                startupTrack:Play(0.2)
                task.spawn(ensureAnimatorIsStepping, startupTrack)

                if loopTrack then
                    local BLEND_TIME = 0.3

                    local waited = 0
                    while startupTrack.Length <= 0 and waited < 3 do
                        task.wait(0.05)
                        waited += 0.05
                    end

                    if startupTrack.Length > BLEND_TIME * 2 then

                        local handoverAt = startupTrack.Length - BLEND_TIME
                        local deadline = os.clock() + startupTrack.Length / math.max(startupTrack.Speed, 0.05) + 5
                        while startupTrack.IsPlaying and startupTrack.TimePosition < handoverAt and os.clock() < deadline
                            and BackNav.animGeneration == animGeneration do
                            RunService.Heartbeat:Wait()
                        end
                        if previewModel and previewModel.Parent and BackNav.animGeneration == animGeneration then
                            loopTrack:Play(BLEND_TIME)
                            startupTrack:Stop(BLEND_TIME)
                        end
                    else
                        startupTrack.Stopped:Wait()
                        if previewModel and previewModel.Parent and BackNav.animGeneration == animGeneration then
                            loopTrack:Play(0.2)
                        end
                    end
                end
            elseif loopTrack then
                loopTrack:Play(0.2)
                task.spawn(ensureAnimatorIsStepping, loopTrack)
            end
        end)
    end

