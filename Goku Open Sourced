local function SetSpiritBombHair(kind)
    if spiritBombLightTween then
        spiritBombLightTween:Cancel()
        spiritBombLightTween = nil
    end

    if HairSystem.SetForm(kind) then
        pcall(PlayHairBurst, kind)
        return
    end

    local oldHair = character:FindFirstChild("GokuSSJHair")
    local light = oldHair and oldHair:FindFirstChildWhichIsA("PointLight", true)
    if light then light.Parent = nil end
    if oldHair then oldHair:Destroy() end
    if not light then
        light = Instance.new("PointLight")
        light.Color = HairSystem.LightColors.SSJ
        light.Range = 8
        light.Brightness = 1
    end

    local newHair, root
    if kind == "Base" then
        newHair = hairModel.Base:Clone()
        for _, name in ipairs({"Base normal", "Left base"}) do
            local junk = newHair:FindFirstChild(name, true)
            if junk then junk:Destroy() end
        end
        newHair.Name = "GokuSSJHair"
        newHair.Parent = character

        local cf = headPart.CFrame * CFrame.new(0, SPIRIT_BOMB_BASE_Y, 0)
        if newHair:IsA("BasePart") then
            root = newHair
            newHair.CFrame = cf
        else
            newHair:PivotTo(cf)
            root = newHair.PrimaryPart or newHair:FindFirstChildWhichIsA("BasePart", true)
        end

        local parts = newHair:GetDescendants()
        table.insert(parts, newHair)
        for _, d in ipairs(parts) do
            if d:IsA("BasePart") then
                d.Anchored   = false
                d.CanCollide = false
                d.Massless   = true
                if d ~= root then
                    local wc = Instance.new("WeldConstraint")
                    wc.Part0  = root
                    wc.Part1  = d
                    wc.Parent = d
                end
            end
        end
        WeldToHead(root)
    else
        local source
        if kind == "SSJB" then
            source = hairModel["Super saiyan Blue"]["Ssj blue (Original)"]
        else
            source = hairModel["Super saiyan 1"]["Ssj dominated (Original)"]
        end
        newHair = source:Clone()
        newHair.Name       = "GokuSSJHair"
        newHair.Anchored   = false
        newHair.CanCollide = false
        newHair.CFrame     = headPart.CFrame * CFrame.new(0, 1.1, 0.5) * CFrame.Angles(0, math.rad(180), 0)
        newHair.Parent     = character
        if kind == "SSJB" then newHair:SetAttribute("IsSSJB", true) end
        WeldToHead(newHair)
        root = newHair
    end
    ssjHair = newHair

    light.Enabled = true
    light.Parent  = root
    if kind == "SSJB" then
        spiritBombLightTween = TweenService:Create(
            light,
            TweenInfo.new(SPIRIT_BOMB_LIGHT_FADE, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
            {Color = HairSystem.LightColors.SSJB}
        )
        spiritBombLightTween:Play()
    elseif kind == "SSJ" then
        light.Color = HairSystem.LightColors.SSJ
    end

    pcall(HairSystem.RecolorDefaultHair)
    pcall(PlayHairBurst, kind)
end

