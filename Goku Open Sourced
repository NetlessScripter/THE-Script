-- Burst bubble that plays on every hair change, colored by the form we switch to
local HAIR_BURST_SIZE = 11   -- final bubble diameter in studs
local HAIR_BURST_TIME = 0.5  -- seconds the bubble takes to expand and fade
local HAIR_BURST_COLORS = {
    Base = Color3.fromRGB(255, 255, 255),
    SSJB = Color3.fromRGB(0, 230, 255),
    SSJ  = Color3.fromRGB(255, 235, 50),
}

local function PlayHairBurst(kind)
    local color = HAIR_BURST_COLORS[kind]
    -- SSJ = the Base Hair color's burst, SSJB = the Ultimate Color's burst
    if kind == "SSJ" then
        color = HairSystem.GetBaseOption().burst
    elseif kind == "SSJB" then
        color = HairSystem.GetUltimateOption().burst
    end
    if not color then return end

    local function MakeSphere(diameter, transparency)
        local p = Instance.new("Part")
        p.Shape        = Enum.PartType.Ball
        p.Material     = Enum.Material.Neon
        p.Color        = color
        p.Size         = Vector3.one * diameter
        p.Transparency = transparency
        p.CanCollide   = false
        p.CanQuery     = false
        p.CanTouch     = false
        p.CastShadow   = false
        p.Massless     = true
        p.CFrame       = headPart.CFrame * CFrame.new(0, 0.6, 0)
        p.Parent       = Workspace

        local weld = Instance.new("WeldConstraint")
        weld.Part0  = headPart
        weld.Part1  = p
        weld.Parent = p

        Debris:AddItem(p, HAIR_BURST_TIME + 0.5)
        return p
    end

    -- outer bubble: pops out fast, then fades
    local bubble = MakeSphere(1.5, 0.35)
    TweenService:Create(bubble, TweenInfo.new(HAIR_BURST_TIME, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
        {Size = Vector3.one * HAIR_BURST_SIZE}):Play()
    TweenService:Create(bubble, TweenInfo.new(HAIR_BURST_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        {Transparency = 1}):Play()

    -- inner flash: smaller and quicker
    local core = MakeSphere(1, 0)
    TweenService:Create(core, TweenInfo.new(HAIR_BURST_TIME * 0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {Size = Vector3.one * (HAIR_BURST_SIZE * 0.5), Transparency = 1}):Play()

    -- a few sparks thrown outward
    local sparks = Instance.new("ParticleEmitter")
    sparks.Color         = ColorSequence.new(color)
    sparks.LightEmission = 1
    sparks.Rate          = 0
    sparks.Lifetime      = NumberRange.new(0.3, 0.5)
    sparks.Speed         = NumberRange.new(14, 24)
    sparks.SpreadAngle   = Vector2.new(180, 180)
    sparks.Size          = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0)})
    sparks.Transparency  = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)})
    sparks.Parent        = bubble
    sparks:Emit(16)
end

