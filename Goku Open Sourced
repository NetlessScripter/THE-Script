-- ---------------------------------------------------------------- SSJB transformation
function PX.StopSSJB(inst)
    inst.ssjbToken = inst.ssjbToken + 1
    local state = inst.ssjb
    inst.ssjb = nil
    if not state then return end
    for _, obj in ipairs(state.emitters) do
        if obj.Parent then obj.Enabled = false end
    end
    local objects = state.objects
    task.delay(2, function()
        for _, obj in ipairs(objects) do
            if obj then obj:Destroy() end
        end
    end)
    if state.holder then state.holder:Destroy() end
end

-- builds the blue aura on a participant (every emitter / light starts disabled and is
-- switched on later by PX.StartSSJB). Safe to call twice: it only builds once.
function PX.CreateSSJBAura(state, char)
    if state.auraBuilt then return end
    state.auraBuilt = true

    local primary = char.PrimaryPart or char:FindFirstChild("HumanoidRootPart")
    if not primary then return end

    local auraHolder = Instance.new("Folder")
    auraHolder.Name = "AuraHolder"
    auraHolder:SetAttribute("LimAura", true)
    auraHolder:SetAttribute("EmoteEffect", true)
    auraHolder.Parent = char
    table.insert(state.objects, auraHolder)

    for _, src in pairs(ReplicatedStorage.Emotes.AuraReal:GetChildren()) do
        local clone = src:Clone()
        clone:SetAttribute("LimAura", true)
        table.insert(state.objects, clone)
        if clone:IsA("Attachment") or clone:IsA("PointLight") then
            clone.Parent = primary
        else
            local weld = Instance.new("Weld")
            weld.Part0 = primary
            weld.Part1 = clone
            weld.Parent = clone
        end
        for _, d in pairs(clone:GetDescendants()) do
            if d:IsA("ParticleEmitter") or d:IsA("PointLight") then
                d.Enabled = false
                table.insert(state.emitters, d)
                d:SetAttribute("LimitedAura", true)
                d:SetAttribute("InnerRageAura", true)
                if d:IsA("ParticleEmitter") then
                    d.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0,   Color3.new(0.0,  0.2,  0.85)),
                        ColorSequenceKeypoint.new(0.3, Color3.new(0.05, 0.45, 1.0)),
                        ColorSequenceKeypoint.new(0.7, Color3.new(0.2,  0.7,  1.0)),
                        ColorSequenceKeypoint.new(1,   Color3.new(0.6,  0.9,  1.0)),
                    })
                else
                    d.Brightness = d.Brightness * 1.3
                    d.Color = Color3.new(0.1, 0.55, 1.0)
                end
            end
        end
    end
end

-- offset = how far into the transformation animation it already is when we notice it, so a
-- late detection still lines the aura up with the animation instead of restarting the timeline
function PX.StartSSJB(inst, offset)
    local char = inst.char
    PX.StopSSJB(inst) -- restart cleanly if it was already running (also bumps the token)
    local myToken = inst.ssjbToken
    local state = { emitters = {}, objects = {} }
    inst.ssjb = state
    offset = math.clamp(tonumber(offset) or 0, 0, PX.SSJBAuraOn)

    local function alive()
        return not inst.dead and inst.ssjbToken == myToken and char.Parent ~= nil
    end

    -- The timers are set up FIRST. Nothing below (a slow sound, a VFX call that errors or
    -- waits) can delay or cancel the aura any more, and the aura no longer depends on the
    -- emote holder still existing (the game's own emote clean-up could remove it early).
    task.delay(math.max(0, PX.SSJBAuraStart - offset), function()
        if not alive() then return end
        local ok, err = pcall(PX.CreateSSJBAura, state, char)
        if not ok then warn("[Participant SSJB] aura:", err) end
    end)

    task.delay(math.max(0, PX.SSJBAuraOn - offset), function()
        if not alive() then return end
        pcall(PX.CreateSSJBAura, state, char) -- no-op when it is already built
        for _, obj in ipairs(state.emitters) do
            if obj.Parent then obj.Enabled = true end
        end
    end)

    task.delay(math.max(0, PX.SSJBAuraLife - offset), function()
        if inst.ssjbToken == myToken then
            PX.StopSSJB(inst)
        end
    end)

    -- transformation sound, in 3D on their torso
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if torso then
        local snd = Instance.new("Sound")
        snd.SoundId = "rbxassetid://117425361961655"
        snd.Volume = 3
        snd.RollOffMinDistance = PX.SSJBSoundMin
        snd.RollOffMaxDistance = PX.SSJBSoundMax
        snd.Parent = torso
        snd:Play()
        Debris:AddItem(snd, snd.TimeLength > 0 and snd.TimeLength or 10)
    end

    -- the energy explosion (the game's own emote VFX, run on their character), in its own
    -- thread so it can neither block nor break the aura
    local holder = Instance.new("Accessory")
    holder.Name = "#EmoteHolder_" .. math.random(1, 100000)
    holder.Parent = char
    state.holder = holder
    CollectionService:AddTag(holder, "emoteendstuff" .. char.Name)
    task.spawn(function()
        local okV, errV = pcall(function()
            require(ReplicatedStorage.Emotes.VFX):MainFunction({
                Character = char,
                vfxName = "Energy Explosion",
                AnimSent = 96993907314948,
                RealBind = holder,
                NoInsertion = true,
                Colour = ssjbColor
            })
        end)
        if not okV then warn("[Participant SSJB] energy explosion:", errV) end
    end)
end

