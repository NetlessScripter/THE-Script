                local panelFont = Font.new("rbxassetid://12187375716", Enum.FontWeight.Regular, Enum.FontStyle.Normal)

                local Style = Enum.EasingStyle
                local Dir   = Enum.EasingDirection

                local function info(duration, style, direction)
                    return TweenInfo.new(duration, style, direction)
                end

                local function animate(duration, style, direction, delayTime, callback)
                    task.spawn(function()
                        if delayTime > 0 then
                            task.wait(delayTime)
                        end
                        local startedAt = os.clock()
                        while true do
                            local alpha = math.clamp((os.clock() - startedAt) / duration, 0, 1)
                            callback(TweenService:GetValue(alpha, style, direction))
                            if alpha >= 1 then
                                break
                            end
                            RunService.Heartbeat:Wait()
                        end
                    end)
