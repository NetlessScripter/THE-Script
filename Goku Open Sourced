                local HEADER_STROKE  = Color3.fromRGB(120, 48, 16)
                local ROW_BACKGROUND = Color3.fromRGB(78, 52, 44)
                local ROW_STROKE     = Color3.fromRGB(214, 110, 58)
                local WHITE          = Color3.fromRGB(255, 255, 255)

                local function verticalGradient(...)
                    local colors = { ... }
                    local keypoints = {}
                    for i, color in ipairs(colors) do
                        keypoints[i] = ColorSequenceKeypoint.new((i - 1) / (#colors - 1), color)
                    end
                    return ColorSequence.new(keypoints)
