        weld.Part0  = headPart
        weld.Part1  = p
        weld.Parent = p

        Debris:AddItem(p, HAIR_BURST_TIME + 0.5)
        return p
    end

    local bubble = MakeSphere(1.5, 0.35)
    TweenService:Create(bubble, TweenInfo.new(HAIR_BURST_TIME, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
        {Size = Vector3.one * HAIR_BURST_SIZE}):Play()
    TweenService:Create(bubble, TweenInfo.new(HAIR_BURST_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        {Transparency = 1}):Play()

    local core = MakeSphere(1, 0)
    TweenService:Create(core, TweenInfo.new(HAIR_BURST_TIME * 0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {Size = Vector3.one * (HAIR_BURST_SIZE * 0.5), Transparency = 1}):Play()

    local sparks = Instance.new("ParticleEmitter")
    sparks.Color         = ColorSequence.new(color)
    sparks.LightEmission = 1
    sparks.Rate          = 0
    sparks.Lifetime      = NumberRange.new(0.3, 0.5)
    sparks.Speed         = NumberRange.new(14, 24)
    sparks.SpreadAngle   = Vector2.new(180, 180)
    sparks.Size          = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0)})
    sparks.Transparency  = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)})
    sparks.Parent        = bubble
    sparks:Emit(16)
end

