    local function onFrame(deltaTime)
        deltaTime = math.min(deltaTime, 0.05)
        local clock = os.clock() - motionStart

        local screen = camera.ViewportSize
        local nx, ny = 0, 0
        if mouseDriven and screen.X > 0 and screen.Y > 0 then
            local mouse = UserInputService:GetMouseLocation()
            nx = math.clamp((mouse.X / screen.X - 0.5) * 2, -1, 1)
            ny = math.clamp((mouse.Y / screen.Y - 0.5) * 2, -1, 1)
        end

        if screen.X > 0 and screen.Y > 0 then
            artSpringX.target  = -nx * PARALLAX_ART_PIXELS
            artSpringY.target  = -ny * PARALLAX_ART_PIXELS * 0.6
            viewSpringX.target = -nx * PARALLAX_VIEW_PIXELS
            viewSpringY.target = -ny * PARALLAX_VIEW_PIXELS * 0.6
            artLayer.Position = UDim2.new(
                artSpringX:step(deltaTime) / screen.X, 0,
                artSpringY:step(deltaTime) / screen.Y, 0
            )
            viewportLayer.Position = UDim2.new(
                viewSpringX:step(deltaTime) / screen.X, 0,
                viewSpringY:step(deltaTime) / screen.Y, 0
            )
        end

        if viewportDistance then
            lookYawSpring.target = -nx * MOUSE_LOOK_DEGREES
            lookPitchSpring.target = ny * 0.03

            local yawDegrees = orbit.introYaw + orbit.exitYaw + swapYawSpring:step(deltaTime) + lookYawSpring:step(deltaTime)
            local pitch = lookPitchSpring:step(deltaTime)
            local zoom = orbit.introZoom * swapZoomSpring:step(deltaTime)

            if ENABLE_IDLE_MOTION then
                yawDegrees += math.sin(clock * 0.55) * 1.4
                pitch += math.sin(clock * 0.8 + 1.2) * 0.012
            end

            local offset = Vector3.new(0, viewportHeight + viewportDistance * pitch, -viewportDistance * zoom)
            local position = viewportFocus + CFrame.Angles(0, math.rad(yawDegrees), 0):VectorToWorldSpace(offset)
            viewportCamera.CFrame = CFrame.lookAt(position, viewportFocus)
        else
            swapYawSpring:step(deltaTime)
            swapZoomSpring:step(deltaTime)
        end

        for _, state in ipairs(buttonStates) do
            state.scale.Scale = math.max(0.01, state.spring:step(deltaTime))
        end
        panelBump.Scale = math.max(0.01, bumpSpring:step(deltaTime))
    end

