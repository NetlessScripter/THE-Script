    local GOHAN_CHECK_FILE = "GohanCheck.json"
    local function gohanUnlocked(entry)
        local HttpService = game:GetService("HttpService")
        local okFile, exists = pcall(function() return isfile and isfile(GOHAN_CHECK_FILE) end)
        if okFile and exists then
            local okRead, raw = pcall(readfile, GOHAN_CHECK_FILE)
            if okRead and raw then
                local okJson, data = pcall(HttpService.JSONDecode, HttpService, raw)
                if okJson and type(data) == "table" and data.UserGohanCheck == true then return true end
            end
        end

        local me = game:GetService("Players").LocalPlayer
        local passed = entry.unlockUserId == me.UserId
        if not passed and entry.unlockNames then
            local myName = me.Name:lower()
            for _, n in ipairs(entry.unlockNames) do
                if myName == tostring(n):lower() then passed = true break end
            end
        end

        if passed and writefile and not (okFile and exists) then
            pcall(function()
                writefile(GOHAN_CHECK_FILE, HttpService:JSONEncode({ UserGohanCheck = true, MainAcc = me.UserId }))
            end)
        end
        return passed
    end

