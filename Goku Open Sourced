    local function FormatSongTime(totalSeconds)
        totalSeconds = math.max(totalSeconds, 0)
        return string.format("%d:%02d", math.floor(totalSeconds / 60), math.floor(totalSeconds % 60))
    end

    -- Length the Song Position slider covers: the whole song, except "lucy~",
    -- which the script cuts off at LucySongCap.
    local function GetSeekableLength(sound)
        local songLength = sound.TimeLength
        if sound.Name:lower():find("lucy~", 1, true) then
            songLength = math.min(songLength, LucySongCap)
        end
        return songLength
    end

    local function GetPlayingSoundOrNil()
        local activeSound = currentMusicSound
        if activeSound and activeSound.Parent and activeSound.TimeLength > 0 then
            return activeSound
        end
        return nil
    end

    local function GetSongPositionText()
        local activeSound = GetPlayingSoundOrNil()
        if not activeSound then
            return "0:00 / 0:00"
        end
        local songLength = GetSeekableLength(activeSound)
        return FormatSongTime(math.min(activeSound.TimePosition, songLength)) .. " / " .. FormatSongTime(songLength)
    end
