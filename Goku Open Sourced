-- plays a 3D copy of a preloaded sound on a participant (my own copies stay 2D)
function PX.PlaySpatial(template, root, minDist, maxDist)
    if not (template and root and root.Parent) then return end
    local snd = template:Clone()
    snd.TimePosition = 0
    snd.RollOffMinDistance = minDist
    snd.RollOffMaxDistance = maxDist
    snd.Parent = root
    snd:Play()
    Debris:AddItem(snd, 10)
end

-- prints only while PX.Debug is on
function PX.Log(...)
    if PX.Debug then print("[Participant]", ...) end
end

-- digits-only animation id of a track (parsed once per Animation instead of every frame)
PX.IdCache = setmetatable({}, { __mode = "k" })
function PX.GetAnimId(track)
    local animation = track.Animation
    if not animation then return nil end
    local id = PX.IdCache[animation]
    if not id then
        id = tostring(animation.AnimationId):match("%d+")
        if id then PX.IdCache[animation] = id end
    end
    return id
end

-- the character model (a model that holds a Humanoid) a part belongs to
function PX.CharacterOf(part)
    local node = part.Parent
    while node and node ~= Workspace do
        if node:IsA("Model") and node:FindFirstChildOfClass("Humanoid") then
            return node
        end
        node = node.Parent
    end
    return nil
end

-- mutes the game's own swing "swoosh" (the same list my own character mutes), so it does
-- not play on top of my swing sound
function PX.MuteSwing(obj)
    if obj:IsA("Sound") and (blockedSoundIds[obj.SoundId] or blockedSoundIds[obj.Name]) then
        obj.Volume = 0
        obj:Stop()
    end
end

