        while true do
            if sequenceId ~= typeSequenceId then
                return false
            end
            local progress = math.clamp((os.clock() - fadeStartTime) / TEXT_FADE_OUT_TIME, 0, 1)
            local easedProgress = TweenService:GetValue(progress, Style.Sine, Dir.In)
            textFade.apply(startVisibility * (1 - easedProgress))
            if progress >= 1 then
                return true
            end
            RunService.Heartbeat:Wait()
        end
    end

