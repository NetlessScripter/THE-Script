-- Clothing combos (DLC tab > Clothing). Each outfit is a shirt + pants asset id;
-- a combo is any outfit's shirt paired with any outfit's pants. The saved combo
-- is stored by outfit name in SaveFile and applied the next time the script runs.
local ClothingSystem = {
    SaveFile     = "GokuClothingCombo.json",
    PreviewModel = nil, -- the viewport copy of the character, set by the panel while its Clothing window is open
    Outfits = {
        { name = "Goku",       shirt = 102058923729170, pants = 18456843948 }, -- the default clothing (same as marketShirtId / marketPantsId)
        { name = "Vegeta",     shirt = 12856134008,    pants = 12984016931 },
        { name = "Trunks",     shirt = 74227521106166, pants = 89122850846001 },
        { name = "Gohan",      shirt = 16529330892,    pants = 88568383176752 },
        { name = "Android 17", shirt = 13723297799,    pants = 123936619503188 },
        { name = "Jiren",      shirt = 13671331438,    pants = 14462260888 },
        { name = "Hit",        shirt = 93036192743554, pants = 75261138126776 },
        { name = "Meguna",      shirt = 18978174040,     pants = 75818285692117 },
        { name = "Broly",       shirt = 13018133325,     pants = 16958229895 },
        { name = "Yuji",        shirt = 82214781746024,  pants = 16656299861 },
        { name = "Gojo",        shirt = 120579519971862, pants = 18101593805 },
        { name = "Whis",        shirt = 1060049731,      pants = 6494541110 },
        { name = "Beerus",      shirt = 121887207282442, pants = 135802755436830 },
        { name = "Grand Priest", shirt = 112029399241988, pants = 85975129748658 },
        { name = "Vegito",      shirt = 13852246099,     pants = 83402968089930 },
        { name = "Gogeta",      shirt = 16028355781,     pants = 17388088112 },
        { name = "Xeno Goku",   shirt = 9110513486,      pants = 7464019656 },
        { name = "Future Gohan", shirt = 14832093352,    pants = 14832078259 },
    },
}

do
    local HttpService   = game:GetService("HttpService")
    local templateCache = {}
    local equipToken    = { Shirt = 0, Pants = 0 }

    function ClothingSystem.FindOutfitIndex(outfitName)
        for outfitIndex, outfit in ipairs(ClothingSystem.Outfits) do
            if outfit.name == outfitName then
                return outfitIndex
            end
        end
        return nil
    end

    -- Returns the saved shirt outfit index and pants outfit index, or nil when
    -- nothing valid is saved.
    function ClothingSystem.ReadSaved()
        if not isfile(ClothingSystem.SaveFile) then return nil end

        local readOk, decoded = pcall(function()
            return HttpService:JSONDecode(readfile(ClothingSystem.SaveFile))
        end)
        if not readOk or type(decoded) ~= "table" then return nil end

        local shirtIndex = ClothingSystem.FindOutfitIndex(decoded.shirt)
        local pantsIndex = ClothingSystem.FindOutfitIndex(decoded.pants)
        if shirtIndex and pantsIndex then
            return shirtIndex, pantsIndex
        end
        return nil
    end

    -- Writes the combo (by outfit name). Returns true when the file was written.
    function ClothingSystem.WriteSaved(shirtIndex, pantsIndex)
        local writeOk, writeError = pcall(function()
            writefile(ClothingSystem.SaveFile, HttpService:JSONEncode({
                shirt = ClothingSystem.Outfits[shirtIndex].name,
                pants = ClothingSystem.Outfits[pantsIndex].name,
            }))
        end)
        if not writeOk then
            warn("[Clothing] Couldn't save the combo: " .. tostring(writeError))
        end
        return writeOk
    end

    -- Same lookup the startup clothing uses: the asset id of a Shirt / Pants item
    -- is turned into the texture it points at (cached, so picking it again is instant).
    local function ResolveTemplate(assetId, className)
        local cacheKey = className .. assetId
        if templateCache[cacheKey] then
            return templateCache[cacheKey]
        end

        local lookupOk, objects = pcall(game.GetObjects, game, "rbxassetid://" .. assetId)
        if lookupOk and objects then
            for _, obj in ipairs(objects) do
                local clothing = obj:IsA(className) and obj or obj:FindFirstChildWhichIsA(className)
                if clothing then
                    local template = (className == "Shirt") and clothing.ShirtTemplate or clothing.PantsTemplate
                    if template ~= "" then
                        templateCache[cacheKey] = template
                        return template
                    end
                end
            end
        end

        -- Lookup failed: use the id directly (not cached, so it retries next time).
        warn("[Clothing] Couldn't look up " .. className .. " " .. tostring(assetId) .. ", using the id directly")
        return "rbxassetid://" .. assetId
    end

    local function SetClothing(model, className, template)
        if not model or not model.Parent then return end

        local item = model:FindFirstChildOfClass(className)
        if not item then
            item = Instance.new(className)
            item.Parent = model
        end
        if className == "Shirt" then
            item.ShirtTemplate = template
        else
            item.PantsTemplate = template
        end
    end

    -- Future Gohan lost his left arm: while his shirt is worn, that arm is made
    -- completely invisible (real character and the viewport copies). Any other shirt
    -- brings the arm back to the transparency it had before.
    ClothingSystem.MissingArmShirtId = 14832093352
    ClothingSystem.MissingArmParts   = { "LeftUpperArm", "LeftLowerArm", "LeftHand", "Left Arm" }
    ClothingSystem.MissingArmGuards  = setmetatable({}, { __mode = "k" })

    function ClothingSystem.SetMissingArm(model, hidden)
        if not model or not model.Parent then return end

        for _, partName in ipairs(ClothingSystem.MissingArmParts) do
            local armPart = model:FindFirstChild(partName)
            if armPart and armPart:IsA("BasePart") then
                if armPart:GetAttribute("OrigArmTransparency") == nil then
                    armPart:SetAttribute("OrigArmTransparency", armPart.Transparency)
                end

                local guards = ClothingSystem.MissingArmGuards
                if hidden then
                    armPart:SetAttribute("ArmHidden", true)
                    armPart.Transparency = 1
                    -- if anything else tries to show the arm again, put it back to invisible
                    if not guards[armPart] then
                        guards[armPart] = armPart:GetPropertyChangedSignal("Transparency"):Connect(function()
                            if armPart:GetAttribute("ArmHidden") and armPart.Transparency ~= 1 then
                                armPart.Transparency = 1
                            end
                        end)
                    end
                else
                    armPart:SetAttribute("ArmHidden", false)
                    if guards[armPart] then
                        guards[armPart]:Disconnect()
                        guards[armPart] = nil
                    end
                    armPart.Transparency = armPart:GetAttribute("OrigArmTransparency") or 0
                end
            end
        end
    end

    -- Puts one shirt / pants on the real character and on the viewport copy (when
    -- the Clothing window is open). The lookup yields, so it runs in its own thread;
    -- a newer pick of the same kind cancels an older one that is still looking up.
    function ClothingSystem.Equip(className, assetId)
        equipToken[className] = equipToken[className] + 1
        local myToken = equipToken[className]

        -- remembered so a respawn can put the same shirt / pants back on
        ClothingSystem.Current = ClothingSystem.Current or {}
        ClothingSystem.Current[className] = assetId

        task.spawn(function()
            local template = ResolveTemplate(assetId, className)
            if equipToken[className] ~= myToken then return end

            SetClothing(localPlayer.Character or character, className, template)
            SetClothing(ClothingSystem.PreviewModel, className, template)

            if className == "Shirt" then
                local hideArm = tostring(assetId) == tostring(ClothingSystem.MissingArmShirtId)
                ClothingSystem.SetMissingArm(localPlayer.Character or character, hideArm)
                ClothingSystem.SetMissingArm(ClothingSystem.PreviewModel, hideArm)
            end
        end)
    end

    -- Wears the saved combo, if there is one (called after the default clothing at startup).
    function ClothingSystem.ApplySaved()
        local shirtIndex, pantsIndex = ClothingSystem.ReadSaved()
        if not shirtIndex then return end

        ClothingSystem.Equip("Shirt", ClothingSystem.Outfits[shirtIndex].shirt)
        ClothingSystem.Equip("Pants", ClothingSystem.Outfits[pantsIndex].pants)
    end
end

