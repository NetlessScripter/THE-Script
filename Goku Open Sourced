-- ---------------------------------------------------------------- teleport VFX
function PX.PlayTeleport(inst)
    task.wait(0.5) -- DoTeleport waits 0.5s after its animation starts before the effect
    local char = inst.char
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if inst.dead or not (root and root.Parent) then return end

    local okP, particles = pcall(function()
