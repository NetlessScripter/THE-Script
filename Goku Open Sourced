-- the character the punch is landing on: the NEAREST living humanoid inside the hit box
function PX.FindM1Target(char, boxCFrame, origin, overlap)
    local best, bestDistance
    for _, part in ipairs(Workspace:GetPartBoundsInBox(boxCFrame, PX.M1BoxSize, overlap)) do
        local model = PX.CharacterOf(part)
        if model and model ~= char then
            local humanoid = model:FindFirstChildOfClass("Humanoid")
            local targetRoot = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
            if humanoid and humanoid.Health > 0 and targetRoot then
                local distance = (targetRoot.Position - origin).Magnitude
                if not bestDistance or distance < bestDistance then
                    best, bestDistance = model, distance
                end
            end
        end
    end
    return best
end

