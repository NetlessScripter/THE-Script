                    hovered = false
                    TweenService:Create(pressScale, info(0.3, Style.Quad, Dir.Out), { Scale = 1 }):Play()
                    TweenService:Create(lift, info(0.45, Style.Quad, Dir.Out), { BackgroundTransparency = 1 }):Play()
                    TweenService:Create(okStroke, info(0.45, Style.Quint, Dir.Out), { Thickness = 2 }):Play()
