    local function CreateDropdown(hostRowButton, dropdownName, itemNames, getHighlightedIndex, onItemPicked)
        local dropdown = { isOpen = false }
        table.insert(allDropdowns, dropdown)

        local dropdownFrame = Instance.new("ScrollingFrame")
        dropdownFrame.Name = dropdownName
        dropdownFrame.Visible = false
        dropdownFrame.Active = true
        dropdownFrame.BackgroundColor3 = valueBoxColor
        dropdownFrame.BorderSizePixel = 0
        dropdownFrame.Position = UDim2.new(0, 0, 1, 2)
        dropdownFrame.Size = UDim2.new(1, 0, 0, 150)
        dropdownFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
        dropdownFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
        dropdownFrame.ScrollingDirection = Enum.ScrollingDirection.Y
        dropdownFrame.ScrollBarThickness = 5
        dropdownFrame.ScrollBarImageColor3 = rowStrokeColor
        dropdownFrame.VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar
        dropdownFrame.ZIndex = 3
        dropdownFrame.Parent = hostRowButton

        local dropdownStroke = Instance.new("UIStroke")
        dropdownStroke.Color = rowStrokeColor
        dropdownStroke.Thickness = 1
        dropdownStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        dropdownStroke.Parent = dropdownFrame

        local dropdownLayout = Instance.new("UIListLayout")
        dropdownLayout.Padding = UDim.new(0, songDropdownItemGap)
        dropdownLayout.SortOrder = Enum.SortOrder.LayoutOrder
        dropdownLayout.Parent = dropdownFrame

        local itemButtons = {}

        -- Open / close animation: the frame grows down from the row (height tween,
        -- the ScrollingFrame clips the items) while its background and border fade.
        local dropdownTargetHeight = 0
        local activeSizeTween
        local activeStrokeTween
        local dropdownOpenDuration = 0.25
        local dropdownCloseDuration = 0.18

        local function AnimateDropdownTo(height, transparency, duration, easingDirection, onCompleted)
            if activeSizeTween then activeSizeTween:Cancel() end
            if activeStrokeTween then activeStrokeTween:Cancel() end

            local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Quint, easingDirection)
            local sizeTween = TweenService:Create(dropdownFrame, tweenInfo, {
                Size = UDim2.new(1, 0, 0, height),
                BackgroundTransparency = transparency,
            })
            local strokeTween = TweenService:Create(dropdownStroke, tweenInfo, { Transparency = transparency })

            activeSizeTween = sizeTween
            activeStrokeTween = strokeTween
            sizeTween.Completed:Connect(function(playbackState)
                if activeSizeTween == sizeTween then
                    activeSizeTween = nil
                    activeStrokeTween = nil
                end
                if playbackState == Enum.PlaybackState.Completed and onCompleted then
                    onCompleted()
                end
            end)
            sizeTween:Play()
            strokeTween:Play()
        end

        local function RefreshVisuals()
            local highlightedIndex = getHighlightedIndex()
            for itemIndex, itemButton in ipairs(itemButtons) do
                local isHighlighted = itemIndex == highlightedIndex
                itemButton.BackgroundColor3 = isHighlighted and highlightColor or rowBackgroundColor
                itemButton.TextColor3 = isHighlighted and selectedTextColor or normalTextColor
            end
        end

        local function LayoutItems()
            local itemHeight = math.max(24, math.floor(hostRowButton.AbsoluteSize.Y * 0.8))
            for _, itemButton in ipairs(itemButtons) do
                itemButton.Size = UDim2.new(1, 0, 0, itemHeight)
            end
            local visibleItems = math.min(#itemButtons, songDropdownVisibleItems)
            dropdownTargetHeight = math.floor(visibleItems * (itemHeight + songDropdownItemGap))

            -- Only touch the size while the dropdown is open; if it's mid-animation,
            -- retarget the tween so a resize can't make it jump or get stuck.
            if dropdown.isOpen then
                if activeSizeTween then
                    AnimateDropdownTo(dropdownTargetHeight, 0, 0.12, Enum.EasingDirection.Out)
                else
                    dropdownFrame.Size = UDim2.new(1, 0, 0, dropdownTargetHeight)
                end
            end
        end

        for itemIndex, itemName in ipairs(itemNames) do
            local itemButton = Instance.new("TextButton")
            itemButton.Name = "DropdownItem" .. itemIndex
            itemButton.LayoutOrder = itemIndex
            itemButton.AutoButtonColor = false
            itemButton.BackgroundColor3 = rowBackgroundColor
            itemButton.BorderSizePixel = 0
            itemButton.Size = UDim2.new(1, 0, 0, 32)
            itemButton.FontFace = settingsFont
            itemButton.Text = itemName
            itemButton.TextColor3 = normalTextColor
            itemButton.TextStrokeColor3 = Color3.new(0, 0, 0)
            itemButton.TextStrokeTransparency = 0
            itemButton.TextScaled = true
            itemButton.TextXAlignment = Enum.TextXAlignment.Left
            itemButton.ZIndex = 4
            itemButton.Parent = dropdownFrame

            local itemPadding = Instance.new("UIPadding")
            itemPadding.PaddingLeft = UDim.new(0, 8)
            itemPadding.PaddingRight = UDim.new(0, 8)
            itemPadding.Parent = itemButton

            local itemTextConstraint = Instance.new("UITextSizeConstraint")
            itemTextConstraint.MaxTextSize = 18
            itemTextConstraint.Parent = itemButton

            itemButton.MouseEnter:Connect(function()
                if itemButton.BackgroundColor3 ~= highlightColor then
                    itemButton.BackgroundColor3 = songHoverColor
                end
            end)
            itemButton.MouseLeave:Connect(RefreshVisuals)

            itemButton.Activated:Connect(function()
                playNextSound()
                onItemPicked(itemIndex)
                CloseAllDropdowns()
            end)

            itemButtons[itemIndex] = itemButton
        end

        hostRowButton:GetPropertyChangedSignal("AbsoluteSize"):Connect(LayoutItems)
        LayoutItems()

        function dropdown.Close()
            dropdown.isOpen = false
            if not dropdownFrame.Visible then
                return
            end
            AnimateDropdownTo(0, 1, dropdownCloseDuration, Enum.EasingDirection.In, function()
                if not dropdown.isOpen then
                    dropdownFrame.Visible = false
                end
            end)
        end

        function dropdown.Toggle()
            if dropdown.isOpen then
                dropdown.Close()
                return
            end
            -- Only one dropdown is open at a time.
            for _, otherDropdown in ipairs(allDropdowns) do
                if otherDropdown ~= dropdown then
                    otherDropdown.Close()
                end
            end
            dropdown.isOpen = true
            RefreshSettingValues()
            LayoutItems()
            RefreshVisuals()
            dropdownFrame.CanvasPosition = Vector2.new(0, 0)

            -- Start collapsed and transparent (unless it's still closing, in which
            -- case it just reverses from where it is), then drop open.
            if not dropdownFrame.Visible then
                dropdownFrame.Size = UDim2.new(1, 0, 0, 0)
                dropdownFrame.BackgroundTransparency = 1
                dropdownStroke.Transparency = 1
                dropdownFrame.Visible = true
            end
            AnimateDropdownTo(dropdownTargetHeight, 0, dropdownOpenDuration, Enum.EasingDirection.Out)
        end

        return dropdown
    end

