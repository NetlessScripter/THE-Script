do
    local equipToken    = 0
    local formTweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)

    -- Where each hair stands: "loading", "ready" or "failed" (nil = not asked for yet).
    -- The Hair window reads this to show "..." / "(failed)" next to a pick.
    local templateStatus = {}
    HairSystem.TemplateStatus = templateStatus

    local ContentProvider = game:GetService("ContentProvider")

    local function GetMeshId(hairName)
        local numericId = string.match(HairOffsets[hairName].AssetId, "%d+")
        return "rbxassetid://" .. tostring(numericId)
    end

    -- The hair ids are mesh ids, so there is nothing to GetObjects: a SpecialMesh with
    -- the id in MeshId is enough. This only asks Roblox to download the mesh and reports
    -- whether it arrived, so a bad id shows "(failed)" in the Hair window.
    local function LoadHairTemplate(hairName)
        if templateStatus[hairName] == "ready" then
            return true
        end

        -- Another thread (the startup preload) is already fetching this hair: wait for it.
        if templateStatus[hairName] == "loading" then
            local waitedSeconds = 0
            while templateStatus[hairName] == "loading" and waitedSeconds < 30 do
                task.wait(0.1)
                waitedSeconds = waitedSeconds + 0.1
            end
            return templateStatus[hairName] == "ready"
        end

        templateStatus[hairName] = "loading"

        local probeMesh = Instance.new("SpecialMesh")
        probeMesh.MeshType = Enum.MeshType.FileMesh
        probeMesh.MeshId   = GetMeshId(hairName)

        local fetchStatus = Enum.AssetFetchStatus.Success
        local preloadOk, preloadError = pcall(function()
            ContentProvider:PreloadAsync({ probeMesh }, function(_, status)
                fetchStatus = status
            end)
        end)
        probeMesh:Destroy()

        if not preloadOk or fetchStatus ~= Enum.AssetFetchStatus.Success then
            -- "failed" is not final: picking the hair again tries it again.
            templateStatus[hairName] = "failed"
            warn("[Hair] Couldn't load " .. hairName .. " (" .. HairOffsets[hairName].AssetId .. "): "
                .. tostring(preloadOk and fetchStatus or preloadError))
            return false
        end

        templateStatus[hairName] = "ready"
        return true
    end

    -- Downloads every hair mesh now, in the background, so picking one is instant and a
    -- hair that can't load is reported at startup instead of on a pick.
    function HairSystem.Preload()
        local hairCount    = #HairSystem.HairNames
        local pendingCount = hairCount
        local loadedCount  = 0
        for _, hairName in ipairs(HairSystem.HairNames) do
            task.spawn(function()
                if LoadHairTemplate(hairName) then
                    loadedCount = loadedCount + 1
                end
                pendingCount = pendingCount - 1
                if pendingCount == 0 then
                    print("[Hair] Preloaded " .. loadedCount .. "/" .. hairCount .. " hairs")
                    if HairSystem.OnChanged then
                        HairSystem.OnChanged()
                    end
                end
            end)
        end
    end

    local function BuildHairModel(hairName)
        if not LoadHairTemplate(hairName) then return nil end

        local hairSettings = HairOffsets[hairName]

        local handle = Instance.new("Part")
        handle.Name = "Handle"
        handle.Size = Vector3.new(1, 1, 1)

        local hairMesh = Instance.new("SpecialMesh")
        hairMesh.MeshType    = Enum.MeshType.FileMesh
        hairMesh.MeshId      = GetMeshId(hairName)
        hairMesh.TextureId   = ""
        hairMesh.Scale       = Vector3.new(1, 1, 1)
        hairMesh.VertexColor = Vector3.new(1, 1, 1)
        hairMesh.Parent      = handle

        local customHairModel = Instance.new("Model")
        customHairModel.Name = HairSystem.ModelName
        handle.Parent = customHairModel
        customHairModel.PrimaryPart = handle

        handle.Anchored     = false
        handle.CanCollide   = false
        handle.CanQuery     = false
        handle.CanTouch     = false
        handle.Massless     = true
        handle.CastShadow   = false
        handle.Transparency = 0
        handle.Material     = Enum.Material.Neon
        handle.Color        = HairSystem.Colors[HairSystem.CurrentForm]

        local customHairLight = Instance.new("PointLight")
        customHairLight.Color      = HairSystem.LightColors[HairSystem.CurrentForm]
        customHairLight.Range      = 8
        customHairLight.Brightness = 1
        customHairLight.Parent     = handle

        customHairModel.Parent = character
        handle.CFrame = headPart.CFrame
            * CFrame.new(0, hairSettings.YOffset, hairSettings.ZOffset)
            * CFrame.Angles(0, math.rad(hairSettings.RotationY), 0)

        local headWeld = Instance.new("WeldConstraint")
        headWeld.Part0  = headPart
        headWeld.Part1  = handle
        headWeld.Parent = handle

        return customHairModel
    end

    function HairSystem.IsActive()
        return HairSystem.Model ~= nil and HairSystem.Model.Parent ~= nil
    end

    function HairSystem.GetSelectedIndex()
        for hairIndex, hairName in ipairs(HairSystem.HairNames) do
            if hairName == HairSystem.SelectedName then
                return hairIndex
            end
        end
        return nil
    end

    function HairSystem.ApplyFormLook(formName, animated)
        local customHairModel = HairSystem.Model
        if not customHairModel or not customHairModel.Parent then return end

        local formColor  = HairSystem.Colors[formName]
        local lightColor = HairSystem.LightColors[formName]
        for _, descendant in ipairs(customHairModel:GetDescendants()) do
            local targetColor
            if descendant:IsA("BasePart") then
                targetColor = formColor
            elseif descendant:IsA("PointLight") then
                targetColor = lightColor
            end
            if targetColor then
                if animated then
                    TweenService:Create(descendant, formTweenInfo, { Color = targetColor }):Play()
                else
                    descendant.Color = targetColor
                end
            end
        end
    end

    function HairSystem.SetForm(formName)
        HairSystem.CurrentForm = formName
        if not HairSystem.IsActive() then
            return false
        end
        HairSystem.ApplyFormLook(formName, true)
        return true
    end

    local function FindColorOption(optionName)
        for _, option in ipairs(HairSystem.ColorOptions) do
            if option.name == optionName then
                return option
            end
        end
        return nil
    end

    function HairSystem.GetBaseOption()
        return FindColorOption(HairSystem.BaseColorName)
    end

    function HairSystem.GetUltimateOption()
        return FindColorOption(HairSystem.UltimateColorName)
    end

    -- The aura particle colour of an option as a ColorSequence.
    function HairSystem.AuraSequence(option)
        return ColorSequence.new({
            ColorSequenceKeypoint.new(0,   option.aura[1]),
            ColorSequenceKeypoint.new(0.3, option.aura[2]),
            ColorSequenceKeypoint.new(0.7, option.aura[3]),
            ColorSequenceKeypoint.new(1,   option.aura[4]),
        })
    end

    -- The normal hair (not a custom one) carries its own spotlight; keep it in step
    -- with the form that is on right now (SSJ = Base Hair color, SSJB = Ultimate Color).
    -- Recolors the normal hair (GokuSSJHair) to the picked Base Hair color / Ultimate
    -- Color. The normal hair is a clone of the game's own mesh, so it is never touched
    -- by ApplyFormLook (that only handles custom hairs). The original colour of each
    -- part is remembered in an attribute so picking the default colour puts it back.
    function HairSystem.RecolorDefaultHair()
        local form = HairSystem.CurrentForm
        if form ~= "SSJ" and form ~= "SSJB" then return end
        local defaultHair = character and character:FindFirstChild("GokuSSJHair")
        if not defaultHair then return end

        -- the colours the game's own hair already has: no recolor needed for those
        local isOriginalLook
        if form == "SSJ" then
            isOriginalLook = HairSystem.BaseColorName == "Super Saiyan"
        else
            isOriginalLook = HairSystem.UltimateColorName == "SS Blue"
        end
        local formColor = HairSystem.Colors[form]

        local parts = defaultHair:GetDescendants()
        table.insert(parts, defaultHair)
        for _, d in ipairs(parts) do
            if d:IsA("BasePart") then
                if d:GetAttribute("OrigHairColor") == nil then
                    d:SetAttribute("OrigHairColor", d.Color)
                end
                if isOriginalLook then
                    d.Color = d:GetAttribute("OrigHairColor")
                else
                    d.Color = formColor
                end
            end
        end
    end

    function HairSystem.RefreshDefaultLight()
        if HairSystem.CurrentForm ~= "SSJ" and HairSystem.CurrentForm ~= "SSJB" then return end
        pcall(HairSystem.RecolorDefaultHair)
        local lightColor = HairSystem.LightColors[HairSystem.CurrentForm]
        local defaultHair = character and character:FindFirstChild("GokuSSJHair")
        local defaultLight = defaultHair and defaultHair:FindFirstChildWhichIsA("PointLight", true)
        if defaultLight and lightColor then
            defaultLight.Color = lightColor
        end
    end

    -- Picks the Base Hair color (hair + spotlight when we are not SSJB) by option name.
    -- Returns true when the name is valid.
    function HairSystem.SetBaseColor(optionName)
        local option = FindColorOption(optionName)
        if not option then return false end
        HairSystem.BaseColorName = option.name
        HairSystem.Colors.SSJ = option.color
        HairSystem.LightColors.SSJ = option.light
        if HairSystem.IsActive() and HairSystem.CurrentForm == "SSJ" then
            HairSystem.ApplyFormLook("SSJ", true)
        end
        HairSystem.RefreshDefaultLight()
        return true
    end

    -- Picks the Ultimate Color (SSJB hair + spotlight, and the SSJB effect colours).
    function HairSystem.SetUltimateColor(optionName)
        local option = FindColorOption(optionName)
        if not option then return false end
        HairSystem.UltimateColorName = option.name
        HairSystem.Colors.SSJB = option.color
        HairSystem.LightColors.SSJB = option.light
        if HairSystem.IsActive() and HairSystem.CurrentForm == "SSJB" then
            HairSystem.ApplyFormLook("SSJB", true)
        end
        HairSystem.RefreshDefaultLight()
        return true
    end

    -- The colour M1 punch visuals take: the Ultimate Color while we are SSJB, otherwise
    -- the Base Hair color (the same colour the hair has right now).
    function HairSystem.GetPunchColor()
        if HairSystem.CurrentForm == "SSJB" then
            return HairSystem.Colors.SSJB
        end
        return HairSystem.Colors.SSJ
    end

    -- Recolours a cloned effect (particles, beams, trails, lights) to the punch colour.
    function HairSystem.TintPunchEffect(container)
        local punchColor = HairSystem.GetPunchColor()
        local punchSequence = ColorSequence.new(punchColor)
        local items = container:GetDescendants()
        table.insert(items, container)
        for _, item in ipairs(items) do
            if item:IsA("ParticleEmitter") or item:IsA("Beam") or item:IsA("Trail") then
                item.Color = punchSequence
            elseif item:IsA("Light") then
                item.Color = punchColor
            end
        end
    end

    function HairSystem.Equip(hairName)
        if not HairOffsets[hairName] then
            warn("[Hair] Unknown hair: " .. tostring(hairName))
            return
        end

        equipToken = equipToken + 1
        local myToken = equipToken

        task.spawn(function()
            if not LoadHairTemplate(hairName) then
                -- the load already warned why; refresh the window so it shows "(failed)"
                if equipToken == myToken and HairSystem.OnChanged then
                    HairSystem.OnChanged()
                end
                return
            end
            if equipToken ~= myToken then return end -- a newer pick replaced this one

            local previousModel = HairSystem.Model
            local buildOk, builtModel = pcall(BuildHairModel, hairName)
            if not buildOk then
                warn("[Hair] Couldn't build " .. hairName .. ": " .. tostring(builtModel))
                builtModel = nil
            end
            if not builtModel then
                templateStatus[hairName] = "failed" -- picking it again retries the build
                if equipToken == myToken and HairSystem.OnChanged then
                    HairSystem.OnChanged()
                end
                return
            end

            local regularHair = character:FindFirstChild("GokuSSJHair")
            if regularHair then
                regularHair:Destroy()
            end
            if previousModel then
                previousModel:Destroy()
            end

            HairSystem.Model        = builtModel
            HairSystem.SelectedName = hairName
            templateStatus[hairName] = "ready"
            print("[Hair] Equipped " .. hairName)
            if HairSystem.OnChanged then
                HairSystem.OnChanged()
            end
        end)
    end

    function HairSystem.Reset()
        equipToken = equipToken + 1

        local hadCustomHair = HairSystem.Model ~= nil
        if HairSystem.Model then
            HairSystem.Model:Destroy()
            HairSystem.Model = nil
        end
        HairSystem.SelectedName = nil

        if hadCustomHair and HairSystem.RestoreDefaultHair then
            HairSystem.RestoreDefaultHair(HairSystem.CurrentForm)
        end
        if HairSystem.OnChanged then
            HairSystem.OnChanged()
        end
    end

    -- Saved hair (DLC tab > Hair > Save). The hair is stored by name in SaveFile;
    -- "Default" means no custom hair (the normal form hair stays on).
    local HttpService = game:GetService("HttpService")

    -- Returns the saved hair name, or nil when nothing valid is saved or Default was saved.
    function HairSystem.ReadSaved()
        if not isfile(HairSystem.SaveFile) then return nil end

        local readOk, decoded = pcall(function()
            return HttpService:JSONDecode(readfile(HairSystem.SaveFile))
        end)
        if not readOk or type(decoded) ~= "table" then return nil end

        if HairOffsets[decoded.hair] then
            return decoded.hair
        end
        return nil
    end

    -- Returns the saved Base Hair color name and Ultimate Color name (each nil when none is saved).
    function HairSystem.ReadSavedColors()
        if not isfile(HairSystem.SaveFile) then return nil, nil end

        local readOk, decoded = pcall(function()
            return HttpService:JSONDecode(readfile(HairSystem.SaveFile))
        end)
        if not readOk or type(decoded) ~= "table" then return nil, nil end

        local savedBase = type(decoded.baseColor) == "string" and decoded.baseColor or nil
        local savedUltimate = type(decoded.ultimateColor) == "string" and decoded.ultimateColor or nil
        return savedBase, savedUltimate
    end

    -- Writes the hair by name (nil = Default) and both colours. Returns true when the file was written.
    function HairSystem.WriteSaved(hairName)
        local writeOk, writeError = pcall(function()
            writefile(HairSystem.SaveFile, HttpService:JSONEncode({
                hair = hairName or "Default",
                baseColor = HairSystem.BaseColorName,
                ultimateColor = HairSystem.UltimateColorName,
            }))
        end)
        if not writeOk then
            warn("[Hair] Couldn't save the hair: " .. tostring(writeError))
        end
        return writeOk
    end

    -- Wears the saved hair, if there is one (called after the default hair exists at startup).
    function HairSystem.ApplySaved()
        local savedBaseColor, savedUltimateColor = HairSystem.ReadSavedColors()
        if savedBaseColor then
            HairSystem.SetBaseColor(savedBaseColor)
        end
        if savedUltimateColor then
            HairSystem.SetUltimateColor(savedUltimateColor)
        end

        local savedHairName = HairSystem.ReadSaved()
        if savedHairName then
            HairSystem.Equip(savedHairName)
        end
    end
end

