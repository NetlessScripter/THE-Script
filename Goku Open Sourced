                index = index % #cutsceneShots + 1
                local shot = cutsceneShots[index]

                cutsceneToken += 1
                local token = cutsceneToken

                if firstShot then
                    fadeScreen(0, FIRST_SHOT_FADE_OUT, Style.Sine, Dir.InOut)
                    task.wait(FIRST_SHOT_FADE_OUT + 0.05)
                    if not (cutsceneRunning and token == cutsceneToken and env.BorderUICutsceneId == cutsceneId) then
                        return
                    end
                end

                camera.CameraType = Enum.CameraType.Scriptable
                camera.CFrame = shot.from
                camera.FieldOfView = shot.fromFov

                fadeFrame.BackgroundTransparency = 0
                fadeScreen(1, firstShot and FIRST_SHOT_FADE_IN or SHOT_FADE_TIME, Style.Sine, Dir.Out)
                firstShot = false

                local progress = Instance.new("NumberValue")
                progress.Value = 0
                local glide = progress.Changed:Connect(function(value)
                    if cameraRestored or env.BorderUICutsceneId ~= cutsceneId then return end
                    local a = shotCurve(math.clamp(value, 0, 1))
                    camera.CFrame = shot.from:Lerp(shot.to, a) * swayOffset(os.clock())
                    camera.FieldOfView = lerp(shot.fromFov, shot.toFov, a)
                end)

                local tween = TweenService:Create(progress, TweenInfo.new(SHOT_DURATION, Enum.EasingStyle.Linear), {
                    Value = 1,
                })
                env.BorderUICutsceneTween = tween
                tween:Play()

                task.delay(SHOT_DURATION - SHOT_FADE_TIME, function()
                    if cutsceneRunning and token == cutsceneToken then
                        fadeScreen(0, SHOT_FADE_TIME, Style.Sine, Dir.In)
                    end
                end)

