                    animate(0.85, Style.Quint, Dir.Out, startDelay, function(alpha)
                        if closing then return end
                        piece.element.Position = RISE_POSITION:Lerp(REST_POSITION, alpha)
                    end)
                    animate(0.5, Style.Sine, Dir.Out, startDelay, function(alpha)
                        if closing then return end
                        piece.fade.apply(alpha)
                    end)
                end

                local function typeLabel(label, text, charDelay)
                    local total = utf8.len(text) or #text
                    label.MaxVisibleGraphemes = 0
                    local startedAt = os.clock()
                    local shown = 0
                    while shown < total do
                        if closing or not label.Parent then
                            return
                        end
                        local due = math.min(total, math.floor((os.clock() - startedAt) / charDelay) + 1)
                        if due ~= shown then
                            shown = due
                            label.MaxVisibleGraphemes = shown
                        end
                        if shown < total then
                            RunService.Heartbeat:Wait()
                        end
                    end
                    label.MaxVisibleGraphemes = -1
                end

                task.spawn(function()
                    task.wait(0.5)
                    typeLabel(titleText, "Update Log", 0.05)
                end)
                task.spawn(function()
                    task.wait(0.85)
                    typeLabel(messageLabel, plainMessage, 0.022)
                end)
                task.delay(1.0, function()
                    ready = true
                end)

                okButton.Activated:Connect(function()
                    if closing or not ready then return end
                    closing = true

                    if not testing then
                        seenDates[dateKey] = true
                        writeSeen(seenDates)
                    end

                    titleText.MaxVisibleGraphemes = -1
                    messageLabel.MaxVisibleGraphemes = -1

                    animate(0.4, Style.Quad, Dir.In, 0, function(alpha)
                        dim.BackgroundTransparency = 0.5 + 0.5 * alpha
                    end)
                    for index, piece in ipairs(pieces) do
                        animate(0.35, Style.Quad, Dir.In, 0.05 * (index - 1), function(alpha)
                            piece.element.Position = REST_POSITION:Lerp(LIFT_POSITION, alpha)
                            piece.fade.apply(1 - alpha)
                        end)
                    end

                    task.wait(0.8)
                    gui:Destroy()
                end)
            end)

            if not built then
                warn("[BirthdayPopup] Failed to show popup: " .. tostring(buildError))
            end
        end)
    end
end

local function IsCharacterPart(part)
    local ancestor = part.Parent
    while ancestor do
        if ancestor:IsA("Model") and ancestor:FindFirstChildOfClass("Humanoid") then
            return true
        end
        ancestor = ancestor.Parent
    end
    return false
end

do
    local concreteTextureUrl  = "https://raw.githubusercontent.com/NetlessScripter/Texture-Reworks/refs/heads/main/IMG_3562.png"
    local concreteTextureFile = "ConcreteReplace.png"

    if not isfile(concreteTextureFile) then
        writefile(concreteTextureFile, game:HttpGet(concreteTextureUrl))
    end

    local getAsset = getcustomasset or getsynasset
    local concreteAssetId = getAsset(concreteTextureFile)

    local studsPerTile = 4

    local faceList = {
        Enum.NormalId.Top,
        Enum.NormalId.Bottom,
        Enum.NormalId.Front,
        Enum.NormalId.Back,
        Enum.NormalId.Left,
        Enum.NormalId.Right,
    }

    local function ApplyConcreteTexture(part)

        local tintColor = part.Color

        for _, face in ipairs(faceList) do
            local existing = part:FindFirstChild("ConcreteReplace_" .. face.Name)
            local tex = existing or Instance.new("Texture")
            tex.Name          = "ConcreteReplace_" .. face.Name
            tex.Texture       = concreteAssetId
            tex.Face          = face
            tex.Color3        = tintColor
            tex.StudsPerTileU = studsPerTile
            tex.StudsPerTileV = studsPerTile
            tex.Parent        = part
        end
    end

    local mapFolder = Workspace:FindFirstChild("Map")
    if mapFolder then
        for _, obj in ipairs(mapFolder:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Material == Enum.Material.Concrete and not IsCharacterPart(obj) then
                ApplyConcreteTexture(obj)
            end
        end

        mapFolder.DescendantAdded:Connect(function(obj)
            if obj:IsA("BasePart") and obj.Material == Enum.Material.Concrete and not IsCharacterPart(obj) then
                ApplyConcreteTexture(obj)
            end
        end)
    else
        warn("[ConcreteReplacer] Workspace.Map folder not found.")
    end
end

