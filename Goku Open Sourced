    local function tweenValue(tweenInfo, callback)
        local value = Instance.new("NumberValue")
        value.Value = 0
        local connection = value.Changed:Connect(callback)

        local tween = trackTween(TweenService:Create(value, tweenInfo, { Value = 1 }))
        tween.Completed:Connect(function(playbackState)
            if playbackState == Enum.PlaybackState.Completed then
                callback(1)
            end
            connection:Disconnect()
            value:Destroy()
        end)
        tween:Play()
        return tween
    end

    local function makeFadeGroup(...)
        local entries = {}

        local function consider(instance)
            if instance:GetAttribute("NoFade") then return end
            if instance:IsA("GuiObject") then
                table.insert(entries, { instance, "BackgroundTransparency", instance.BackgroundTransparency })
                if instance:IsA("TextLabel") or instance:IsA("TextButton") then
                    table.insert(entries, { instance, "TextTransparency", instance.TextTransparency })
                end
            elseif instance:IsA("UIStroke") then
                table.insert(entries, { instance, "Transparency", instance.Transparency })
            end
        end

        for _, root in ipairs({ ... }) do
            consider(root)
            for _, descendant in ipairs(root:GetDescendants()) do
                consider(descendant)
            end
        end

        local group = { value = 1 }
        function group.apply(visibility)
            visibility = math.clamp(visibility, 0, 1)
            group.value = visibility
            for _, entry in ipairs(entries) do
                entry[1][entry[2]] = 1 - (1 - entry[3]) * visibility
            end
        end
        return group
    end

    local function tweenFade(group, target, tweenInfo)
        local from = group.value
        return tweenValue(tweenInfo, function(alpha)
            group.apply(from + (target - from) * alpha)
        end)
    end

    local function lerpSequence(from, to, t)
        local a, b = from.Keypoints, to.Keypoints
        if #a ~= #b then
            return (t < 0.5) and from or to
        end
        local keypoints = table.create(#a)
        for i = 1, #a do
            keypoints[i] = ColorSequenceKeypoint.new(a[i].Time, a[i].Value:Lerp(b[i].Value, t))
        end
        return ColorSequence.new(keypoints)
    end

