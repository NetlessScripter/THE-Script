local localPlayer    = Players.LocalPlayer
local character      = localPlayer.Character or localPlayer.CharacterAdded:Wait()
local humanoid       = character:WaitForChild("Humanoid")
local animator       = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
local rootPart       = character:WaitForChild("HumanoidRootPart")
local headPart       = character:WaitForChild("Head")
local hotbar         = localPlayer.PlayerGui:WaitForChild("Hotbar"):WaitForChild("Backpack"):WaitForChild("Hotbar")

-- ===== Respawn support ====================================================
-- Everything in this file used to be wired to the first character only, so it
-- all stopped once you died. Now the character variables above are refreshed
-- every time a new character spawns, and every piece of code that attaches
-- itself to the character (event listeners, hair, clothing, HUD styling...) is
-- registered through CharacterHooks.Add: it runs once right away and again on
-- each respawn. (One table = one local, the file is close to Luau's limit.)
local CharacterHooks = { list = {}, hudToken = 0 }

-- Walks PlayerGui down to the hotbar without yielding; nil while the game is
-- still rebuilding its HUD after a respawn.
function CharacterHooks.FindHotbar()
    local playerGui = localPlayer:FindFirstChild("PlayerGui")
    local hudRoot   = playerGui and playerGui:FindFirstChild("Hotbar")
    local backpack  = hudRoot and hudRoot:FindFirstChild("Backpack")
    return backpack and backpack:FindFirstChild("Hotbar")
end

function CharacterHooks.Run(hook)
    local hookOk, hookError = pcall(hook)
    if not hookOk then
        warn("[Respawn] " .. tostring(hookError))
    end
end

-- Runs `hook` now and again for every new character.
function CharacterHooks.Add(hook)
    table.insert(CharacterHooks.list, hook)
    CharacterHooks.Run(hook)
end

function CharacterHooks.OnAnimationPlayed(callback)
    CharacterHooks.Add(function()
        humanoid.AnimationPlayed:Connect(callback)
    end)
end

function CharacterHooks.OnChildAdded(callback)
    CharacterHooks.Add(function()
        character.ChildAdded:Connect(callback)
    end)
end

localPlayer.CharacterAdded:Connect(function(newCharacter)
    local newHumanoid = newCharacter:WaitForChild("Humanoid", 15)
    local newRoot     = newCharacter:WaitForChild("HumanoidRootPart", 15)
    local newHead     = newCharacter:WaitForChild("Head", 15)
    if not (newHumanoid and newRoot and newHead) then return end
    if localPlayer.Character ~= newCharacter then return end -- already replaced by an even newer one

    character = newCharacter
    humanoid  = newHumanoid
    animator  = newHumanoid:FindFirstChildOfClass("Animator") or newHumanoid:WaitForChild("Animator", 5) or Instance.new("Animator", newHumanoid)
    rootPart  = newRoot
    headPart  = newHead
    hotbar    = CharacterHooks.FindHotbar() or hotbar

    for _, hook in ipairs(CharacterHooks.list) do
        if localPlayer.Character ~= newCharacter then return end
        CharacterHooks.Run(hook)
    end
end)

