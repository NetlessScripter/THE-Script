                local function styleText(label, strokeThickness, gradientColors)
                    label.FontFace = panelFont
                    label.TextColor3 = WHITE
                    label.TextStrokeTransparency = 1

                    local textStroke = Instance.new("UIStroke")
                    textStroke.Name = "TextOutline"
                    textStroke.Color = Color3.new(0, 0, 0)
                    textStroke.Thickness = strokeThickness
                    textStroke.LineJoinMode = Enum.LineJoinMode.Round
                    textStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
                    textStroke.Parent = label

                    local textGradient = Instance.new("UIGradient")
                    textGradient.Name = "TextGradient"
                    textGradient.Rotation = 90
                    textGradient.Color = gradientColors
                    textGradient.Parent = label
                end

                local function makeFadeGroup(root)
                    local entries = {}

                    local function consider(instance)
                        if instance:GetAttribute("NoFade") then return end
                        if instance:IsA("GuiObject") then
                            table.insert(entries, { instance, "BackgroundTransparency", instance.BackgroundTransparency })
                            if instance:IsA("TextLabel") or instance:IsA("TextButton") then
                                table.insert(entries, { instance, "TextTransparency", instance.TextTransparency })
                            end
                        elseif instance:IsA("UIStroke") then
                            table.insert(entries, { instance, "Transparency", instance.Transparency })
                        end
                    end

                    consider(root)
                    for _, descendant in ipairs(root:GetDescendants()) do
                        consider(descendant)
                    end

                    local group = { value = 1 }
                    function group.apply(visibility)
                        visibility = math.clamp(visibility, 0, 1)
                        group.value = visibility
                        for _, entry in ipairs(entries) do
                            entry[1][entry[2]] = 1 - (1 - entry[3]) * visibility
                        end
                    end
                    return group
                end

                local okParent, guiParent = pcall(function()
