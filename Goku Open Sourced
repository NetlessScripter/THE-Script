        sfx.Volume = 1
        sfx.RollOffMinDistance = PX.TeleportMin
        sfx.RollOffMaxDistance = PX.TeleportMax
        sfx.Parent = root
        sfx:Play()
        Debris:AddItem(sfx, 5)
    end

    -- the same flicker DoTeleport does on my character
