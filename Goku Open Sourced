        mapFolder.DescendantAdded:Connect(function(obj)
            if obj:IsA("BasePart") and obj.Material == Enum.Material.Wood and not IsCharacterPart(obj) then
                ApplyWoodTexture(obj)
            end
        end)
    else
        warn("[WoodReplacer] Workspace.Map folder not found.")
    end
end

