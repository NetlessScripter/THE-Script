                    if MENU_SWAY_ENABLED then
                        local easeIn = math.clamp((elapsed - MENU_FLY_TIME * 0.35) / MENU_SWAY_EASE_IN, 0, 1)
                        swayAmount = easeIn * easeIn * (3 - 2 * easeIn)
