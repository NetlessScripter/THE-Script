local function DownloadSongFile(url, filename)
    if not isfile(filename) then
        writefile(filename, game:HttpGet(url))
    end

    local readOk, contents = pcall(readfile, filename)
    if not readOk or #contents < minValidSongFileBytes then
        writefile(filename, game:HttpGet(url))
    end
end

-- Install record. Every install writes this JSON file:
--   { "count": <how many pack songs are installed>, "installed": [ <their names> ] }
local dbPackManifestFile = "DBMusicPack.json"

-- Returns the recorded names as a set. A missing or unreadable file = nothing recorded.
local function ReadDbPackManifest()
    local recorded = {}
    if not isfile(dbPackManifestFile) then return recorded end

    local readOk, decoded = pcall(function()
        return game:GetService("HttpService"):JSONDecode(readfile(dbPackManifestFile))
    end)
    if readOk and type(decoded) == "table" and type(decoded.installed) == "table" then
        for _, name in ipairs(decoded.installed) do
            recorded[name] = true
        end
    end
    return recorded
end

-- Adds one song to the record and rewrites the JSON (count + names, in pack order).
-- Names whose file has since gone missing are dropped so the record stays truthful.
local function RecordDbPackSongInstalled(songName)
    local recorded = ReadDbPackManifest()
    recorded[songName] = true

    local names = {}
    for _, song in ipairs(dbSongs) do
        if recorded[song.name] and (song.name == songName or isfile(song.file)) then
            table.insert(names, song.name)
        end
    end

    writefile(dbPackManifestFile, game:GetService("HttpService"):JSONEncode({
        count = #names,
        installed = names,
    }))
end

-- Checks the script's pack list against the record. Returns the names that are
-- installed and the songs that still need installing (new songs added to the
-- script, or ones whose file is gone).
local function GetDbPackStatus()
    local recorded = ReadDbPackManifest()
    local installedNames = {}
    local missingSongs = {}
    for _, song in ipairs(dbSongs) do
        if recorded[song.name] and isfile(song.file) then
            table.insert(installedNames, song.name)
        else
            table.insert(missingSongs, song)
        end
    end
    return installedNames, missingSongs
end

-- Downloads one pack song and checks the file is real (a failed download can
-- leave a tiny error page behind - that gets deleted so it can't pass as installed).
local function InstallDbPackSong(song)
    DownloadSongFile(song.url, song.file)
    local readOk, contents = pcall(readfile, song.file)
    if not readOk or #contents < minValidSongFileBytes then
        pcall(delfile, song.file)
        error("downloaded file was invalid")
    end
end

local function GetGitSound(url, filename)
    DownloadSongFile(url, filename)
    local getAsset = getcustomasset or getsynasset
    local sound = Instance.new("Sound")
    sound.SoundId = getAsset(filename)
    sound.Parent  = Workspace
    return sound
end

local function WaitForSoundToLoad(sound, timeoutSeconds)
    if sound.IsLoaded then return end
    local isLoaded = false
    local loadedConnection
    loadedConnection = sound.Loaded:Connect(function()
        isLoaded = true
    end)
    local elapsedSeconds = 0
    while not isLoaded and not sound.IsLoaded and elapsedSeconds < timeoutSeconds do
        task.wait(0.1)
        elapsedSeconds = elapsedSeconds + 0.1
    end
    loadedConnection:Disconnect()
end

local musicActive            = true
local currentSongIndex       = nil
local usedStartingSong       = false
local currentMusicSound      = nil
local prematureEndRetryCount = 0
local currentFadeInTween      = nil
local playbackGeneration     = 0

-- Which pack the shuffle draws from: "Regular" (musicSongs) or "DB" (dbSongs).
-- Only one is ever active; picking a song from the other pack's dropdown
-- switches it on and this one off.
local activePack = "Regular"

-- ===== Tournament of Power event hook =====================================
-- Kept in ONE table (not many locals) because this file is close to Luau's
-- local-variable limit. The trigger is the same condition the event script
-- waits for: this user saying this exact line in chat. When it fires, the
-- current song fades out, the event songs take over (and can't be changed),
-- and teleporting is locked for a cooldown.
local EventMode = {
    userId           = 8029999470,
    phrase           = "Okay, Beginning now.",
    fadeTime         = 0.7,   -- seconds the current song takes to fade out
    teleportCooldown = 15,    -- seconds teleporting is locked once the event begins
    -- The first two songs always play in this order: { pack, name }. A song whose
    -- pack isn't installed (Super Saiyan Blue without the DLC) is skipped, and
    -- nothing is ever downloaded for the event.
    openingSongs     = { { "DB", "Super Saiyan Blue" }, { "Regular", "where am i supposed to go" } },
    -- After those, the shuffle runs forever. DLC installed: the best DLC songs
    -- (only installed ones) plus the regular songs below. DLC not installed: the
    -- regular songs only.
    dbSongPool       = { "Super Saiyan Blue", "Fighting Spirit", "Sparking Battle", "Final Battle", "Vegito Vs Zamasu", "Trouble Erupts" },
    regularSongPool  = { "where am i supposed to go", "Kanye West - Flashing Lights", "yves tumor - limerence", "oblivion", "do i clench my fists?" },
    opening          = {},        -- the openingSongs that can actually play, set when the event begins
    pool             = {},        -- { pack, name } entries the shuffle draws from, set when the event begins
    lastPick         = nil,       -- the last { pack, name } played (so the shuffle never repeats it)
    active           = false,     -- true from the moment the event begins
    teleportReadyAt  = 0,         -- os.clock() time teleporting becomes available again
    songsStarted     = 0,
}

-- Plays the opening songs in order, then shuffles the pool forever (never the
-- same song twice in a row). Songs can come from either pack, so this also
-- switches activePack to the pack the song lives in before returning its index.
function EventMode.PickNextSongIndex()
    EventMode.songsStarted = EventMode.songsStarted + 1

    local pick = EventMode.opening[EventMode.songsStarted]
    if not pick then
        local pool = EventMode.pool
        local previous = EventMode.lastPick
        if #pool == 1 then
            pick = pool[1]
        else
            repeat
                pick = pool[math.random(#pool)]
            until not previous or previous[1] ~= pick[1] or previous[2] ~= pick[2]
        end
    end
    EventMode.lastPick = pick

    activePack = pick[1]
    local songs = pick[1] == "DB" and dbSongs or musicSongs
    for index, song in ipairs(songs) do
        if song.name == pick[2] then
            return index
        end
    end
    return 1
end

local function GetSongsForPack(packName)
    return packName == "DB" and dbSongs or musicSongs
end

local function FindSongIndexByName(name)
    local songs = GetSongsForPack(activePack)
    local wanted = name:lower():gsub("^%s+", ""):gsub("%s+$", "")
    -- 1) exact name, 2) exact file name (with or without .mp3), 3) name contains the text
    for i, song in ipairs(songs) do
        if song.name:lower() == wanted then
            return i
        end
    end
    for i, song in ipairs(songs) do
        local fileLower = song.file:lower()
        if fileLower == wanted or fileLower:gsub("%.mp3$", "") == wanted then
            return i
        end
    end
    for i, song in ipairs(songs) do
        if song.name:lower():find(wanted, 1, true) then
            return i
        end
    end
    return nil
end

local function PickNextSongIndex()
    local songCount = #GetSongsForPack(activePack)
    if songCount == 1 then return 1 end
    local index
    repeat
        index = math.random(songCount)
    until index ~= currentSongIndex
    return index
end

-- Song speed. PlaybackSpeed changes speed and pitch together (like a record):
-- slower is lower, faster is higher.
local function ApplyMusicSpeedToSound(sound)
    sound.PlaybackSpeed = musicPlaybackSpeed
end

local function SetMusicSpeed(newSpeed)
    local clampedSpeed = math.clamp(newSpeed, musicSpeedMinimum, musicSpeedMaximum)
    musicPlaybackSpeed = math.floor(clampedSpeed * 100 + 0.5) / 100

    local activeSound = currentMusicSound
    if activeSound and activeSound.Parent then
        ApplyMusicSpeedToSound(activeSound)
    end
end

-- Song reverb. Every music Sound gets one ReverbSoundEffect, created the first
-- time reverb is needed on it and switched off (not destroyed) when the preset
-- is "Off". Each new song picks the current preset / mix up in PlaySoundCycle.
local function ApplyMusicReverbToSound(sound)
    local reverbEffect = sound:FindFirstChild("MusicReverb")
    local preset = musicReverbPresets[musicReverbPresetIndex]

    if not preset.decayTime then
        if reverbEffect then
            reverbEffect.Enabled = false
        end
        return
    end

    if not reverbEffect then
        reverbEffect = Instance.new("ReverbSoundEffect")
        reverbEffect.Name = "MusicReverb"
        reverbEffect.Parent = sound
    end

    local wetLevel = musicReverbWetSilent
    if musicReverbMix > 0 then
        wetLevel = musicReverbWetQuietest + musicReverbMix * (musicReverbWetLoudest - musicReverbWetQuietest)
    end

    reverbEffect.DecayTime = preset.decayTime
    reverbEffect.Density   = preset.density
    reverbEffect.Diffusion = preset.diffusion
    reverbEffect.DryLevel  = musicReverbDryLevel
    reverbEffect.WetLevel  = wetLevel
    reverbEffect.Enabled   = true
end

local function SetMusicReverbPreset(presetIndex)
    if not musicReverbPresets[presetIndex] then return end
    musicReverbPresetIndex = presetIndex

    local activeSound = currentMusicSound
    if activeSound and activeSound.Parent then
        ApplyMusicReverbToSound(activeSound)
    end
end

local function SetMusicReverbMix(newMix)
    musicReverbMix = math.clamp(math.floor(newMix / musicReverbMixStep + 0.5) * musicReverbMixStep, 0, 1)

    local activeSound = currentMusicSound
    if activeSound and activeSound.Parent then
        ApplyMusicReverbToSound(activeSound)
    end
end

local function PlaySoundCycle(isRetryingCurrentSong, forcedSongIndex)
    if not musicActive then return end

    -- Every cycle gets a generation number. If something newer starts (a song
    -- picked from the panel, music toggled off/on) the older cycle sees the
    -- mismatch and stops itself instead of chaining into another random song.
    playbackGeneration = playbackGeneration + 1
    local myGeneration = playbackGeneration

    if forcedSongIndex then
        prematureEndRetryCount = 0
        usedStartingSong = true
        currentSongIndex = forcedSongIndex
    elseif isRetryingCurrentSong then
        prematureEndRetryCount = prematureEndRetryCount + 1
    else
        prematureEndRetryCount = 0
        if EventMode.active then
            currentSongIndex = EventMode.PickNextSongIndex()
        elseif not usedStartingSong then
            usedStartingSong = true
            local startIndex = (typeof(_G.StartingSong) == "string" and _G.StartingSong ~= "") and FindSongIndexByName(_G.StartingSong)
            if typeof(_G.StartingSong) == "string" and _G.StartingSong ~= "" and not startIndex then
                warn("[Music] StartingSong \"" .. _G.StartingSong .. "\" didn't match any song, picking randomly")
            end
            currentSongIndex = startIndex or PickNextSongIndex()
        else
            currentSongIndex = PickNextSongIndex()
        end
    end

    local entry = GetSongsForPack(activePack)[currentSongIndex]
    print("[Music] Now playing: " .. entry.name)

    local sound = GetGitSound(entry.url, entry.file)
    sound.Name   = entry.name
    sound.Volume = 0
    ApplyMusicSpeedToSound(sound)
    ApplyMusicReverbToSound(sound)
    currentMusicSound = sound

    WaitForSoundToLoad(sound, 5)
    if not musicActive or not sound.Parent or myGeneration ~= playbackGeneration then
        sound:Destroy()
        return
    end

    sound:Play()

    local fadeInTween = TweenService:Create(sound, TweenInfo.new(5, Enum.EasingStyle.Linear), { Volume = musicVolume })
    currentFadeInTween = fadeInTween
    fadeInTween:Play()

    local songFinished = false
    local function FinishSong(reachedEnd)
        if songFinished then return end
        songFinished = true
        sound:Destroy()

        if not musicActive then return end
        if myGeneration ~= playbackGeneration then return end

        if reachedEnd or prematureEndRetryCount >= maxPrematureEndRetries then
            PlaySoundCycle()
        else
            PlaySoundCycle(true)
        end
    end

    -- Whether the song got into its last couple of seconds. The old wall-clock
    -- check can't be used any more: speed changes and seeking make "time since
    -- it started" meaningless, and TimePosition may already be reset by the time
    -- Ended fires - so the position is watched while the song is still playing.
    local reachedSongEnd = false
    task.spawn(function()
        while not songFinished and sound.Parent do
            if sound.IsPlaying and sound.TimeLength > 0 then
                reachedSongEnd = sound.TimePosition >= sound.TimeLength - 2
            end
            task.wait(0.1)
        end
    end)

    sound.Ended:Connect(function()
        local reachedEnd = sound.TimeLength <= 0 or sound.TimePosition >= sound.TimeLength - 1 or reachedSongEnd
        FinishSong(reachedEnd)
    end)

    if entry.name:lower():find("lucy~", 1, true) then
        task.spawn(function()
            while not songFinished and musicActive and sound.Parent do
                while not songFinished and musicActive and sound.Parent and sound.TimePosition < LucyFadeOutStart do
                    task.wait(0.1)
                end
                if songFinished or not musicActive or not sound.Parent then return end

                local fadeOutDuration = math.max(LucySongCap - LucyFadeOutStart, 0.1)
                local fadeOutTween = TweenService:Create(sound, TweenInfo.new(fadeOutDuration, Enum.EasingStyle.Linear), { Volume = 0 })
                fadeOutTween:Play()

                -- Scrubbing back to before the fade-out start (Song Position
                -- slider) cancels the fade and brings the volume back.
                local scrubbedBack = false
                while not songFinished and musicActive and sound.Parent and sound.TimePosition < LucySongCap do
                    if sound.TimePosition < LucyFadeOutStart then
                        scrubbedBack = true
                        break
                    end
                    task.wait(0.1)
                end
                if songFinished then return end

                if not scrubbedBack then
                    sound:Stop()
                    FinishSong(true)
                    return
                end

                fadeOutTween:Cancel()
                if sound.Parent then
                    sound.Volume = musicVolume
                end
            end
        end)
    end
end

-- Immediately swaps whatever is playing for song `index` of the given pack
-- ("Regular" or "DB"; defaults to the active one) and makes that pack the active
-- pack. Used by the panel's song dropdowns.
local function PlaySongAtIndex(index, packName)
    if EventMode.active then return end -- songs can't be changed once the event has begun
    packName = packName or activePack
    if not GetSongsForPack(packName)[index] then return end

    activePack = packName
    playbackGeneration = playbackGeneration + 1

    if currentFadeInTween then
        currentFadeInTween:Cancel()
        currentFadeInTween = nil
    end
    if currentMusicSound then
        currentMusicSound:Stop()
        currentMusicSound:Destroy()
        currentMusicSound = nil
    end

    _G.Music    = true
    musicActive = true
    task.spawn(PlaySoundCycle, false, index)
end

-- The event begins: lock teleporting for its cooldown, fade the current song out
-- (0.7s, Sine InOut), then start the event songs. Defined here (after
-- PlaySoundCycle) so it can call it.
function EventMode.Begin()
    EventMode.teleportReadyAt = os.clock() + EventMode.teleportCooldown

    if EventMode.active then return end -- the music only switches over once
    EventMode.active       = true
    EventMode.songsStarted = 0

    -- Dash cooldown comes back (attribute removed = the game's normal state); the
    -- stun/freeze remover further down stops itself while the event is active
    Workspace:SetAttribute("NoDashCooldown", nil)

    -- Work out which DLC songs are installed. Opening songs and the shuffle pool
    -- are built from that; nothing is ever downloaded for the event.
    local statusOk, installedNames = pcall(GetDbPackStatus)
    local installed = {}
    if statusOk then
        for _, installedName in ipairs(installedNames) do
            installed[installedName] = true
        end
    end

    EventMode.opening  = {}
    EventMode.pool     = {}
    EventMode.lastPick = nil

    for _, openingSong in ipairs(EventMode.openingSongs) do
        if openingSong[1] == "Regular" or installed[openingSong[2]] then
            table.insert(EventMode.opening, openingSong)
        end
    end
    for _, poolName in ipairs(EventMode.dbSongPool) do
        if installed[poolName] then
            table.insert(EventMode.pool, { "DB", poolName })
        end
    end
    for _, poolName in ipairs(EventMode.regularSongPool) do
        table.insert(EventMode.pool, { "Regular", poolName })
    end
    activePack = EventMode.opening[1] and EventMode.opening[1][1] or "Regular"

    -- Take over: any running song cycle sees the new generation and stops chaining
    playbackGeneration = playbackGeneration + 1
    if currentFadeInTween then
        currentFadeInTween:Cancel()
        currentFadeInTween = nil
    end

    local oldSound = currentMusicSound
    task.spawn(function()
        local fadeStartedAt = os.clock()
        if oldSound and oldSound.Parent then
            TweenService:Create(
                oldSound,
                TweenInfo.new(EventMode.fadeTime, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                { Volume = 0 }
            ):Play()
        end

        local remaining = EventMode.fadeTime - (os.clock() - fadeStartedAt)
        if remaining > 0 then
            task.wait(remaining)
        end

        if oldSound then
            oldSound:Stop()
            oldSound:Destroy()
            if currentMusicSound == oldSound then
                currentMusicSound = nil
            end
        end

        -- If music is switched off in the panel nothing plays now, but turning it
        -- back on goes straight to the event songs
        if musicActive then
            PlaySoundCycle()
        end
    end)
end

