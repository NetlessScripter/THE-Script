        kind = "m1"
    else
        inst.ignored[track] = true
        return
    end

    inst.handled[track] = true
    track.Stopped:Once(function()
        inst.handled[track] = nil
    end)

    local now = os.clock()
    if kind == "teleport" then
        if now - inst.lastTeleport < PX.TeleportFlagSeconds then return end
        inst.lastTeleport = now
        task.spawn(PX.PlayTeleport, inst)
    elseif kind == "ssjb" then
        if now < inst.ssjbLockUntil then
            PX.Log(inst.plr.Name, "SSJB animation", id, "ignored (same transformation)")
            return
        end
        inst.ssjbLockUntil = now + PX.SSJBLockSeconds
        local offset = 0
        pcall(function() offset = track.TimePosition end)
        PX.Log(inst.plr.Name, "SSJB start from animation", id, "at", offset)
        task.spawn(PX.StartSSJB, inst, offset)
    elseif kind == "m1" then
        local data = PX.M1Anims[id]
        local last = inst.lastM1[data.key]
        if last and now - last < PX.M1FlagSeconds then return end
        inst.lastM1[data.key] = now
        PX.Log(inst.plr.Name, "M1", data.key, "animation", id)
        inst.m1MuteUntil = now + PX.M1MuteSeconds
        for _, obj in ipairs(inst.char:GetDescendants()) do
            PX.MuteSwing(obj)
        end
        task.spawn(PX.PlayM1, inst, data)
    else
        local token = inst.ssjbToken
        task.delay(PX.SSJBRevertDelay, function()
            if not inst.dead and inst.ssjbToken == token then
                PX.StopSSJB(inst)
            end
        end)
    end
end

local ActorInstances = {}
local InstanceToken  = {}

local function destroyActorInstance(plr)
    local inst = ActorInstances[plr]
    if not inst then return end
    ActorInstances[plr] = nil
    inst.dead = true
    for _, conn in ipairs(inst.conns) do
        pcall(function() conn:Disconnect() end)
    end
    PX.StopSSJB(inst)
end

local function createActorInstance(plr, char, isLocal)
    InstanceToken[plr] = (InstanceToken[plr] or 0) + 1
    local token = InstanceToken[plr]
    destroyActorInstance(plr)

    local hum      = char:WaitForChild("Humanoid", 10)
    local root     = char:WaitForChild("HumanoidRootPart", 10)
    if not (hum and root) then return end
    local animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 5)
    if not animator then return end
    if InstanceToken[plr] ~= token or plr.Character ~= char then return end

    local inst = {
        plr = plr, char = char, dead = false, conns = {},
        handled = setmetatable({}, { __mode = "k" }),
        ignored = setmetatable({}, { __mode = "k" }),
        lastTeleport = -math.huge, lastM1 = {},
        ssjbLockUntil = -math.huge, m1MuteUntil = 0,
        ssjbToken = 0, ssjb = nil,
    }

    table.insert(inst.conns, char.DescendantAdded:Connect(function(obj)
        if obj:IsA("Sound") and os.clock() < inst.m1MuteUntil then
            PX.MuteSwing(obj)
            task.defer(PX.MuteSwing, obj)
        end
    end))

    local prevBlockReact = char:GetAttribute("BlockReact") or 0
    table.insert(inst.conns, char:GetAttributeChangedSignal("BlockReact"):Connect(function()
        local blockReact = char:GetAttribute("BlockReact")
        if not blockReact then return end
        if char:GetAttribute("Blocking") and math.abs(math.abs(blockReact) - math.abs(prevBlockReact)) > 1 then
            PX.PlayDodgeSounds(char:FindFirstChild("HumanoidRootPart") or root)
        end
        prevBlockReact = blockReact
    end))

    table.insert(inst.conns, RunService.Heartbeat:Connect(function()
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            PX.HandleTrack(inst, track)
        end
    end))
    table.insert(inst.conns, animator.AnimationPlayed:Connect(function(track)
        PX.HandleTrack(inst, track)
    end))

    ActorInstances[plr] = inst
end

local EVENT_QUALIFY_PHRASE  = "GX-LIMITLESS!"
local EVENT_QUALIFY_SECONDS = 20

local RemoteParticipants = {}

local function registerParticipant(plr)
	if RemoteParticipants[plr] then return end
	RemoteParticipants[plr] = plr.CharacterAdded:Connect(function(char)
		task.spawn(createActorInstance, plr, char, false)
	end)
	if plr.Character then
		task.spawn(createActorInstance, plr, plr.Character, false)
	end
end

Players.PlayerRemoving:Connect(function(plr)
	local conn = RemoteParticipants[plr]
	if conn then conn:Disconnect() end
	RemoteParticipants[plr] = nil
	InstanceToken[plr] = (InstanceToken[plr] or 0) + 1
	destroyActorInstance(plr)
end)

local eventParticipantsStarted = false
local EventQualify = { deadline = 0 }

local function EventParticipants_Start()
	eventParticipantsStarted = true
end

function EventQualify.Check(userId, message)
	if userId == REAL_LOCAL_PLAYER.UserId then return end
	if message:match("^%s*(.-)%s*$"):lower() ~= EVENT_QUALIFY_PHRASE:lower() then return end
	local plr = Players:GetPlayerByUserId(userId)
	if plr then registerParticipant(plr) end
end

do
	local textChat = game:GetService("TextChatService")
	if textChat.ChatVersion == Enum.ChatVersion.TextChatService then
		textChat.MessageReceived:Connect(function(msg)
			if msg.TextSource then
				EventQualify.Check(msg.TextSource.UserId, msg.Text)
			end
		end)
	else
		local function hookQualify(p)
			p.Chatted:Connect(function(msg)
				EventQualify.Check(p.UserId, msg)
			end)
		end
		for _, p in ipairs(Players:GetPlayers()) do
			hookQualify(p)
		end
		Players.PlayerAdded:Connect(hookQualify)
	end
end

function EventQualify.ScanHistory()
	local found = {}
	local phraseLower = EVENT_QUALIFY_PHRASE:lower()

	local function clean(t)
		t = tostring(t or ""):gsub("<[^>]->", "")
		return (t:match("^%s*(.-)%s*$"))
	end

	local function isText(o)
		return o:IsA("TextLabel") or o:IsA("TextButton")
	end

	local function playerFromText(t)
		local c = clean(t):lower()
		c = c:gsub("^%[", ""):gsub("%]?%s*:?%s*$", "")
		if c == "" then return nil end
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= REAL_LOCAL_PLAYER and (p.Name:lower() == c or p.DisplayName:lower() == c) then
				return p
			end
		end
		return nil
	end

	local function scanRoot(root)
		for _, d in ipairs(root:GetDescendants()) do
			if isText(d) then
				local low = clean(d.Text):lower()
				local s1, e1 = low:find(phraseLower, 1, true)
				if s1 then
					local rem = (low:sub(1, s1 - 1) .. low:sub(e1 + 1)):match("^%s*(.-)%s*$")
					local plr
					if rem ~= "" then
						plr = playerFromText(rem)
					else
						local node = d.Parent
						for _ = 1, 3 do
							if not node or node == root then break end
							local texts = {}
							for _, sib in ipairs(node:GetDescendants()) do
								if isText(sib) and sib ~= d then texts[#texts + 1] = sib end
							end
							if #texts > 6 then break end
							for _, sib in ipairs(texts) do
								plr = playerFromText(sib.Text)
								if plr then break end
							end
							if plr then break end
							node = node.Parent
						end
					end
					if plr then found[plr] = true end
				end
			end
		end
	end

	local function pass()
		local roots = {}
		local isNewChat = false
		pcall(function()
			isNewChat = game:GetService("TextChatService").ChatVersion == Enum.ChatVersion.TextChatService
		end)

		local function getNewChatRoot(wait)
			local ok, root = pcall(function()
				local cg = game:GetService("CoreGui")
				return cg:FindFirstChild("ExperienceChat") or (wait and cg:WaitForChild("ExperienceChat", 5)) or nil
			end)
			return ok and root or nil
		end

		local function getOldChatRoot(wait)
			local ok, root = pcall(function()
				local pg = REAL_LOCAL_PLAYER:FindFirstChild("PlayerGui") or (wait and REAL_LOCAL_PLAYER:WaitForChild("PlayerGui", 5)) or nil
				if not pg then return nil end
				return pg:FindFirstChild("Chat") or (wait and pg:WaitForChild("Chat", 5)) or nil
			end)
			return ok and root or nil
		end

		local newRoot = getNewChatRoot(isNewChat)
		local oldRoot = getOldChatRoot(not isNewChat)
		if newRoot then roots[#roots + 1] = newRoot end
		if oldRoot then roots[#roots + 1] = oldRoot end

		for _, r in ipairs(roots) do
			local ok, err = pcall(scanRoot, r)
			if not ok then warn("[Qualify] chat scan error:", err) end
		end
		for plr in pairs(found) do
			pcall(registerParticipant, plr)
		end
	end

	task.spawn(function()
		pass()
		task.wait(3)
		pass()
	end)
end

local EVENT_QUALIFY_ANIM_ID = "77366695973257"

do
	local hooked = setmetatable({}, { __mode = "k" })

	local function qualifies(track)
		local a = track and track.Animation
		return a ~= nil and a.AnimationId:find(EVENT_QUALIFY_ANIM_ID, 1, true) ~= nil
	end

	local onTrigger
	local seen = setmetatable({}, { __mode = "k" })
	local function check(plr, track)
		if seen[track] or not qualifies(track) then return end
		seen[track] = true
		track.Stopped:Once(function() seen[track] = nil end)
		onTrigger(plr)
	end

	function onTrigger(plr)
		registerParticipant(plr)
	end

	local function hookAnimator(plr, animator)
		if hooked[animator] then return end
		hooked[animator] = true
		animator.AnimationPlayed:Connect(function(track)
			check(plr, track)
		end)
		for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
			check(plr, t)
		end
	end

	local function hookChar(plr, char)
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("Animator") then hookAnimator(plr, d) end
		end
		char.DescendantAdded:Connect(function(d)
			if d:IsA("Animator") then hookAnimator(plr, d) end
		end)
	end

	local function hookPlayer(plr)
		if plr == REAL_LOCAL_PLAYER then return end
		if plr.Character then hookChar(plr, plr.Character) end
		plr.CharacterAdded:Connect(function(c) hookChar(plr, c) end)
	end

	for _, p in ipairs(Players:GetPlayers()) do hookPlayer(p) end
	Players.PlayerAdded:Connect(hookPlayer)

	task.spawn(function()
		while true do
			task.wait(0.5)
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= REAL_LOCAL_PLAYER and plr.Character then
					local animator = plr.Character:FindFirstChildWhichIsA("Animator", true)
					if animator then
						for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
							check(plr, t)
						end
					end
				end
			end
		end
	end)
end

