    -- Installs whatever pack songs are missing, in the background, showing
    -- progress on the DLC row ("Installing 1/3"). Each finished song is written
    -- to the JSON record straight away, so it stays accurate even if the install
    -- is interrupted. Afterwards the script's pack list is checked against the
    -- record again: all installed -> the row becomes the song dropdown; anything
    -- still missing -> "Retry" (after a failure) or "N+ Needs to be installed".
    StartDbPackInstall = function()
        if dbPackInstalling then return end
        local songsToInstall = dbPackMissingSongs
        if #songsToInstall == 0 then return end

        dbPackInstalling = true
        dbPackInstallFailed = false
        dbPackInstallDone = 0
        dbPackInstallTotal = #songsToInstall
        RefreshSettingValues()

        task.spawn(function()
            for _, songEntry in ipairs(songsToInstall) do
                local installOk, installError = pcall(function()
                    InstallDbPackSong(songEntry)
                    RecordDbPackSongInstalled(songEntry.name)
                end)
                if not installOk then
                    warn("[DB Music Pack] Couldn't install " .. songEntry.name .. ": " .. tostring(installError))
                    dbPackInstallFailed = true
                    break
                end
                dbPackInstallDone = dbPackInstallDone + 1
                RefreshSettingValues()
            end

            dbPackInstalledNames, dbPackMissingSongs = GetDbPackStatus()
            dbPackInstalling = false
            RefreshSettingValues()
        end)
    end
