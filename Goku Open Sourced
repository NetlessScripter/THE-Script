    local function punctuationPause(text, letterIndex)
        local byteIndex = utf8.offset(text, letterIndex)
        if not byteIndex then return 1 end
        local ch = text:sub(byteIndex, byteIndex)
        if ch == "," or ch == ";" or ch == ":" then
            return 6
        elseif ch == "." or ch == "!" or ch == "?" then
            return 10
        end
        return 1
    end

    local function typeLabel(label, text, charDelay, sequenceId)
        label.Text = text
        label.MaxVisibleGraphemes = 0

        local total = utf8.len(text) or #text
        local revealTimes = table.create(total)
        local totalTime = 0
        for i = 1, total do
            revealTimes[i] = totalTime
            totalTime += charDelay * punctuationPause(text, i)
        end

        local startTime = os.clock()
        local shown = 0
        while shown < total do
            if sequenceId ~= typeSequenceId or not label.Parent then
                return false
            end
            local elapsed = os.clock() - startTime
            local due = shown
            while due < total and revealTimes[due + 1] <= elapsed do
                due += 1
            end
            if due ~= shown then
                shown = due
                label.MaxVisibleGraphemes = shown
            end
            if shown < total then
                RunService.Heartbeat:Wait()
            end
        end

        while os.clock() < startTime + totalTime do
            if sequenceId ~= typeSequenceId or not label.Parent then
                return false
            end
            RunService.Heartbeat:Wait()
        end

        if sequenceId ~= typeSequenceId then
            return false
        end
        label.MaxVisibleGraphemes = -1
        return true
    end

